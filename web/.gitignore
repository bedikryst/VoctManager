# build output
dist/
# throwaway verification build — `astro build --outDir dist-verify`, so a check can read a
# finished build without disturbing the `dist/` the developer keeps serving
dist-verify/
# generated types
.astro/
# The copy desk's reading of concerts.yaml (`npm run copy:extract`) — a projection of the YAML,
# regenerated on demand and ingested over the API, so committing it would put the same text in
# git twice and double the diff on every copy change.
copydesk/segments.json
# deps
node_modules/
# env & local
.env
.env.production
*.local
# os / editor
.DS_Store

# Source photos — collaborator-owned, deployed manually to the server.
# These are large originals (5–12 MB each) consumed by the Astro asset pipeline;
# the user uploads them out-of-band so the repo stays slim and the rights holders'
# files do not enter source control. Astro reads from src/assets/photos/ at build
# time (see lib/photos.ts), so the directory must exist on the build host.
src/assets/photos/

# Source videos — large MP4s, uploaded out-of-band to the build host like the photos
# above. Astro imports them from src/assets/videos/ and emits content-hashed URLs, so
# stable public `/video/*.mp4` paths are not generated.
src/assets/videos/

# Local A/B clips for grading decisions (docs/… none — throwaway). Served by `astro dev` at
# /probki/ because only public/ is served statically; kept OUT of git and out of the image,
# since anything under public/ is copied verbatim into dist/ and would ship to nginx.
public/probki/
