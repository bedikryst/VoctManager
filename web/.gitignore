# build output
dist/
# throwaway verification build — `astro build --outDir dist-verify`, so a check can read a
# finished build without disturbing the `dist/` the developer keeps serving
dist-verify/
# generated types
.astro/
# The copy desk's reading of concerts.yaml (`npm run copy:extract`) — a projection of the YAML,
# regenerated on demand and ingested over the API, so committing it would put the same text in
# git twice and double the diff on every copy change.
copydesk/segments.json
# Rendered brand-animation masters (`npm run rite:render`) — ProRes/PNG sequences in the
# hundreds of MB, regenerated from rite.html on demand and handed to video collaborators
# out-of-band. The SOURCE (rite/rite.html, rite/render.mjs) is committed; its output is not.
rite/out/
# deps
node_modules/
# env & local
.env
.env.production
*.local
# os / editor
.DS_Store

# Source photos — collaborator-owned, deployed manually to the server.
# These are large originals (5–12 MB each) consumed by the Astro asset pipeline;
# the user uploads them out-of-band so the repo stays slim and the rights holders'
# files do not enter source control. Astro reads from src/assets/photos/ at build
# time (see lib/photos.ts), so the directory must exist on the build host.
src/assets/photos/

# Video — large MP4s, uploaded out-of-band to the host like the photos above, and kept out
# of the build entirely (lib/videos.ts explains what that buys). `src/assets/videos/` is the
# masters-and-encodes archive; `public/video/` is what the site serves, at stable paths, from
# a bind mount in production and from `astro dev` locally.
src/assets/videos/
public/video/

# The downloadable press material (`npm run press:pack`): crops, previews, PDFs, ZIPs and the
# index /press reads. Tens of megabytes of photographs that are out of git for the reason above —
# it is built where the originals are and uploaded to the build host by hand. Its ABSENCE is a
# supported state, not a broken one: /press looks for it (lib/pressPack) and renders "materials on
# request" wherever it is missing, which is exactly what is true there. The manifest that says
# what goes in IS tracked (press-pack/manifest.yaml); the press photo originals it names are not,
# on the same terms as src/assets/photos/.
public/press/
press-pack/photos/

# Local A/B clips for grading decisions (docs/… none — throwaway). Served by `astro dev` at
# /probki/ because only public/ is served statically; kept OUT of git and out of the image,
# since anything under public/ is copied verbatim into dist/ and would ship to nginx.
public/probki/
