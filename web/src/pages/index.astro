---
/**
 * @file index.astro
 * @description Public landing (`/`). Reads as a partytura: metadata, jsonLd, then the
 *  rite as three movements braided by AetherInterlude (I · Lumen, II · Vox, III · Sustinete).
 *  The `rite` flag declares the once-per-session preloader to the shell, which decides the
 *  `preloader-skip` / `voct-motion` gates for this page (DocumentGates) — they cannot be armed
 *  from here, because on a navigation into "/" it is the outgoing page that has to arm them.
 * @architecture Astro islands 2026
 * @module pages/index
 */
import { getImage } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { bleedPair, photo } from "../lib/photos";
import { toRibbons } from "../lib/registrum";
import "../styles/landing.css";

import HeroSection from "../components/landing/HeroSection.astro";
import ManifestSection from "../components/landing/ManifestSection.astro";
import AetherInterlude from "../components/landing/AetherInterlude.astro";
import LitanySection from "../components/landing/LitanySection.astro";
import EnsembleSection from "../components/landing/EnsembleSection.astro";
import DirectorSection from "../components/landing/DirectorSection.astro";
import ImaginesBand from "../components/landing/ImaginesBand.astro";
import PathSection from "../components/landing/PathSection.astro";
import SilenceMoment from "../components/landing/SilenceMoment.astro";
import FinalSupportSection from "../components/landing/FinalSupportSection.astro";
import CodaSection from "../components/landing/CodaSection.astro";
import VaultBuffer from "../components/landing/VaultBuffer.astro";

import { AudioController } from "../islands/landing/AudioController";
import { Preloader } from "../islands/landing/Preloader";
import { StickyHeader } from "../islands/landing/StickyHeader";
import { SiteFooter } from "../islands/landing/SiteFooter";
import { VaultIsland } from "../islands/landing/VaultIsland";
import { VoxMoment } from "../islands/landing/VoxMoment";
import { VideoLightbox } from "../islands/landing/VideoLightbox";
import { MovementSpine } from "../islands/landing/MovementSpine";

const title = "VoctEnsemble — Z ciszy głos. Koncerty Duchowe";
// Kept under ~160 characters: Google truncates past that, and a description that spends its
// visible half on a second slogan buries the one fact a searcher needs (who sings what).
const description =
  "VoctEnsemble: dwanaście głosów w kamiennej nawie, od Victorii po Pärta. Cykl Koncertów Duchowych pod dyrekcją Florenta de Bazelaire.";

const ogImage = (
  await getImage({ src: bleedPair("hero-landing").desktop, width: 1200, format: "webp" })
).src;

// Desktop "registrum" ribbons for the StickyHeader island — derived here because a client
// island cannot read the concerts collection itself (see lib/registrum).
const ribbons = toRibbons(await getCollection("concerts"), "pl");

// Poster for the concert reel (Vox moment + lightbox) — a still from the film itself, which is
// what `concerts.yaml` already declares for it (`wcielenie.video.poster`). It used to reuse the
// nave frame that now carries the litany, so one photograph stood twice on this page: once as a
// wordless statement and once as the poster for a film it is not a frame of.
const voxPoster = (await getImage({ src: photo("kd-wcielenie-5"), width: 1600, format: "webp" }))
  .src;

// TODO (when structured video metadata is approved — MODAL_VIDEO/VOX_VIDEO in
// data/landing/video.ts): add a `video` VideoObject member here so Google can show a video
// rich result. Deliberately absent until real footage ships. See landing-vox-video-spec Part J.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "MusicGroup",
  // Shared entity ids — /o-nas declares an AboutPage graph pointing at the SAME
  // ensemble/foundation nodes, so search engines see one entity, not per-page twins.
  "@id": "https://voctensemble.com/#ensemble",
  name: "VoctEnsemble",
  url: "https://voctensemble.com",
  genre: ["Sacred music", "Choral music", "Polifonia"],
  description:
    "Zespół wokalny wykonujący muzykę sakralną. Cykl Koncerty Duchowe pod dyrekcją Florenta de Bazelaire. Rezydujący zespół Fundacji VoctFoundation.",
  founder: { "@type": "Person", name: "Florent de Bazelaire" },
  funder: {
    "@type": "NGO",
    "@id": "https://voctensemble.com/#foundation",
    name: "VoctFoundation",
    identifier: "KRS 0001237252",
    address: {
      "@type": "PostalAddress",
      streetAddress: "Św. Filipa 23/3",
      postalCode: "31-150",
      addressLocality: "Kraków",
      addressCountry: "PL",
    },
  },
  sameAs: [
    "https://www.instagram.com/voctensemble/",
    "https://www.facebook.com/voctensemble/",
    "https://www.youtube.com/@VoctEnsemble-nb7gh",
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  path="/"
  image={ogImage}
  bodyClass="theme-marketing"
  reveal={false}
  rite
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <VaultBuffer />
  </Fragment>

  <div class="voct-landing">
    <a class="skip-link" href="#main">Przejdź do treści</a>

    <Preloader client:load />
    <AudioController client:load />

    <StickyHeader client:load ribbons={ribbons} />
    <MovementSpine client:idle />

    <main id="main">
      <HeroSection />
      <ManifestSection />

      {/* Movement inscriptions are real liturgical Latin, never coined: "Lumen Christi" is the
          Easter Vigil acclamation sung as the paschal candle enters a dark church — the exact
          rite this movement's interlude performs (parchment cut to night, one flame). Keep any
          replacement short: the spine label is hidden below 1440px because the gutter is narrow
          (13-spine.css), and a longer inscription pushes that breakpoint up. */}
      <section class="movement" id="ruch-i" data-movement="lumen" aria-label="I · Lumen Christi">
        <AetherInterlude variant="passage" roman="I" latin="Lumen Christi" />
        <LitanySection />
        <EnsembleSection />
        <DirectorSection />
      </section>

      <section class="movement" id="ruch-ii" data-movement="vox" aria-label="II · Vox memoriae">
        <AetherInterlude variant="memory" roman="II" latin="Vox memoriae" />
        <SilenceMoment />
        <VoxMoment client:visible poster={voxPoster} />
        {/* Movement II is named memoriae and visual memory is the one register it lacked: the
            band announces the five evenings in photographs, the register unfolds them in words
            directly below. The "no poster images" rule this appears to bend is about REGISTER
            ENTRIES — see docs/web-landing-guardrails.md §1, where the reading is recorded. */}
        <ImaginesBand />
        <PathSection />
      </section>

      <section class="movement" id="ruch-iii" data-movement="sustinete" aria-label="III · Sustinete nos">
        <AetherInterlude variant="offering" roman="III" latin="Sustinete nos" />
        <FinalSupportSection />
      </section>

      <CodaSection />
    </main>

    <SiteFooter client:visible />

    <VaultIsland client:idle />
    <VideoLightbox client:idle poster={voxPoster} />
  </div>

  <style is:global>
    /* The landing's own no-motion un-gate used to live here, three `!important` rules deep.
       It is gone because every one of them became a restatement: the registers are declared
       inside `html.voct-motion` (styles/registers.css), so without that class the ink is
       un-hidden by base.css, the lead's pseudo-rule is never created and the veil rests at
       opacity 0. An `!important` that only repeats what the cascade already says is a trap
       for whoever next tries to change the thing it pins. */

    /* Once-per-session preloader skip: hide the SSR'd overlay BEFORE first paint for
       returning visitors (and for reduced motion, which never gets the rite). The
       body.preload-open scroll-lock is also neutralised so the page is immediately
       interactive on a ClientRouter return to "/". EXCEPTION: when the rite resolves into
       the threshold choice (`.is-choice` — e.g. the saved choice expired mid-session), the
       overlay must show despite the session skip; its scroll lock is `threshold-open`,
       which this neutralisation deliberately doesn't touch.
       `.is-hidden` belongs in the same exception: dismissing that choice drops `.is-choice`,
       so without it the overlay hit `display: none` in the same frame and the 700ms
       dissolve never played — the question just vanished. */
    html.preloader-skip .preloader { display: none !important; }
    html.preloader-skip .preloader:is(.is-choice, .is-hidden) { display: grid !important; }
    html.preloader-skip body.preload-open { overflow: visible !important; }
  </style>

  <script>
    import "../scripts/landing.ts";
  </script>
</BaseLayout>
