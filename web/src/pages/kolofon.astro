---
/**
 * @file kolofon.astro
 * @description Public colophon — quiet destination linked from every page footer (not in main
 *  nav). A colophon states who, where, when, with what types and with whose help; this one runs
 *  hero → sigil → Regula → Constructio → Typi → Imagines → Fundatio → Auctor → Gratiarum actio,
 *  closing on the impression date and the inscription. The sigil is per-visit (lib/sigil.ts,
 *  seeded from sessionStorage so there is NO persistent client identifier under RODO) and redrawn
 *  on every page-load — same visit, same seal; a fresh one each return. Tone: dark hero →
 *  parchment body, matching `/koncerty/[id]`.
 *
 *  THE PAGE'S ONE RULE, and the reason `Regula` is four sentences and not a paragraph: a colophon
 *  SHOWS its craft, it does not explain it. Every block here is set in the thing it describes —
 *  the type specimens demonstrate their own axes, the Regula lines are ruled and inked by the
 *  registers they name. Prose about the site's own metaphors belongs nowhere on it.
 *
 *  Rubrics (`.kol-eyebrow`, `.kol-section-label`) deliberately declare no font-family or
 *  text-transform: base.css owns the two-voice rubric for every host carrying a `.lat` span
 *  (capitalis caps candle for the Latin, mono lowercase muted for the Polish gloss), and a page
 *  rule setting either one ties its specificity and silently wins on bundle order.
 * @architecture Astro islands 2026
 * @module pages/kolofon
 */
import { getImage } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteChrome from "../components/SiteChrome.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { VaultIsland } from "../islands/landing/VaultIsland";
import { bleedPair } from "../lib/photos";
import "../styles/vault.css";

const title = "Kolofon — VoctEnsemble · VoctFoundation";
const description =
  "Kolofon strony VoctEnsemble — kroje pisma, konstrukcja, fotografie, fundacja, autorzy.";

const ogImage = (
  await getImage({ src: bleedPair("hero-landing").desktop, width: 1200, format: "webp" })
).src;

// The impression: when this copy of the page was struck. Taken once at build time and spent
// twice — as the closing statement of fact and as the graph's `dateModified` — so the two can
// never disagree. `Intl` carries the Polish genitive month ("1 sierpnia"), which is the ordinary
// reading and the reason not to hand-roll a month table.
const impressio = new Date();
const impressioLabel = new Intl.DateTimeFormat("pl-PL", {
  day: "numeric",
  month: "long",
  year: "numeric",
}).format(impressio);
const impressioIso = impressio.toISOString();

// Shared-entity JSON-LD: the page is authored by a named person and published by the SAME
// foundation node the landing/o-nas graphs declare (#foundation), so this reads as one
// entity's colophon — clean E-E-A-T signal for a young nonprofit.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  url: "https://voctensemble.com/kolofon",
  description,
  inLanguage: "pl-PL",
  dateModified: impressioIso,
  author: {
    "@type": "Person",
    name: "Krystian Bugalski",
    email: "krystian.bugalski@voctensemble.com",
  },
  publisher: {
    "@type": "NGO",
    "@id": "https://voctensemble.com/#foundation",
    name: "VoctFoundation",
  },
};
---

<BaseLayout
  title={title}
  description={description}
  path="/kolofon"
  image={ogImage}
  bodyClass="page-kolofon"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <a class="skip-link" href="#tresc">Przejdź do treści</a>
  <SiteChrome current="/kolofon" tone="dark" />

  <main id="tresc">
    {/* ── Hero: small, dark, restrained ───────────────────────────────────── */}
    <section class="kol-hero" aria-label="Kolofon">
      <div class="kol-hero-inner">
        <p class="kol-eyebrow micro reveal">
          <span class="lat" lang="la">Colophon</span>
          <span class="kol-dot" aria-hidden="true">·</span>
          <span>Pieczęć rzemiosła</span>
        </p>
        <h1 class="kol-title reveal ink-press" data-d="1">Kolofon.</h1>
        <p class="kol-lede reveal" data-d="2">
          Krótka inskrypcja na końcu książki, w której drukarz zapisywał miejsce
          i czas oraz to, kto rzecz wydał. Tu robimy to samo.
        </p>
      </div>
    </section>

    {/* ── Sigil — per-visit deterministic SVG ─────────────────────────────── */}
    <section class="kol-band kol-band-deep kol-seal" aria-labelledby="kol-h-sigil">
      <div class="kol-wrap kol-narrow">
        <h2 id="kol-h-sigil" class="kol-section-label micro reveal">
          <span class="lat" lang="la">Sigillum</span>
          <span class="kol-dot" aria-hidden="true">·</span>
          <span>Pieczęć wizyty</span>
        </h2>
        {/* `.reveal-cue` and NOT `.reveal`: the seal carries an authored draw, and a node
            wearing a choreography takes the bare trigger and no register (registers.css) —
            stacking ink on top of a drawing is two motions where the page means one. The
            caption is copy, so it keeps the ink; `data-d` stays on the figure as the
            subtree's cadence carrier. */}
        <figure class="kol-seal-figure reveal-cue" data-d="1">
          <div class="kol-seal-mount" data-sigil-mount role="img" aria-label="Pieczęć Twojej wizyty">
            {/* Client-side fallback: an anchor circle so the layout never collapses
                if JS is unavailable. The sigil script replaces innerHTML. It carries no
                `sg-` class, so the draw choreography passes over it untouched. */}
            <svg viewBox="0 0 220 220" xmlns="http://www.w3.org/2000/svg" stroke="currentColor" fill="none">
              <circle cx="110" cy="110" r="92" stroke-width="0.6" stroke-opacity="0.4" />
              <circle cx="110" cy="110" r="2" fill="currentColor" stroke="none" />
            </svg>
          </div>
          {/* Belongs to the generated seal, not to the fallback: it promises a seal that
              turns per visit and vanishes with the tab, which is true of nothing the anchor
              circle does. The script reveals it by flagging the figure, so a visitor without
              JS gets the circle and no claim about it. */}
          <figcaption class="kol-seal-caption kol-gloss reveal">
            ta&nbsp;sama, póki tu&nbsp;jesteś · nowa, gdy&nbsp;wrócisz · znika, gdy&nbsp;zamkniesz tę stronę
          </figcaption>
        </figure>
      </div>
    </section>

    {/* ── Regula — the rule the page is set by, stated and never explained ──
        Four sentences, no gloss after any of them. Two are demonstrated by the row they sit in
        (every row is ruled, then inked); the other two are demonstrated by the whole site, which
        lights its photographs and moves none of its text. Adding a paragraph here to say so is
        the one thing this block must never do. */}
    <section class="kol-band kol-band-soft" aria-labelledby="kol-h-regula">
      <div class="kol-wrap">
        <h2 id="kol-h-regula" class="kol-section-label micro reveal">
          <span class="lat" lang="la">Regula</span>
          <span class="kol-dot" aria-hidden="true">·</span>
          <span>Reguła</span>
        </h2>
        <p class="kol-lead kol-lead-tight reveal" data-d="1">
          Strona jest składana według czterech zdań.
        </p>
        <ul class="kol-regula" data-d="2">
          <li class="reveal reveal-rule">Wszystko czeka wpisane blado, zanim zostanie dopisane.</li>
          <li class="reveal reveal-rule">Kartę liniuje się przed pierwszą literą.</li>
          <li class="reveal reveal-rule">Fotografię wydobywa światło.</li>
          <li class="reveal reveal-rule">Litera zostaje tam, gdzie ją położono.</li>
        </ul>
      </div>
    </section>

    {/* ── Konstrukcja — build philosophy + tooling ────────────────────────── */}
    <section class="kol-band kol-band-soft kol-band-rule-top" aria-labelledby="kol-h-constructio">
      <div class="kol-wrap">
        <h2 id="kol-h-constructio" class="kol-section-label micro reveal">
          <span class="lat" lang="la">Constructio</span>
          <span class="kol-dot" aria-hidden="true">·</span>
          <span>Konstrukcja</span>
        </h2>
        <p class="kol-lead reveal" data-d="1">
          Strona zbudowana w&nbsp;Astro: statyczny HTML, a&nbsp;wyspy Reacta wchodzą tylko
          tam, gdzie potrzebny jest stan po&nbsp;stronie klienta. CSS pisany ręcznie, osobno
          dla każdej strony.
        </p>
        {/* The container carries the cadence, each row carries the registers: `data-d` sets
            --reveal-delay for the whole subtree, so a row is ruled and then written as one
            gesture instead of the block inking over rows whose hairlines have not arrived. */}
        <dl class="kol-defs" data-d="2">
          <div class="kol-def reveal reveal-rule">
            <dt>Framework</dt>
            <dd>Astro · statyczny HTML + hydratowane wyspy Reacta</dd>
          </div>
          <div class="kol-def reveal reveal-rule">
            <dt>Płynność scrolla</dt>
            <dd>Lenis · hostowany z naszej domeny</dd>
          </div>
          <div class="kol-def reveal reveal-rule">
            <dt>Animacja</dt>
            <dd>CSS, fonty wariacyjne i IntersectionObserver</dd>
          </div>
          <div class="kol-def reveal reveal-rule">
            <dt>Dane</dt>
            <dd>Astro Content Collections · YAML z walidacją Zod</dd>
          </div>
          <div class="kol-def reveal reveal-rule">
            <dt>Obrazy</dt>
            <dd>AVIF i WebP w wielu rozmiarach, generowane przy budowaniu</dd>
          </div>
          <div class="kol-def reveal reveal-rule">
            <dt>Pomiar</dt>
            <dd>Plausible · anonimowo, bez&nbsp;cookies, serwery w&nbsp;UE</dd>
          </div>
          <div class="kol-def reveal reveal-rule">
            <dt>Prywatność</dt>
            <dd>cały kod i&nbsp;wszystkie kroje pochodzą z&nbsp;tej domeny; Plausible jest jedynym wyjątkiem</dd>
          </div>
        </dl>
      </div>
    </section>

    {/* ── Typi — typeface credits ─────────────────────────────────────────── */}
    <section class="kol-band kol-band-soft kol-band-rule-top" aria-labelledby="kol-h-typi">
      <div class="kol-wrap">
        <h2 id="kol-h-typi" class="kol-section-label micro reveal">
          <span class="lat" lang="la">Typi</span>
          <span class="kol-dot" aria-hidden="true">·</span>
          <span>Kroje pisma</span>
        </h2>
        {/* Independent rows under one onset was the `.donation-rows` shape: as a single 513px
            node the last specimens were written before they were reached. Each row now has its
            own trigger and the list keeps its rolling cadence. */}
        <ul class="kol-fonts">
          <li class="kol-font kol-font--cormorant reveal reveal-rule">
            <span class="kol-font-sample">Cormorant Garamond</span>
            <span class="kol-font-meta kol-gloss">Christian Thalmann · garaldowa antykwa na nagłówki i&nbsp;tekst</span>
          </li>
          <li class="kol-font kol-font--cinzel reveal reveal-rule">
            <span class="kol-font-sample">Cinzel</span>
            <span class="kol-font-meta kol-gloss">Natanael Gama · kapitała inskrypcyjna na rubryki i cyfry rzymskie</span>
          </li>
          <li class="kol-font kol-font--sans reveal reveal-rule">
            <span class="kol-font-sample">IBM Plex Sans</span>
            <span class="kol-font-meta kol-gloss">Mike Abbink i&nbsp;Bold Monday dla IBM · sans-serif do czytania</span>
          </li>
          <li class="kol-font kol-font--plex reveal reveal-rule">
            <span class="kol-font-sample">IBM Plex Mono</span>
            <span class="kol-font-meta kol-gloss">Mike Abbink i&nbsp;Bold Monday dla IBM · monospace na meta i daty</span>
          </li>
        </ul>
        <p class="kol-license kol-gloss reveal" data-d="2">
          Wszystkie cztery na&nbsp;licencji SIL Open Font License · hostowane z&nbsp;naszej domeny jako woff2
        </p>
      </div>
    </section>

    {/* ── Imagines — photographers. Source of truth is the `(fot. …)` convention in
        src/content/concerts.yaml gallery captions; a caption without one is the foundation's own
        frame. Authored rather than derived: the convention is free text that nothing validates,
        and a silent parse failure would drop a human credit. Adding a photographer to the YAML
        therefore means updating this list by hand. ─────────────────────────── */}
    <section class="kol-band kol-band-soft kol-band-rule-top" aria-labelledby="kol-h-imagines">
      <div class="kol-wrap">
        <h2 id="kol-h-imagines" class="kol-section-label micro reveal">
          <span class="lat" lang="la">Imagines</span>
          <span class="kol-dot" aria-hidden="true">·</span>
          <span>Fotografie</span>
        </h2>
        <p class="kol-lead kol-lead-tight reveal" data-d="1">
          Zdjęcia z&nbsp;Koncertów Duchowych. Pozostałe fotografie w&nbsp;serwisie są własnością fundacji.
        </p>
        <ul class="kol-collab">
          <li class="reveal reveal-rule">
            <span class="kol-collab-name">Kamila Grudzińska</span>
            <span class="kol-collab-role kol-gloss">9 Kart · Bazylika NSPJ w&nbsp;Krakowie</span>
          </li>
          <li class="reveal reveal-rule">
            <span class="kol-collab-name">Wojciech Przybył</span>
            <span class="kol-collab-role kol-gloss">9 Kart · Archikatedra Łódzka</span>
          </li>
          <li class="reveal reveal-rule">
            <span class="kol-collab-name">Jakub Garbacz</span>
            <span class="kol-collab-role kol-gloss">9 Kart · Archikatedra Łódzka</span>
          </li>
        </ul>
      </div>
    </section>

    {/* ── Fundatio — foundation legal ─────────────────────────────────────── */}
    <section class="kol-band kol-band-soft kol-band-rule-top" aria-labelledby="kol-h-fundatio">
      <div class="kol-wrap">
        <h2 id="kol-h-fundatio" class="kol-section-label micro reveal">
          <span class="lat" lang="la">Fundatio</span>
          <span class="kol-dot" aria-hidden="true">·</span>
          <span>Fundacja</span>
        </h2>
        <p class="kol-lead kol-lead-tight reveal" data-d="1">
          Fundacja VoctFoundation działa w obszarze kultury, sztuki oraz ochrony
          dziedzictwa; VoctEnsemble jest jej zespołem-rezydentem. Dochód przeznaczamy
          w całości na&nbsp;cele statutowe.
        </p>
        <dl class="kol-defs kol-defs-tight" data-d="2">
          <div class="kol-def reveal reveal-rule">
            <dt>Siedziba</dt>
            <dd>ul. Św.&nbsp;Filipa 23/3 · 31-150 Kraków</dd>
          </div>
          <div class="kol-def reveal reveal-rule">
            <dt>KRS</dt>
            <dd class="kol-num">0001237252</dd>
          </div>
          <div class="kol-def reveal reveal-rule">
            <dt>NIP</dt>
            <dd class="kol-num">6762718992</dd>
          </div>
          <div class="kol-def reveal reveal-rule">
            <dt>REGON</dt>
            <dd class="kol-num">544621525</dd>
          </div>
          <div class="kol-def reveal reveal-rule">
            <dt>Zarząd</dt>
            <dd>Florent de Bazelaire · Anna Marcisz · Krystian Bugalski</dd>
          </div>
          <div class="kol-def reveal reveal-rule">
            <dt>Statut</dt>
            <dd>
              {/* The `↗` is the design's "this leaves the page" mark and is decorative, so it
                  is hidden from assistive tech — which means the fact it carries has to be
                  said in words for the reader who cannot see it. */}
              <a href="/docs/Statut-VoctFoundation.pdf" target="_blank" rel="noopener" class="kol-link">
                Statut Fundacji VoctFoundation (PDF) <span aria-hidden="true">↗</span><span class="sr-only">, otwiera się w nowym oknie</span>
              </a>
            </dd>
          </div>
          <div class="kol-def reveal reveal-rule">
            <dt>Polityka</dt>
            <dd>
              <a href="/polityka-prywatnosci" class="kol-link">Polityka prywatności</a>
            </dd>
          </div>
        </dl>
      </div>
    </section>

    {/* ── Auctor — author block ───────────────────────────────────────────── */}
    <section class="kol-band kol-band-soft kol-band-rule-top" aria-labelledby="kol-h-auctor">
      <div class="kol-wrap">
        <h2 id="kol-h-auctor" class="kol-section-label micro reveal">
          <span class="lat" lang="la">Auctor</span>
          <span class="kol-dot" aria-hidden="true">·</span>
          <span>Autor</span>
        </h2>
        <p class="kol-author-name reveal ink-press" data-d="1">Krystian Bugalski</p>
        <p class="kol-author-role reveal" data-d="1">projekt · kod</p>
        <p class="kol-author-contact reveal" data-d="2">
          {/* No `↗` here: the arrow is the site's mark for a link that opens elsewhere in the
              browser, and a `mailto:` hands off to a mail client instead. */}
          <a href="mailto:krystian.bugalski@voctensemble.com" rel="author" class="kol-link">
            krystian.bugalski@voctensemble.com
          </a>
        </p>
      </div>
    </section>

    {/* ── Gratiarum actio — factual credits for past concerts (not personal endorsements) ─── */}
    <section class="kol-band kol-band-soft kol-band-rule-top kol-gratia" aria-labelledby="kol-h-gratia">
      <div class="kol-wrap">
        <h2 id="kol-h-gratia" class="kol-section-label micro reveal">
          <span class="lat" lang="la">Gratiarum actio</span>
          <span class="kol-dot" aria-hidden="true">·</span>
          <span>Podziękowania</span>
        </h2>
        <p class="kol-lead kol-lead-tight reveal" data-d="1">
          Twórczynie i twórcy, których praca składała się na&nbsp;kolejne Koncerty Duchowe
          — nazwiska z plakatów i programów.
        </p>
        <ul class="kol-collab">
          <li class="reveal reveal-rule">
            <span class="kol-collab-name">Jakub Garbacz · Ars Sonora Studio</span>
            <span class="kol-collab-role kol-gloss">realizacja nagrań · Kontemplacja Wcielenia, 2024</span>
          </li>
          <li class="reveal reveal-rule">
            <span class="kol-collab-name">Ada Bystrzycka · Multiscena</span>
            <span class="kol-collab-role kol-gloss">reżyseria świateł · wybrane koncerty 2024–2025</span>
          </li>
          <li class="reveal reveal-rule">
            <span class="kol-collab-name">Sebastian Kuźma · ART Agencja Rzemieślników Teatralnych</span>
            <span class="kol-collab-role kol-gloss">animacja wizualna · wybrane koncerty 2024–2025</span>
          </li>
          <li class="reveal reveal-rule">
            <span class="kol-collab-name">Radu Ropotan</span>
            <span class="kol-collab-role kol-gloss">skrzypce · Wołanie Gór, 2024</span>
          </li>
          <li class="reveal reveal-rule">
            <span class="kol-collab-name">Krzysztof Michałek · Michał Piechnik</span>
            <span class="kol-collab-role kol-gloss">organy · Hymn Poległym, 2025</span>
          </li>
          <li class="reveal reveal-rule">
            <span class="kol-collab-name">Fundacja Carpe Diem · Ośrodek Kultury Norwida</span>
            <span class="kol-collab-role kol-gloss">współorganizacja · wybrane wydarzenia</span>
          </li>
        </ul>
        {/* The impression, then the inscription — the historical order, and the reason they are
            two lines: one is a Polish fact, the other terse Latin, and running them together
            costs the inscription its finality. */}
        <p class="kol-impressio reveal" data-d="3">Złożono i&nbsp;odbito {impressioLabel}</p>
        <p class="kol-close micro reveal" lang="la" data-d="4">Cracoviae · MMXXVI · Laus&nbsp;Deo</p>
      </div>
    </section>
  </main>

  <SiteFooter />

  <VaultIsland client:idle />
  <script>
    import "../scripts/vault-triggers.ts";
    import { buildSigilSvg, getOrCreateVisitSeed } from "../lib/sigil";

    // Redraw on every page-load, not just once: the sigil script is a module that runs once
    // on first import, but a ClientRouter return to /kolofon swaps in fresh SSR markup (the
    // bare fallback circle) without re-running module top-level code. Binding to
    // `astro:page-load` (fires on initial load AND after each view-transition swap) keeps the
    // seal present on return. Guarded on the mount element — a no-op on every other page.
    const drawSigil = () => {
      const mount = document.querySelector<HTMLElement>("[data-sigil-mount]");
      if (!mount) return;
      mount.innerHTML = buildSigilSvg(getOrCreateVisitSeed(), { size: 220 });
      // The flag the caption is gated on. Set after the injection, so the promise and the
      // thing it describes arrive together; the SSR markup ships without it, which is what
      // keeps the caption off the no-JS fallback.
      mount.closest<HTMLElement>(".kol-seal-figure")?.setAttribute("data-sigil-live", "");
    };
    document.addEventListener("astro:page-load", drawSigil);
  </script>
</BaseLayout>

<style>
  /* Colophon runs darker ink than the body default (--ink-soft); background comes from base.css.
     `:global` because <body> belongs to BaseLayout and never carries this file's `data-astro-cid`
     — bare, this selector matches nothing and the page silently keeps the default ink. */
  :global(body.page-kolofon) { color: var(--ink); }

  /* Hero */
  .kol-hero { background: var(--dark); color: var(--paper); padding: clamp(120px, 16vw, 200px) var(--gutter) clamp(64px, 9vw, 100px); }
  .kol-hero-inner { max-width: 760px; margin: 0 auto; }
  .kol-title { font-family: var(--serif); font-weight: 300; line-height: .95; font-size: clamp(56px, 8vw, 120px); letter-spacing: -.01em; margin: 0; color: var(--paper); }
  .kol-lede { margin: clamp(28px, 4vw, 44px) 0 0; font-family: var(--serif); font-style: italic; font-weight: 300; font-size: clamp(18px, 1.8vw, 24px); line-height: 1.5; color: rgba(244, 241, 233, .82); max-width: 50ch; }

  /* Bands */
  .kol-band { padding: clamp(72px, 11vw, 140px) var(--gutter); position: relative; }
  .kol-band-soft { background: var(--paper); color: var(--ink); }
  .kol-band-deep { background: var(--dark); color: var(--paper); }
  .kol-band-rule-top { padding-top: clamp(48px, 7vw, 84px); }
  .kol-band-rule-top::before { content: ""; display: block; width: 60px; height: 1px; background: var(--line); margin-bottom: clamp(48px, 7vw, 84px); }
  .kol-wrap { max-width: 1180px; margin: 0 auto; }
  .kol-narrow { max-width: 760px; margin: 0 auto; }

  /* ── The two rubric tiers ──────────────────────────────────────────────────
     Face and letter case belong to base.css, which keys them on the presence of a `.lat` span:
     the Latin is the stone (capitalis, capitals, candle), the Polish is the gloss reading it
     aloud (mono, lowercase, muted). Declaring either here would tie that rule's specificity and
     win on bundle order, collapsing both halves into one voice — so these carry geometry and
     the gloss tier's colour and tracking only. */
  .kol-eyebrow { display: inline-flex; align-items: center; gap: 10px; font-size: 11px; letter-spacing: .1em; color: rgba(244, 241, 233, .68); margin: 0 0 28px; }
  .kol-section-label { display: inline-flex; align-items: center; gap: 8px; font-size: 10.5px; font-weight: 400; letter-spacing: .1em; color: var(--ink-muted); margin: 0 0 28px; }
  .kol-band-deep .kol-section-label { color: rgba(244, 241, 233, .56); }
  /* Ground-agnostic: the separator belongs to whichever tier it sits between, on parchment and
     on the dark band alike. A fixed colour here was a near-white dot on parchment. */
  .kol-dot { opacity: .5; }

  /* The gloss voice as running text. `.micro` is the rubric LABEL utility (capitalis, capitals,
     0.24em) and these four roles are sentences — designer credits, a licence line, a caption, a
     collaborator's function — written in sentence case with diacritics because they are meant to
     be read. `.kol-close` keeps `.micro`: it is an inscription, which is what that utility is for. */
  .kol-gloss { font-family: var(--mono); font-size: 12.5px; line-height: 1.6; letter-spacing: .015em; color: var(--ink-muted); }

  /* Sigil */
  .kol-seal { padding-bottom: clamp(72px, 11vw, 140px); }
  .kol-seal-figure { display: flex; flex-direction: column; align-items: center; gap: 28px; margin: 36px 0 0; color: var(--candle); }
  .kol-seal-mount { width: 220px; height: 220px; display: block; }
  .kol-seal-mount :global(svg) { width: 100%; height: 100%; display: block; }
  .kol-seal-caption { display: none; max-width: 46ch; text-align: center; color: rgba(244, 241, 233, .56); }
  .kol-seal-figure[data-sigil-live] .kol-seal-caption { display: block; }

  /* ── The seal writes itself ───────────────────────────────────────────────
     `:global()` on every selector that reaches inside the SVG, and this is not optional:
     the markup is injected with innerHTML, so it carries no `data-astro-cid-…`, and a
     scoped rule appends that attribute to every compound and matches nothing. The one
     `:global(svg)` above is the existing proof.

     The hidden state is `:not(.is-in)` rather than a resting `.is-in` state, for the same
     reason the interlude's knot is: the SVG arrives on `astro:page-load`, so on a short
     viewport the observer can flag the figure before the markup exists. Keyed this way a
     late injection renders finished instead of stuck at dashoffset 1. It is also the whole
     of the reduced-motion story — `html.voct-motion` is withheld under `reduce`
     (DocumentGates), so the hidden state never engages and the seal is simply present.

     `pathLength="1"` (lib/sigil.ts) normalises every stroke to one unit, so a ring and a
     ray share one clock and the composition is carried by the ORDER rather than by their
     lengths. --ease-rule because a drawn stroke is a ruled line wherever it lives.

     BUDGET: last stroke at 1.55s ≈ 620px of travel, so the seal closes with the figure's
     top still ~170px down a 900px screen. A cue is exempt from SETTLE_FALLBACK_MS
     (reveal.ts returns early for `.reveal-cue`), which removes the 3.4s guard rail and
     makes overrunning easier, not harder — the ~2.0s ceiling is the real one here. */
  /* The `var()` fallbacks are the failure mode, not decoration: an `sg-draw` element that
     reached the page without one of the step classes below would leave `--sg-in` unset, and an
     unresolved var makes the WHOLE shorthand invalid at computed-value time — so the element
     would snap into place instead of drawing, silently, on one element out of thirty. */
  .kol-seal-figure :global(.sg-draw) {
    stroke-dasharray: 1 1;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset var(--sg-in, .5s) var(--ease-rule) var(--sg-at, 0s);
  }
  /* No `opacity` in the arrived state on purpose: the roman date ships at 0.55 as a
     presentation attribute (its ink strength), so declaring 1 here would brighten it. */
  .kol-seal-figure :global(.sg-fade) {
    transition: opacity var(--sg-in, .4s) var(--ease-ink) var(--sg-at, 0s);
  }
  html.voct-motion .kol-seal-figure:not(.is-in) :global(.sg-draw) { stroke-dashoffset: 1; }
  html.voct-motion .kol-seal-figure:not(.is-in) :global(.sg-fade) { opacity: 0; }

  /* The writing order: the field, then the socket for the candle, then the cross of four
     cardinal rays answered by four intercardinals, then the ornaments, the flame, and the
     date last — a seal is dated after it is cut. */
  .kol-seal-figure :global(.sg-ring)   { --sg-at: 0s;    --sg-in: .62s; }
  .kol-seal-figure :global(.sg-socket) { --sg-at: .16s;  --sg-in: .50s; }
  .kol-seal-figure :global(.sg-ray-a)  { --sg-at: .34s;  --sg-in: .46s; }
  .kol-seal-figure :global(.sg-ray-b)  { --sg-at: .46s;  --sg-in: .46s; }
  .kol-seal-figure :global(.sg-orn)    { --sg-at: .80s;  --sg-in: .42s; }
  .kol-seal-figure :global(.sg-candle) { --sg-at: .98s;  --sg-in: .36s; }
  .kol-seal-figure :global(.sg-date)   { --sg-at: 1.10s; --sg-in: .45s; }

  /* Body lead + definition lists */
  .kol-lead { font-family: var(--serif); font-style: italic; font-weight: 300; font-size: clamp(20px, 2.2vw, 28px); line-height: 1.5; color: var(--ink); max-width: 30ch; margin: 0 0 clamp(40px, 5vw, 56px); letter-spacing: -.005em; }
  .kol-lead-tight { font-size: clamp(18px, 1.8vw, 22px); line-height: 1.6; max-width: 38ch; }

  /* ── Regula ───────────────────────────────────────────────────────────────
     Roman rather than italic: the leads on this page are italic, and these are inscriptions
     rather than voice. Each line is a row like every other list here, so its hairline is the
     layout's own — nothing was added in order to have something to rule. */
  .kol-regula { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(18px, 2.4vw, 26px); max-width: 720px; }
  .kol-regula li { padding-top: 16px; border-top: 1px solid var(--line); font-family: var(--serif); font-weight: 300; font-size: clamp(19px, 2vw, 26px); line-height: 1.35; letter-spacing: -.005em; color: var(--ink); }

  /* Definition lists. The four-track grid + subgrid is what makes the labels line up: with each
     row sizing its own two columns, every `dt` set its own width and the values stood ragged
     down both halves of the page. */
  .kol-defs { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(20px, 3vw, 32px) clamp(28px, 4vw, 56px); margin: 0; padding: 0; max-width: 880px; }
  .kol-defs-tight { gap: clamp(16px, 2vw, 24px) clamp(28px, 4vw, 56px); }
  .kol-def { display: grid; grid-template-columns: max-content 1fr; gap: clamp(16px, 2vw, 28px); align-items: baseline; padding-top: 14px; border-top: 1px solid var(--line); }
  .kol-def dt { font-family: var(--capitalis); font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; color: var(--ink-muted); margin: 0; min-width: 88px; }
  .kol-def dd { margin: 0; font-family: var(--serif); font-size: clamp(15px, 1.3vw, 18px); line-height: 1.5; color: var(--ink); }
  /* Registry numbers are data whose alignment carries meaning (tokens.css), and `/o-nas` sets the
     same three in mono — one datum, one face. The prose rows stay serif. */
  .kol-def dd.kol-num { font-family: var(--mono); font-size: clamp(14px, 1.2vw, 16px); letter-spacing: .02em; }

  @supports (grid-template-columns: subgrid) {
    .kol-defs { grid-template-columns: max-content 1fr max-content 1fr; }
    .kol-def { grid-column: span 2; grid-template-columns: subgrid; }
  }

  /* Fonts list — each row demonstrates its typeface on the axis it actually ships:
     Cormorant and Cinzel are variable weight axes; Plex Sans ships variable (100–700); Plex Mono
     ships as two static weights (300/400), so its demo snaps between the real faces and shifts
     tracking rather than pretending to an axis it doesn't have. Verified against public/fonts/.

     Each face states its four numbers ONCE, as custom properties, and three consumers read
     them: the resting state, the hover repeat, and the arrival keyframe. They were literals
     in two places before the keyframe existed and would have been literals in four after. */
  .kol-fonts { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(28px, 4vw, 44px); max-width: 760px; }
  .kol-fonts li.kol-font {
    display: grid;
    gap: 6px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  /* `font-weight` and `font-variation-settings` are both set from one value: the axis wins
     wherever there is one, and on Plex Mono — which has none — `font-weight` is what picks
     between the two shipped faces. One declaration block covers all four. */
  .kol-font-sample {
    display: inline-block;
    font-size: clamp(28px, 3.4vw, 44px);
    line-height: 1.1;
    color: var(--ink);
    font-weight: var(--spec-wght);
    font-variation-settings: "wght" var(--spec-wght);
    letter-spacing: var(--spec-track);
    transition:
      font-variation-settings 1.1s var(--ease-slow, ease),
      font-weight 1.1s var(--ease-slow, ease),
      letter-spacing 1.1s var(--ease-slow, ease);
  }
  .kol-font:hover .kol-font-sample {
    font-weight: var(--spec-wght-peak);
    font-variation-settings: "wght" var(--spec-wght-peak);
    letter-spacing: var(--spec-track-peak);
  }
  .kol-font-meta { transition: color 0.5s var(--ease, ease); }
  .kol-font:hover .kol-font-meta { color: var(--candle-ink); }

  /* Cormorant Garamond — italic axis is its signature, weight breathes wider on attention */
  .kol-font--cormorant .kol-font-sample {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    --spec-wght: 320;
    --spec-wght-peak: 560;
    --spec-track: -0.005em;
    --spec-track-peak: 0.008em;
  }

  /* Cinzel — capitals only, so the sample has nowhere to go but wider; weight 400→640 on
     its 400–900 axis, and the tracking opens further than the others because inscriptional
     capitals read as letters set in stone rather than as a word */
  .kol-font--cinzel .kol-font-sample {
    font-family: 'Cinzel', Georgia, serif;
    --spec-wght: 400;
    --spec-wght-peak: 640;
    --spec-track: 0.06em;
    --spec-track-peak: 0.16em;
  }

  /* Plex Sans — variable weight (100–700); on attention the range opens up with a touch of tracking */
  .kol-font--sans .kol-font-sample {
    font-family: 'IBM Plex Sans', -apple-system, sans-serif;
    --spec-wght: 320;
    --spec-wght-peak: 620;
    --spec-track: -0.01em;
    --spec-track-peak: 0.005em;
  }

  /* IBM Plex Mono — two shipped static weights (300 → 400) + tracking; the grid stays fixed */
  .kol-font--plex .kol-font-sample {
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    --spec-wght: 300;
    --spec-wght-peak: 400;
    --spec-track: 0;
    --spec-track-peak: 0.05em;
  }

  /* ── The specimens on arrival ─────────────────────────────────────────────
     The block's whole idea is that a face demonstrates its own axis, and the demonstration
     was `:hover` only — so on a phone the Typi section was four names and four notes, and
     after Etap A6 dropped the dead tab stops it was mouse-only everywhere. Firing it on
     arrival gives it to touch and to the keyboard at once, without a focus target that does
     nothing when it is reached.

     OUT AND BACK, which is deliberately not what `.ink-press` does. The press is an
     ENTRANCE and must be one-way, or scrolling back up rethickens a heading the page has
     finished writing. A specimen is not an entrance: the axis IS the subject, and the way
     to show an axis is to travel it and put it back. Sanctioned here and nowhere else.

     BUDGET. The row is ink+lead, so its ink ends at 0.18 + 0.9 = 1.08s — but it is ~82%
     inked at 0.6s, and that is what the delay is measured against; waiting for the true end
     would close the gesture at ~2.4s, past the ceiling. Peak at 1.15s, rest again at 1.9s.
     The return is allowed to run late on purpose: the outbound travel is the demonstration
     and it lands inside the reading zone, while the return is only housekeeping and costs
     nothing if it finishes as the row leaves the top of the screen.

     No queue and no per-row `data-d`: the rows sit ~134px apart, so at reference pace their
     own triggers are ~335ms apart already — wider than the shared queue's 220ms step.

     Reflow was the thing to check, since weight and tracking are both reflowing channels.
     The widest sample is "Cormorant Garamond": ~340px at the 44px cap, and ~212px at the
     28px floor against ~319px of column on a 375px screen. Nothing reaches a second line at
     the heavy end. */
  @keyframes kol-specimen {
    0% {
      font-weight: var(--spec-wght);
      font-variation-settings: "wght" var(--spec-wght);
      letter-spacing: var(--spec-track);
      animation-timing-function: var(--ease, ease);
    }
    42%, 58% {
      font-weight: var(--spec-wght-peak);
      font-variation-settings: "wght" var(--spec-wght-peak);
      letter-spacing: var(--spec-track-peak);
      animation-timing-function: var(--ease-ink, ease);
    }
    100% {
      font-weight: var(--spec-wght);
      font-variation-settings: "wght" var(--spec-wght);
      letter-spacing: var(--spec-track);
    }
  }

  /* No fill mode, and that is load-bearing rather than a default left alone: `forwards`
     would hold the last keyframe forever and the hover repeat would never be able to
     out-rank it again. With none, the sample is at rest before the delay and back under the
     stylesheet's control the instant the gesture ends. */
  html.voct-motion .kol-font.is-in .kol-font-sample {
    animation: kol-specimen 1.3s var(--ease, ease) 0.6s;
  }

  /* A ClientRouter arrival is already composed: BaseLayout settles the above-the-fold
     reveals inside the swap and `vt-nav` strips their transition, but a transition is all it
     strips — an animation would still play through the page transition on a viewport tall
     enough to reach this section. Mirrors registers.css's press guard. */
  html.voct-motion.vt-nav .kol-font.is-in .kol-font-sample { animation: none; }

  .kol-license { margin: clamp(28px, 4vw, 40px) 0 0; max-width: 74ch; }

  /* Under `reduce` the gate itself is withheld (DocumentGates), so `.is-in` never lands and
     neither of these can fire. They cover the one path that reaches them: a preference
     flipped mid-session, where the gate stays on the root until the next navigation. */
  @media (prefers-reduced-motion: reduce) {
    .kol-font-sample { transition: none; }
    html.voct-motion .kol-font.is-in .kol-font-sample { animation: none; }
    .kol-seal-figure :global(.sg-draw),
    .kol-seal-figure :global(.sg-fade) { transition: none; }
  }

  /* Author block */
  .kol-author-name { font-family: var(--serif); font-weight: 300; font-size: clamp(36px, 5vw, 60px); line-height: 1.05; letter-spacing: -.01em; color: var(--ink); margin: 0; }
  .kol-author-role { margin: 12px 0 0; font-family: var(--capitalis); font-size: 11.5px; letter-spacing: .22em; text-transform: uppercase; color: var(--candle-ink); }
  .kol-author-contact { margin: clamp(20px, 3vw, 28px) 0 0; font-family: var(--serif); font-size: clamp(18px, 1.6vw, 22px); color: var(--ink); }

  /* Collaborators + photographers — one row shape for both credit lists */
  .kol-collab { list-style: none; margin: 0 0 clamp(36px, 5vw, 56px); padding: 0; display: grid; gap: clamp(14px, 2vw, 20px); max-width: 760px; }
  .kol-collab li { display: grid; grid-template-columns: 1fr max-content; gap: 16px; padding-top: 12px; border-top: 1px solid var(--line); align-items: baseline; }
  .kol-collab-name { font-family: var(--serif); font-size: clamp(18px, 1.8vw, 22px); color: var(--ink); }
  .kol-collab-role { text-align: right; }

  /* Closing pair: the fact, then the inscription. */
  .kol-impressio { margin: 0 0 12px; font-family: var(--mono); font-size: 12px; letter-spacing: .05em; color: var(--ink-muted); }
  .kol-close { color: var(--ink-muted); margin: 0; letter-spacing: .26em; }

  /* Links */
  .kol-link { color: var(--ink); border-bottom: 1px solid var(--line-strong); padding-bottom: 1px; transition: color .3s var(--ease, ease), border-color .3s var(--ease, ease); }
  .kol-link:hover { color: var(--candle-ink); border-bottom-color: var(--candle-ink); }

  /* ── LEAD register ────────────────────────────────────────────────────────
     Every hairline below is a border the layout already carried. The real border stays for no-JS
     and reduced-motion visitors; only under the motion gate is it handed to a pseudo-rule that
     can be drawn, top-anchored (`--rule-inset`'s default) because the trigger fires on an
     element's top and because a scribe rules the line before writing on it.
     The four `.kol-band-rule-top` separators cannot join: `::before` is already their hairline,
     and that is the pseudo-element this register draws through. */
  html.voct-motion .kol-regula li.reveal-rule,
  html.voct-motion .kol-def.reveal-rule,
  html.voct-motion .kol-fonts li.kol-font.reveal-rule,
  html.voct-motion .kol-collab li.reveal-rule {
    border-top-color: transparent;
    --rule-ink: var(--line);
  }

  @media (max-width: 640px) {
    .kol-defs { grid-template-columns: 1fr; }
    .kol-collab li { grid-template-columns: 1fr; gap: 4px; }
    .kol-collab-role { text-align: left; }
  }

  @supports (grid-template-columns: subgrid) {
    @media (max-width: 640px) {
      .kol-defs { grid-template-columns: max-content 1fr; }
    }
  }
</style>
