---
/**
 * @file [id].astro
 * @description Polish concert page (/koncerty/[id]) — the canonical, un-prefixed route. All
 *  structure, styles and JSON-LD live in the shared ConcertPage component; this file only decides
 *  which concerts exist in Polish and hands each one down with `lang`.
 *
 *  EVERY page-bearing concert has a Polish page, unconditionally: Polish is the source, so a
 *  concert whose translation has not started still has a page here. The `/en` and `/fr` siblings
 *  filter the same list through `TRANSLATED_ROUTES` instead.
 * @architecture Astro islands 2026
 * @module pages/koncerty/[id]
 */
import { getCollection } from "astro:content";
import ConcertPage from "../../components/pages/ConcertPage.astro";

export async function getStaticPaths() {
  const concerts = await getCollection("concerts", ({ data }) => data.hasPage);
  return concerts.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<ConcertPage lang="pl" entry={entry} />
