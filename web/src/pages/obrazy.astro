---
/**
 * @file obrazy.astro
 * @description The collective image archive (/obrazy) — every documentary photograph the cycle
 *  has, held in one document. It is a SEQUENCE OF EVENINGS, never a mosaic: each evening keeps
 *  its roman numeral, its title and its date, and its own frames are packed by the same
 *  `layoutShots` the concert pages use, so the archive reads as five galleries bound together in
 *  Via order rather than as a thumbnail wall. That distinction is the page's whole design brief —
 *  these are low-contrast chiaroscuro frames from a dark nave, and a grid of small tiles renders
 *  them as black rectangles before it fails them stylistically.
 *
 *  Dark throughout, on `--night`, as the concert galleries are: parchment kills these frames.
 *  Every shot opens the shared lightbox (islands/landing/ImageLightbox), and the photographers
 *  are gathered into one colophon at the foot instead of being repeated under each frame.
 *
 *  All forty-three frames are ONE set in the lightbox (`data-image-group="obrazy"`), because the
 *  page is one sequence and stopping the arrows at each evening's last frame would contradict the
 *  document the reader is holding. Each frame carries its own evening's URL, so the name of the
 *  evening is never lost even though the head that states it has scrolled away.
 *
 *  Not in the main nav and not in TRANSLATED_ROUTES — see docs/web-imagines-spec.md §7 for both
 *  decisions and for the entrances it does get.
 * @architecture Astro islands 2026
 * @module pages/obrazy
 */
import type { ImageMetadata } from "astro";
import { getCollection } from "astro:content";
import { getImage, Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteChrome from "../components/SiteChrome.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { photoOptional } from "../lib/photos";
import { layoutShots } from "../lib/galleryLayout";
import { framedShot } from "../lib/galleryFrame";
import { candleFrom } from "../lib/candle";
import { SITE } from "../i18n/config";
import { VaultIsland } from "../islands/landing/VaultIsland";
import { ImageLightbox } from "../islands/landing/ImageLightbox";
import "../styles/vault.css";
import "../styles/image-lightbox.css";

// Via order — the same order the register and /koncerty walk, so an evening sits in the same
// place on every surface. An entry with no photographs simply has no series here; the roman
// numerals stay the concert's own, so a gap in the numbering would be honest rather than a slip.
const concerts = (await getCollection("concerts")).sort((a, b) => a.data.order - b.data.order);

const series = await Promise.all(
  concerts
    .filter((entry) => entry.data.gallery.length > 0)
    .map(async (entry) => {
      const c = entry.data;
      const gallery: {
        img: ImageMetadata;
        alt: string;
        caption?: string;
        credit?: string;
        ar: number;
      }[] = [];
      for (const g of c.gallery) {
        const img = photoOptional(g.img);
        if (img)
          gallery.push({
            img,
            alt: g.alt ?? "",
            caption: g.caption,
            credit: g.credit,
            ar: Number((img.width / img.height).toFixed(4)),
          });
      }
      // Same packing and the same measure as the concert page: `.im-wrap` is 1180 wide and the
      // gutter clamp tops out at 40, which are `layoutShots`'s own defaults. Passing nothing is
      // therefore the statement that this gallery is hung exactly like that one.
      const shots = await Promise.all(
        layoutShots(gallery).map(async (g) => ({ ...g, frame: await framedShot(g.img) })),
      );
      return {
        id: entry.id,
        roman: c.roman,
        latin: c.latin,
        title: c.title,
        viaDate: c.viaDate,
        hasPage: c.hasPage,
        candle: candleFrom(c.accent),
        shots,
        credits: gallery.map((g) => g.credit),
      };
    }),
);

// One colophon for the whole archive: each hand named once, in the order the evenings run.
// Incomplete attribution is STATED rather than passed over. A list of three photographers with
// no qualification is a claim that the three of them took all of it, and most of this archive's
// frames have no recorded author.
const allCredits = series.flatMap((s) => s.credits);
const photographers = [...new Set(allCredits.filter(Boolean))] as string[];
const hasUncredited = allCredits.some((c) => !c);

const title = "Obrazy — fotografie Koncertów Duchowych · VoctEnsemble";
const description =
  "Archiwum fotografii VoctEnsemble. Dokumentalne zdjęcia z pięciu Koncertów Duchowych, w kolejności, w jakiej się odbyły.";

// The share image is a frame from the archive itself, not a hero from elsewhere: the page is the
// photographs, so anything else would misrepresent it in a preview card.
const ogSource = series[0]?.shots[0]?.img;
const ogImage = ogSource
  ? (await getImage({ src: ogSource, width: 1200, format: "webp" })).src
  : "/logo_gold.png";

// JSON-LD: one ImageGallery for the page. Deliberately WITHOUT a per-frame ImageObject list —
// 43 nodes with `creditText` would quadruple the graph to restate what the visible colophon
// already says, and the GSC pass settled that extra schema is proposed before it is added, not
// assumed. If image search ever becomes a real channel for this site, that is the moment to
// revisit it, with the Search Console numbers in hand.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  name: "Obrazy — fotografie Koncertów Duchowych",
  url: `${SITE}/obrazy`,
  description,
  inLanguage: "pl-PL",
  publisher: {
    "@type": "NGO",
    "@id": `${SITE}/#foundation`,
    name: "VoctFoundation",
  },
};
---

<BaseLayout
  title={title}
  description={description}
  path="/obrazy"
  image={ogImage}
  bodyClass="page-obrazy"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <a class="skip-link" href="#tresc">Przejdź do treści</a>
  <SiteChrome current="/obrazy" tone="dark" />

  <main id="tresc">
    <header class="im-head">
      <div class="im-wrap">
        <span class="im-label micro reveal">
          <span class="lat">Imagines</span>
          <span class="im-dot" aria-hidden="true">·</span>
          <span>Archiwum fotografii</span>
        </span>
        <h1 class="im-title reveal ink-press" data-d="1">Obrazy</h1>
        <p class="im-lede reveal" data-d="2">
          Fotografie z pięciu wieczorów cyklu, w kolejności, w jakiej zostały wykonane.
        </p>
      </div>
    </header>

    {
      series.map((s) => (
        <section class="im-series" aria-label={s.title} style={`--candle: ${s.candle}`}>
          <div class="im-wrap">
            {/* The series head carries the station's own candle, so an evening is recognisable
                here by the same light it burns on its page. Numeral, name, date — the register's
                three facts and nothing added. */}
            <header class="im-series-head">
              <span class="im-series-roman reveal">{s.roman}</span>
              <h2 class="im-series-title reveal ink-press" data-d="1">
                {s.hasPage ? <a href={`/koncerty/${s.id}`}>{s.title}</a> : s.title}
              </h2>
              <span class="im-series-meta micro reveal" data-d="2">
                <span class="lat">{s.latin}</span>
                <span class="im-dot" aria-hidden="true">·</span>
                <span>{s.viaDate}</span>
              </span>
            </header>

            {/* Photographs are LIT, not written: the veil belongs to the image and the caption
                keeps the ink. `data-d` sits on the figure so both children inherit one cadence —
                a row that crosses the trigger together would otherwise light in unison. */}
            <div class="im-line">
              {s.shots.map((g, i) => (
                <figure
                  class="im-shot"
                  data-d={String((i % 3) + 1)}
                  style={`--ar: ${g.ar}; --w: ${g.w}px; --w-max: ${g.wMax}px`}
                >
                  {/* One group for the WHOLE document, not one per evening: the archive is a
                      single sequence in Via order, and the reader who opens the first frame of
                      Wcielenie and keeps pressing → should arrive at Aeternam the way they would
                      by scrolling. The exit under the frame is what keeps the evenings named. */}
                  <button
                    type="button"
                    class="im-shot-media shot-open"
                    data-image-open
                    data-image-group="obrazy"
                    data-image-src={g.frame.src}
                    data-image-srcset={g.frame.srcset}
                    data-image-sizes={g.frame.sizes}
                    data-image-alt={g.alt}
                    data-image-caption={g.caption}
                    data-image-credit={g.credit}
                    data-image-w={String(g.frame.width)}
                    data-image-h={String(g.frame.height)}
                    data-image-href={s.hasPage ? `/koncerty/${s.id}` : undefined}
                    data-image-href-label={s.hasPage ? s.title : undefined}
                  >
                    <Image
                      src={g.img}
                      widths={[560, 840, 1200]}
                      sizes={`(max-width: 640px) 92vw, ${g.wMax}px`}
                      alt={g.alt}
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="reveal-light" aria-hidden="true"></span>
                  </button>
                  {g.caption && <figcaption class="micro reveal">{g.caption}</figcaption>}
                </figure>
              ))}
            </div>
          </div>
        </section>
      ))
    }

    <footer class="im-colophon">
      <div class="im-wrap">
        <span class="im-label micro reveal">
          <span class="lat">Photographi</span>
          <span class="im-dot" aria-hidden="true">·</span>
          <span>Fotografie</span>
        </span>
        {
          photographers.length > 0 && (
            <ul class="im-colophon-list reveal" data-d="1">
              {photographers.map((name) => (
                <li>{name}</li>
              ))}
            </ul>
          )
        }
        {
          hasUncredited && (
            <p class="im-colophon-note reveal" data-d="2">
              Autorzy pozostałych zdjęć nie zostali odnotowani. Jeśli któreś z nich jest Twoje,
              napisz do nas: dopiszemy nazwisko.
            </p>
          )
        }
        <a class="im-colophon-back" href="/koncerty">Wróć do Koncertów Duchowych</a>
      </div>
    </footer>
  </main>

  <SiteFooter />

  <VaultIsland client:idle />
  <ImageLightbox client:idle />
  <script>
    import "../scripts/vault-triggers.ts";
    import "../scripts/image-triggers.ts";
  </script>
</BaseLayout>

<style>
  /* The whole document is night — a parchment band anywhere here would put a lit page between two
     dark ones and break the reading of the archive as one room. */
  .page-obrazy { background: var(--night, #100f0d); color: var(--paper, #f4f1e9); }
  main { display: block; }
  /* The frame's own scroll-lock, named for THIS body class: a blanket `body.image-open` rule
     would reach documents that never mount the island. */
  :global(body.page-obrazy.image-open) { overflow: hidden; }

  .im-wrap { max-width: 1180px; margin: 0 auto; }
  .im-dot { margin: 0 8px; color: rgba(244, 241, 233, .42); }
  .im-label { display: inline-flex; align-items: center; gap: 8px; font-family: var(--capitalis); font-size: 10.5px; letter-spacing: .26em; text-transform: uppercase; color: var(--candle); margin: 0 0 22px; }

  /* ── Head ──────────────────────────────────────────────────────────────────
     No hero photograph. The page is 43 photographs long; opening it with a
     forty-fourth, larger and decorative, would be the one frame here that documents
     nothing. */
  .im-head { padding: clamp(120px, 16vw, 200px) max(28px, 5vw) clamp(56px, 7vw, 88px); }
  .im-title { font-family: var(--serif); font-weight: 300; line-height: .98; font-size: clamp(52px, 10vw, 132px); letter-spacing: -.01em; margin: 0; color: var(--paper); }
  .im-lede { margin: clamp(26px, 3.5vw, 40px) 0 0; max-width: 46ch; font-family: var(--serif); font-weight: 300; font-size: clamp(18px, 1.8vw, 24px); line-height: 1.56; color: rgba(244, 241, 233, .74); }

  /* ── One evening ───────────────────────────────────────────────────────────
     The head is a three-part rule: numeral in the station's candle, name in the serif,
     the Latin and the date in the mono voice. Top-anchored hairline, which is where the
     trigger fires. */
  .im-series { padding: clamp(56px, 8vw, 104px) max(28px, 5vw); }
  .im-series-head { display: grid; grid-template-columns: max-content 1fr; gap: 4px clamp(20px, 3vw, 36px); align-items: baseline; margin: 0 0 clamp(36px, 5vw, 56px); padding-top: clamp(22px, 3vw, 32px); border-top: 1px solid rgba(244, 241, 233, .16); }
  .im-series-roman { grid-row: span 2; font-family: var(--capitalis); font-size: clamp(20px, 2.4vw, 30px); letter-spacing: .1em; color: var(--candle); line-height: 1; }
  .im-series-title { margin: 0; font-family: var(--serif); font-weight: 300; line-height: 1.06; font-size: clamp(28px, 4vw, 52px); letter-spacing: -.01em; color: var(--paper); }
  /* The link is the title, as in the landing's register: the reader already wants to press the
     name of the evening, and a second control beside it would make a toolbar of a series head.
     Gold hairline on approach, the site's own link idiom — never a button. */
  .im-series-title a { color: inherit; border-bottom: 1px solid transparent; padding-bottom: 2px; transition: color .35s var(--ease, ease), border-color .35s var(--ease, ease); }
  .im-series-title a:hover { color: var(--candle); border-bottom-color: color-mix(in srgb, var(--candle) 62%, transparent); }
  .im-series-meta { grid-column: 2; display: inline-flex; align-items: baseline; font-family: var(--capitalis); font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; color: rgba(244, 241, 233, .52); }
  .im-series-meta .lat { color: rgba(244, 241, 233, .72); }

  /* ── The line ──────────────────────────────────────────────────────────────
     Rows hung by HEIGHT, not cut into columns: each shot asks for the width its own aspect needs
     at the row height (`--w`, from lib/galleryLayout), so portraits pack four to a row where
     landscapes take three. Grow and shrink both run ∝ aspect, which is what keeps a line at one
     height; `--w-max` stops a short row inflating its photographs, `center` hangs the remainder.
     THE CONTRACT — `flex: var(--ar) 1 var(--w)` + `max-width: var(--w-max)` — is stated in
     lib/galleryLayout's header and is what the concert page's `.kd-gallery-grid` declares too.
     The two are deliberately not one stylesheet: what genuinely drifts is the packing, and that
     already lives in one module; the rest of each gallery is its page's own tone. */
  .im-line { display: flex; flex-wrap: wrap; justify-content: center; gap: clamp(20px, 3vw, 40px); }
  .im-shot { margin: 0; flex: var(--ar) 1 var(--w); max-width: var(--w-max); }
  /* Bounds the veil to the image: `inset: 0` on the figure would darken the caption too, and a
     caption is copy — it keeps the ink. */
  .im-shot-media { position: relative; display: block; }
  .im-shot :global(img) { width: 100%; height: auto; display: block; border: 1px solid rgba(244, 241, 233, .12); box-shadow: 0 40px 90px -46px rgba(0, 0, 0, .9); }
  .im-shot figcaption { margin-top: 14px; font-family: var(--capitalis); font-size: 10.5px; letter-spacing: .14em; text-transform: uppercase; color: rgba(244, 241, 233, .56); }
  /* On a phone the aspect has no room to argue: one shot per row, full measure. */
  @media (max-width: 640px) {
    .im-shot { flex-basis: 100%; max-width: 100%; }
  }

  /* ── Colophon ──────────────────────────────────────────────────────────────
     Who held the camera, on its own plate at the foot. Names are set in the serif because they
     are people, not metadata. */
  .im-colophon { padding: clamp(72px, 10vw, 128px) max(28px, 5vw) clamp(84px, 12vw, 148px); background: var(--dark, #080807); }
  .im-colophon-list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px clamp(24px, 4vw, 48px); }
  .im-colophon-list li { font-family: var(--serif); font-weight: 300; font-size: clamp(19px, 2vw, 26px); color: rgba(244, 241, 233, .9); }
  .im-colophon-note { margin: clamp(28px, 4vw, 40px) 0 0; max-width: 52ch; font-family: var(--sans); font-weight: 300; font-size: clamp(14px, 1.05vw, 15.5px); line-height: 1.7; color: rgba(244, 241, 233, .56); }
  .im-colophon-back { display: inline-block; margin-top: clamp(36px, 5vw, 56px); font-family: var(--mono); font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; color: rgba(244, 241, 233, .72); border-bottom: 1px solid rgba(244, 241, 233, .28); padding-bottom: 4px; transition: color .35s var(--ease, ease), border-color .35s var(--ease, ease); }
  .im-colophon-back:hover { color: var(--candle); border-bottom-color: var(--candle); }

  @media (max-width: 720px) {
    .im-series-head { grid-template-columns: 1fr; gap: 8px; }
    .im-series-roman { grid-row: auto; }
    .im-series-meta { grid-column: 1; }
  }
</style>
