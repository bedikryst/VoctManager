---
/**
 * @file obrazy.astro
 * @description The collective image archive (/obrazy) — every documentary photograph the cycle
 *  has, held in one document. It is a SEQUENCE OF EVENINGS, never a mosaic, and inside an evening
 *  it is a sequence of RUNS: the rehearsal, then the night, and for the one touring programme one
 *  run per city (lib/galleryRuns). The run is the unit of both the layout and the text.
 *
 *  EVERY RUN IS A PLATE AND A SHEET. The run opens with one photograph large — up to 904px, its
 *  own aspect, with the place and date printed once in the margin beside it — and the rest of the
 *  run hangs under it at the packing the concert pages use, capped at half the plate's height.
 *  That alternation is the whole design brief, and the cap is what makes it a rule rather than an
 *  accident: `layoutShots` sizes a row to fill the measure, so a run with three frames left over
 *  would hang them nearly as large as the plate that opened it and a run with seven would not.
 *
 *  The alternation is load-bearing because this archive has no variety for the packing to answer:
 *  all but a handful of the frames are 3:2, so uniform packing resolves every run to three-up and
 *  arrives at the thumbnail grid docs/web-imagines-spec.md §2 rejects, from the other direction.
 *  These are low-contrast chiaroscuro frames from a dark nave, and a grid of small tiles renders
 *  them as black rectangles before it fails them stylistically. The plate is what gives the eye
 *  something to stand on; the sheet is what keeps the page from being all heroes.
 *
 *  Dark throughout, on `--night`, as the concert galleries are: parchment kills these frames. The
 *  ground therefore never turns, and the thresholds are ruled instead — each evening opens on a
 *  full-bleed hairline in its own candle, drawn left→right by the LEAD register.
 *
 *  Every frame in the document is ONE set in the lightbox (`data-image-group="obrazy"`), because
 *  the page is one sequence and stopping the arrows at each evening's last frame would contradict
 *  the document the reader is holding. Each frame carries its own evening's URL, so the name of
 *  the evening is never lost even though the head that states it has scrolled away.
 *
 *  Each evening is an ANCHOR (`id` = the concert's own id), which is how the concert pages and
 *  the lightbox's exit reach the one they came from instead of the head of a 15 000px document —
 *  and how the head's INDEX steers inside it: five entries in the registrum's grammar (numeral,
 *  name, a leader ruled out to the count of frames, the Latin under it), which is the one thing
 *  on this page a reader can use before they have scrolled.
 *
 *  Not in the main nav and not in TRANSLATED_ROUTES — see docs/web-imagines-spec.md §7 for both
 *  decisions and for the entrances it does get; §17 is the rebuild this file describes and §19
 *  the pass that finished it.
 * @architecture Astro islands 2026
 * @module pages/obrazy
 */
import type { ImageMetadata } from "astro";
import { getCollection } from "astro:content";
import { getImage, Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteChrome from "../components/SiteChrome.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { photoOptional } from "../lib/photos";
import { layoutShots } from "../lib/galleryLayout";
import { galleryRuns } from "../lib/galleryRuns";
import { creditList, creditSentence, frameCredit } from "../lib/photoCredit";
import { framedShot } from "../lib/galleryFrame";
import { candleFrom } from "../lib/candle";
import { SITE } from "../i18n/config";
import { VaultIsland } from "../islands/landing/VaultIsland";
import { ImageLightbox } from "../islands/landing/ImageLightbox";
import "../styles/vault.css";
import "../styles/image-lightbox.css";

/** The plate's measure: `.im-wrap` (1180) less the inscription column and its gutter, so a plate
 *  and its margin together rule to the same edges as the sheet below them. */
const PLATE_W = 904;
/** Ceiling on a plate's height. A 3:2 frame reaches the full measure well under it; a 9:16
 *  portrait is stopped here at ~392px wide, which is what keeps Hymn's plate from becoming a
 *  tower — the same argument `layoutShots` makes with `maxHeight`. */
const PLATE_H = 700;
/** How tall the sheet may stand against the plate that opened its run. This is the rhythm, stated
 *  as one number: without it the sheet's height comes from how many frames the run happens to
 *  have left over, so a two-frame sheet hangs at 570 under a 700px plate (81% — no rhythm at all)
 *  while a seven-frame sheet hangs at 245 under 904 (27%). A ceiling, not a target: a long run
 *  still fills its measure and comes out well under this. */
const SHEET_SCALE = 0.5;

// Via order — the same order the register and /koncerty walk, so an evening sits in the same
// place on every surface. An entry with no photographs simply has no series here; the roman
// numerals stay the concert's own, so a gap in the numbering would be honest rather than a slip.
const concerts = (await getCollection("concerts")).sort((a, b) => a.data.order - b.data.order);

const withGallery = concerts.filter((entry) => entry.data.gallery.length > 0);

const evenings = await Promise.all(
  withGallery.map(async (entry, index) => {
    const c = entry.data;
    // No `caption`: the field survives in the schema for the per-frame note (the concert page
    // prints one where a frame carries it), but on this page everything a caption used to say is
    // in the run's inscription, said once.
    const resolved: {
      img: ImageMetadata;
      alt: string;
      credit?: string | undefined;
      source?: string | undefined;
      moment: "rehearsal" | "concert";
      venue?: string | undefined;
      date?: string | undefined;
      plate: boolean;
      ar: number;
    }[] = [];
    for (const g of c.gallery) {
      const img = photoOptional(g.img);
      if (img)
        resolved.push({
          ...g,
          img,
          alt: g.alt ?? "",
          ar: Number((img.width / img.height).toFixed(4)),
        });
    }

    const runs = await Promise.all(
      // The concert's own venue and date are the fallback, so a single-venue evening states
      // neither per frame. `galleryRuns` refuses a slash-joined venue list for the two touring
      // entries — every frame of those carries its own.
      galleryRuns(resolved, { venue: c.venue, date: c.date }).map(async (run) => {
        // The plate is the run's FIRST frame — the frames are stored in the order they were
        // taken, so a run opens where the evening did — unless one of them claims the slot with
        // `plate: true`. Exactly one gallery does, and it earned it by measurement rather than
        // by taste: see the note above Hymn's entries in concerts.yaml.
        const at = Math.max(
          0,
          run.shots.findIndex((s) => s.plate),
        );
        const lead = run.shots[at]!;
        const rest = run.shots.filter((_, i) => i !== at);
        const plate = { ...lead, frame: await framedShot(lead.img) };
        // Clamped to the SOURCE as well as to the measure, because the archive holds a few small
        // scans: a 900px original handed a 904px slot is served at 1× on a 2× screen and has no
        // larger rendition to reach for, so the one frame the run opens on would be its softest.
        const plateW = Math.round(Math.min(PLATE_W, PLATE_H * plate.ar, plate.img.width));
        // Same packing and the same measure as the concert page — `.im-wrap` is 1180 wide and the
        // gutter clamp tops out at 40, which are `layoutShots`'s own defaults — under a height cap
        // this page sets from the plate standing over it.
        const sheet = await Promise.all(
          layoutShots(rest, { maxHeight: Math.round((plateW / plate.ar) * SHEET_SCALE) }).map(
            async (g) => ({ ...g, frame: await framedShot(g.img) }),
          ),
        );
        return { ...run, plate, plateW, sheet };
      }),
    );

    return {
      id: entry.id,
      roman: c.roman,
      latin: c.latin,
      title: c.title,
      viaDate: c.viaDate,
      hasPage: c.hasPage,
      candle: candleFrom(c.accent),
      // The rail's fill, as on /koncerty: how far down the Via this evening stands.
      viaStep: `${Math.round(((index + 1) / withGallery.length) * 100)}%`,
      count: resolved.length,
      runs,
      shots: resolved,
    };
  }),
);

const allShots = evenings.flatMap((e) => e.shots);

// One colophon for the whole archive: each hand named once, in the order the evenings run, and the
// outlets after them under their own label. The rest is STATED rather than passed over — a list of
// names with no qualification is a claim that those names took every frame here, and most of this
// archive is the ensemble photographing itself.
const photographers = creditList(
  [...new Set(allShots.map((s) => s.credit).filter(Boolean))] as string[],
  [...new Set(allShots.map((s) => s.source).filter(Boolean))] as string[],
  false,
);
// The archive's own frames are the colophon's closing sentence rather than a list item: they are
// the majority here, and a majority reads as a statement, not as one entry among seven.
const hasOwnFrames = allShots.some((s) => !s.credit && !s.source);

// The scale of the thing, counted rather than typed — the fact that makes an archive an archive,
// and the one the page never used to state. Places are the resolved run titles, so a rehearsal
// (whose room was never recorded) is correctly not one of them.
const places = new Set(
  evenings.flatMap((e) => e.runs.filter((r) => r.moment === "concert").map((r) => r.title)),
);
const years = allShots
  .map((s) => s.date)
  .filter((d): d is string => Boolean(d))
  .concat(withGallery.map((e) => e.data.date).filter((d): d is string => Boolean(d)))
  .map((d) => d.slice(0, 4))
  .sort();
const span = years.length > 0 ? `${years[0]}–${years[years.length - 1]}` : "";

/** Polish counts one, a few, and many differently, and these three numbers are computed — so a
 *  photograph added to the YAML must not be able to leave "48 fotografia" on the page. */
const plural = (n: number, one: string, few: string, many: string): string => {
  const t = n % 10;
  const h = n % 100;
  if (n === 1) return one;
  if (t >= 2 && t <= 4 && (h < 12 || h > 14)) return few;
  return many;
};
const scale = [
  `${allShots.length} ${plural(allShots.length, "fotografia", "fotografie", "fotografii")}`,
  `${evenings.length} ${plural(evenings.length, "wieczór", "wieczory", "wieczorów")}`,
  `${places.size} ${plural(places.size, "miejsce", "miejsca", "miejsc")}`,
  span,
].filter(Boolean);

const title = "Obrazy — fotografie Koncertów Duchowych · VoctEnsemble";
const description =
  "Archiwum fotografii VoctEnsemble. Dokumentalne zdjęcia z pięciu Koncertów Duchowych, w kolejności, w jakiej się odbyły.";

// The share image is a frame from the archive itself, not a hero from elsewhere: the page is the
// photographs, so anything else would misrepresent it in a preview card.
const ogSource = evenings[0]?.runs[0]?.plate.img;
const ogImage = ogSource
  ? (await getImage({ src: ogSource, width: 1200, format: "webp" })).src
  : "/logo_gold.png";

// JSON-LD: one ImageGallery for the page. Deliberately WITHOUT a per-frame ImageObject list —
// one node per photograph with `creditText` would quadruple the graph to restate what the visible
// colophon already says, and the GSC pass settled that extra schema is proposed before it is added, not
// assumed. If image search ever becomes a real channel for this site, that is the moment to
// revisit it, with the Search Console numbers in hand.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  name: "Obrazy — fotografie Koncertów Duchowych",
  url: `${SITE}/obrazy`,
  description,
  inLanguage: "pl-PL",
  publisher: {
    "@type": "NGO",
    "@id": `${SITE}/#foundation`,
    name: "VoctFoundation",
  },
};
---

<BaseLayout
  title={title}
  description={description}
  path="/obrazy"
  image={ogImage}
  bodyClass="page-obrazy"
  breadcrumb={[{ name: "Obrazy", path: "/obrazy" }]}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <a class="skip-link" href="#tresc">Przejdź do treści</a>
  {/* The head's index, given back to the reader who has scrolled past it. §20 measured that
      `.im-index` cannot clear the fold at any desktop size — 669→1146 against 900 — so the one
      steering device this page has is legible for about a single scroll gesture of a 15 500px
      document, and the rail that replaces it below the fold is a readout with `pointer-events:
      none`. The tabula is the same five entries in the same order, summoned by a run back up the
      page (styles/tabula.css). Deliberately NOT a second authoring of them: same ids, same
      numerals, same counts, one line each — if `.im-index` ever states a different fact from
      this, the two have been given different sources and that is the bug. */}
  <SiteChrome
    current="/obrazy"
    tone="dark"
    index={evenings.map((e) => ({
      id: e.id,
      roman: e.roman,
      title: e.title,
      // Abbreviated as the printed index and the evening heads abbreviate — the same fact must
      // not meet the reader under two different labels on one page.
      figure: `${e.count} ${e.count === 1 ? "fotografia" : "fot."}`,
      latin: e.latin,
      meta: e.viaDate,
    }))}
  />

  {/* Where the reader stands, in the Via's own terms. This is one of the two longest pages on the
      site — the archive runs to some 17 000px of phone scroll — and it was the only long one with
      no position at all. Same three parts and the same driver contract as /koncerty's via-rail;
      it hides wherever the margin it hangs in does not exist (see the breakpoint's own note). */}
  <aside class="im-rail" aria-hidden="true">
    <span class="im-rail-num">I</span>
    <span class="im-rail-line"><span class="im-rail-fill"></span></span>
    <span class="im-rail-date"></span>
  </aside>

  <main id="tresc">
    <header class="im-head">
      <div class="im-wrap">
        <span class="im-label micro reveal">
          <span class="lat">Imagines</span>
          <span class="im-dot" aria-hidden="true">·</span>
          <span>Archiwum fotografii</span>
        </span>
        <h1 class="im-title reveal ink-press" data-d="1">Obrazy</h1>
        <p class="im-lede reveal" data-d="2">
          To jest wszystko, co zostało z tych wieczorów poza dźwiękiem. Fotografie idą
          w kolejności, w jakiej powstały — od pierwszej próby do ostatniego koncertu.
        </p>
        {/* Counted at build, never typed: the numbers are the archive's only self-description
            and a page that states them wrongly is worse than one that states nothing. */}
        <p class="im-scale reveal reveal-rule">
          {
            scale.map((part, i) => (
              <>
                {i > 0 && <span class="im-dot" aria-hidden="true">·</span>}
                <span>{part}</span>
              </>
            ))
          }
        </p>

        {/* THE INDEX. A 15 000px document that states its scale and then hands the reader
            nothing to steer by; the anchors exist (every evening is one), so this is the head
            that uses them. It is a codex's table of contents, not a filter bar: numeral, name,
            a leader ruled out to the count of frames, and the evening's own Latin under it.
            One <nav> landmark, which is what a table of contents is for — the page's caution
            about landmarks is about the ten runs, not about this.

            A LEADER IS NOT A RULE (guardrails §5): it has no length until the title and the
            figure it runs between are both set, so it follows its entry's ink rather than
            leading it — the same order registrum.css and nave-menu.css author, and the same one
            an audit has already tried to "correct" into an inversion once. Hence a plain span
            drawn by this file's own rules and NOT `.reveal-rule`. */}
        <nav class="im-index" aria-label="Spis wieczorów">
          {
            evenings.map((e, i) => (
              <a class="im-entry reveal" href={`#${e.id}`} style={`--candle: ${e.candle}; --i: ${i}`}>
                <span class="im-entry-roman">{e.roman}</span>
                <span class="im-entry-title">{e.title}</span>
                <span class="im-entry-lead" aria-hidden="true" />
                {/* Abbreviated as the evening heads abbreviate, not spelled out: the two are the
                    same fact and a reader meeting "9 fotografii" here and "9 fot." three screens
                    down would be reading two different labels for one number. */}
                <span class="im-entry-count micro">
                  {e.count} {e.count === 1 ? "fotografia" : "fot."}
                </span>
                {/* The two-tier rubric from base.css does the work: `.lat` sets the Latin in
                    capitalis caps and drops the rest of the line to the mono gloss. The tier is
                    quieted here rather than left at candle — the numeral is already carrying this
                    evening's light, and two dyed words in one index row is a colour field. */}
                <span class="im-entry-meta micro">
                  <span class="lat">{e.latin}</span>
                  <span class="im-dot" aria-hidden="true">·</span>
                  <span>{e.viaDate}</span>
                </span>
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    {
      evenings.map((e) => (
        <section
          class="im-evening"
          id={e.id}
          aria-label={e.title}
          style={`--candle: ${e.candle}`}
          data-via-num={e.roman}
          data-via-date={e.viaDate}
          data-via-step={e.viaStep}
        >
          {/* The threshold. The ground cannot turn here — a parchment band would put a lit page
              between two dark ones and break the reading of the archive as one room — so the
              evening is announced by a full-bleed hairline in its OWN candle, ruled left→right
              as the section arrives. The border is real for a no-JS or reduced-motion reader and
              is handed to the pseudo-rule only under the motion gate, per the LEAD contract. */}
          <div class="im-wrap">
            <header class="im-evening-head">
              <span class="im-evening-roman reveal">{e.roman}</span>
              <h2 class="im-evening-title reveal ink-press" data-d="1">
                {e.hasPage ? <a href={`/koncerty/${e.id}`}>{e.title}</a> : e.title}
              </h2>
              <span class="im-evening-meta micro reveal" data-d="2">
                <span class="lat">{e.latin}</span>
                <span class="im-dot" aria-hidden="true">·</span>
                <span>{e.viaDate}</span>
                <span class="im-dot" aria-hidden="true">·</span>
                <span>{e.count} {e.count === 1 ? "fotografia" : "fot."}</span>
              </span>
            </header>

            {/* A div, deliberately: a labelled <section> is a landmark, ten of them would bury
                the page's real ones, and two evenings both open on a run called "Próba". The
                inscription names the run in the document where a reader of any kind meets it. */}
            {e.runs.map((run) => (
              <div class="im-run">
                {/* THE PLATE. One photograph at the run's own scale, and beside it the only place
                    this run's place and date are printed. `--plate-w` is computed rather than
                    left to `object-fit`, so a portrait plate ends where the photograph ends and
                    the inscription stays against it instead of drifting into empty measure. */}
                <div class="im-plate" style={`--plate-w: ${run.plateW}px`}>
                  <figure class="im-shot im-shot--plate">
                    <button
                      type="button"
                      class="im-shot-media shot-open"
                      data-image-open
                      data-image-group="obrazy"
                      data-image-src={run.plate.frame.src}
                      data-image-srcset={run.plate.frame.srcset}
                      data-image-sizes={run.plate.frame.sizes}
                      data-image-alt={run.plate.alt}
                      data-image-caption={[run.title, run.date].filter(Boolean).join(" · ")}
                      data-image-credit={frameCredit(run.plate)}
                      data-image-w={String(run.plate.frame.width)}
                      data-image-h={String(run.plate.frame.height)}
                      data-image-href={e.hasPage ? `/koncerty/${e.id}` : undefined}
                      data-image-href-label={e.hasPage ? e.title : undefined}
                    >
                      {/* The top candidate is 1920 rather than a step fitted to the plate,
                          because 1920 is the exact transform `framedShot` already asks for — so
                          the plate's 2× rendition and the lightbox's largest are ONE emitted
                          file. Same dedupe argument galleryFrame.ts makes about its 1200.
                          `width` names that same transform a third time, which is what keeps the
                          fallback inside the dedupe instead of at source resolution — a 6000px
                          archive frame. It reads `frame.width` rather than a literal 1920 because
                          the archive holds squares and small scans too: sharp would clamp a 1920
                          request down to the source, but the TRANSFORM would still be recorded as
                          1920 and emit a twin of the 1485 the ladder already carries. Asking for
                          the number `framedShot` settled on is asking for the same file. */}
                      <Image
                        src={run.plate.img}
                        widths={[560, 904, 1920]}
                        width={run.plate.frame.width}
                        sizes={`(max-width: 720px) 100vw, (max-width: 860px) 92vw, ${run.plateW}px`}
                        alt={run.plate.alt}
                        loading="lazy"
                        decoding="async"
                      />
                      <span class="reveal-light" aria-hidden="true" />
                    </button>
                  </figure>

                  {/* Read once for the whole run. The place is set in the serif because it is a
                      place — the same argument the colophon makes for setting names in it — and
                      everything that is metadata about the place keeps the mono voice under it. */}
                  <div class="im-inscription reveal-rule">
                    <span class="im-inscription-place reveal">{run.title}</span>
                    {run.date && (
                      <span class="im-inscription-date micro reveal" data-d="1">
                        {run.date}
                      </span>
                    )}
                    {/* Only a run naming SOMEBODY prints a credit here. Where the whole run is the
                        ensemble's own the colophon says so once for the archive, and ten run heads
                        repeating "fot. archiwum zespołu" down a page this long would be the
                        template showing through (lib/galleryRuns). A mixed run is the case that
                        must speak: the name alone would take the frames beside it with it. */}
                    {(run.credits.length > 0 || run.sources.length > 0) && (
                      <span class="im-inscription-credit micro reveal" data-d="2">
                        {creditSentence(run.credits, run.sources, run.anyUncredited, "fot.")}
                      </span>
                    )}
                  </div>
                </div>

                {/* THE SHEET. What the plate opened, at the packing both galleries share.
                    Photographs are LIT, not written: the veil belongs to the image. `data-d` sits
                    on the figure so the veil inherits the row's cadence — a row that crosses the
                    trigger together would otherwise light in unison. No captions: everything they
                    used to carry is in the inscription above, said once. */}
                {run.sheet.length > 0 && (
                  <div class="im-sheet">
                    {run.sheet.map((g, i) => (
                      <figure
                        class="im-shot"
                        data-d={String((i % 3) + 1)}
                        style={`--share: ${g.share}`}
                      >
                        {/* One group for the WHOLE document, not one per run or per evening: the
                            archive is a single sequence in Via order, and the reader who opens
                            the first frame of Wcielenie and keeps pressing → should arrive at
                            Aeternam the way they would by scrolling. The exit under the frame is
                            what keeps the evenings named. */}
                        <button
                          type="button"
                          class="im-shot-media shot-open"
                          data-image-open
                          data-image-group="obrazy"
                          data-image-src={g.frame.src}
                          data-image-srcset={g.frame.srcset}
                          data-image-sizes={g.frame.sizes}
                          data-image-alt={g.alt}
                          data-image-caption={[run.title, run.date].filter(Boolean).join(" · ")}
                          data-image-credit={frameCredit(g)}
                          data-image-w={String(g.frame.width)}
                          data-image-h={String(g.frame.height)}
                          data-image-href={e.hasPage ? `/koncerty/${e.id}` : undefined}
                          data-image-href-label={e.hasPage ? e.title : undefined}
                        >
                          {/* `width` = top of the ladder, which is also `framedShot`'s 1200
                              candidate; it keeps the fallback inside that dedupe rather than at
                              source resolution. Clamped to the source for the same reason the
                              plate above clamps: a 1200 request against a narrower scan is
                              recorded as 1200 and emits a twin of what the ladder already has. */}
                          <Image
                            src={g.img}
                            widths={[560, 840, 1200]}
                            width={Math.min(g.img.width, 1200)}
                            sizes={`(max-width: 720px) 92vw, ${g.w}px`}
                            alt={g.alt}
                            loading="lazy"
                            decoding="async"
                          />
                          <span class="reveal-light" aria-hidden="true" />
                        </button>
                      </figure>
                    ))}
                  </div>
                )}
              </div>
            ))}
          </div>
        </section>
      ))
    }

    <footer class="im-colophon">
      <div class="im-wrap">
        {/* `Photographi` names what the list mostly is; the one outlet in it carries its own
            label in the row, which is what keeps the rubric from crediting a masthead. */}
        <span class="im-label micro reveal">
          <span class="lat">Photographi</span>
          <span class="im-dot" aria-hidden="true">·</span>
          <span>Fotografie</span>
        </span>
        {
          photographers.length > 0 && (
            <ul class="im-colophon-list reveal" data-d="1">
              {photographers.map((name) => (
                <li>{name}</li>
              ))}
            </ul>
          )
        }
        {
          hasOwnFrames && (
            <p class="im-colophon-note reveal" data-d="2">
              Pozostałe fotografie pochodzą z archiwum zespołu.
            </p>
          )
        }
        <a class="im-colophon-back" href="/koncerty">Wróć do Koncertów Duchowych</a>
      </div>
    </footer>
  </main>

  <SiteFooter />

  <VaultIsland client:idle />
  <ImageLightbox client:idle />
  <script>
    import "../scripts/vault-triggers.ts";
    import "../scripts/image-triggers.ts";
  </script>

  <script>
    // The rail, on the same contract as /koncerty's: the section publishes its numeral, its short
    // date and its fill as data attributes, and the rail only reads them. Re-armed on every
    // ClientRouter navigation, and the observer is disconnected first so a return to this page
    // never leaves two watching the same sections.
    let railIO: IntersectionObserver | undefined;

    const setupObrazy = () => {
      railIO?.disconnect();
      const rail = document.querySelector<HTMLElement>(".im-rail");
      if (!rail) return; // not this page

      const num = rail.querySelector<HTMLElement>(".im-rail-num");
      const date = rail.querySelector<HTMLElement>(".im-rail-date");
      const fill = rail.querySelector<HTMLElement>(".im-rail-fill");
      const active = new Set<Element>();

      railIO = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              active.add(entry.target);
              const el = entry.target as HTMLElement;
              if (num) num.textContent = el.dataset.viaNum ?? "";
              if (date) date.textContent = el.dataset.viaDate ?? "";
              if (fill) fill.style.height = el.dataset.viaStep ?? "0%";
            } else {
              active.delete(entry.target);
            }
          }
          rail.classList.toggle("is-active", active.size > 0);
        },
        { threshold: 0.02 },
      );
      document.querySelectorAll(".im-evening").forEach((s) => railIO!.observe(s));
    };

    document.addEventListener("astro:page-load", setupObrazy);
  </script>
