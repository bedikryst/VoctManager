---
/**
 * @file BaseLayout.astro
 * @description Document shell for every public page. Owns <head> (per-page SEO/OG/canonical),
 *  global styles, native cross-document transitions (<ClientRouter />), and the Lenis
 *  smooth-scroll lifecycle (fine-pointer + motion-allowed only, re-anchored on navigation).
 * @architecture Astro islands 2026
 * @module layouts/BaseLayout
 */
import { ClientRouter } from "astro:transitions";
import DocumentGates from "../components/DocumentGates.astro";
import { LOCALE_META, LOCALES, SITE, type Locale } from "../i18n/config";
import { breadcrumbList, type Crumb } from "../lib/breadcrumb";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/registers.css";
import "../styles/cursor.css";
import "../styles/transitions.css";
import "../styles/nave-menu.css";
import "../styles/registrum.css";
import { ScrollTopButton } from "../islands/landing/ScrollTopButton";
import { SiteCursor } from "../islands/landing/SiteCursor";

interface Props {
  title: string;
  description: string;
  /** Absolute path of this page, e.g. "/kontakt" — drives canonical + og:url. */
  path: string;
  /** OG/Twitter share image (absolute path under the build root). Required — the old
      default pointed at /photos/…, a directory that does not exist in public/, so any
      page relying on it shipped a 404 og:image. Every page now passes a real image. */
  image: string;
  /** Alt text for the share image (og:image:alt / twitter:image:alt). Defaults to the page
      title — every image here is the page's own hero, so the title describes it adequately. */
  imageAlt?: string;
  /** Optional class on <body> for page-level theming hooks. */
  bodyClass?: string;
  /**
   * Keep this equal to the page's `--edge-band` (tokens.css). It is the fallback iOS Safari
   * drops to for the bands above and below a fixed header once something invalidates the
   * background-color it sampled at load — opening the nave does. Two different values means
   * the band changes colour behind the reader's back.
   */
  themeColor?: string;
  /**
   * THIS LAYOUT drives the page's reveal controller (adds `reveal-ready`; the controller in
   * scripts/reveal.ts then toggles `.is-in`), with the `authored` cadence — per-element `data-d`
   * delays and no onset queue.
   *
   * The landing opts OUT (`false`) and calls the SAME controller itself from scripts/landing.ts,
   * because its cadence is the shared onset queue: its siblings are generated in bulk and would
   * otherwise enter in unison. Opting out is therefore a promise to run the controller yourself
   * — the register's hidden state is keyed on `html.voct-motion`, so a page that opts out and
   * then runs nothing sits at half-ink with nothing left to raise it.
   *
   * Parallax stays active regardless (same `data-parallax` contract). Surfaces as
   * `<html data-reveal>` so DocumentGates can arm the gate on the INCOMING document during a
   * navigation, before it is ever painted.
   */
  reveal?: boolean;
  /**
   * This page carries the once-per-session preloader rite (the landing, and only the landing).
   * Surfaces as `<html data-rite>`, which is what tells DocumentGates whether to decide the
   * `preloader-skip` gate for this document at all.
   */
  rite?: boolean;
  /** Page locale — drives `<html lang>` and og:locale. Defaults to Polish (the un-prefixed site). */
  lang?: Locale;
  /** hreflang alternates for a translated page (absolute URLs incl. x-default). Empty on
      Polish-only pages, where no alternate graph is emitted. See i18n/config.hreflangAlternates. */
  alternates?: { hreflang: string; href: string }[];
  /**
   * This page's position in the site hierarchy, as a `BreadcrumbList` for the search result —
   * there is no visible breadcrumb bar and none is planned (see lib/breadcrumb). Pass the FULL
   * trail BELOW home, ending with this page itself; the home node is prepended here so no page
   * repeats it. Omit on a page that is its own top level (the landing) or that ships noindex
   * (/press, /404), where the trail would never be read.
   *
   * The last entry's `path` must be this page's own `path` — the build fails loudly if it is
   * not, because the two would otherwise disagree in silence and hand Google a trail whose leaf
   * points at a different URL than the canonical it sits beside.
   */
  breadcrumb?: Crumb[];
}

const {
  title,
  description,
  path,
  image,
  imageAlt = title,
  bodyClass = "",
  themeColor = "#000000",
  reveal = true,
  rite = false,
  lang = "pl",
  alternates = [],
  breadcrumb,
} = Astro.props;

const canonical = new URL(path, SITE).href;
const ogImage = new URL(image, SITE).href;
const ogLocale = LOCALE_META[lang].ogLocale;
// og:locale:alternate advertises the OTHER locales this same page exists in — only meaningful
// when the page is actually translated (it carries an hreflang graph).
const ogLocaleAlternates =
  alternates.length > 0
    ? LOCALES.filter((l) => l !== lang).map((l) => LOCALE_META[l].ogLocale)
    : [];

const breadcrumbTail = breadcrumb?.at(-1);
if (breadcrumbTail && breadcrumbTail.path !== path) {
  throw new Error(
    `BaseLayout: breadcrumb ends at "${breadcrumbTail.path}" but this page is "${path}". ` +
      "The trail's last entry is the page itself — pass the same path.",
  );
}
const breadcrumbLd = breadcrumb ? breadcrumbList(breadcrumb, lang) : undefined;
---

<!doctype html>
<html
  lang={LOCALE_META[lang].htmlLang}
  data-reveal={reveal ? "on" : undefined}
  data-rite={rite ? "on" : undefined}
>
  <head>
    <meta charset="utf-8" />
    {/* Keep `viewport-fit=cover` — every safe-area calc in this codebase (.chrome, .nave-inner,
        .skip-link, .scroll-top) is written against it. Be aware, though, that on iOS 26 it does
        NOT buy what it used to: measured on device with cover present, `env(safe-area-inset-top)`
        still resolves to 0 while the layout viewport sits ~45px below the physical top. Safari
        applies an obscured-content inset of its own and the safe-area calcs quietly add nothing.
        The band that opens above the bar as a result is handled via the canvas — see
        `--edge-band` in tokens.css. */}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/png" href="/logo_icon.png" />
    <link rel="apple-touch-icon" href="/logo_icon.png" />
    <meta name="theme-color" content={themeColor} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* hreflang graph — emitted only on translated pages (i18n/config.hreflangAlternates returns
        [] for Polish-only pages). x-default points at the Polish original. */}
    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
      ))
    }

    <!-- Self-hosted critical fonts — preloaded, GDPR-safe. The latin-ext subsets are
         preloaded FIRST: this is a Polish-language site, so the diacritics (ą ć ę ł ń ó ś ż)
         that live in latin-ext appear in every headline — without these preloads the hero's
         "ł" in "głos" arrived by late discovery and repainted after first render. -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/CormorantGaramond-Variable.latin-ext.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/CormorantGaramond-Variable.latin.woff2"
      crossorigin
    />
    <!-- Cinzel carries the rubric layer, which is above the fold on every page (the eyebrow
         sits over the first headline) and costs ~40 KB for both subsets — cheap enough to
         put in the critical path. The Cyrillic subsets are deliberately absent here: their
         `unicode-range` already limits them to the few concert pages with sung Cyrillic text,
         and preloading is per-document, so listing them would pull 41 KB onto every page. -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/Cinzel-Variable.latin-ext.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/Cinzel-Variable.latin.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/IBMPlexSans-Variable.latin-ext.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/IBMPlexSans-Variable.latin.woff2"
      crossorigin
    />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="VoctEnsemble" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content={ogLocale} />
    {ogLocaleAlternates.map((loc) => <meta property="og:locale:alternate" content={loc} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- Plausible Analytics — cookieless, EU-hosted (see /polityka-prywatnosci). The
         `tagged-events` variant reports the `plausible-event-name=…` classes already wired
         on CTAs/gate/vault. Auto-tracks pushState, so ClientRouter swaps count as pageviews.
         Production only: in dev the data would be localhost noise. -->
    {
      import.meta.env.PROD && (
        <script
          is:inline
          defer
          data-domain="voctensemble.com"
          src="https://plausible.io/js/script.tagged-events.js"
        />
      )
    }

    <!-- Native cross-page transitions (View Transition API). -->
    <ClientRouter />

    {/* Hidden-state gates on <html>, applied before first paint here and to the incoming
        document at astro:before-swap. Rendered on every page, not only the ones that use a gate:
        during a navigation it is the OUTGOING document that has to arm the arriving one, so the
        decision must be present everywhere. Nothing has to strip a gate on the way out — the
        swap clears every attribute on <html> and copies the incoming document's, so a page that
        does not ask for a gate simply arrives without it (this is how the landing arrives
        without `reveal-ready`, so this layout leaves its reveals alone). See DocumentGates. */}
    <DocumentGates />

    {/* Where this page sits in the site, for the search result only — nothing renders. Emitted
        as its own JSON-LD block rather than folded into the page's graph: every page below the
        landing owns a different node type (MusicEvent, AboutPage, ImageGallery…), and Google
        reads multiple ld+json blocks per document. See lib/breadcrumb. */}
    {
      breadcrumbLd && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
      )
    }

    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
    <SiteCursor client:load transition:persist="site-cursor" />
    <ScrollTopButton client:idle transition:persist="scroll-top" lang={lang} />

    <script>
      // The canvas colour drives the bands iOS Safari opens above and below a fixed header —
      // see `--edge-band` / `--edge-foot` in tokens.css. Nothing else reaches them: fixed,
      // sticky, sticky with a negative top, theme-color and the body colour slot were each
      // measured on device and each failed.
      //
      // It is TIED TO THE FOOTER'S VISIBILITY rather than applied once at load. Timing was the
      // trap: the top band samples the canvas around first paint, and a deferred script still
      // beats that sample, so simply setting the footer colour early tinted the top band too.
      // Keying on the footer sidesteps the race entirely — at load and over the hero the canvas
      // is the CSS black, and by the time it turns, the footer is what fills the screen anyway,
      // so both bands agreeing with it is correct rather than merely harmless.
      //
      // Both the canvas and the body colour slot are written: which of the two iOS reads is not
      // settled, and body's slot carries no visible surface (that is an opaque background-image
      // on every page), so writing it costs nothing.
      let edgeWatch: IntersectionObserver | undefined;
      const armEdgeBands = (): void => {
        edgeWatch?.disconnect();
        // `.site-footer` is the landing's, `.site-foot` every other page's.
        const footer = document.querySelector(".site-footer, .site-foot");
        if (!footer) return;
        // READ AT PAINT TIME, not at arm time. A page's footer colour is not necessarily a
        // constant for the life of the page: the landing's ends on the ground of the canonical
        // hour it is read in (`--nox`, styles/landing/06-footer.css), so a value cached here
        // would leave a parchment strip under a night plate. Reading two custom properties when
        // the footer crosses the viewport edge costs nothing at that rate.
        const paint = (v: string): void => {
          if (!v) return;
          document.documentElement.style.setProperty("background-color", v);
          document.body.style.setProperty("background-color", v);
        };
        edgeWatch = new IntersectionObserver((entries) => {
          const cs = getComputedStyle(document.body);
          const band = cs.getPropertyValue("--edge-band").trim();
          const foot = cs.getPropertyValue("--edge-foot").trim();
          entries.forEach((e) => paint(e.isIntersecting ? foot : band));
        });
        edgeWatch.observe(footer);
      };
      armEdgeBands();
      // ClientRouter swaps <body>, taking the inline style, the observer's target and the page's
      // own --edge-foot with it.
      document.addEventListener("astro:page-load", armEdgeBands);
    </script>

    <script>
      // Lenis smooth scroll — only on fine pointers with motion allowed.
      // Resilient to ClientRouter navigations: one RAF loop, instance recreated
      // and scroll re-anchored on swap.
      import Lenis from "lenis";
      import { setupReveal } from "../scripts/reveal";

      const fine = window.matchMedia("(pointer: fine) and (hover: hover)").matches;
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (fine && !reduce) {
        // Cinematic feel without lag:
        //   • lerp 0.085 (≈10% slower than default 0.1) — the sacred tone reads as "deliberate",
        //     but stays well above the 0.05 threshold where users start perceiving lag.
        //   • duration 1.6s for programmatic scrollTo (vs default 1.2) — when an anchor jumps,
        //     it should travel like a slow camera dolly, not a cut.
        //   • easing: expo-out — same family the section-glow + manifest transitions already use,
        //     so wheel-driven scroll, anchor jumps, and reveal kinematics share one ease.
        //   • wheelMultiplier 0.9 — slightly tames over-eager trackpads on macOS without numbing
        //     ordinary mouse wheels.
        // NB: this whole block is gated behind `(pointer: fine) and (hover: hover)`, so Lenis
        // never runs on touch — mobile keeps fully native momentum scroll. No touch-tuning here
        // on purpose; any `touch*` option would be dead config.
        let lenis = new Lenis({
          lerp: 0.085,
          duration: 1.6,
          easing: (t: number) => (t === 1 ? 1 : 1 - Math.pow(2, -10 * t)),
          wheelMultiplier: 0.9,
          smoothWheel: true,
        });
        // Expose the shared instance so page scripts (e.g. landing anchor smooth-scroll)
        // route through it instead of spawning a second, fighting RAF loop.
        (window as unknown as { __lenis?: Lenis }).__lenis = lenis;
        const raf = (time: number) => {
          lenis.raf(time);
          requestAnimationFrame(raf);
        };
        requestAnimationFrame(raf);

        // Astro (history.scrollRestoration = "manual") has ALREADY applied the correct scroll
        // target by the time astro:after-swap fires — 0 for forward navigations, the saved
        // position for back/forward history traversal. Sync Lenis's virtual position to whatever
        // the document scroll now is, rather than forcing the top: forcing 0 discarded the
        // restored position and made "back" jump to the top (the reported "przeskakiwanie").
        document.addEventListener("astro:after-swap", () => {
          lenis.scrollTo(window.scrollY, { immediate: true, force: true });
        });
      }

      // Hide the native cursor for the duration of a view-transition swap. The pseudo-
      // element snapshot layer that View Transitions renders does NOT inherit the
      // page's `cursor: none` from `.has-custom-cursor`, so without this the system
      // pointer flashes back during the crossfade. Setting `cursor: none` inline on the
      // html element applies to the transition overlay too (it's part of the same
      // document root). Skip on touch / reduced-motion (custom cursor isn't enabled there).
      const cursorFine = window.matchMedia("(pointer: fine) and (hover: hover)").matches;
      const cursorReduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (cursorFine && !cursorReduce) {
        document.addEventListener("astro:before-preparation", () => {
          if (document.body.classList.contains("has-custom-cursor")) {
            document.documentElement.style.cursor = "none";
          }
        });
        document.addEventListener("astro:after-swap", () => {
          document.documentElement.style.cursor = "";
        });
      }

      // How this navigation reads. Astro writes `direction` to `<html data-astro-transition>`,
      // keeps it across the swap and clears it when the transition finishes — so it is the one
      // marker a transition-long ::view-transition rule can safely key on. A tap inside the open
      // mobile menu leaves with a card that has to be lifted off the page, not a leaf that turns
      // (transitions.css). The menu is still open at this point: it is closed at before-swap, on
      // purpose, so the outgoing snapshot captures the card.
      document.addEventListener("astro:before-preparation", (event) => {
        if (document.querySelector(".chrome.menu-open")) event.direction = "menu";
      });

      // Hold the swap a moment for the incoming hero photo. The new page is drawn fully opaque
      // underneath the dissolving old one, so whatever its hero has painted by the time the
      // transition starts is what the visitor looks at for the whole 420ms — an unpainted photo
      // means the media's ground for the length of the dissolve and then a pop. `prefetchAll`
      // usually has the HTML cached already, so this waits on the image alone, and it is capped:
      // past the cap the navigation goes ahead and the photo lands when it lands.
      const HERO_WARM_MS = 300;
      document.addEventListener("astro:before-preparation", (event) => {
        const load = event.loader;
        event.loader = async () => {
          await load();
          if (event.defaultPrevented) return; // not an HTML page — the browser takes it from here
          await warmHero(event.newDocument, event.signal);
        };
      });

      const warmHero = async (doc: Document, signal: AbortSignal): Promise<void> => {
        // `newDocument` still points at the live document until the loader parses a response.
        if (doc === document || signal.aborted) return;
        const hero = doc.querySelector("picture.bleed");
        if (!hero) return;
        // Let the LIVE document pick the file. `<source media>` is art direction and
        // `<source type>` is format negotiation; both resolve against a real viewport, which the
        // parsed document does not have. A hidden clone here therefore fetches exactly the
        // candidate the new page will ask for, and warms the HTTP cache for it.
        const probe = document.importNode(hero, true) as HTMLElement;
        const img = probe.querySelector("img");
        if (!img) return;
        probe.setAttribute("aria-hidden", "true");
        probe.style.cssText =
          "position:fixed;left:-9999px;top:0;width:1px;height:1px;opacity:0;pointer-events:none";
        img.classList.remove("is-animated"); // no Ken Burns on a 1px probe
        img.loading = "eager";
        img.fetchPriority = "high";
        document.body.append(probe);
        signal.addEventListener("abort", () => probe.remove(), { once: true });
        const settled = new Promise<void>((resolve) => {
          img.addEventListener("load", () => resolve(), { once: true });
          img.addEventListener("error", () => resolve(), { once: true });
        });
        await Promise.race([settled, new Promise((r) => window.setTimeout(r, HERO_WARM_MS))]);
        // Won the race → the fetch is done, drop the probe. Timed out → leave it: removing an
        // in-flight <img> can cancel its request, and the incoming page is about to ask for that
        // exact file. Either way the body swap discards it a moment later.
        if (img.complete) probe.remove();
      };

      // Navigation composure — the incoming page must arrive ALREADY composed, so the page
      // transition (transitions.css) reveals a finished hero instead of one that then
      // re-animates. This runs inside the swap, before the browser snapshots the new page:
      // the reveal gate is already on the root (DocumentGates armed it on this document at
      // before-swap, so its hidden state was in force the moment the body was inserted) and
      // `vt-nav` (base.css) strips the reveal transition, so settling SNAPS instead of playing.
      // Below-the-fold reveals stay hidden and still animate on scroll. The landing opts out of
      // the global reveal system and owns its own entrance, so there is nothing to do there.
      document.addEventListener("astro:after-swap", () => {
        const root = document.documentElement;
        if (!root.classList.contains("reveal-ready")) return;
        // Measure before touching any class, so one settle cannot shift the next measurement.
        // The hidden state is opacity-only (the ink register — base.css), so these rects are
        // the elements' true positions; the fold test needs no allowance for a translate.
        // An empty box means the node isn't rendered at all (a reveal inside a closed <details>,
        // e.g. the /koncerty programme rows) — those report top 0 and must NOT be counted as
        // above the fold, or they would be settled here and lose their cascade on open.
        const vh = window.innerHeight;
        const pending = [...document.querySelectorAll<HTMLElement>(".reveal:not(.is-in)")].filter(
          (el) => {
            const rect = el.getBoundingClientRect();
            return (rect.width > 0 || rect.height > 0) && rect.top < vh;
          },
        );
        root.classList.add("vt-nav");
        for (const el of pending) el.classList.add("is-in");
      });

      // One-shot reveal — animates once on enter, then persists. Re-scans after each
      // ClientRouter navigation (fresh DOM). Above-the-fold nodes intersect immediately.
      // The controller itself is shared with the landing (scripts/reveal.ts); what this page
      // supplies is the cadence, and `authored` is the right one here: a subpage staggers its
      // own nodes with `data-d`, which is a CSS delay, so an onset queue on top would delay
      // them twice. `reveal-ready` means THIS layout drives the page — the landing withholds it
      // and calls the same controller itself with the queue.
      let dropReveals: (() => void) | undefined;
      const setupReveals = () => {
        dropReveals?.();
        dropReveals = undefined;
        if (!document.documentElement.classList.contains("reveal-ready")) return;
        dropReveals = setupReveal(document, {
          reduce: window.matchMedia("(prefers-reduced-motion: reduce)").matches,
          cadence: "authored",
        });
      };
      document.addEventListener("astro:page-load", () => {
        setupReveals();
        // Composure window over: re-enable reveal transitions so the below-the-fold reveals
        // animate on scroll again. The next navigation re-arms vt-nav from scratch.
        document.documentElement.classList.remove("vt-nav");
      });

      // Parallax — JS-driven (cross-browser; scroll-timeline CSS is still partial in FF/Safari).
      // One rAF-throttled scroll loop; layers refreshed per navigation. The image is taller than
      // its frame and centred, so the clamped drift never exposes an edge — provided the layer
      // actually rests at that centre, which is what `base` below is for.
      //
      // `data-parallax` is a SPEED against scroll distance, and the room is a fraction of the
      // FRAME, so the two only agree while the frame is roughly the height of the viewport. A
      // frame travels `vh + frameH` from entering to leaving, so anything above
      // `2·cap / (vh + frameH)` pins the layer against the clamp for the rest of the pass and the
      // drift visibly stops — the shorter the band, the longer it is stopped, and at the site's
      // default 0.16 anything under a full viewport is stopped for most of it. Short bands
      // therefore state their own speed (BleedImage's `parallax` prop). The default is left alone
      // because retuning it would re-time every hero on the site to fix bands that can say so.
      let layers: HTMLElement[] = [];
      let pTicking = false;
      const applyParallax = () => {
        pTicking = false;
        const vh = window.innerHeight;
        for (const el of layers) {
          const frame = el.parentElement;
          if (!frame) continue;
          const r = frame.getBoundingClientRect();
          if (r.bottom < -200 || r.top > vh + 200) {
            // Off-screen: drop the transform so the layer un-promotes and frees its GPU
            // texture. Decisive on /koncerty, where six full-bleed blurred backdrops would
            // otherwise stay composited at once; re-set the next frame it re-enters the margin.
            if (el.style.transform) el.style.transform = "";
            continue;
          }
          const speed = parseFloat(el.dataset.parallax || "0.16") || 0.16;
          const scale = parseFloat(el.dataset.parallaxScale || "1") || 1;
          // Room to drift without exposing an edge: either the image is taller than its
          // frame, or an inset:0 layer is scaled up (e.g. blurred station backdrops).
          // ×0.98 for the same reason the scale branch takes ×0.85: `offsetHeight`/`offsetTop`
          // are integers over percentage lengths that are not, so a drift taken to the exact
          // arithmetic limit can land the edge a fraction of a pixel inside the frame and rule a
          // hairline along it. Two percent of the drift buys that away.
          const cap =
            scale > 1
              ? ((frame.offsetHeight * (scale - 1)) / 2) * 0.85
              : (Math.max(0, el.offsetHeight - frame.offsetHeight) / 2) * 0.98;
          // Where the layer must rest for its room to be symmetric — MEASURED, not assumed.
          // A tall layer is not necessarily flush with the top of its frame: the sheets centre
          // theirs (`.bleed` is `top: -10%` under a 120% height, `.station-bg` is `inset: -30%`),
          // and subtracting `cap` from an already-centred layer spends the whole upward half of
          // the room before the first pixel of scroll. Every negative drift then lifts its bottom
          // edge clear of the frame — invisible on a section as tall as the viewport, because the
          // exposed strip is still below the fold while the drift is negative, and plainly visible
          // on a short band, which is where it was finally seen (the /o-nas plate, entering from
          // the bottom with a strip of ground under the photograph). `offsetTop` reads 0 for a
          // flush layer and -cap for a centred one, so both land correctly.
          const base = scale > 1 ? 0 : -Math.max(0, cap + el.offsetTop);
          let drift = (r.top + r.height / 2 - vh / 2) * -speed;
          if (drift > cap) drift = cap;
          else if (drift < -cap) drift = -cap;
          const scalePart = scale !== 1 ? ` scale(${scale})` : "";
          el.style.transform = `translate3d(0, ${(base + drift).toFixed(1)}px, 0)${scalePart}`;
        }
      };
      const onParallax = () => {
        if (!pTicking) {
          pTicking = true;
          requestAnimationFrame(applyParallax);
        }
      };
      if (!reduce) {
        window.addEventListener("scroll", onParallax, { passive: true });
        window.addEventListener("resize", onParallax, { passive: true });
      }
      // Collect this page's layers and PLACE them. Placement cannot wait for astro:page-load:
      // until the first run a layer carries no transform and sits at its CSS rest (`top: -10%`),
      // while its settled position is another `cap` px above that — so the first run always
      // moves the photo. On a navigation astro:page-load lands after the new page has been
      // snapshotted, which is why the hero was seen jumping mid-transition; on a cold load it is
      // the window load event, i.e. after the images finish. Running it inside astro:after-swap
      // (before the snapshot) and once at module time makes the placement part of the page's
      // first painted state instead of a correction to it.
      const refreshParallax = () => {
        if (reduce) return;
        layers = [...document.querySelectorAll<HTMLElement>("[data-parallax]")];
        applyParallax();
      };
      refreshParallax();
      document.addEventListener("astro:after-swap", refreshParallax);
      document.addEventListener("astro:page-load", refreshParallax);
    </script>
  </body>
</html>
