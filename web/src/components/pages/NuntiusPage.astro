---
/**
 * @file NuntiusPage.astro
 * @description Locale-agnostic body of `/nuntius` — the page a mail's link lands on. It confirms
 *  a sign-up for the concert notice list, or ends one, and says which happened. The three route
 *  files (/nuntius, /en/nuntius, /fr/nuntius) are one-liners that differ only in `lang`.
 *
 *  A LATIN ROUTE NAME, so one URL serves three languages: the backend builds these links
 *  (`outreach/services.NOTICE_PATH`) and a locale-translated slug would have made that table a
 *  place for the two halves to drift apart.
 *
 *  THE WORK IS DONE BY THE ISLAND, NOT BY THIS DOCUMENT, and that is the point rather than an
 *  implementation detail. A confirmation that fired on the GET would be spent by every link
 *  scanner between us and the reader — Outlook Safe Links, antivirus proxies, a preview card —
 *  forging the one fact double opt-in exists to prove. A scanner fetches HTML; it does not
 *  hydrate an island.
 *
 *  IT IS ALSO WHERE PEOPLE GUESS. The URL is printed in every mail we send and it is the one that
 *  looks like the list's own address, so a reader who was told about the notices arrives here
 *  holding no token at all. That state used to answer them with a wall; it now leads with the way
 *  in (`/newsletter`), which is why this page hands the island a sign-up href.
 *
 *  `noindex`, and deliberately OUTSIDE `TRANSLATED_ROUTES` for the reason the /404 leaf states:
 *  that ledger lights up links, a switcher and an hreflang graph, and nothing on this site links
 *  here — only a mail does. Three documents, no ledger entry, so the canonical below is composed
 *  from `lang` rather than looked up.
 *
 *  EVERY WORD IS CHROME (`i18n/content/nuntius.ts`). This page tells a reader whether they are
 *  subscribed; a state message that fell back to Polish on the French page would leave them
 *  unable to answer that question, which is the test the copy desk's §6r sets for chrome.
 * @architecture Astro islands 2026
 * @module components/pages/NuntiusPage
 */
import { getImage } from "astro:assets";

import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteChrome from "../SiteChrome.astro";
import SiteFooter from "../SiteFooter.astro";
import { DEFAULT_LOCALE, localizePath, type Locale } from "../../i18n/config";
import { getCollection } from "astro:content";

import { NUNTIUS } from "../../i18n/content/nuntius";
import { UI } from "../../i18n/ui";
import { bleedPair } from "../../lib/photos";
import { cycleStations } from "../../lib/cycle";
import { longDate } from "../../lib/dates";
import { concertKey, withOverlay } from "../../lib/copyOverlay";
import { NuntiusIsland, type NoticeOccurrence } from "../../islands/landing/NuntiusIsland";
import "../../styles/notice.css";

interface Props {
  lang?: Locale;
}
const { lang = DEFAULT_LOCALE } = Astro.props;

const t = NUNTIUS[lang].page;
const ui = UI[lang];

/* This document's own URL — composed, not looked up. See the header. */
const path = lang === DEFAULT_LOCALE ? "/nuntius" : `/${lang}/nuntius`;

/**
 * The evenings the confirmed leaf can offer — every published STATION still ahead, ascending.
 *
 * A LIST, NOT `upcomingStation`. Two things that helper cannot do here. It answers with one
 * evening chosen at BUILD time, and this document is the one page on the site that is opened
 * from a mailbox rather than from a link — days or weeks after the deploy that made it, which is
 * exactly long enough for "the next concert" to have already happened. And it reads only `date`,
 * so a tour's own evenings in `dates` are invisible to it; a confirmation that skipped four of
 * the five cities would be offering the wrong one. The choice is therefore the island's, made
 * against the reader's clock; this pass only typesets the candidates and drops what was already
 * past when the site was built.
 *
 * Stations only, for the reason `lib/cycle` states: a wedding is not what "the next concert"
 * means, and this list promises Spiritual Concerts.
 */
const builtOn = new Intl.DateTimeFormat("en-CA", {
  timeZone: "Europe/Warsaw",
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
}).format(new Date());

const hrefConcerts = localizePath("/koncerty", lang);

const occurrences: NoticeOccurrence[] = cycleStations(await getCollection("concerts"))
  .flatMap((entry): NoticeOccurrence[] => {
    /* This evening's words in this locale: the overlay's translation where one exists, the
       corpus's Polish otherwise. Never `pickLocale` — the corpus is Polish-only (spec §7). */
    const say = (field: string, polish: string): string =>
      withOverlay(concertKey(entry.id, field), lang, polish);
    const title = say("title", entry.data.title);
    /* An evening with no page of its own is still a PLACE on /koncerty: the station carries the
       anchor, so this door lands on the announcement rather than at the head of the walk. */
    const href = entry.data.hasPage
      ? `${hrefConcerts}/${entry.id}`
      : `${hrefConcerts}#${entry.id}`;
    /* The date is data and the hour is data; neither is ever typed into copy (spec §5). */
    const moment = (date: string, time?: string): string =>
      [longDate(date, lang), time].filter(Boolean).join(" · ");

    /* A tour states each city in `dates`; a single evening states itself in `date`/`metaPlace`.
       The venue of a tour date is a proper name and is printed as the corpus wrote it, which is
       what the itinerary on the concert's own page does with the same field. */
    if (entry.data.dates?.length) {
      return entry.data.dates.map((evening) => ({
        date: evening.date,
        title,
        place: evening.venue,
        moment: moment(evening.date, evening.time),
        href,
      }));
    }
    if (!entry.data.date) return [];
    return [
      {
        date: entry.data.date,
        title,
        place: say("metaPlace", entry.data.metaPlace.pl),
        moment: moment(entry.data.date, entry.data.time),
        href,
      },
    ];
  })
  .filter((evening) => evening.date >= builtOn)
  .sort((a, b) => a.date.localeCompare(b.date));

const ogImage = (
  await getImage({ src: bleedPair("koncerty-hero").desktop, width: 1200, format: "webp" })
).src;
---

<BaseLayout
  title={t.meta.title}
  description={t.meta.description}
  path={path}
  image={ogImage}
  bodyClass="page-nuntius"
  lang={lang}
>
  <Fragment slot="head">
    <meta name="robots" content="noindex,follow" />
  </Fragment>

  <a class="skip-link" href="#tresc">{ui.skipToContent}</a>
  <SiteChrome current="/nuntius" tone="dark" lang={lang} />

  <main id="tresc" class="nuntius-main">
    {/* `client:load` and not `client:visible`: the panel IS the page, and a reader who followed a
        link from their mailbox is owed the answer without a scroll event to earn it. */}
    <NuntiusIsland
      client:load
      lang={lang}
      chrome={t}
      concertsHref={localizePath("/koncerty", lang)}
      homeHref={localizePath("/", lang)}
      signupHref={localizePath("/newsletter", lang)}
      signupLabel={NUNTIUS[lang].invitation.cta}
      occurrences={occurrences}
    />
    <noscript>
      <p class="notice-noscript">{t.noscript}</p>
    </noscript>
  </main>

  {/* The receipt already answers for the list — confirming it, or offering the sign-up again in
      the states where the link failed. A second ask under it would not know which. */}
  <SiteFooter lang={lang} notice={false} />
</BaseLayout>
