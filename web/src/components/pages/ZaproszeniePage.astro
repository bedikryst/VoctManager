---
/**
 * @file ZaproszeniePage.astro
 * @description `/zaproszenie` — the printed invitation to one concert, opened on a screen: a page a
 *  phone reads more easily than the PDF, and one that can be sent on its own. Its last ask is the
 *  concert invitation list. Sharing and Facebook links connect the reader with other guests
 *  and the organiser's event; this page does not collect attendance declarations.
 *
 *  THE COVER OPENS AN EDITORIAL SPREAD. The page is the evening's poster in thought rather than
 *  in picture: a night sky over the whole sheet and, above the title, an eclipse at the moment its
 *  light returns. Nothing on it is a light block, the reply card included (`styles/zaproszenie.css`).
 *  The spread pairs the invitation's host, moment, venue and signature with the concert's prose,
 *  composers and performers. Each column reads down its own axis; on a phone the invitation
 *  precedes the concert. The programme link introduces its composers, followed by performer
 *  credits. Every word stands from the start, with no reveal on scroll. One response strip follows
 *  both. Then the recording:
 *  the programme's first evening, heard before anything is asked, because people give to what they
 *  have taken part in. It prints only when the recording is on the host that builds the page.
 *  The foundation comes next, as the page's second ask and the one it most wants answered:
 *  its paragraph, the donors' sentences, the gift's act, and its own profiles (not the ensemble's,
 *  which the footer carries), in a band of sky that holds one star per donor and explains none of
 *  them (`scripts/donor-sky.ts`). The act opens the donation vault in place, as the menu's
 *  "Wesprzyj" does; its href, the landing's donation section (`/#wesprzyj`, a deep link that skips
 *  the rite), is the road without JS. The page moves twice, each time once: the eclipse dawns, and
 *  when the act is reached the donors' stars light one after another and the act takes the light
 *  last. The future-invitation list follows as a postscript for the reader not ready to give, and
 *  the cover's credit closes the sheet. The title stands once, on the cover; the invitation reads
 *  on from it as one sentence ("VoctEnsemble serdecznie zaprasza na Koncert Duchowy…").
 *
 *  THE ARTWORK IS OPTIONAL TO THE BUILD AND OUTSIDE GIT. `zaproszenie-eclipse` is a total solar
 *  eclipse at its diamond ring (NASA/Carla Thomas, 2017, public domain), recoloured amber, its
 *  black turned to transparency, its clipped flare softened into the corona and the Moon kept
 *  opaque so no star shows through it. `zaproszenie-stars` is a seamless star tile drawn for this
 *  page. Without them the sheet is its night and the eclipse its amber haze. The eclipse's credit
 *  closes the page when the build found the photograph.
 *
 *  THE ASK IS THE LIST'S ISLAND IN THIS PAGE'S DRESS. `NoticeForm` is mounted here directly rather
 *  through `NoticeSignup`, whose rubric, Latin and headline are /koncerty's: here the rubric is the
 *  card's, the sentence is in the card's voice, and the blank and the act are the reply card's
 *  (`styles/invitation-notice.css`). What a consent record depends on is the same as on every other
 *  placement: the clause and the act come from `nuntius.ts`, prepared by `chromeHtmlForIsland`,
 *  the promise and the receipt's hint from /koncerty's `notice.*`, and the screen is recorded as
 *  `web:zaproszenie`.
 *
 *  `noindex`, out of the sitemap and out of `TRANSLATED_ROUTES`: the concert's own page is the one
 *  search should find, and this one goes out of date with the evening.
 * @module components/pages/ZaproszeniePage
 */
import { getImage } from "astro:assets";
import { getEntry } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import ExcerptsGlyph from "../ExcerptsGlyph.astro";
import SiteChrome from "../SiteChrome.astro";
import SiteFooter from "../SiteFooter.astro";
import VaultMount from "../VaultMount.astro";
import { FOUNDATION, SOCIAL_NETWORK_NAMES } from "../../data/foundation";
import { NoticeForm } from "../../islands/landing/NoticeForm";
import { fill } from "../../i18n/content/koncert";
import { KONCERTY_PAGE } from "../../i18n/content/koncerty";
import { NUNTIUS } from "../../i18n/content/nuntius";
import { INVITATION_CONCERT_ID, ZAPROSZENIE, frameTemplate } from "../../i18n/content/zaproszenie";
import { UI } from "../../i18n/ui";
import { SITE } from "../../i18n/config";
import { candleFrom } from "../../lib/candle";
import { currentPerformance } from "../../lib/cycle";
import { longDate, weekdayName } from "../../lib/dates";
import { concertExcerpts } from "../../lib/excerpts";
import { chromeHtmlForIsland } from "../../lib/islandCopy";
import { pageCopy } from "../../lib/pageCopy";
import { bleedPair, photoOptional } from "../../lib/photos";
import "../../styles/invitation.css";
import "../../styles/invitation-notice.css";
import "../../styles/excerpts.css";
import "../../styles/zaproszenie.css";
import "../../styles/vault.css";

const lang = "pl";
const ui = UI[lang];
const copy = ZAPROSZENIE;
const inside = copy.inside;

const entry = await getEntry("concerts", INVITATION_CONCERT_ID);
if (!entry) throw new Error(`[zaproszenie] No concert "${INVITATION_CONCERT_ID}" in the corpus.`);
/* The evening invited to: the programme's next performance laid over its row, so every fact below
   is that night's and none is the record's (lib/cycle). */
const concert = currentPerformance(entry).data;
const { date, time, venue } = concert;
if (!date || !time || !venue) {
  throw new Error(`[zaproszenie] "${INVITATION_CONCERT_ID}" needs a date, an hour and a venue to be invited to.`);
}

const day = `${weekdayName(date, lang)}, ${longDate(date, lang)}`;
/* The venue is "church, town" (content.config): the card sets the church on its own line and the
   town on the cover. */
const venueParts = venue.split(",").map((part) => part.trim());
const city = venueParts.length > 1 ? venueParts.at(-1) : undefined;
const church = venueParts.length > 1 ? venueParts.slice(0, -1).join(", ") : venue;
const free = concert.admission === "free";
/* The frame's name is set in italics, so the template is printed around it rather than as HTML. */
const [frameBefore, frameAfter] = concert.festival ? frameTemplate(concert.festival).split("{name}") : [];
const organizer = concert.organizer ? fill(inside.organizer, { name: concert.organizer }) : undefined;
const description = [
  fill(copy.meta.description, { title: concert.title, day, time, venue }),
  free ? copy.meta.free : "",
].filter(Boolean).join(" ");
const invitationUrl = `${SITE}/zaproszenie`;
const shareText = [
  `${inside.host} ${inside.invites} ${inside.kind} „${concert.title}”. ${day}, ${time}.`,
  `${[church, concert.address ?? city].filter(Boolean).join(", ")}.`,
  free ? copy.meta.free : "",
].filter(Boolean).join(" ");
const shareEmail = `mailto:?subject=${encodeURIComponent(copy.meta.title)}&body=${encodeURIComponent(shareText + "\n\n" + invitationUrl)}`;
/* The card sets the hour the Polish way, minutes raised over the hour: 13³⁰. */
const [hours, minutes] = time.split(":");

/* The list's shared voice: the promise a reader consents under and the receipt's hint. */
const notice = pageCopy(KONCERTY_PAGE, lang).notice;
const nuntius = NUNTIUS[lang];
const noticeChrome = {
  ...nuntius.form,
  errorEmail: copy.ask.errorEmail,
  errorSend: copy.ask.errorSend,
  consentHtml: chromeHtmlForIsland(nuntius.form.consentHtml, lang),
};
const noticeCopy = {
  sentTitle: copy.ask.sentTitle,
  sentBody: copy.ask.sentBody,
  sentHint: notice.sentHint,
};

/* A link pasted into a message shows the evening's poster, the same frame its own page shares. */
const shareImg = concert.share ? photoOptional(concert.share) : undefined;
const ogImage = shareImg ?? bleedPair("koncerty-hero").desktop;

/* The recording is the record's evening, not the one invited to, so it reads the entry itself; the
   bar it raises at the foot of the viewport burns the concert's candle, as on /podziekowanie. */
const excerpts = await concertExcerpts(entry, lang, bleedPair(entry.data.heroImg ?? entry.data.bg).desktop);
const excerptsCandle = candleFrom(entry.data.accent);

/* The invitation's artwork. Each is optional; see the header. */
const art = async (name: string, width: number) => {
  const src = photoOptional(name);
  return src ? getImage({ src, width: Math.min(width, src.width), format: "webp" }) : undefined;
};
const [eclipse, stars] = await Promise.all([
  art("zaproszenie-eclipse", 1200),
  /* Drawn at twice the 1024 CSS px it tiles at (styles/zaproszenie.css). */
  art("zaproszenie-stars", 2048),
]);
const creditHtml = eclipse ? `${copy.cover.credit.lead} ${copy.cover.credit.eclipseHtml}.` : undefined;
---

<BaseLayout
  title={copy.meta.title}
  description={description}
  path="/zaproszenie"
  image={ogImage}
  bodyClass="page-invitation page-zaproszenie"
  lang={lang}
>
  <Fragment slot="head">
    <meta name="robots" content="noindex,follow" />
    {/* Without JavaScript the island's server-rendered form cannot send; the address replaces it. */}
    <noscript><style is:inline>.inv-notice .notice-form { display: none; }</style></noscript>
  </Fragment>

  <a class="skip-link" href="#tresc">{ui.skipToContent}</a>
  <SiteChrome current="/zaproszenie" tone="dark" lang={lang} />

  <main id="tresc" class="inv-sheet zap" style={stars ? `--zap-stars: url("${stars.src}")` : undefined}>
    <div class="inv-sky" aria-hidden="true"></div>

    {/* ── The cover ── */}
    <header class="zap-cover" data-entrance="waiting">
      <div class="zap-figure" role={eclipse ? "img" : undefined} aria-label={eclipse ? copy.cover.eclipse : undefined} aria-hidden={eclipse ? undefined : "true"}>
        {eclipse && (
          <img class="zap-art" src={eclipse.src} width={eclipse.attributes.width} height={eclipse.attributes.height} alt="" decoding="async" fetchpriority="high" />
        )}
      </div>
      <h1 class="zap-title">{concert.title}</h1>
      <p class="zap-cover-line">{copy.cover.line}</p>
      <p class="zap-cover-moment">
        <time datetime={date}>{longDate(date, lang)}</time>
        {city && <><span aria-hidden="true"> · </span><span>{city}</span></>}
      </p>
    </header>

    <div class="zap-content">
      <div class="zap-spread">
        {/* ── The invitation ── */}
        <section class="zap-inside" aria-label={inside.aria}>
          <p class="zap-host">
            <span class="zap-host-name">{inside.host}</span>
            <span class="zap-host-line">{inside.invites}</span>
          </p>
          <p class="zap-kind">{inside.kind}</p>
          <p class="zap-subtitle" set:html={inside.subtitleHtml} />

          <span class="zap-rule" aria-hidden="true"></span>

          <p class="zap-moment">
            <time datetime={`${date}T${time}`}>
              <span class="zap-day">{day}</span>
              <span class="zap-sep zap-sep-day" aria-hidden="true">—</span>
              <span class="zap-at">
                {inside.hourPrefix}&nbsp;<span class="sr-only">{time}</span><span aria-hidden="true">{hours}<sup class="inv-minutes">{minutes}</sup></span>
              </span>
            </time>
            {free && (
              <>
                <span class="zap-sep" aria-hidden="true">—</span>
                <span class="zap-free">{inside.admission}</span>
              </>
            )}
          </p>

          <address class="zap-place">
            <span class="zap-church">{church}</span>
            {concert.address && (concert.mapUrl ? (
              <a class="zap-address inv-link" href={concert.mapUrl} target="_blank" rel="noopener noreferrer">{concert.address}</a>
            ) : (
              <span class="zap-address">{concert.address}</span>
            ))}
            {(concert.venueNote || concert.festival) && (
              <span class="zap-room">
                {concert.venueNote && <span class="zap-room-floor">{concert.venueNote}</span>}
                {concert.festival && <span>{frameBefore}<em>{concert.festival.name}</em>{frameAfter}</span>}
              </span>
            )}
          </address>

          <p class="zap-sign">
            <span class="zap-sign-name">{inside.signature.name}</span>
            <span class="zap-sign-role">{inside.signature.role}</span>
          </p>
        </section>

        {/* ── The concert ── */}
        <section class="zap-about" aria-labelledby="zap-about-heading">
          <h2 id="zap-about-heading" class="zap-about-heading">{copy.about.heading}</h2>
          <p class="zap-about-text" set:html={`${copy.about.textHtml} ${copy.about.eveningHtml}`} />
          <div class="zap-programme">
            {concert.hasPage && (
              <p class="zap-door">
                <a class="inv-door" href={`/koncerty/${INVITATION_CONCERT_ID}#program`} data-invitation-goal="programme">{copy.about.programme}</a>
              </p>
            )}
            <ul class="zap-works" role="list">
              {copy.about.composers.map((name) => <><li class="zap-name">{name}</li>{" "}</>)}
            </ul>
          </div>
          <div class="zap-cast">
            {copy.about.cast.map((line, row) => (
              <p class={row === 0 ? "zap-cast-lead" : undefined}>{line.map((item, index, all) => <><span class="zap-name">{item}</span>{index < all.length - 1 && " "}</>)}</p>
            ))}
            {/* The organiser who booked the evening and the funder's sentence, owed to the reader
                as facts and set as the credits' last, quietest line. */}
            {(organizer || concert.funding) && (
              <p class="zap-credits">
                {organizer && <span class="zap-name">{organizer}</span>}{" "}
                {concert.funding && <span class="zap-name">{concert.funding}</span>}
              </p>
            )}
          </div>
        </section>
      </div>

      <div class="zap-response">
        {/* Keyed by the evening, so a guest who accepted an earlier night of the programme is
            asked again for this one. */}
        <button class="zap-accept" type="button" hidden data-invitation-accept data-accept-key={`${INVITATION_CONCERT_ID}:${date}`} data-accepted-label={copy.actions.accepted} aria-live="polite">
          {copy.actions.accept}
        </button>
        <nav class="zap-actions" aria-label={copy.actions.aria}>
          <div class="zap-utilities">
            <a class="inv-door" href="/zaproszenie.ics" data-invitation-goal="calendar" download="pochwala-stworzenia.ics" data-astro-reload>{copy.actions.calendar}</a>
            <a class="inv-door" href={shareEmail} data-invitation-goal="share" data-invitation-share data-share-title={copy.meta.title} data-share-text={shareText} data-share-url={invitationUrl}>{copy.actions.share}</a>
          </div>
          {concert.facebookEvent && (
            <a class="inv-door zap-facebook" href={concert.facebookEvent} data-invitation-goal="facebook" target="_blank" rel="noopener noreferrer">{copy.actions.facebook}</a>
          )}
        </nav>
      </div>
    </div>

    {/* ── The recording ── */}
    {excerpts && (
      <div class="zap-listen">
        <ExcerptsGlyph excerpts={excerpts} labels={copy.listen} lang={lang} candle={excerptsCandle} title={entry.data.title} />
      </div>
    )}

    {/* ── The foundation, and the gift ── */}
    <section class="zap-foundation" aria-labelledby="zap-foundation-heading">
      {/* The donors' sky (scripts/donor-sky.ts): one star per donor, with no caption and no count.
          Empty until the collection's figure arrives, and empty for good without one. */}
      <div class="zap-donor-sky" aria-hidden="true" data-donor-sky></div>
      <h2 id="zap-foundation-heading" class="zap-foundation-name">{copy.foundation.name}</h2>
      <p class="zap-foundation-text">{copy.foundation.text}</p>
      <p class="zap-donors">{copy.foundation.donors}</p>
      {/* `data-give-kindle`: reaching the act lights it, and the bar's WESPRZYJ with it
          (scripts/give-kindle.ts). The mark sits on the act, not the section, so a phone sees the
          flare rather than the heading above it. */}
      <p class="zap-give" data-give-kindle>
        <a class="zap-give-act" href="/#wesprzyj" data-vault-open="100">{copy.foundation.give}</a>
      </p>
      {FOUNDATION.socials.length > 0 && (
        <p class="zap-foundation-links">
          {FOUNDATION.socials.map((profile) => (
            <a class="inv-door" href={profile.url} data-invitation-goal="social" target="_blank" rel="noopener noreferrer">{SOCIAL_NETWORK_NAMES[profile.network]}</a>
          ))}
        </p>
      )}
    </section>

    {/* ── The ask, where the card prints its RSVP ── */}
    <section class="inv-ask" aria-labelledby="zap-ask-heading">
      <h2 id="zap-ask-heading" class="inv-rubric inv-ask-rubric">{copy.ask.rubric}</h2>
      <p class="inv-say">
        <span class="inv-say-invitation">{copy.ask.invitation}</span>
        <span class="inv-say-promise">{notice.lede}</span>
      </p>
      <div class="inv-slot">
        <div class="inv-card inv-notice notice-inner">
          <NoticeForm
            client:visible
            lang={lang}
            chrome={noticeChrome}
            copy={noticeCopy}
            surface="web:zaproszenie"
            placement="band"
            showAddressCorrection
          />
          <noscript>
            <p class="inv-noscript">
              {copy.ask.noscript}{" "}
              <a href={`mailto:${copy.ask.contactEmail}`}>{copy.ask.contactEmail}</a>
            </p>
          </noscript>
        </div>
      </div>
    </section>

    {creditHtml && <p class="zap-credit" set:html={creditHtml} />}
  </main>

  <SiteFooter lang={lang} variant="invitation" />

  <VaultMount lang={lang} />
</BaseLayout>

<script>
  import "../../scripts/vault-triggers.ts";
  import { setupDonorSky } from "../../scripts/donor-sky";
  import { setupInvitation } from "../../scripts/invitation";

  let dispose: (() => void) | undefined;
  document.addEventListener("astro:page-load", () => {
    dispose?.();
    const invitation = setupInvitation();
    const sky = setupDonorSky();
    dispose = () => {
      invitation?.();
      sky?.();
    };
  });
  document.addEventListener("astro:before-swap", () => {
    dispose?.();
    dispose = undefined;
  });
</script>
