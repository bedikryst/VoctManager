---
/**
 * @file RsvpPage.astro
 * @description `/rsvp` — the reply card for the invitations to one concert. A guest arrives from the
 *  link sent with the invitation, writes a name and a seat count on the card, and leaves with a
 *  receipt; the office reads the result in the Django admin (outreach → Concert reservations).
 *
 *  IT IS THE REPLY CARD, NOT THE INVITATION AGAIN. The invitation reaches the guest in the message
 *  the link arrives in, and as a page of its own at `/zaproszenie`; this page says nothing of it a
 *  second time. It is the card's fourth page made into an object: one card lying on the rose paper,
 *  with the evening it answers for as its running head (title, day, hour — enough for a guest who
 *  opens the link again, or is forwarded it, to know what it is), the card's rubric, a sentence
 *  addressed to the guest, and the blanks. Where the evening is stands under the card on the sheet, for the day itself.
 *  The cover's light waits behind the card's top edge and rises over it when the guest says yes
 *  (`styles/rsvp.css` says how).
 *
 *  THE ARTWORK IS OPTIONAL TO THE BUILD. The images live in `src/assets/photos/` (outside git, like
 *  every photograph — they come from the invitation's design, not from us) and are read with
 *  `photoOptional`, so a host without them builds the page on its gradients alone.
 *
 *  THE FACTS OF THE EVENING ARE READ, NOT WRITTEN: title, day, hour and map come from the corpus
 *  entry `RSVP_CONCERT_ID` names, and so does the moment the form closes. What the card says
 *  around them is this page's own copy (`i18n/content/rsvp.ts`).
 *
 *  `noindex`, out of the sitemap and out of `TRANSLATED_ROUTES`: nobody searches for it, and the
 *  only way in is the link sent with the invitation.
 * @architecture Astro islands 2026
 * @module components/pages/RsvpPage
 */
import { getImage } from "astro:assets";
import { getEntry } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteChrome from "../SiteChrome.astro";
import SiteFooter from "../SiteFooter.astro";
import { RsvpForm } from "../../islands/landing/RsvpForm";
import { RSVP, RSVP_CONCERT_ID, RSVP_MAX_SEATS } from "../../i18n/content/rsvp";
import { UI } from "../../i18n/ui";
import { dayMonth, weekdayName } from "../../lib/dates";
import { chromeHtmlForIsland } from "../../lib/islandCopy";
import { bleedPair, photoOptional } from "../../lib/photos";
import "../../styles/invitation.css";
import "../../styles/rsvp.css";

const lang = "pl";
const ui = UI[lang];

const entry = await getEntry("concerts", RSVP_CONCERT_ID);
if (!entry) throw new Error(`[rsvp] No concert "${RSVP_CONCERT_ID}" in the corpus.`);
const concert = entry.data;
const { date, time } = concert;
if (!date || !time) {
  throw new Error(`[rsvp] "${RSVP_CONCERT_ID}" needs a date and an hour to take reservations.`);
}

/* The running head names the day without its year: the deadline under it prints the year, and the
   head has to hold two short lines on a phone. */
const day = `${weekdayName(date, lang)}, ${dayMonth(date, lang)}`;
/* The card sets the hour the Polish way, minutes raised over the hour: 13³⁰. */
const [hours, minutes] = time.split(":");
const formCopy = {
  ...RSVP.form,
  privacyHtml: chromeHtmlForIsland(RSVP.form.privacyHtml, lang),
  farewell: RSVP.farewell.replace("{date}", dayMonth(date, lang)).replace("{time}", time),
};

/* A link pasted into a message shows the evening's poster, the same frame its own page shares. */
const shareImg = concert.share ? photoOptional(concert.share) : undefined;
const ogImage = (
  await getImage({ src: shareImg ?? bleedPair("koncerty-hero").desktop, width: 1200, format: "webp" })
).src;

/* The invitation's artwork. Each is optional; see the header. */
const art = async (name: string, width: number) => {
  const src = photoOptional(name);
  return src ? getImage({ src, width: Math.min(width, src.width), format: "webp" }) : undefined;
};
const [light, cloudLeft, cloudRight] = await Promise.all([
  art("zaproszenie-light", 1200),
  art("zaproszenie-cloud-left", 860),
  art("zaproszenie-cloud-right", 920),
]);
---

<BaseLayout
  title={RSVP.meta.title}
  description={RSVP.meta.description}
  path="/rsvp"
  image={ogImage}
  bodyClass="page-invitation page-rsvp"
  lang={lang}
>
  <Fragment slot="head">
    <meta name="robots" content="noindex,follow" />
    {/* The island renders its form on the server too. Without JavaScript that form cannot send,
        and a native submit would put the guest's name in the URL; the address below replaces it. */}
    <noscript><style is:inline>.rsvp-form { display: none; }</style></noscript>
  </Fragment>

  <a class="skip-link" href="#tresc">{ui.skipToContent}</a>
  <SiteChrome current="/rsvp" ground="paper" lang={lang} />

  <main id="tresc" class="inv-sheet rsvp">
    {/* The card's cloud banks, gathering into the foot corners when the controller cues them.
        Decoration only. */}
    <div class="inv-sky" aria-hidden="true">
      {cloudLeft && (
        <img class="inv-cloud inv-cloud-left reveal-cue" src={cloudLeft.src} alt="" loading="lazy" decoding="async" />
      )}
      {cloudRight && (
        <img class="inv-cloud inv-cloud-right reveal-cue" src={cloudRight.src} alt="" loading="lazy" decoding="async" />
      )}
    </div>

    <div class="rsvp-stage">
      {/* The cover's light, low behind the card's top edge until the guest answers. */}
      <span class="rsvp-sun" aria-hidden="true">
        <span class="inv-light">
          {light && <img src={light.src} alt="" decoding="async" />}
        </span>
      </span>

      <article class="inv-card rsvp-card" aria-labelledby="rsvp-title">
        <header class="rsvp-head">
          <p class="rsvp-evening reveal">
            <span class="rsvp-evening-title">{concert.title}</span>
            <time class="rsvp-evening-moment" datetime={`${date}T${time}`}>
              <span>{day}</span>
              <span aria-hidden="true">·</span>
              <span>
                {RSVP.hourPrefix}&nbsp;<span class="sr-only">{time}</span><span aria-hidden="true">{hours}<sup class="inv-minutes">{minutes}</sup></span>
              </span>
            </time>
          </p>

          <h1 id="rsvp-title" class="inv-rubric rsvp-rubric reveal" data-d="1">
            <span aria-hidden="true">{RSVP.rubric}</span>
            <span class="sr-only">{RSVP.formAria}</span>
          </h1>

          <p class="rsvp-ask reveal" data-d="2">
            <span class="rsvp-welcome">{RSVP.welcome}</span>
            <span class="rsvp-purpose">{RSVP.purpose}</span>
          </p>
        </header>

        <div class="rsvp-slot reveal" data-d="3">
          <RsvpForm
            client:load
            copy={formCopy}
            concert={RSVP_CONCERT_ID}
            startsOn={{ date, time }}
            maxSeats={RSVP_MAX_SEATS}
            contactEmail={RSVP.contact.email}
          />
          <noscript>
            <p class="inv-noscript">
              {RSVP.noscript}{" "}
              <a href={`mailto:${RSVP.contact.email}`}>{RSVP.contact.email}</a>
            </p>
          </noscript>
        </div>
      </article>
    </div>

    <footer class="rsvp-where reveal">
      <address class="rsvp-place">
        <span class="rsvp-church">{RSVP.place.church}</span>
        {concert.mapUrl ? (
          <a class="rsvp-address inv-link" href={concert.mapUrl} target="_blank" rel="noopener noreferrer">
            {RSVP.place.address}<span class="inv-out" aria-hidden="true">↗</span>
          </a>
        ) : (
          <span class="rsvp-address">{RSVP.place.address}</span>
        )}
        <span class="rsvp-room">{RSVP.place.room}</span>
      </address>
      <p class="rsvp-contact">
        {RSVP.contact.line}{" "}
        <a class="inv-link" href={`mailto:${RSVP.contact.email}`}>{RSVP.contact.email}</a>
      </p>
      {concert.hasPage && (
        <a class="inv-door" href={`/koncerty/${RSVP_CONCERT_ID}`}>{RSVP.programme} →</a>
      )}
    </footer>
  </main>

  <SiteFooter lang={lang} />
</BaseLayout>
