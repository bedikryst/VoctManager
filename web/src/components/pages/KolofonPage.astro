---
/**
 * @file KolofonPage.astro
 * @description Locale-agnostic body of the colophon (/kolofon) — the quiet destination linked from
 *  every page footer (not in main nav). A colophon states who, where, when, with what types and
 *  with whose help; this one runs hero → sigil → Regula → Constructio → Typi → Imagines → Fundatio
 *  → Auctor → Gratiarum actio, closing on the impression date and the inscription. The three route
 *  files (/kolofon, /en/kolofon, /fr/kolofon) are one-liners that differ only in `lang`.
 *
 *  The sigil is per-visit (lib/sigil.ts, seeded from sessionStorage so there is NO persistent
 *  client identifier under RODO) and redrawn on every page-load — same visit, same seal; a fresh
 *  one each return. Tone: dark hero → parchment body, matching `/koncerty/[id]`.
 *
 *  THE PAGE'S ONE RULE, and the reason `Regula` is four sentences and not a paragraph: a colophon
 *  SHOWS its craft, it does not explain it. Every block here is set in the thing it describes —
 *  the type specimens demonstrate their own axes, the Regula lines are ruled and inked by the
 *  registers they name, and a photographer's name opens the photographs it is credited for.
 *  Prose about the site's own metaphors belongs nowhere on it.
 *
 *  WHERE EVERY WORD COMES FROM, and on this page that is five places rather than two:
 *
 *  - What the PAGE says (the rubrics' vernacular tier, the four rules, the materials, the type
 *    notes, the credits' roles) is Polish prose in `src/content/pages/kolofon.yaml`, read through
 *    `lib/pageCopy` with the desk's translations substituted per field.
 *  - The FOUNDATION'S MISSION is read from /kontakt's corpus, not restated here: the same
 *    paragraph stands on both pages, and two desk rows holding one paragraph is the drift the
 *    overlay's stale machinery cannot see (spec §7).
 *  - What a CONCERT says — an evening's title in the `Imagines` rows — goes through the desk's
 *    overlay by concert key (`say()`), never through `pickLocale`, which returns Polish in every
 *    locale on a Polish-only corpus.
 *  - CHROME (the seal's accessible name, the impression phrase, the outlet tag, the button's verb)
 *    is `i18n/content/kolofon.ts`; the page's own name in a breadcrumb is `ui.ts`'s footer label,
 *    which is the entrance that leads here. The frame count is /obrazy's declension, deliberately:
 *    one number must not meet the reader as "8 fot." on one page and "8 photographs" on the other.
 *  - NAMES AND NUMBERS — the typefaces, the collaborators, the board, the registry, the address —
 *    are in this file, because they are the same in every language.
 *
 *  `Imagines` is therefore the page's only interactive rubric, and it is the one surface on the
 *  site that can answer "which of these are hers": /obrazy is ordered by evening, so a hand is
 *  scattered across it by construction. The frames are an AUTHORED set (`data-image-set`,
 *  lib/imageFrame) rather than a DOM group, because this page shows no photograph to group.
 *
 *  Rubrics (`.kol-eyebrow`, `.kol-section-label`) deliberately declare no font-family or
 *  text-transform: base.css owns the two-voice rubric for every host carrying a `.lat` span
 *  (capitalis caps candle for the Latin, mono lowercase muted for the Polish gloss), and a page
 *  rule setting either one ties its specificity and silently wins on bundle order.
 * @architecture Astro islands 2026
 * @module components/pages/KolofonPage
 */
import { getImage } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteChrome from "../SiteChrome.astro";
import SiteFooter from "../SiteFooter.astro";
import VaultMount from "../../components/VaultMount.astro";
import { ImageLightbox } from "../../islands/landing/ImageLightbox";
import { bleedPair, photo } from "../../lib/photos";
import { galleryRuns } from "../../lib/galleryRuns";
import { framedShot } from "../../lib/galleryFrame";
import { frameCredit } from "../../lib/photoCredit";
import { longDate } from "../../lib/dates";
import { concertKey, withOverlay } from "../../lib/copyOverlay";
import { pageCopy } from "../../lib/pageCopy";
import type { ImageFrameItem } from "../../lib/imageFrame";
import { KOLOFON_CHROME, KOLOFON_PAGE } from "../../i18n/content/kolofon";
import { KONTAKT_PAGE } from "../../i18n/content/kontakt";
import { counted, OBRAZY_CHROME } from "../../i18n/content/obrazy";
import { UI } from "../../i18n/ui";
import { localizePath, pageI18n, SITE, type Locale } from "../../i18n/config";
import "../../styles/vault.css";
import "../../styles/image-lightbox.css";

interface Props {
  /** Which language this render is. Drives the copy, the chrome, the URL and the hreflang graph. */
  lang: Locale;
}
const { lang } = Astro.props;

const copy = pageCopy(KOLOFON_PAGE, lang);
const t = KOLOFON_CHROME[lang];
const ui = UI[lang];
// One base path → this render's own URL, its hreflang graph, and the locales the switcher offers.
const { path, alternates, available } = pageI18n("/kolofon", lang);

// The foundation's mission, read from the page that already holds it. It is printed verbatim on
// /kontakt under `page.kontakt.locus.mission`, and a second desk row carrying the same paragraph is
// exactly the drift the overlay cannot detect: an editor moves one, nothing marks the other stale,
// and the two pages state the foundation's purpose differently in the same locale.
const mission = pageCopy(KONTAKT_PAGE, lang).locus.mission;

const ogImage = (
  await getImage({ src: bleedPair("hero-landing").desktop, width: 1200, format: "webp" })
).src;

// The impression: when THIS COPY of the page was struck, which is a fact about the printing and
// is deliberately not published as the graph's `dateModified`. Every deploy restrikes the page,
// so a machine-readable modification date taken from the build would announce an edit to the
// colophon each time anything else on the site changed — a claim of authorship activity that did
// not happen. The visible line stays because a colophon dating its own impression is the truth it
// is for.
//
// Composed from the LOCAL calendar day rather than `toISOString`, which is UTC: a build running
// after 22:00 in a positive-offset zone would otherwise date the impression tomorrow. The
// formatting is `lib/dates`, the site's one long-date formatter, so this line reads in the same
// register as every dateline (and carries the Polish genitive month, "1 sierpnia", for free).
const now = new Date();
const impressioIso = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}-${String(
  now.getDate(),
).padStart(2, "0")}`;
const impressioLabel = longDate(impressioIso, lang);

// Shared-entity JSON-LD: the page is authored by a named person and published by the SAME
// foundation node the landing/o-nas graphs declare (#foundation), so this reads as one
// entity's colophon — clean E-E-A-T signal for a young nonprofit.
//
// The author's address is on his OWN domain and the publisher's is not, which is the distinction
// this node exists to draw: a colophon carries the printer's mark beside the publisher's imprint,
// and an address inside voctensemble.com would fold the two into one party. Writing about how the
// site was made reaches the person who made it.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: copy.meta.title,
  url: `${SITE}${path}`,
  description: copy.meta.description,
  inLanguage: lang,
  author: {
    "@type": "Person",
    name: "Krystian Bugalski",
    email: "krystian@bugalski.dev",
  },
  publisher: {
    "@type": "NGO",
    "@id": `${SITE}/#foundation`,
    name: "VoctFoundation",
  },
};

/** What this render prints for one of a concert's copy fields: the overlay's translation where one
    exists, the corpus's Polish otherwise. */
const say = (id: string, field: string, polish: string): string =>
  withOverlay(concertKey(id, field), lang, polish);

// ── Imagines: where the photographs came from, read off the `credit` and `source` fields in
// src/content/concerts.yaml and walked in Via order, so each hand appears where its evening stands
// and a name added to the YAML needs no second edit here. This list was hand-kept while a credit
// was free text inside a caption — a typed field is safe to read, and the hand-kept copy had
// already drifted, filing Wojciech Przybył under the city he did not shoot. Places come through
// `galleryRuns`, which is what makes a tour report the church a frame was actually taken in rather
// than the evening's whole itinerary — and which names that church in this locale (i18n/content/miejsca).
//
// Hands and outlets are gathered apart and printed apart: an outlet's row says "źródło" in the
// role column, because a masthead set in the same voice as a photographer's name is a claim that
// the masthead took the picture.
// Each name also OPENS its own frames, which is the one thing this rubric could do that /obrazy
// cannot: the archive is ordered by evening, so it can never answer "which of these are hers".
// The set is authored rather than collected from the DOM — there is no photograph on this page to
// hang a `data-image-group` off (lib/imageFrame states both forms and why this surface takes this
// one). `framedShot` is the SAME helper the two gallery surfaces call, so every rendition here is
// a file /obrazy already emits and the page costs no new bytes on disk.
interface Hand {
  /** Evening → the places inside it where this name's frames were taken. */
  readonly evenings: Map<string, Set<string>>;
  /** The frames themselves, in Via order — their count is the hand's share of the archive. */
  readonly frames: ImageFrameItem[];
}
type Provenance = Map<string, Hand>;
const note = (
  into: Provenance,
  name: string,
  evening: string,
  place: string,
  frame: ImageFrameItem,
): void => {
  const hand = into.get(name) ?? { evenings: new Map<string, Set<string>>(), frames: [] };
  into.set(name, hand);
  hand.frames.push(frame);
  const places = hand.evenings.get(evening) ?? new Set<string>();
  hand.evenings.set(evening, places);
  if (place) places.add(place);
};

const hands: Provenance = new Map();
const outlets: Provenance = new Map();
for (const entry of (await getCollection("concerts")).sort((a, b) => a.data.order - b.data.order)) {
  const c = entry.data;
  const title = say(entry.id, "title", c.title);
  // Every frame keeps the road back to its own evening, exactly as /obrazy's do — a set opened
  // from a name would otherwise be the dead end the frame's exit was built to close.
  const exit = c.hasPage
    ? { href: localizePath(`/koncerty/${entry.id}`, lang), hrefLabel: title }
    : {};
  for (const run of galleryRuns(c.gallery, { venue: c.venue, date: c.date }, lang)) {
    const caption = [run.title, run.date].filter(Boolean).join(" · ");
    // FRAME BY FRAME, never over `run.credits` — that roll is deduplicated per run, so walking it
    // would tally a hand once per evening and print "1 fot." under someone who shot eight. The
    // credit-before-source precedence is galleryRuns's own, restated here because this loop is
    // what decides which of the two lists a name lands in.
    for (const shot of run.shots) {
      const into = shot.credit ? hands : shot.source ? outlets : null;
      const name = shot.credit ?? shot.source;
      if (!into || !name) continue;
      // `photo`, not `photoOptional`: /obrazy may silently render one frame fewer, but a rubric
      // whose entire job is attribution must not print "7 fot." over eight credited frames because
      // a filename was mistyped. A missing asset fails the build here, loudly, and that is the
      // trade this page wants.
      const img = photo(shot.img);
      note(into, name, title, run.title, {
        ...(await framedShot(img)),
        alt: shot.alt ? say(entry.id, `gallery.${shot.img}.alt`, shot.alt) : "",
        caption,
        // Resolved by the trigger, never by the room — only a surface reading the gallery knows
        // whether a frame has a photographer, an outlet or the ensemble behind it.
        credit: frameCredit(shot, lang),
        ...exit,
      });
    }
  }
}

const rows = (
  from: Provenance,
  lead: string,
): { name: string; role: string; label: string; items: ImageFrameItem[] }[] =>
  [...from].map(([name, { evenings, frames }]) => ({
    name,
    // The tally, then "evening · place" — and a hand that stood at two of them carries both. The
    // count is what turns a roll of names into an attribution: without it the list states that six
    // people photographed the cycle and leaves their shares indistinguishable. It is also what
    // makes the name legible as a DOOR — a name that merely turns out to be pressable is a hidden
    // affordance, where "8 fot." beside it is an invitation. Abbreviated by /obrazy's own
    // declension, because one fact meeting the reader under two labels on two pages reads as
    // two facts.
    role: [
      ...(lead ? [lead] : []),
      counted(frames.length, OBRAZY_CHROME[lang].figure, lang),
      ...[...evenings].map(([evening, places]) => [evening, ...places].join(" · ")),
    ].join(" · "),
    // The button's own name, because its visible text is only the person. The count is left out of
    // it deliberately: the role line beside it is in the same list item and is read straight after.
    label: `${name} — ${frames.length === 1 ? t.openFrame : t.openFrames}`,
    items: frames,
  }));
const imagines = [...rows(hands, ""), ...rows(outlets, t.sourceRole)];

// ── The two lists whose NAMES are here and whose words are the corpus's ────────────────────────
//
// A name is the same in every language, so it stays in this file; what it is credited FOR is
// prose and is on the desk. The id pairs the two, and it is the desk's key for the row — which is
// why the pairing THROWS rather than falling through: a face or a collaborator whose note is
// missing would otherwise print a name with an empty line beside it, which on a page whose whole
// job is attribution is worse than a build failure.
const noted = <T extends { readonly id: string }>(
  items: readonly T[],
  id: string,
  what: string,
): T => {
  const found = items.find((item) => item.id === id);
  if (!found) {
    throw new Error(`[kolofon] ${what} "${id}" has no entry in src/content/pages/kolofon.yaml.`);
  }
  return found;
};

/** The four faces in the order the page sets them; `id` is also the row's CSS modifier. */
const faces = [
  { id: "cormorant", name: "Cormorant Garamond" },
  { id: "cinzel", name: "Cinzel" },
  { id: "sans", name: "IBM Plex Sans" },
  { id: "plex", name: "IBM Plex Mono" },
].map((face) => ({ ...face, meta: noted(copy.typi.items, face.id, "typeface").meta }));

/** People, studios and institutions, in the order the evenings ran. */
const thanks = [
  { id: "garbacz", name: "Jakub Garbacz · Ars Sonora Studio" },
  { id: "bystrzycka", name: "Ada Bystrzycka · Multiscena" },
  { id: "kuzma", name: "Sebastian Kuźma · ART Agencja Rzemieślników Teatralnych" },
  { id: "ropotan", name: "Radu Ropotan" },
  { id: "organy", name: "Krzysztof Michałek · Michał Piechnik" },
  { id: "carpediem", name: "Fundacja Carpe Diem · Ośrodek Kultury Norwida" },
].map((person) => ({ ...person, role: noted(copy.gratia.items, person.id, "credit").role }));
---

{/* The breadcrumb prints the name the footer's Index column gives this page — the entrance that
    leads here — rather than the h1, which carries the full stop the design sets it with. */}
<BaseLayout
  title={copy.meta.title}
  description={copy.meta.description}
  path={path}
  image={ogImage}
  bodyClass="page-kolofon"
  lang={lang}
  alternates={alternates}
  breadcrumb={[{ name: ui.footer.colophon, path }]}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <a class="skip-link" href="#tresc">{ui.skipToContent}</a>
  <SiteChrome current="/kolofon" tone="dark" lang={lang} availableLocales={available} />

  <main id="tresc">
    {/* ── Hero: small, dark, restrained ───────────────────────────────────── */}
    <section class="kol-hero" aria-label={ui.footer.colophon}>
      <div class="kol-hero-inner">
        <p class="kol-eyebrow micro reveal">
          <span class="lat" lang="la">Colophon</span>
          <span class="kol-dot" aria-hidden="true">·</span>
          <span>{copy.hero.eyebrow}</span>
        </p>
        <h1 class="kol-title reveal ink-press" data-d="1">{copy.hero.title}</h1>
        {/* The definition stands alone, and the sentence that used to follow it ("Tu robimy to
            samo.") is gone for the page's own reason rather than for brevity: the lede names three
            things a colophon records — place, time, who published — and the last two lines of this
            page ARE those three, in the historical order. Announcing the answer at the top spends
            the ending before the reader reaches it, on the one page whose rule is that it shows
            its craft instead of stating it. The h1 above already says which colophon this is. */}
        <p class="kol-lede reveal" data-d="2">{copy.hero.lede}</p>
      </div>
    </section>

    {/* ── Sigil — per-visit deterministic SVG ─────────────────────────────── */}
    <section class="kol-band kol-band-deep kol-seal" aria-labelledby="kol-h-sigil">
      <div class="kol-wrap kol-narrow">
        <h2 id="kol-h-sigil" class="kol-section-label micro reveal">
          <span class="lat" lang="la">Sigillum</span>
          <span class="kol-dot" aria-hidden="true">·</span>
          <span>{copy.sigillum.eyebrow}</span>
        </h2>
        {/* `.reveal-cue` and NOT `.reveal`: the seal carries an authored draw, and a node
            wearing a choreography takes the bare trigger and no register (registers.css) —
            stacking ink on top of a drawing is two motions where the page means one. The
            caption is copy, so it keeps the ink; `data-d` stays on the figure as the
            subtree's cadence carrier. */}
        <figure class="kol-seal-figure reveal-cue" data-d="1">
          <div class="kol-seal-mount" data-sigil-mount role="img" aria-label={t.sigilAria}>
            {/* Client-side fallback: an anchor circle so the layout never collapses
                if JS is unavailable. The sigil script replaces innerHTML. It carries no
                `sg-` class, so the draw choreography passes over it untouched. */}
            <svg viewBox="0 0 220 220" xmlns="http://www.w3.org/2000/svg" stroke="currentColor" fill="none">
              <circle cx="110" cy="110" r="92" stroke-width="0.6" stroke-opacity="0.4" />
              <circle cx="110" cy="110" r="2" fill="currentColor" stroke="none" />
            </svg>
          </div>
          {/* Belongs to the generated seal, not to the fallback: it promises a seal that
              turns per visit and vanishes with the tab, which is true of nothing the anchor
              circle does. The script reveals it by flagging the figure, so a visitor without
              JS gets the circle and no claim about it. */}
          <figcaption class="kol-seal-caption kol-gloss reveal">
            {copy.sigillum.caption}
          </figcaption>
        </figure>
      </div>
    </section>

    {/* ── Regula — the rule the page is set by, stated and never explained ──
        Four sentences, no gloss after any of them. Two are demonstrated by the row they sit in
        (every row is ruled, then inked); the other two are demonstrated by the whole site, which
        lights its photographs and moves none of its text. Adding a paragraph here to say so is
        the one thing this block must never do. */}
    <section class="kol-band kol-band-soft" aria-labelledby="kol-h-regula">
      <div class="kol-wrap">
        <h2 id="kol-h-regula" class="kol-section-label micro reveal">
          <span class="lat" lang="la">Regula</span>
          <span class="kol-dot" aria-hidden="true">·</span>
          <span>{copy.regula.eyebrow}</span>
        </h2>
        <p class="kol-lead kol-lead-tight reveal" data-d="1">{copy.regula.lead}</p>
        <ul class="kol-regula" data-d="2">
          {copy.regula.items.map((rule) => <li class="reveal reveal-rule">{rule.text}</li>)}
        </ul>
      </div>
    </section>

    {/* ── Konstrukcja — build philosophy + tooling ────────────────────────── */}
    <section class="kol-band kol-band-soft kol-band-rule-top" aria-labelledby="kol-h-constructio">
      <div class="kol-wrap">
        <h2 id="kol-h-constructio" class="kol-section-label micro reveal">
          <span class="lat" lang="la">Constructio</span>
          <span class="kol-dot" aria-hidden="true">·</span>
          <span>{copy.constructio.eyebrow}</span>
        </h2>
        <p class="kol-lead reveal" data-d="1">{copy.constructio.lead}</p>
        {/* The container carries the cadence, each row carries the registers: `data-d` sets
            --reveal-delay for the whole subtree, so a row is ruled and then written as one
            gesture instead of the block inking over rows whose hairlines have not arrived.
            One of the values states a negation ("bez cookies") and the corpus keeps it to
            exactly one — see the list's own note in kolofon.yaml. */}
        <dl class="kol-defs" data-d="2">
          {
            copy.constructio.items.map((row) => (
              <div class="kol-def reveal reveal-rule">
                <dt>{row.term}</dt>
                <dd>{row.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    {/* ── Typi — typeface credits ─────────────────────────────────────────── */}
    <section class="kol-band kol-band-soft kol-band-rule-top" aria-labelledby="kol-h-typi">
      <div class="kol-wrap">
        <h2 id="kol-h-typi" class="kol-section-label micro reveal">
          <span class="lat" lang="la">Typi</span>
          <span class="kol-dot" aria-hidden="true">·</span>
          <span>{copy.typi.eyebrow}</span>
        </h2>
        {/* Independent rows under one onset was the `.donation-rows` shape: as a single 513px
            node the last specimens were written before they were reached. Each row now has its
            own trigger and the list keeps its rolling cadence.

            The SPECIMEN is the face's own name and stays here rather than in the corpus: it is a
            proper name, and it is the string whose weight axis the row travels — the id it is
            keyed by is also its CSS modifier, so a row cannot be given a note without the face
            the note describes. */}
        <ul class="kol-fonts">
          {
            faces.map((face) => (
              <li class={`kol-font kol-font--${face.id} reveal reveal-rule`}>
                <span class="kol-font-sample">{face.name}</span>
                <span class="kol-font-meta kol-gloss">{face.meta}</span>
              </li>
            ))
          }
        </ul>
        <p class="kol-license kol-gloss reveal" data-d="2">{copy.typi.license}</p>
      </div>
    </section>

    {/* ── Imagines — photographers, derived above from the gallery `credit` fields. Only hands
        from outside the ensemble are named: a frame with no credit is the ensemble's own, which
        the lede states once for the whole site rather than filing the archive as a person. ── */}
    <section class="kol-band kol-band-soft kol-band-rule-top" aria-labelledby="kol-h-imagines">
      <div class="kol-wrap">
        <h2 id="kol-h-imagines" class="kol-section-label micro reveal">
          <span class="lat" lang="la">Imagines</span>
          <span class="kol-dot" aria-hidden="true">·</span>
          <span>{copy.imagines.eyebrow}</span>
        </h2>
        <p class="kol-lead kol-lead-tight reveal" data-d="1">{copy.imagines.lead}</p>
        {/* The name is the trigger, and the hairline under it is what says so AT REST. That is
            /obrazy's argument for standing its `↗` at rest rather than on hover, and it binds
            harder here: `Gratiarum actio` below uses this identical row shape and is not
            pressable, so a mark that appeared only under a pointer would leave a reader who never
            hovers unable to tell the two lists apart. A button, never a link — nothing is
            navigated to; the frame opens over the page it was opened from. */}
        <ul class="kol-collab">
          {
            imagines.map((p) => (
              <li class="reveal reveal-rule">
                <button
                  type="button"
                  class="kol-collab-name kol-collab-open"
                  data-image-open
                  data-image-set={JSON.stringify(p.items)}
                  aria-label={p.label}
                >
                  {p.name}
                </button>
                <span class="kol-collab-role kol-gloss">{p.role}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* ── Fundatio — foundation legal ─────────────────────────────────────── */}
    <section class="kol-band kol-band-soft kol-band-rule-top" aria-labelledby="kol-h-fundatio">
      <div class="kol-wrap">
        <h2 id="kol-h-fundatio" class="kol-section-label micro reveal">
          <span class="lat" lang="la">Fundatio</span>
          <span class="kol-dot" aria-hidden="true">·</span>
          <span>{copy.fundatio.eyebrow}</span>
        </h2>
        {/* The mission is /kontakt's field, printed here rather than copied — see the note on
            `mission` above. */}
        <p class="kol-lead kol-lead-tight reveal" data-d="1">{mission}</p>
        {/* The registry rows are DATA: an address, three register numbers and three names, printed
            identically in every locale, exactly as the footer prints the same three numbers. KRS,
            NIP and REGON are the Polish registers' own acronyms and are not translated either —
            only the four labels beside them are copy. */}
