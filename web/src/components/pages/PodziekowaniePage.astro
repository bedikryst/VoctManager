---
/**
 * @file PodziekowaniePage.astro
 * @description `/podziekowanie` — the thanks sent after one concert to the guests its invitation
 *  reached outside the notice list, by the same hand and the same kind of link as `/zaproszenie`.
 *  It is that page's pair: the invitation's paper and ink (`styles/invitation.css`), bound to the
 *  same corpus entry (`INVITATION_CONCERT_ID`), Polish only, signed by the ensemble.
 *
 *  A KEEPSAKE OF THE AFTERNOON, PRINTED ON THE CARD'S PAPER, in reading order:
 *  - the cover: the invitation's hands and light, the title, the word of thanks and the day;
 *  - the Canticle: the fact the list's letter is built on, the empty staff the oldest manuscript
 *    rules over the first verse (the verse and its gloss are the first lines of the programme's
 *    own text of the Canticle), what was written into it, and the recording (`ExcerptsGlyph`);
 *  - the thanks, and under it the donors in a printed frame with the act that opens the donation
 *    vault in place (`data-vault-open`, `scripts/vault-triggers.ts`; its href, the landing's
 *    donation section, is the road without JS);
 *  - four photographs: the rehearsal and the concert from one place in the aisle side by side,
 *    then the church full of listeners seen from the altar and the ensemble on its steps
 *    afterwards, each across the grid; each opens the site's lightbox as one set, with the door
 *    to the concert's gallery;
 *  - the list, `NoticeForm` in the invitation's dress (`styles/invitation-notice.css`) under its
 *    own screen value, `web:podziekowanie`. It stands high, straight after the photographs:
 *    these guests joining the list is what the page is for. The photographs between it and the
 *    donors' frame keep the two asks from reading as one appeal;
 *  - the programme's back page: the cast beside the acknowledgements, which open on the two hosts
 *    they thank, the director of POLMIC who introduced the concert and the festival's organiser,
 *    each print over a name and a function; then the way to the concert page and the signature.
 *    The hosts stand where they are thanked rather than among the afternoon's photographs: a
 *    portrait of a stranger needs its name, and here the name is already on the page.
 *
 *  THE INVITATION'S HANDS, REACHING AS THEY DID THERE. The guests opened the invitation on them,
 *  so the thanks opens on them too, and only the word under the title differs.
 *  `scripts/podziekowanie.ts` runs the entrance on the invitation's contract and rests the light
 *  and the clouds out of view, in a hidden tab and while a guest writes; the invitation's own
 *  script and the hands' breathing stay on /zaproszenie. Reveal comes from BaseLayout.
 *
 *  THE CAST IS THE CORPUS'S (`roster`, then the music assistant and the conductor from
 *  `credits`, as the concert page closes its Voces band with the conductor), so a correction there
 *  reaches both pages. Its names are cleared for this concert's pages, and this is one of them.
 *
 *  EVERY PHOTOGRAPH IS OPTIONAL TO THE BUILD (`photoOptional`), being uploaded to the host by hand.
 *  The pair and the hosts print only when both of their files resolve, since one frame of either
 *  leaves a column empty; each landscape prints on its own file. The glyph prints only when the recording is on the host
 *  (`lib/excerpts`). So open the page on the host before sending its link.
 *
 *  `noindex`, out of the sitemap and out of `TRANSLATED_ROUTES`, like `/zaproszenie`.
 * @module components/pages/PodziekowaniePage
 */
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import { getEntry } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import ExcerptsGlyph from "../ExcerptsGlyph.astro";
import SiteChrome from "../SiteChrome.astro";
import SiteFooter from "../SiteFooter.astro";
import VaultMount from "../VaultMount.astro";
import { ImageLightbox } from "../../islands/landing/ImageLightbox";
import { NoticeForm } from "../../islands/landing/NoticeForm";
import { KONCERTY_PAGE } from "../../i18n/content/koncerty";
import { NUNTIUS } from "../../i18n/content/nuntius";
import { PODZIEKOWANIE } from "../../i18n/content/podziekowanie";
import { INVITATION_CONCERT_ID, ZAPROSZENIE } from "../../i18n/content/zaproszenie";
import { UI } from "../../i18n/ui";
import { candleFrom } from "../../lib/candle";
import { croppedShot } from "../../lib/croppedShot";
import { longDate } from "../../lib/dates";
import { concertExcerpts } from "../../lib/excerpts";
import { framedShot } from "../../lib/galleryFrame";
import { chromeHtmlForIsland } from "../../lib/islandCopy";
import { pageCopy } from "../../lib/pageCopy";
import { bleedPair, photoOptional } from "../../lib/photos";
import "../../styles/invitation.css";
import "../../styles/invitation-notice.css";
import "../../styles/excerpts.css";
import "../../styles/image-lightbox.css";
import "../../styles/podziekowanie.css";
import "../../styles/vault.css";

/** The pair, cut to one scale on the altar painting from the originals the letter's spread uses. */
const PAIR_REHEARSAL = "kd-stworzenie-pair-rehearsal";
const PAIR_CONCERT = "kd-stworzenie-pair-concert";
/** The church seen from the altar, cut taller than the gallery's 3:2 from the same file, so the
    vault, the organ and every row of listeners stand in one frame. The alt is the gallery frame's. */
const CHURCH = "kd-stworzenie-listeners";
const CHURCH_GALLERY = "kd-stworzenie-11";
/** The director of POLMIC, who introduced the concert, and the festival's organiser: a close
    portrait cut from each gallery frame for the print, the gallery frame itself for the lightbox,
    and the gallery's caption, `Name, function`, set as two lines. */
const HOSTS = [
  { print: "kd-stworzenie-38-portrait", gallery: "kd-stworzenie-38" },
  { print: "kd-stworzenie-39-portrait", gallery: "kd-stworzenie-39" },
] as const;
/** The ensemble on the church steps afterwards: the gallery's own frame, as it hangs there. */
const AFTER = "kd-stworzenie-17";
/** The programme item whose text is the Canticle. */
const CANTICLE_WORK = "Laudes creaturarum";
/** The empty staff's lines. Four is the chant staff of the manuscript's age, assumed, not yet read
    off cod. 338 itself; the list's letter draws five. */
const STAFF_LINES = [0, 1, 2, 3];

/** Holds the separator to the name before it. Built from its code point, as `lib/typo` builds its own. */
const NBSP = String.fromCharCode(0xa0);

const lang = "pl";
const ui = UI[lang];
const copy = PODZIEKOWANIE;
const letter = copy.letter;

const entry = await getEntry("concerts", INVITATION_CONCERT_ID);
if (!entry) throw new Error(`[podziekowanie] No concert "${INVITATION_CONCERT_ID}" in the corpus.`);
const concert = entry.data;
const { date } = concert;
if (!date) throw new Error(`[podziekowanie] "${INVITATION_CONCERT_ID}" needs the date it was sung on.`);
const city = concert.venue?.split(",").at(-1)?.trim();
const concertPath = `/koncerty/${INVITATION_CONCERT_ID}`;

/* A gallery frame's alt and caption are the gallery's, so the frame is described in one place. */
const galleryAlt = (img: string): string => {
  const alt = concert.gallery.find((shot) => shot.img === img)?.alt;
  if (!alt) throw new Error(`[podziekowanie] "${img}" has no alt in the gallery of "${INVITATION_CONCERT_ID}".`);
  return alt;
};

/* The Canticle's first verse, the one the manuscript rules its empty lines over, and its gloss:
   the first line of each, without the comma the verse runs on with. */
const firstLine = (text: string | undefined): string | undefined =>
  text?.split("\n")[0]?.trim().replace(/[,;:]$/, "") || undefined;
const canticleItem = concert.program.find((item) => item.work === CANTICLE_WORK);
const incipit = firstLine(canticleItem?.text);
const incipitGloss = firstLine(canticleItem?.textGloss?.pl);
if (!incipit) throw new Error(`[podziekowanie] "${INVITATION_CONCERT_ID}" has no text for "${CANTICLE_WORK}".`);

/* The list's shared voice, already in "Ty": the promise, the receipt, the clause and the errors. */
const notice = pageCopy(KONCERTY_PAGE, lang).notice;
const nuntius = NUNTIUS[lang];
const noticeChrome = {
  ...nuntius.form,
  consentHtml: chromeHtmlForIsland(nuntius.form.consentHtml, lang),
};
const noticeCopy = {
  sentTitle: notice.sentTitle,
  sentBody: notice.sentBody,
  sentHint: notice.sentHint,
};

/* The recording, and the candle its bar burns at the foot of the viewport. */
const hero = bleedPair(concert.heroImg ?? concert.bg);
const excerpts = await concertExcerpts(entry, lang, hero.desktop);
const candle = candleFrom(concert.accent);

/* A link pasted into a message shows the church full of listeners, in the gallery's landscape cut:
   a preview card crops to landscape, and the tall cut would lose the pews to it. */
const ogFrame = photoOptional(CHURCH_GALLERY);
const ogImage = (await getImage({ src: ogFrame ?? hero.desktop, width: 1200, format: "webp" })).src;

/* Four frames read in order: the pair (before, during) side by side, then the listeners seen from
   the altar at the pair's 4:5 and the ensemble afterwards at 3:2, each across the grid, so a
   missing file never leaves a column empty. The grid is 720px, inside the sheet's gutter
   (max(28px, 5vw)) below 800px. Each frame opens the lightbox with the whole photograph, and the
   hosts' prints on the back page join the same set, with an exit to the concert's gallery. */
const PORTRAIT_ASPECT = 4 / 5;
const WIDE_ASPECT = 3 / 2;
const COLUMN_SIZES = "(min-width: 800px) 354px, (min-width: 600px) calc(45vw - 6px), calc(50vw - 32px)";
const ACROSS_SIZES = "(min-width: 800px) 720px, (min-width: 560px) 90vw, calc(100vw - 56px)";
const frame = async (img: ImageMetadata, across: boolean, aspect: number, alt: string) => ({
  thumb: await croppedShot(img, { aspect, widths: across ? [540, 720, 1080, 1440] : [360, 540, 720] }),
  full: await framedShot(img),
  sizes: across ? ACROSS_SIZES : COLUMN_SIZES,
  alt,
  across,
});
const rehearsalImg = photoOptional(PAIR_REHEARSAL);
const concertImg = photoOptional(PAIR_CONCERT);
const churchImg = photoOptional(CHURCH);
const afterImg = photoOptional(AFTER);
const shots = [
  ...(rehearsalImg && concertImg
    ? await Promise.all([
        frame(rehearsalImg, false, PORTRAIT_ASPECT, copy.photos.rehearsalAlt),
        frame(concertImg, false, PORTRAIT_ASPECT, copy.photos.concertAlt),
      ])
    : []),
  ...(churchImg ? [await frame(churchImg, true, PORTRAIT_ASPECT, galleryAlt(CHURCH_GALLERY))] : []),
  ...(afterImg ? [await frame(afterImg, true, WIDE_ASPECT, galleryAlt(AFTER))] : []),
];

/* The hosts the acknowledgements open on, two prints side by side in a block of at most 400px
   (the thanks column is 378–388px wide beside the cast, the sheet's measure under it). The
   gallery's caption reads `Name, function`, so its first comma is where the second line starts. */
const HOST_SIZES = "(min-width: 460px) 194px, calc(50vw - 34px)";
const hostPrint = async ({ print, gallery }: (typeof HOSTS)[number]) => {
  const printImg = photoOptional(print);
  const galleryImg = photoOptional(gallery);
  if (!printImg || !galleryImg) return undefined;
  const caption = concert.gallery.find((shot) => shot.img === gallery)?.caption ?? "";
  const seam = caption.indexOf(", ");
  if (seam < 1) {
    throw new Error(`[podziekowanie] "${gallery}" needs a caption "Name, function" in the gallery of "${INVITATION_CONCERT_ID}".`);
  }
  return {
    thumb: await croppedShot(printImg, { aspect: PORTRAIT_ASPECT, widths: [200, 300, 400] }),
    full: await framedShot(galleryImg),
    alt: galleryAlt(gallery),
    caption,
    name: caption.slice(0, seam),
    role: caption.slice(seam + 2),
  };
};
const hostPrints = await Promise.all(HOSTS.map(hostPrint));
const hosts = hostPrints.every((host): host is NonNullable<typeof host> => host !== undefined) ? hostPrints : [];

/* The cast in the order a programme's back page sets it: the voices, the instruments, the music
   assistant who prepared the ensemble, and the conductor last. The last two are matched in
   `credits` on their Polish roles, as the concert page matches the conductor. */
const rosterGroups = concert.roster?.groups ?? [];
const assistant = concert.credits.find((credit) => /asystent/i.test(credit.role));
const conductor = concert.credits.find((credit) => /dyrygent/i.test(credit.role));
const cast = [
  ...rosterGroups.filter((group) => !group.instrument).map((group) => ({ ...group, conductor: false })),
  ...rosterGroups.filter((group) => group.instrument).map((group) => ({ ...group, conductor: false })),
  ...(assistant ? [{ voice: assistant.role, names: [assistant.name], conductor: false }] : []),
  ...(conductor ? [{ voice: conductor.role, names: [conductor.name], conductor: true }] : []),
];

/* The invitation's artwork, optional like every photograph. */
const art = async (name: string, width: number) => {
  const src = photoOptional(name);
  return src ? getImage({ src, width: Math.min(width, src.width), format: "webp" }) : undefined;
};
const [light, handLeft, handRight, cloudLeft, cloudRight] = await Promise.all([
  art("zaproszenie-light", 1200),
  art("zaproszenie-hand-left", 1200),
  art("zaproszenie-hand-right", 1200),
  art("zaproszenie-cloud-left", 860),
  art("zaproszenie-cloud-right", 920),
]);
const hasHands = Boolean(handLeft && handRight);
---

<BaseLayout
  title={copy.meta.title}
  description={copy.meta.description}
  path="/podziekowanie"
  image={ogImage}
  bodyClass="page-invitation page-podziekowanie"
  lang={lang}
>
  <Fragment slot="head">
    <meta name="robots" content="noindex,follow" />
    {/* Without JavaScript the island's server-rendered form cannot send; the address replaces it. */}
    <noscript><style is:inline>.inv-notice .notice-form { display: none; }</style></noscript>
  </Fragment>

  <a class="skip-link" href="#tresc">{ui.skipToContent}</a>
  <SiteChrome current="/podziekowanie" ground="paper" lang={lang} />

  <main id="tresc" class="inv-sheet pdz">
    <div class="inv-sky" aria-hidden="true">
      {cloudLeft && (
        <img class="inv-cloud inv-cloud-left reveal-cue" src={cloudLeft.src} width={cloudLeft.attributes.width} height={cloudLeft.attributes.height} alt="" loading="lazy" decoding="async" />
      )}
      {cloudRight && (
        <img class="inv-cloud inv-cloud-right reveal-cue" src={cloudRight.src} width={cloudRight.attributes.width} height={cloudRight.attributes.height} alt="" loading="lazy" decoding="async" />
      )}
    </div>

    {/* ── The cover ── */}
    <header class="pdz-cover" data-entrance="waiting">
      <div class="pdz-touch" role={hasHands ? "img" : undefined} aria-label={hasHands ? ZAPROSZENIE.cover.hands : undefined} aria-hidden={hasHands ? undefined : "true"}>
        <span class="pdz-glow" aria-hidden="true">
          <span class="inv-light">
            {light && <img src={light.src} width={light.attributes.width} height={light.attributes.height} alt="" decoding="async" fetchpriority="high" />}
          </span>
        </span>
        {hasHands && handLeft && (
          <img class="pdz-hand pdz-hand-left" src={handLeft.src} width={handLeft.attributes.width} height={handLeft.attributes.height} alt="" decoding="async" fetchpriority="high" />
        )}
        {hasHands && handRight && (
          <img class="pdz-hand pdz-hand-right" src={handRight.src} width={handRight.attributes.width} height={handRight.attributes.height} alt="" decoding="async" fetchpriority="high" />
        )}
      </div>
      <h1 class="pdz-title">{concert.title}</h1>
      <p class="pdz-cover-line">{copy.cover.line}</p>
      <p class="pdz-cover-moment">
        <time datetime={date}>{longDate(date, lang)}</time>
        {city && <><span aria-hidden="true"> · </span><span>{city}</span></>}
      </p>
    </header>

    {/* ── The Canticle: the fact, the empty lines over its first verse, the music written in ── */}
    <div class="pdz-canticle">
      <p class="pdz-text reveal">{letter.lede}</p>
      <figure class="pdz-folio reveal-cue">
        <span class="pdz-staff" aria-hidden="true">
          {STAFF_LINES.map((line) => <span class="pdz-staff-line" style={`--line: ${line}`} />)}
        </span>
        <blockquote class="pdz-incipit" lang="it"><p>{incipit}</p></blockquote>
        {incipitGloss && <figcaption class="pdz-incipit-gloss">{incipitGloss}</figcaption>}
      </figure>
      <p class="pdz-text reveal">{letter.sung}</p>
      {/* A control, so no register: it stands at full ink. */}
      {excerpts && (
        <div class="pdz-listen">
          <ExcerptsGlyph excerpts={excerpts} labels={copy.listen} lang={lang} candle={candle} title={concert.title} />
        </div>
      )}
    </div>

    {/* ── The thanks, and the donors in the frame a programme prints its patrons in ── */}
    <div class="pdz-thanks">
      <p class="pdz-text reveal">{letter.thanks}</p>
    </div>
    <div class="pdz-patrons reveal">
      <p class="pdz-text">{letter.donors}</p>
      <p class="pdz-give">
        <a class="inv-act pdz-act" href="/#wesprzyj" data-vault-open="100"><span>{copy.give.act}</span></a>
      </p>
    </div>

    {/* ── Four photographs, and the door to the rest ── */}
    {(shots.length > 0 || concert.hasPage) && (
      <section class="pdz-photos" aria-label={copy.photos.aria}>
        {shots.length > 0 && (
          <div class="pdz-frames reveal">
            {shots.map((shot) => (
              <figure class:list={["pdz-shot", { "pdz-shot-across": shot.across }]}>
                <button
                  type="button"
                  class="shot-open"
                  data-image-open
                  data-image-group="pdz-photos"
                  data-image-src={shot.full.src}
                  data-image-srcset={shot.full.srcset}
                  data-image-sizes={shot.full.sizes}
                  data-image-alt={shot.alt}
                  data-image-w={String(shot.full.width)}
                  data-image-h={String(shot.full.height)}
                  data-image-href={concert.hasPage ? `${concertPath}#obrazy` : undefined}
                  data-image-href-label={concert.hasPage ? copy.photos.gallery : undefined}
                >
                  <img class="pdz-photo" src={shot.thumb.src} srcset={shot.thumb.srcset} sizes={shot.sizes} width={shot.thumb.width} height={shot.thumb.height} alt={shot.alt} loading="lazy" decoding="async" />
                </button>
              </figure>
            ))}
          </div>
        )}
        {concert.hasPage && (
          <p class="pdz-gallery reveal">
            <a class="inv-door" href={`${concertPath}#obrazy`}>{copy.photos.gallery}<span class="pdz-door-arrow" aria-hidden="true">→</span></a>
          </p>
        )}
      </section>
    )}

    {/* ── The list, straight after the photographs ── */}
    <section class="inv-ask pdz-ask" aria-labelledby="pdz-ask-heading">
      <h2 id="pdz-ask-heading" class="inv-rubric inv-ask-rubric reveal">{copy.ask.rubric}</h2>
      <p class="inv-say reveal" data-d="1">
        <span class="inv-say-invitation">{copy.ask.invitation}</span>
        <span class="inv-say-promise">{notice.lede}</span>
      </p>
      <div class="inv-slot reveal" data-d="2">
        <div class="inv-card inv-notice notice-inner">
          <NoticeForm
            client:visible
            lang={lang}
            chrome={noticeChrome}
            copy={noticeCopy}
            surface="web:podziekowanie"
            placement="band"
            showAddressCorrection
          />
          <noscript>
            <p class="inv-noscript">
              {copy.ask.noscript}{" "}
              <a href={`mailto:${copy.ask.contactEmail}`}>{copy.ask.contactEmail}</a>
            </p>
          </noscript>
        </div>
      </div>
    </section>

    {/* ── The programme's back page: who sang and played, and whom the ensemble thanks ── */}
    <div class="pdz-back">
      {cast.length > 0 && (
        <section class="pdz-back-page" aria-labelledby="pdz-cast-heading">
          <h2 id="pdz-cast-heading" class="inv-rubric pdz-rubric reveal">{copy.cast.rubric}</h2>
          <dl class="pdz-roll">
            {cast.map((group) => (
              <div class:list={["pdz-roll-entry", "reveal", { "pdz-roll-conductor": group.conductor }]} data-d="1">
                <dt class="pdz-roll-label">{group.voice}</dt>
                <dd class="pdz-roll-names">
                  {/* The spaces stay outside the hidden dot, so a screen reader still hears two names. */}
                  {group.names.map((name, index) => (
                    <>{index > 0 && <>{NBSP}<span class="pdz-roll-dot" aria-hidden="true">·</span>{" "}</>}<span class="pdz-roll-name">{name}</span></>
                  ))}
                </dd>
              </div>
            ))}
          </dl>
        </section>
      )}
      <section class="pdz-back-page" aria-labelledby="pdz-partners-heading">
        <h2 id="pdz-partners-heading" class="inv-rubric pdz-rubric reveal">{copy.partners.rubric}</h2>
        {hosts.length > 0 && (
          <div class="pdz-hosts reveal" data-d="1">
            {hosts.map((host) => (
              <figure class="pdz-host">
                <button
                  type="button"
                  class="shot-open"
                  data-image-open
                  data-image-group="pdz-photos"
                  data-image-src={host.full.src}
                  data-image-srcset={host.full.srcset}
                  data-image-sizes={host.full.sizes}
                  data-image-alt={host.alt}
                  data-image-caption={host.caption}
                  data-image-w={String(host.full.width)}
                  data-image-h={String(host.full.height)}
                  data-image-href={concert.hasPage ? `${concertPath}#obrazy` : undefined}
                  data-image-href-label={concert.hasPage ? copy.photos.gallery : undefined}
                >
                  <img class="pdz-photo" src={host.thumb.src} srcset={host.thumb.srcset} sizes={HOST_SIZES} width={host.thumb.width} height={host.thumb.height} alt={host.alt} loading="lazy" decoding="async" />
                </button>
                <figcaption class="pdz-host-caption">
                  <span class="pdz-host-name">{host.name}</span>
                  <span class="pdz-host-role">{host.role}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        )}
        {/* `role="list"`: Safari drops a list's semantics once its markers are styled away. */}
        <ul class="pdz-roll" role="list">
          {copy.partners.list.map((partner) => (
            <li class="pdz-roll-entry reveal" data-d="2">
              <span class="pdz-credit-who">{partner.who}</span>
              <span class="pdz-credit-for">
                {partner.for}
                {partner.link && (
                  <>{" "}<a class="inv-link" href={partner.link.href} target="_blank" rel="noopener noreferrer">{partner.link.text}<span class="inv-out" aria-hidden="true">↗</span></a></>
                )}
              </span>
            </li>
          ))}
        </ul>
      </section>
    </div>

    {/* ── The way to the concert page, and the signature ── */}
    <div class="pdz-close">
      <p class="pdz-text reveal">
        {letter.more.before}<a class="inv-link" href={concertPath}>{letter.more.link}</a>{letter.more.after}
      </p>
      <p class="pdz-sign reveal" data-d="1">{letter.signature}</p>
    </div>
  </main>

  <SiteFooter lang={lang} variant="invitation" />

  <VaultMount lang={lang} />
  <ImageLightbox client:idle />
</BaseLayout>

<script>
  import "../../scripts/vault-triggers.ts";
  import "../../scripts/image-triggers.ts";
  import { setupThanks } from "../../scripts/podziekowanie";

  let dispose: (() => void) | undefined;
  document.addEventListener("astro:page-load", () => {
    dispose?.();
    dispose = setupThanks();
  });
  document.addEventListener("astro:before-swap", () => {
    dispose?.();
    dispose = undefined;
  });
</script>
