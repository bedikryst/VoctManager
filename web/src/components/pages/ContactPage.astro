---
/**
 * @file ContactPage.astro
 * @description Locale-agnostic body of the contact page. It owns all the structure, styles and
 *  JSON-LD; every word comes from the copy desk — the prose from `src/content/pages/kontakt.yaml`
 *  through `lib/pageCopy` (translations substituted per field from the overlay), the chrome from
 *  `i18n/content/kontakt.ts`. The three route files (/kontakt, /en/kontakt, /fr/kontakt) are
 *  one-liners that differ only in `lang`.
 *
 *  THE PAGE FRAMES ITSELF AS AN INVITATION — every past station of the Via began with someone's,
 *  and the next can too — so it reads as where future concerts start, not a generic "write to us"
 *  form. Three prioritised email channels rendered as a semantic <dl>, each with a
 *  subject-prefilled mailto and a copy-to-clipboard button (a bare mailto is a real desktop failure
 *  when no mail client is configured). Then an honest "three voices" signature: the foundation
 *  board answers together, so the three people are named instead of faking a per-channel owner.
 *  Then ONE paper-soft band carrying all the administrative weight — foundation, a mail-only
 *  correspondence address (no map, nobody works there), and the data-controller note — so nothing
 *  floats as small print in a void, and a quiet coda closes. No contact form (RODO — channels only).
 *
 *  The registry identifiers and the postal address are NOT copy and stay in this markup: they are
 *  the same legal facts the JSON-LD carries, and they read identically in every language.
 * @architecture Astro islands 2026
 * @module components/pages/ContactPage
 */
import { getImage } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteChrome from "../SiteChrome.astro";
import SiteFooter from "../SiteFooter.astro";
import BleedImage from "../BleedImage.astro";
import { bleedPair } from "../../lib/photos";
import { pageCopy } from "../../lib/pageCopy";
import { CONTACT_CHROME, KONTAKT_PAGE } from "../../i18n/content/kontakt";
import { UI } from "../../i18n/ui";
import { localizePath, pageI18n, SITE, type Locale } from "../../i18n/config";
import { VaultIsland } from "../../islands/landing/VaultIsland";
import "../../styles/vault.css";

interface Props {
  /** Which language this render is. Drives the copy, the chrome, the URL and the hreflang graph. */
  lang: Locale;
}
const { lang } = Astro.props;

const copy = pageCopy(KONTAKT_PAGE, lang);
const t = CONTACT_CHROME[lang];
// One base path → this render's own URL, its hreflang graph, and the locales the switcher offers.
const { path, alternates, available } = pageI18n("/kontakt", lang);
const hrefFoundation = `${localizePath("/o-nas", lang)}#fundacja`;
const hrefConcerts = localizePath("/koncerty", lang);

const hero = bleedPair("kontakt-hero");

// schema.org's own vocabulary for what each channel is FOR — a fixed term per channel, not copy,
// so it is keyed off the channel id rather than its translatable role line. A channel added
// without a term here still emits a contact point, as the least wrong of the answers available.
const CONTACT_TYPE: Readonly<Record<string, string>> = {
  booking: "bookings",
  patronat: "sponsorship",
  ogolne: "general inquiries",
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: copy.meta.title,
  url: `${SITE}${path}`,
  inLanguage: lang,
  about: {
    "@type": "Organization",
    name: "Fundacja VoctFoundation",
    alternateName: "VoctEnsemble",
    url: SITE,
    email: "kontakt@voctensemble.com",
    address: {
      "@type": "PostalAddress",
      streetAddress: "ul. Św. Filipa 23/3",
      postalCode: "31-150",
      addressLocality: "Kraków",
      addressCountry: "PL",
    },
    contactPoint: copy.channels.items.map((channel) => ({
      "@type": "ContactPoint",
      email: channel.email,
      contactType: CONTACT_TYPE[channel.id] ?? "general inquiries",
      availableLanguage: ["Polish", "English", "French"],
    })),
    sameAs: [
      "https://www.instagram.com/voctensemble/",
      "https://www.facebook.com/voctensemble/",
      "https://www.youtube.com/@VoctEnsemble-nb7gh",
    ],
  },
};

// Build-time optimized share image derived from the hero original.
const ogImage = (await getImage({ src: hero.desktop, width: 1200, format: "webp" })).src;
---

<BaseLayout
  title={copy.meta.title}
  description={copy.meta.description}
  path={path}
  image={ogImage}
  bodyClass="page-kontakt"
  lang={lang}
  alternates={alternates}
  breadcrumb={[{ name: UI[lang].nav.contact, path }]}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <a class="skip-link" href="#tresc">{UI[lang].skipToContent}</a>
  <SiteChrome current="/kontakt" lang={lang} availableLocales={available} />

  <main id="tresc">
    {/* ── Hero ─────────────────────────────────────────────────────────── */}
    <section class="hero" aria-label={t.heroAria}>
      <div class="hero-media" aria-hidden="true">
        <BleedImage desktop={hero.desktop} mobile={hero.mobile} alt="" position="center 40%" eager animate />
      </div>
      <div class="hero-inner">
        <p class="eyebrow reveal">
          <span class="lat">Scribe nobis</span>{"  ·  "}{copy.hero.eyebrow}
        </p>
        <h1>
          <span class="line"><span class="reveal ink-press">{copy.hero.title1}</span></span>
          <span class="line"><span class="reveal ink-press" data-d="1" set:html={copy.hero.title2Html} /></span>
        </h1>
        <p class="hero-lede reveal" data-d="2">{copy.hero.lede}</p>
        <span class="scroll-cue reveal" data-d="3">{copy.hero.scrollCue}</span>
      </div>
    </section>

    {/* ── Channels — the page's altar ──────────────────────────────────── */}
    <section class="channels-section" aria-label={t.channelsAria}>
      <div class="channels-wrap">
        <div class="col-head reveal">
          <span class="eyebrow"><span class="lat">Tres ianuae</span>  ·  {copy.channels.eyebrow}</span>
          <h2 class="ink-press">{copy.channels.h2}</h2>
        </div>
        <p class="contact-intro reveal" data-d="1" set:html={copy.channels.introHtml} />

        <dl class="channels">
          {
            copy.channels.items.map((c, i) => (
              <div class="channel reveal" data-d={String((i % 3) + 1)}>
                <dt class="channel-role">{c.role}</dt>
                <dd class="channel-body">
                  <p class="channel-line">
                    <a class="channel-mail" href={`mailto:${c.email}?subject=${encodeURIComponent(c.subject)}`}>
                      {c.email}
                    </a>
                    <button
                      class="channel-copy"
                      type="button"
                      data-copy={c.email}
                      data-copied={t.copied}
                      aria-label={t.copyAria.replace("{email}", c.email)}
                    >
                      <span class="copy-label">{t.copy}</span>
                    </button>
                  </p>
                  <p class="channel-hint">{c.hint}</p>
                </dd>
              </div>
            ))
          }
        </dl>

        <div class="after-channels reveal">
          <p>{copy.after.languages}</p>
          <p set:html={copy.after.pressHtml} />
        </div>

        <div class="voices reveal">
          <span class="voices-label">{copy.voices.label}</span>
          <p class="voices-names">
            {copy.voices.names.map((v, i) => (
              <>
                {i > 0 && <span class="voices-dot" aria-hidden="true"> · </span>}
                {v}
              </>
            ))}
          </p>
          <p class="voices-note">{copy.voices.note}</p>
        </div>
      </div>
    </section>

    {/* ── Foundation, correspondence address & data-controller — all the administrative
          weight in ONE paper-soft band so the page never floats small print in a void.
          No map, no "come find us": the seat is a mailing address, nobody works there. ── */}
    <section class="locus" aria-label={t.locusAria}>
      <div class="locus-wrap">
        <div class="col-head reveal">
          <span class="eyebrow"><span class="lat">Fundatio</span>  ·  {copy.locus.eyebrow}</span>
          <h2 class="ink-press">{copy.locus.h2}</h2>
        </div>
        <div class="locus-grid">
          <div class="aside-block reveal" data-d="1">
            <h3>{copy.locus.foundationLabel}</h3>
            <p class="fund-mission">{copy.locus.mission}</p>
            <p class="fund-more">
              <a class="fund-link" href={hrefFoundation}>{copy.locus.foundationLink}</a>
            </p>
          </div>

          <div class="aside-block reveal" data-d="2">
            <h3>{copy.locus.addressLabel}</h3>
            <p class="addr">
              Fundacja VoctFoundation<br />
              ul. Św.&nbsp;Filipa 23/3<br />
              31-150 Kraków
            </p>
            <p class="addr-note">{copy.locus.addressNote}</p>
          </div>
        </div>

        <div class="locus-legal reveal">
          <p class="rodo-admin">
            <span class="rodo-admin-label">{copy.legal.controllerLabel}</span>
            Fundacja VoctFoundation · KRS 0001237252 · NIP 6762718992 · REGON 544621525
          </p>
          <p class="rodo-note" set:html={copy.legal.rodoHtml} />
        </div>
      </div>
    </section>

    {/* ── Coda — the page wybrzmiewa, nie kończy się drobnym drukiem ────── */}
    <section class="coda" aria-label={t.codaAria}>
      <div class="coda-inner">
        <span class="coda-glyph reveal" aria-hidden="true"></span>
        <h2 class="reveal ink-press" data-d="1">{copy.coda.h2}</h2>
        <p class="reveal" data-d="2">{copy.coda.lede}</p>
        {/* Controls out of the register — see the station actions on /koncerty. */}
        <div class="coda-links">
          <a href={hrefConcerts}>{copy.coda.concertsLink}</a>
          <a href="/?donate" data-vault-open="100">{copy.coda.supportLink}</a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter lang={lang} />

  <VaultIsland client:idle />
  <script>
    import "../../scripts/vault-triggers.ts";

    // Copy-to-clipboard for contact channels. Document-delegated + guarded so it binds once
    // and survives ClientRouter DOM swaps (the buttons only exist on this page; the listener
    // no-ops everywhere else). A bare mailto is a real desktop failure when no mail client is
    // configured — the copy button is the escape hatch. The confirmation is read off the button
    // rather than written here, because this script is shared by three locales.
    if (!(window as unknown as { __voctCopy?: boolean }).__voctCopy) {
      (window as unknown as { __voctCopy?: boolean }).__voctCopy = true;
      document.addEventListener("click", (e) => {
        const target = e.target;
        if (!(target instanceof Element)) return;
        const btn = target.closest<HTMLButtonElement>("[data-copy]");
        if (!btn) return;
        const value = btn.dataset.copy;
        const done = btn.dataset.copied;
        const label = btn.querySelector<HTMLElement>(".copy-label");
        if (!value || !done || !label || !navigator.clipboard) return;
        navigator.clipboard
          .writeText(value)
          .then(() => {
            const prev = label.textContent;
            btn.classList.add("is-copied");
            label.textContent = done;
            window.setTimeout(() => {
              btn.classList.remove("is-copied");
              label.textContent = prev;
            }, 1800);
          })
          .catch(() => {});
      });
    }
  </script>
</BaseLayout>

<style>
  /* Hero */
  .hero { position: relative; min-height: 84svh; display: flex; align-items: flex-end; padding: 0 var(--gutter) clamp(54px, 8vw, 92px); color: var(--paper); overflow: hidden; isolation: isolate; }
  .hero-media { position: absolute; inset: 0; z-index: -2; }
  /* Photo keeps full brightness; text pocket (bottom-left) deepened via the diagonal (see o-nas). */
  .hero::after { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(8,8,7,.48) 0%, rgba(8,8,7,.12) 40%, rgba(8,8,7,.8) 100%), linear-gradient(72deg, rgba(8,8,7,.72) 0%, rgba(8,8,7,.22) 46%, transparent 72%); }
  .hero-inner { max-width: 1180px; width: 100%; margin: 0 auto; padding: 0; }
  .hero h1 { font-family: var(--serif); font-weight: 300; line-height: .98; font-size: clamp(48px, 8.4vw, 116px); letter-spacing: -.01em; margin: 16px 0 0; }
  .hero h1 em { color: var(--candle); }
  .hero-lede { font-family: var(--serif); font-style: italic; font-weight: 300; font-size: clamp(19px, 2.2vw, 28px); line-height: 1.42; max-width: 36ch; margin: 22px 0 0; color: rgba(244, 241, 233, .9); }
  .scroll-cue { margin-top: 34px; font-family: var(--capitalis); font-size: 10px; letter-spacing: .26em; text-transform: uppercase; color: rgba(244,241,233,.62); display: inline-flex; align-items: center; gap: 10px; }
  .scroll-cue::after { content: ""; width: 38px; height: 1px; background: currentColor; opacity: .6; animation: cuepulse 3.4s var(--ease-slow) infinite; }

  /* Shared section head (channels + locus) */
  .col-head { margin: 0; }
  .col-head .eyebrow { display: block; margin-bottom: 16px; }
  .col-head h2 { font-family: var(--serif); font-weight: 300; font-size: clamp(30px, 3.6vw, 48px); line-height: 1.05; color: var(--ink); margin: 0; letter-spacing: -.01em; }

  /* Channels — the altar */
  /* Parchment bands hand the rubric's Latin tier the ink gold: `.lat` is a child and keeps
     matching base.css, whose default is the full candle drawn for night (2.10:1 here). The hero
     is outside both and keeps it. Same call on `.locus` below. */
  .channels-section { padding: clamp(72px, 11vw, 150px) var(--gutter); --lat-ink: var(--candle-ink); }
  .channels-wrap { max-width: 920px; margin: 0 auto; }
  .contact-intro { font-family: var(--serif); font-style: italic; font-weight: 300; font-size: clamp(19px, 2vw, 25px); line-height: 1.5; color: var(--ink-soft); max-width: 40ch; margin: 18px 0 0; }
  .contact-intro em { color: var(--candle-ink); }

  .channels { margin: clamp(40px, 5vw, 64px) 0 0; }
  .channel { display: grid; gap: 12px; padding: clamp(26px, 3.6vw, 40px) 0; border-top: 1px solid var(--line); }
  .channel:last-of-type { border-bottom: 1px solid var(--line); }
  .channel-role { font-family: var(--capitalis); font-size: 10.5px; letter-spacing: .18em; text-transform: uppercase; color: var(--candle-ink); margin: 0; }
  .channel-body { margin: 0; }
  .channel-line { display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px 18px; margin: 0; }
  .channel-mail { font-family: var(--serif); font-size: clamp(22px, 3.2vw, 34px); color: var(--ink); border-bottom: 1px solid transparent; transition: border-color .3s var(--ease); overflow-wrap: anywhere; }
  .channel-mail:hover { border-bottom-color: var(--candle); }
  .channel-copy { display: inline-flex; align-items: center; gap: 6px; align-self: center; font-family: var(--capitalis); font-size: 9.5px; letter-spacing: .16em; text-transform: uppercase; color: var(--ink-muted); background: transparent; border: 1px solid var(--line); border-radius: 999px; padding: 5px 12px; cursor: pointer; transition: color .3s var(--ease), border-color .3s var(--ease); }
  .channel-copy:hover { color: var(--ink); border-color: var(--line-strong); }
  .channel-copy.is-copied { color: var(--sage); border-color: var(--sage); }
  .channel-hint { margin: 12px 0 0; max-width: 56ch; font-size: clamp(14px, 1.1vw, 15.5px); line-height: 1.7; color: var(--ink-muted); }

  /* After channels — languages, rhythm, media pointer */
  .after-channels { margin: clamp(34px, 5vw, 54px) 0 0; display: grid; gap: 16px; }
  .after-channels p { max-width: 62ch; font-size: clamp(14.5px, 1.15vw, 16px); line-height: 1.72; color: var(--ink-soft); }
  .after-channels a { border-bottom: 1px solid var(--line-strong); transition: color .3s var(--ease), border-color .3s var(--ease); }
  .after-channels a:hover { color: var(--candle-blue); border-color: var(--candle-blue); }

  /* Three voices — honest signature */
  .voices { margin: clamp(40px, 5vw, 60px) 0 0; padding-top: clamp(28px, 3.6vw, 40px); border-top: 1px solid var(--line); }
  .voices-label { font-family: var(--capitalis); font-size: 10px; letter-spacing: .22em; text-transform: uppercase; color: var(--ink-muted); }
  .voices-names { margin: 14px 0 0; font-family: var(--serif); font-weight: 300; font-size: clamp(22px, 2.6vw, 30px); line-height: 1.35; color: var(--ink); }
  /* The separator is aria-hidden, but it is the only thing keeping three names from running
     together on one line — it has to be seen, so it takes the ink tier rather than the mark
     exemption. */
  .voices-dot { color: var(--candle-ink); }
  .voices-note { margin: 12px 0 0; max-width: 48ch; font-size: 16px; line-height: 1.72; color: var(--ink-muted); }

  /* Seat & foundation */
  .locus { background: var(--paper-soft); padding: clamp(72px, 11vw, 150px) var(--gutter); --lat-ink: var(--candle-ink); }
  .locus-wrap { max-width: 920px; margin: 0 auto; }
  .locus-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(36px, 5vw, 72px); align-items: start; margin-top: clamp(36px, 5vw, 56px); }
  @media (max-width: 620px) { .locus-grid { grid-template-columns: 1fr; gap: 40px; } }
  .aside-block { margin: 0; }
  .aside-block h3 { font-family: var(--capitalis); font-size: 10px; letter-spacing: .24em; text-transform: uppercase; color: var(--ink-muted); margin: 0 0 16px; font-weight: 400; }
  .addr { font-family: var(--mono); font-size: 13px; line-height: 1.9; letter-spacing: .02em; color: var(--ink-soft); }
  .addr-note { margin: 14px 0 0; font-size: 13.5px; line-height: 1.7; color: var(--ink-muted); max-width: 34ch; }
  .fund-mission { font-size: 16px; line-height: 1.75; color: var(--ink-soft); margin: 0 0 16px; max-width: 42ch; }
  .fund-more { margin: 0; }
  .fund-link { font-family: var(--mono); font-size: 10.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-muted); border-bottom: 1px solid var(--line-strong); padding-bottom: 3px; transition: color .3s var(--ease), border-color .3s var(--ease); }
  .fund-link:hover { color: var(--candle-blue); border-color: var(--candle-blue); }

  /* Administrative fine print — lives inside the locus band, hairline-separated, so it
     reads as the practical tail of one section instead of floating small print on paper. */
  .locus-legal { margin-top: clamp(40px, 5vw, 64px); padding-top: clamp(26px, 3.2vw, 36px); border-top: 1px solid var(--line); }
  .rodo-admin { font-family: var(--mono); font-size: 11px; line-height: 1.85; letter-spacing: .03em; color: var(--ink-muted); margin: 0 0 14px; }
  .rodo-admin-label { display: block; font-size: 9.5px; letter-spacing: .2em; text-transform: uppercase; color: var(--candle-ink); margin-bottom: 6px; }
  .rodo-note { margin: 0; font-family: var(--mono); font-size: 10.5px; line-height: 1.85; letter-spacing: .02em; color: var(--ink-muted); max-width: 78ch; }
  .rodo-note a { border-bottom: 1px solid var(--line); transition: color .3s var(--ease), border-color .3s var(--ease); }
  .rodo-note a:hover { color: var(--ink); border-color: var(--line-strong); }

  /* Coda — the page wybrzmiewa. No divider line: the paper-soft → paper step and the gold
     aura carry the turn, so nothing reads as a stray rule floating in space. */
  .coda { position: relative; padding: clamp(64px, 8vw, 104px) var(--gutter) clamp(84px, 12vw, 150px); text-align: center; overflow: hidden; isolation: isolate; }
  .coda::before { content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none; background: radial-gradient(66% 56% at 50% 30%, color-mix(in srgb, var(--candle) 16%, transparent) 0%, transparent 62%); }
  .coda-inner { max-width: 620px; margin: 0 auto; display: grid; justify-items: center; }
  .coda-glyph { width: 80px; height: 220px; margin-bottom: 46px; background: linear-gradient(165deg, #e6d3a0 0%, #c6a45b 52%, #ad8a44 100%); -webkit-mask: url(/voct-mark.svg) center / contain no-repeat; mask: url(/voct-mark.svg) center / contain no-repeat; opacity: .85; }
  .coda h2 { font-family: var(--serif); font-weight: 300; font-size: clamp(40px, 7vw, 84px); line-height: 1; letter-spacing: -.01em; color: var(--ink); margin: 0; }
  .coda p { margin: 18px 0 0; font-family: var(--serif); font-style: italic; font-weight: 300; font-size: clamp(18px, 2vw, 24px); line-height: 1.45; color: var(--ink-soft); }
  .coda-links { margin: 34px 0 0; display: flex; flex-wrap: wrap; gap: 14px 30px; justify-content: center; }
  .coda-links a { font-family: var(--mono); font-size: 10.5px; letter-spacing: .18em; text-transform: uppercase; color: var(--ink-muted); border-bottom: 1px solid var(--line); padding-bottom: 4px; transition: color .3s var(--ease), border-color .3s var(--ease); }
  .coda-links a:hover { color: var(--candle); border-color: var(--candle); }

  @media (prefers-reduced-motion: reduce) {
    .scroll-cue::after { animation: none; }
  }
  @keyframes cuepulse { 0%, 100% { transform: scaleX(.4); opacity: .3; } 50% { transform: scaleX(1); opacity: .7; } }
</style>
