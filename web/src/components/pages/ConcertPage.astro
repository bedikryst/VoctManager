       each line still starts flush on the measure. */
    .kd-program-meta { flex-basis: 100%; margin-left: -13px; clip-path: inset(0 0 0 13px); }
    .kd-text-cols, .kd-text-cols.is-single { grid-template-columns: 1fr; gap: 18px; }
