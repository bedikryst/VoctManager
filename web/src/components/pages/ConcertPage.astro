---
/**
 * @file ConcertPage.astro
 * @description Locale-agnostic body of a dedicated concert page. The three route files
 *  (/koncerty/[id], /en/koncerty/[id], /fr/koncerty/[id]) hold the `getStaticPaths` their locale
 *  is entitled to and render this component with a different `lang`; everything else lives here.
 *  A page exists only for entries flagged `hasPage: true` in the `concerts` collection — by
 *  design, not every concert deserves one. It exists when the entry carries real depth: a
 *  reflection, a Latin inscriptio, a curated program with per-work source notes and — where
 *  the booklet preserved it — the sung word itself with its gloss.
 *
 *  The page reads like the ensemble's own programme book: a dark full-bleed nave (hero +
 *  reflection), then the visitor "sits down to read the programme" on parchment (the program
 *  with its expandable sung texts), a composer's voice, the voices of the evening (per-evening
 *  roster), documentary photographs, and finally the Via that runs on — prev / next station,
 *  the road that does not dead-end. Each station burns its own candle: `--candle` inside
 *  <main> is re-toned from the concert `accent` (lib/candle), while the chrome keeps gold.
 *
 *  WHERE EVERY WORD COMES FROM, and the distinction the whole file rests on:
 *
 *  - What the CONCERT says is Polish in `concerts.yaml` and translated in the copy desk's
 *    per-locale overlay (`concerts.en.yaml` / `concerts.fr.yaml`). It is read through `say()`
 *    below and NEVER through `pickLocale`: since stage C3 the corpus is Polish-only, so a
 *    `LocalizedText` in it carries `pl` alone and `pickLocale` would hand back Polish in every
 *    locale — silently, on a page that looked translated. Fallback is per FIELD, so a
 *    half-translated evening still builds and prints Polish only where the translation is
 *    missing.
 *  - What the PAGE says (band labels, affordances, aria names, the two default sentences) is
 *    chrome and lives in `i18n/content/koncert.ts`.
 *  - Latin rubrics, work titles, composers, singers, venues and dates are none of the above:
 *    names and structure, printed unchanged or formatted per locale (lib/dates).
 * @architecture Astro islands 2026
 * @module components/pages/ConcertPage
 */
import type { ImageMetadata } from "astro";
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import { getImage, Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteChrome from "../SiteChrome.astro";
import SiteFooter from "../SiteFooter.astro";
import BleedImage from "../BleedImage.astro";
import { bleedPair, photoOptional } from "../../lib/photos";
import { layoutShots } from "../../lib/galleryLayout";
import { galleryRuns } from "../../lib/galleryRuns";
import { creditSentence, frameCredit } from "../../lib/photoCredit";
import { framedShot } from "../../lib/galleryFrame";
import { candleFrom, candleInkFrom } from "../../lib/candle";
import { concertKey, withOverlay } from "../../lib/copyOverlay";
import type { TabulaEntry } from "../../lib/tabula";
import { absolute, musicEvent } from "../../lib/eventSchema";
import { videoAsset, videoAssetAv1 } from "../../lib/videos";
import { longDate } from "../../lib/dates";
import { formatRef } from "../../lib/scriptureRef";
import { CONCERT, fill } from "../../i18n/content/koncert";
import { UI } from "../../i18n/ui";
import { glossFor, localizePath, pageI18n, type Locale } from "../../i18n/config";
import { VaultIsland } from "../../islands/landing/VaultIsland";
import { ImageLightbox } from "../../islands/landing/ImageLightbox";
import { VideoPlayer } from "../../islands/landing/video/VideoPlayer";
import "../../styles/vault.css";
import "../../styles/vplayer.css";
import "../../styles/image-lightbox.css";

interface Props {
  /** Which language this render is. Drives the copy, the chrome, the URL and the hreflang graph. */
  lang: Locale;
  /** The concert this page is about, handed down by the route's own `getStaticPaths`. */
  entry: CollectionEntry<"concerts">;
}
const { lang, entry } = Astro.props;
const c = entry.data;
const ui = CONCERT[lang];

// This page's own URL, its hreflang graph and the locales it exists in — all from ONE base path,
// which is also what the chrome compares `current` against and what the language switcher
// localizes. A concert enters the graph only once its id is in `TRANSLATED_ROUTES`, and the two
// foreign routes below generate exactly the same set, so a page and the links to it appear
// together (i18n/config states the contract).
const basePath = `/koncerty/${entry.id}`;
const { path, alternates, available } = pageI18n(basePath, lang);

/**
 * What this render prints for one of the concert's copy fields: the overlay's translation where
 * one exists, the corpus's Polish otherwise. Every word the CONCERT says goes through here — the
 * plain scalars and the `pl` of the locale maps alike, since both are addressed by the same desk
 * key (copydesk/contract.mjs is the table that decides which text is copy and what it is called).
 */
const say = (field: string, polish: string): string =>
  withOverlay(concertKey(entry.id, field), lang, polish);
/** The same, for a field a concert may simply not have. */
const sayIf = (field: string, polish: string | undefined): string | undefined =>
  polish === undefined ? undefined : say(field, polish);

// The dateline is composed, never stored: the place is copy held per locale, the moment is either
// the ISO `date` formatted for this locale or the vague `dateLabel` (a season, a bare year) —
// which is copy too, so it comes through the overlay like everything else.
const metaPlace = say("metaPlace", c.metaPlace.pl);
const metaDate = c.date
  ? longDate(c.date, lang)
  : c.dateLabel && say("dateLabel", c.dateLabel.pl);
const heroMeta = [metaPlace, metaDate].filter(Boolean).join(" · ");
const heroTime = c.time ? [ui.hero.timePrefix, c.time].filter(Boolean).join(" ") : "";
// The evening's motto: a Latin verse (printed unchanged), its vernacular, and the citation that
// cites the verse. The gloss does two jobs in one slot — the Latin's vernacular where there IS an
// `inscriptio`, a standalone editorial note where there is not — and both are copy either way.
const inscriptioGloss = sayIf("inscriptioGloss", c.inscriptioGloss?.pl);
const inscriptioRefText = c.inscriptioRef
  ? formatRef(c.inscriptioRef, lang, sayIf("inscriptioRef.source", c.inscriptioRef.source?.pl))
  : undefined;
// The hero takes the station's canonical photograph (`heroImg`) — the same file /o-nas shows
// as the milestone — rather than a second byte-identical copy under the `st-*-bg-desktop`
// name. `bg` stays what it is: the pre-blurred card wash for /koncerty.
const bg = bleedPair(c.heroImg ?? c.bg);
const ogImage = (await getImage({ src: bg.desktop, width: 1200, format: "webp" })).src;

// ── The station's own light: `--candle` inside <main> takes the concert accent's hue at
// the base gold's OKLCH lightness (build-time hex — no runtime CSS feature risk). Gold
// accents pass through unchanged; the chrome and vault outside <main> keep brand gold.
//
// `--candle-ink` is the same hue at a luminance small text can be read at, and it is needed
// here for a reason particular to this page: two of its bands are parchment, and full candle
// is 2.10 : 1 on parchment however the hue is tinted. Which of the two a rule takes is decided
// by ROLE, not by band — `--candle` keeps the hairlines, marks and display gold, `--candle-ink`
// carries every gold string small enough to have to be read.
const candle = candleFrom(c.accent);
const candleInk = candleInkFrom(c.accent);

// ── Via neighbours: only page-bearing concerts (a non-page neighbour would 404). The road
// runs THROUGH the detail pages — a walk, not a set of dead-ends. Skips a slot when there
// is no page-bearing neighbour on that side.
const ordered = (await getCollection("concerts")).sort((a, b) => a.data.order - b.data.order);
const walk = ordered.filter((e) => e.data.hasPage);
const here = walk.findIndex((e) => e.id === entry.id);
const prev = here > 0 ? walk[here - 1] : null;
const next = here >= 0 && here < walk.length - 1 ? walk[here + 1] : null;
/** A neighbour's name in this locale. It is keyed by ITS OWN id, which is why it cannot go
    through `say` — that helper is bound to the concert this page is about. */
const neighbourTitle = (e: CollectionEntry<"concerts">): string =>
  withOverlay(concertKey(e.id, "title"), lang, e.data.title);

// ── Poster + documentary gallery. photoOptional so a slot can be declared in YAML before its
// image lands on disk — a missing file is silently skipped rather than breaking the build.
const posterImg = c.poster ? photoOptional(c.poster) : undefined;
const gallery: {
  img: ImageMetadata;
  alt: string;
  caption?: string | undefined;
  credit?: string | undefined;
  source?: string | undefined;
  moment: "rehearsal" | "concert";
  venue?: string | undefined;
  date?: string | undefined;
  ar: number;
}[] = [];
for (const g of c.gallery) {
  const img = photoOptional(g.img);
  // Alt text is COPY — 621 words of it across the corpus — and the desk keys it by the image's
  // own name, which is why the gallery is the one list here whose key is not a position. Leaving
  // it Polish on a foreign page is an accessibility regression, not a cosmetic one.
  if (img)
    gallery.push({
      ...g,
      img,
      alt: g.alt ? say(`gallery.${g.img}.alt`, g.alt) : "",
      caption: sayIf(`gallery.${g.img}.caption`, g.caption),
      ar: Number((img.width / img.height).toFixed(4)),
    });
}

// The gallery is cut into RUNS — the rehearsal, the night, and one per city on the tour — and the
// run's place and date are printed at its head instead of under every frame. Fifteen frames from
// three churches used to carry fifteen captions naming three churches; see lib/galleryRuns.
//
// The head appears only where there is more than one run: a single-run gallery would be printing
// the page's own `meta` back at a reader who read it in the hero two screens up.
//
// Each run hangs by row HEIGHT, not by a column count — the packing lives in lib/galleryLayout so
// the collective archive and this page stay one geometry. Defaults there are this page's measure
// (.kd-wrap 1180, the gap's clamp ceiling, the 640 height cap).
const runs = await Promise.all(
  galleryRuns(gallery, { venue: c.venue, date: c.date }, lang).map(async (run) => ({
    ...run,
    shots: await Promise.all(
      layoutShots(run.shots).map(async (g) => ({ ...g, frame: await framedShot(g.img) })),
    ),
  })),
);
const showRunHeads = runs.length > 1;

// Where the evening's photographs came from, gathered once for the gallery's foot. Order of first
// appearance, deduplicated: a colophon names each hand once, however many frames it took. The
// ensemble's own archive stands in the list wherever a frame names nobody, so a page whose gallery
// is entirely its own still says where the photographs come from.
const galleryCredits = creditSentence(
  [...new Set(gallery.map((g) => g.credit).filter(Boolean))] as string[],
  [...new Set(gallery.map((g) => g.source).filter(Boolean))] as string[],
  gallery.some((g) => !g.credit && !g.source),
  lang,
  "colophon",
);

const hasTour = c.dates.length > 0;

// ── Credits: the ROLE is copy and the NAME never is (glossary §1). Keyed by position, which is
// stable under append — the contract's own rule, and the reason a role that looks like a natural
// key is not used as one: it is the very value being translated.
const credits = c.credits.map((cr, i) => ({
  role: say(`credits.${i}.role`, cr.role),
  name: cr.name,
}));
// ── The conductor stood that evening too: every roster (Voces) closes with the conductor,
// pulled from the credits so no YAML entry has to repeat him. Program-header obsada keeps
// its own line — a programme book names the conductor in both places. Matched on the POLISH
// role, because the corpus is Polish and the translated list is a projection of it.
const conductorAt = c.credits.findIndex((cr) => /dyrygent/i.test(cr.role));
const conductorCredit = conductorAt >= 0 ? credits[conductorAt] : undefined;
// A page carries the sung word when any work — or any clasp, since in 9 Kart the psalm itself
// lives in the returns rather than in the work rows — prints its text. The provenance line hangs
// off this, so a clasp-only page must still own up to where its texts come from.
const hasText = c.program.some((p) => p.text || p.textGloss || p.claspText || p.claspTextGloss);

// ── The programme, in this locale. Every work is resolved ONCE here, against its own position in
// `c.program` — which is the key the copy desk addresses it by — so that the grouping below and
// the markup further down can never reach for an index that has drifted from the corpus.
//
// A gloss is the sung text in the READER'S language, so it collapses into the original wherever
// the two are already the same one: thirteen of the corpus's sung texts are English and one is
// Polish. Their slots are filled in every locale regardless — an empty one falls back to Polish
// and would print a Polish stanza under an English original — so it is the page that declines to
// say the same thing twice.
const program = c.program.map((p, i) => ({
  ...p,
  note: sayIf(`program.${i}.note`, p.note),
  rubric: sayIf(`program.${i}.rubric`, p.rubric),
  clasp: sayIf(`program.${i}.clasp`, p.clasp),
  inscriptioGlossText: sayIf(`program.${i}.inscriptioGloss`, p.inscriptioGloss?.pl),
  inscriptioRefText: p.inscriptioRef
    ? formatRef(p.inscriptioRef, lang, sayIf(`program.${i}.inscriptioRef.source`, p.inscriptioRef.source?.pl))
    : undefined,
  gloss: {
    text: glossFor(p.text, sayIf(`program.${i}.textGloss`, p.textGloss?.pl)),
    clasp: glossFor(p.claspText, sayIf(`program.${i}.claspTextGloss`, p.claspTextGloss?.pl)),
  },
}));

// ── `realizacja` is a free-text credit line owned by the /koncerty listing, and each evening fills
// it with whatever extra hand it had: "Realizacja: Ars Sonora Studio", "Skrzypce: Radu Ropotan",
// "Organy: …". Split a leading "Rola:" so the colophon prints a true credit instead of filing a
// violinist under "Realizacja". No prefix ⇒ the line really is a realizacja credit, and the page's
// own word for it stands in. The split runs on the TRANSLATED string, because the label half is
// copy and the translator carried the colon with it (glossary §1).
const realizacjaCredit = (() => {
  const line = sayIf("realizacja", c.realizacja);
  if (!line) return undefined;
  const m = line.match(/^\s*([^:]{2,24}?)\s*:\s*(.+)$/);
  return m ? { role: m[1], name: m[2] } : { role: ui.program.realizacjaRole, name: line };
})();

// ── Concert film: still for the in-flow player. Falls back to the hero bg when no dedicated
// poster is set. The MP4 source is consumed by VideoPlayer, never exposed as a native anchor.
const filmPoster = c.video ? (photoOptional(c.video.poster ?? "") ?? bg.desktop) : undefined;
const filmPosterSrc = filmPoster
  ? (await getImage({ src: filmPoster, width: 1600, format: "webp" })).src
  : undefined;
const filmVideoSrc = c.video ? videoAsset(c.video.asset) : undefined;
const filmVideoSrcAv1 = c.video ? videoAssetAv1(c.video.asset) : undefined;

// ── The tabula: this page's own table of contents, hung from the chrome's line and summoned by a
// run back UP the document (lib/tabula, styles/tabula.css). These are the longest documents on the
// site — 16 400px at 1440×900 on Wołanie Gór, 17 300 on a phone — and until now the only one with
// no position and no index of any kind, while `/` has its movement spine and both `/koncerty` and
// `/obrazy` have a rail.
//
// EVERY ROW'S TWO NAMES ARE THE BAND'S OWN, copied from the `kd-section-label` it already prints
// at its head, because an index that renames what it points at is a second vocabulary for one
// page. The numerals are the INDEX'S: the bands carry no number anywhere on the page, and
// numbering its own entries is what a table of contents has always done.
//
// The `when` flags are the SAME expressions the bands are guarded by below, hoisted so the two
// cannot drift — an index row pointing at a band that a concert without a `verbum` never rendered
// is a dead anchor, and it would only ever be found on the one concert missing that field.
//
// Two bands are deliberately absent. The PULL QUOTE is punctuation, not a place — it prints no
// label of its own, so a row for it would have to invent one. The CODA is the road out (prev /
// next concert); reaching it by index would be skipping the page rather than steering it.
const TABULA_ROMAN = ["I", "II", "III", "IV", "V", "VI", "VII", "VIII"] as const;
const tabula: TabulaEntry[] = [
  { when: !!c.prologue, id: "prolog", title: ui.bands.prologue, figure: "Ante concentum" },
  { when: !!c.verbum, id: "slowo", title: ui.bands.verbum, figure: "Verbum" },
  { when: hasTour, id: "wykonania", title: ui.bands.tour, figure: "Itinerarium" },
  { when: !!(c.reflection || c.reflectionNote), id: "refleksja", title: ui.bands.reflection, figure: "Reflectio" },
  { when: c.program.length > 0, id: "program", title: ui.bands.program, figure: "Programma" },
  { when: !!(c.roster && c.roster.groups.length > 0), id: "glosy", title: ui.bands.voces, figure: "Voces" },
  { when: !!(c.video && filmVideoSrc), id: "zapis", title: ui.bands.film, figure: "Imago viva" },
  { when: gallery.length > 0, id: "obrazy", title: ui.bands.gallery, figure: "Imagines" },
]
  .filter((b) => b.when)
  .map((b, i) => ({
    id: b.id,
    roman: TABULA_ROMAN[i] ?? String(i + 1),
    title: b.title,
    figure: b.figure,
    figureLang: "la",
  }));

// ── The acts (the salvation-history movements), in this locale. Keyed by the act's own `id`,
// which is identity rather than copy — so inserting an act re-keys nothing, and the name, the
// leading line and the scriptural interlude beside it are all translated under that stable key.
const movements = c.movements.map((m) => ({
  ...m,
  glossText: say(`movements.${m.id}.gloss`, m.gloss.pl),
  line: sayIf(`movements.${m.id}.line`, m.line),
  interludeGloss: sayIf(`movements.${m.id}.interlude.gloss`, m.interlude?.gloss?.pl),
  interludeRefText: m.interlude?.ref
    ? formatRef(
        m.interlude.ref,
        lang,
        sayIf(`movements.${m.id}.interlude.ref.source`, m.interlude.ref.source?.pl),
      )
    : undefined,
}));

// ── Programme grouped into movements. Numbering runs continuously across acts (the bis carries
// "bis"); consecutive works sharing a movement id sit under one act header. A concert with no
// `movements` collapses to a single unlabelled group → the flat list.
type Movement = (typeof movements)[number];
type ProgItem = (typeof program)[number];
const movementsById = new Map(movements.map((m) => [m.id, m]));
const programGroups: { movement?: Movement; items: { p: ProgItem; num: string }[] }[] = [];
let runningNum = 0;
for (const p of program) {
  const num = p.bis ? "bis" : String(++runningNum).padStart(2, "0");
  const mv = p.movement ? movementsById.get(p.movement) : undefined;
  const tail = programGroups.at(-1);
  if (tail && tail.movement?.id === mv?.id) tail.items.push({ p, num });
  else programGroups.push({ movement: mv, items: [{ p, num }] });
}

const concertTitle = say("title", c.title);
const essence = say("essence", c.essence);
const title = `${concertTitle} — ${ui.meta.titleSuffix}`;
const description = essence;

// ── JSON-LD: a tour emits one MusicEvent per date (each evening carries its own venue,
// address and admission); a single-date concert keeps one event. The node's shape — status
// from the calendar, shared performer/organizer ids, offers only where recorded — belongs to
// lib/eventSchema, which /koncerty emits from too.
// The node describes THIS locale's page, so its url and its prose are this render's — the
// alternates in <head> are what tie the three documents together.
const eventUrl = absolute(path);
const eventImage = absolute(ogImage);
const events = hasTour
  ? c.dates.map((d) =>
      musicEvent({
        name: concertTitle,
        description: essence,
        image: eventImage,
        url: eventUrl,
        date: d.date,
        time: d.time,
        venue: d.venue,
        address: d.address,
        admission: d.admission,
      }),
    )
  : [
      musicEvent({
        name: concertTitle,
        description: essence,
        image: eventImage,
        url: eventUrl,
        date: c.date,
        time: c.time,
        venue: c.venue ?? metaPlace,
        address: c.address,
        admission: c.admission,
      }),
    ];
const jsonLd =
  events.length === 1
    ? { "@context": "https://schema.org", ...events[0] }
    : events.map((e) => ({ "@context": "https://schema.org", ...e }));
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  alternates={alternates}
  lang={lang}
  image={ogImage}
  bodyClass="page-koncert-detail"
  breadcrumb={[
    { name: ui.meta.breadcrumb, path: localizePath("/koncerty", lang) },
    { name: concertTitle, path },
  ]}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <a class="skip-link" href="#tresc">{UI[lang].skipToContent}</a>
  {/* The BASE path, not this render's: the chrome compares `current` against locale-neutral
      paths, and the full one is what marks THIS concert's ribbon with the crimson stitch while
      the bare KONCERTY link keeps the section state. */}
  <SiteChrome
    current={basePath}
    tone="dark"
    index={tabula}
    lang={lang}
    availableLocales={available}
  />

  <main id="tresc" style={`--candle: ${candle}; --candle-ink: ${candleInk}`}>
    {/* ── Hero: full-bleed church, latin inscriptio, title, meta ───────────── */}
    <section class="kd-hero" aria-label={concertTitle}>
      <div class="kd-hero-media" aria-hidden="true">
        <BleedImage desktop={bg.desktop} mobile={bg.mobile} alt="" eager animate />
      </div>
      <div
        class="kd-hero-veil"
        aria-hidden="true"
        style={c.heroFoot ? `--hero-foot: ${c.heroFoot}` : undefined}
      >
      </div>

      <div class="kd-hero-inner">
        <p class="kd-hero-eyebrow reveal">
          <span>{ui.hero.station} {c.roman}</span>
          <span class="kd-dot" aria-hidden="true">·</span>
          <span class="lat">{c.latin}</span>
        </p>
        <h1 class="kd-hero-title reveal ink-press" data-d="1">{concertTitle}</h1>
        <p class="kd-hero-meta reveal" data-d="1">{heroMeta}{heroTime ? ` · ${heroTime}` : ""}</p>

        {c.inscriptio && (
          <p class="kd-inscriptio reveal" data-d="2">
            <em class="kd-inscriptio-lat">{c.inscriptio}</em>
            {/* The vernacular and the citation are one line of their own under the verse — the
                citation cites the verse, so it travels with the gloss rather than claiming a
                third line for four characters. */}
            {(inscriptioGloss || inscriptioRefText) && (
              <span class="kd-inscriptio-line">
                {inscriptioGloss && (
                  <span class="kd-inscriptio-gloss">{inscriptioGloss}</span>
                )}
                {inscriptioRefText && (
                  <span class="kd-inscriptio-ref">{inscriptioRefText}</span>
                )}
              </span>
            )}
          </p>
        )}

        <span class="kd-hero-cue reveal" data-d="3" aria-hidden="true">{ui.hero.cue}</span>
      </div>
    </section>

    {/* ── The evening's contents, printed ONCE as front matter ───────────────────────────────
          The page already has an index — the chrome's tabula, built from the same array below.
          What it does not have is one that serves a FIRST reading: tabula.css states the weakness
          itself ("the register is summoned by a POINTER… and this by a scroll gesture the reader
          may not have meant as one"), and the threshold is 180px of deliberate backward scroll on
          desktop, 340 on touch. A reader going down the page for the first time never makes that
          gesture, so the tabula serves RETURN and nothing served ARRIVAL. These are the longest
          documents on the site; arriving in one with no idea what it holds is what made a composed
          page read as a wall, and it is why the gallery and the roster at the foot were reported
          as unreachable rather than as badly placed.

          So the page states its contents where a book states them — at the front, read once, left
          behind. Not chrome: nothing sticky, nothing summoned, no permanent slot spent. The bar's
          tabula goes on doing what it does well.

          RENDERED FROM THE SAME `tabula` ARRAY, deliberately. Its rows are already guarded by the
          same `when` expressions as the bands themselves, so a row here can never point at a band
          this concert did not render — and a second hand-kept list would be a second vocabulary
          for one page, which is the fault the array's own header warns about.

          It stands on `--night` because the prologue below it does: the hero, this leaf and the
          threshold band are one dark opening stretch, and the page's first parchment is `#program`. */}
    {tabula.length > 1 && (
      <nav class="kd-band kd-tabula-front" aria-label={ui.tabula}>
        <div class="kd-wrap">
          <h2 class="kd-section-label micro reveal">
            <span class="lat">Tabula</span>
            <span class="kd-dot" aria-hidden="true">·</span>
            <span>{ui.tabula}</span>
          </h2>
          <ol class="kd-tabula-list reveal-rule">
            {tabula.map((e, i) => (
              <li class="kd-tabula-row reveal" data-d={String((i % 3) + 1)}>
                {/* The register goes on the ROW; the link keeps its own hover transition, which a
                    `.reveal` on the same element would replace rather than add to. */}
                <a class="kd-tabula-link" href={`#${e.id}`}>
                  <span class="kd-tabula-roman">{e.roman}</span>
                  <span class="kd-tabula-title">{e.title}</span>
                  <span class="kd-tabula-lead" aria-hidden="true"></span>
                  {e.figure && (
                    <span class="kd-tabula-figure" lang={e.figureLang}>{e.figure}</span>
                  )}
                </a>
              </li>
            ))}
          </ol>
        </div>
      </nav>
    )}

    {/* ── Prologue: the threshold of the evening — draws the reader across the doorway
          into the experience before the reflection. ─────────────────────────────── */}
    {c.prologue && (
      <section class="kd-band kd-prologue" id="prolog" aria-label={ui.bands.prologue}>
        <div class="kd-wrap kd-narrow">
          {/* The mark takes the ink and it leads the band. It is decorative to a screen reader and
              a register node all the same: it is the tallest thing here and the eye's first stop,
              so leaving it at full opacity had it standing complete above two lines still arriving
              — the band assembling backwards. Everything below it steps once. */}
          <span class="kd-prologue-mark reveal" aria-hidden="true"></span>
          <h2 class="kd-section-label micro reveal" data-d="1">
            <span class="lat">Ante concentum</span>
            <span class="kd-dot" aria-hidden="true">·</span>
            <span>{ui.bands.prologue}</span>
          </h2>
          <p class="kd-prologue-text reveal" data-d="2">{say("prologue", c.prologue)}</p>
        </div>
      </section>
    )}

    {/* ── Verbum: the spoken threshold word — a live introduction transcribed, lightly
          edited for readability (subtractive only), never paraphrased. Fulfils the promise
          the prologue makes ("o. Naliwajko wprowadza…"); the unsigned `bridge` line hands
          the reader onward — the hush before the first work — so the narrative baton the
          prologue used to carry now falls AFTER the word was actually spoken. ─────────── */}
    {c.verbum && (
      <section class="kd-band kd-verbum" id="slowo" aria-label={ui.bands.verbum}>
        <div class="kd-wrap kd-narrow">
          <h2 class="kd-section-label micro reveal">
            <span class="lat">Verbum</span>
            <span class="kd-dot" aria-hidden="true">·</span>
            <span>{ui.bands.verbum}</span>
          </h2>
          <blockquote class="kd-verbum-quote reveal" data-d="1">
            <p>{say("verbum.quote", c.verbum.quote)}</p>
          </blockquote>
          {/* The speaker's name is copy; the day he spoke is the concert's own `date`, appended
              here so the citation cannot drift from it (and simply absent for an evening whose
              day is vague, rather than invented). */}
          <p class="kd-verbum-cite reveal" data-d="2">
            {[say("verbum.speaker", c.verbum.speaker.pl), c.date && longDate(c.date, lang)]
              .filter(Boolean)
              .join(" · ")}
          </p>

          <details class="kd-verbum-full reveal" data-d="2">
            <summary>
              <span class="kd-text-cue">{ui.verbum.fullCue}</span>
              <span class="kd-text-icon" aria-hidden="true"></span>
            </summary>
            {/* `--i` is the paragraph's place in the transcript, read by the unfold cascade in
                the CSS below. It is set here rather than counted in CSS because `nth-child`
                would have to be written out per paragraph for a text of unknown length. */}
            <div class="kd-verbum-body">
              {say("verbum.text", c.verbum.text).split("\n\n").map((para, i) => (
                <p style={`--i: ${i}`}>{para}</p>
              ))}
            </div>
          </details>

          {/* Both steps continue the section's count rather than restarting it. The bridge closes
              the word and the note owns up to the editing, so they are the last two things read
              here — and a node left without `data-d` carries delay 0, which would have entered
              them ahead of the citation and the transcript above whenever the band crosses the
              trigger in one callback. */}
          {c.verbum.bridge && <p class="kd-verbum-bridge reveal" data-d="3">{say("verbum.bridge", c.verbum.bridge)}</p>}
          <p class="kd-verbum-note micro reveal" data-d="4">{ui.verbum.note}</p>
        </div>
      </section>
    )}

    {/* ── Tour dates (multi-city). Single-date concerts keep the date in `meta`. ─ */}
    {hasTour && (
      <section class="kd-band kd-tour" id="wykonania" aria-label={ui.bands.tour}>
        <div class="kd-wrap">
          <h2 class="kd-section-label micro reveal">
            <span class="lat">Itinerarium</span>
            <span class="kd-dot" aria-hidden="true">·</span>
            <span>{ui.bands.tour}</span>
          </h2>
          {/* Lead without ink: the list has no copy of its own, only the rule the rows hang from.
              It is drawn while the first row is still arriving, which is the order a scribe works
              in and the reason this register exists. */}
          <ol class="kd-tour-list reveal-rule">
            {c.dates.map((d, i) => (
              <li class="kd-tour-row reveal" data-d={String((i % 3) + 1)}>
                <span class="kd-tour-date">{longDate(d.date, lang)}</span>
                <span class="kd-tour-venue">{d.venue}</span>
                {d.time && <span class="kd-tour-time">{[ui.hero.timePrefix, d.time].filter(Boolean).join(" ")}</span>}
              </li>
            ))}
          </ol>
        </div>
      </section>
    )}

    {/* ── Reflection: Florent's authored paragraph + our unsigned bridge note ─── */}
    {(c.reflection || c.reflectionNote) && (
      <section class="kd-band kd-reflection" id="refleksja" aria-label={ui.bands.reflection}>
        <div class="kd-wrap kd-narrow">
          <h2 class="kd-section-label micro reveal">
            <span class="lat">Reflectio</span>
            <span class="kd-dot" aria-hidden="true">·</span>
            <span>{ui.bands.reflection}</span>
          </h2>
          {c.reflection && <p class="kd-reflection-text reveal" data-d="1">{say("reflection", c.reflection)}</p>}
          {c.reflectionAttribution && (
            <p class="kd-reflection-attrib micro reveal" data-d="2">{say("reflectionAttribution", c.reflectionAttribution)}</p>
          )}
          {c.reflectionNote && (
            <p class="kd-reflection-note reveal" data-d="2">{say("reflectionNote", c.reflectionNote)}</p>
          )}
        </div>
      </section>
    )}

    {/* ── Program: the programme book. Founder's name for the evening, obsada,
          then each work with scoring, source verse and — where kept — the sung
          word with its gloss in the reader's language (a <details>, unfolded by the
          disclosure controller — see the script at the foot of this file). ───── */}
    {c.program.length > 0 && (
      <section class="kd-band kd-band-soft kd-program-band tone-light" id="program" aria-label={ui.bands.program}>
        <div class="kd-wrap">
          <header class="kd-section-head">
            {/* The section's heading is this label, on every section and unconditionally. The
                page used to emit exactly ONE <h2> — the programme lede — which is optional in
                the schema, so the first concert shipped without one would have gone h1 → h3 on
                8000px of programme book. Heading navigation is how a screen-reader reader skims
                a page this long; it must not hang off a YAML field. */}
            <h2 class="kd-section-label micro reveal">
              <span class="lat">Programma</span>
              <span class="kd-dot" aria-hidden="true">·</span>
              <span>{ui.bands.program}</span>
            </h2>
            {c.programLede && (
              <p class="kd-section-title reveal ink-press" data-d="1">{say("programLede", c.programLede)}</p>
            )}

            {(credits.length > 0 || realizacjaCredit) && (
              <dl class="kd-credits reveal" data-d="2" aria-label={ui.program.creditsAria}>
                {credits.map((cr) => (
                  <div class="kd-credit">
                    <dt>{cr.role}</dt>
                    <dd>{cr.name}</dd>
                  </div>
                ))}
                {realizacjaCredit && (
                  <div class="kd-credit">
                    <dt>{realizacjaCredit.role}</dt>
                    <dd>{realizacjaCredit.name}</dd>
                  </div>
                )}
              </dl>
            )}

            {c.programArc && <p class="kd-program-arc reveal" data-d="3">{say("programArc", c.programArc)}</p>}
          </header>

          <ol class="kd-program">
            {programGroups.map((grp) => (
              <>
                {/* The Latin is the verse and the Polish is its translation: read in sequence, so
                    they take a step rather than one 672px onset that finished before the
                    translation was reached. */}
                {grp.movement?.interlude && (
                  <li class="kd-interlude" aria-label={ui.program.interludeAria}>
                    <p class="kd-interlude-lat reveal">{grp.movement.interlude.lat}</p>
                    {grp.movement.interludeGloss && (
                      <p class="kd-interlude-gloss reveal" data-d="1">
                        {grp.movement.interludeGloss}
                      </p>
                    )}
                    {grp.movement.interludeRefText && (
                      <span class="kd-interlude-ref micro reveal" data-d="1">
                        {grp.movement.interludeRefText}
                      </span>
                    )}
                  </li>
                )}
                {grp.movement && (
                  <li class="kd-movement reveal reveal-rule">
                    <h3 class="kd-movement-head">
                      <span class="kd-movement-lat">{grp.movement.lat}</span>
                      <span class="kd-movement-gloss">{grp.movement.glossText}</span>
                    </h3>
                    {grp.movement.line && <p class="kd-movement-line">{grp.movement.line}</p>}
                  </li>
                )}
                {grp.items.map(({ p, num }) => (
                  <>
                    {/* Ink AND lead — the one pair the register language allows on a node, and
                        this is the page's archetype for it: a programme is ruled before it is
                        set. The rule leads, the ink follows 0.18s behind (registers.css); the
                        rows whose hairline the layout deliberately drops suppress the pseudo-rule
                        with it, in the CSS below. */}
                    <li class:list={["kd-program-item", "reveal", "reveal-rule", { "is-bis": p.bis }]}>
                      <span class="kd-program-num micro">{num}</span>
                      <div class="kd-program-body">
                    <p class="kd-program-composer">
                      <span class="kd-program-composer-name">{p.composer}</span>
                      {p.years && <span class="kd-program-years"> · {p.years}</span>}
                    </p>
                    <p class="kd-program-work">
                      <em>{p.work}</em>
                      {/* The three facts travel as ONE rail: loose in the title's flex row they
                          left the line one chip at a time, so a work could set its year beside
                          the title and its scoring a line below. */}
                      {(p.year || p.voicing || p.duration) && (
                        <span class="kd-program-meta">
                          {p.year && <span class="kd-program-year">{p.year}</span>}
                          {p.voicing && <span class="kd-program-voicing">{p.voicing}</span>}
                          {p.duration && <span class="kd-program-duration">{p.duration}</span>}
                        </span>
                      )}
                    </p>
                    {(p.inscriptio || p.inscriptioGlossText || p.inscriptioRefText) && (
                      <p class="kd-program-inscriptio">
                        {p.inscriptio && <em class="kd-program-inscriptio-lat">{p.inscriptio}</em>}
                        {p.inscriptio && p.inscriptioGlossText && (
                          <span class="kd-dot" aria-hidden="true">·</span>
                        )}
                        {/* Same pairing as the hero's, but this one only breaks onto its own line
                            on a narrow column — see the 720 query.

                            The citation is parenthetical to a motto and a line of its own without
                            one: two works in the yaml carry a chapter and verse and no incipit
                            (Zieleński's "Vox in Rama", Shaw's "refugium"), and brackets around a
                            standalone reference would be a parenthesis to nothing. */}
                        {(p.inscriptioGlossText || p.inscriptioRefText) && (
                          <span class="kd-program-inscriptio-line">
                            {p.inscriptioGlossText && (
                              <span class="kd-program-inscriptio-gloss">{p.inscriptioGlossText}</span>
                            )}
                            {p.inscriptioRefText && (
                              <span class="kd-program-inscriptio-ref">{p.inscriptio || p.inscriptioGlossText ? ` (${p.inscriptioRefText})` : p.inscriptioRefText}</span>
                            )}
                          </span>
                        )}
                      </p>
                    )}
                    {/* The rubric: not what was sung — what was done. A missal prints its
                        instructions apart from its texts; so does this. */}
                    {p.rubric && (
                      <p class="kd-rubric">
                        <span class="kd-rubric-mark" aria-hidden="true"></span>
                        <span>{p.rubric}</span>
                      </p>
                    )}
                    {p.note && <p class="kd-program-note-work">{p.note}</p>}
                    {(p.text || p.gloss.text) && (
                      <details class="kd-text">
                        <summary>
                          <span class="kd-text-cue">{ui.program.textCue}</span>
                          <span class="kd-text-icon" aria-hidden="true"></span>
                        </summary>
                        <div
                          class:list={["kd-text-cols", { "is-single": !(p.text && p.gloss.text) }]}
                        >
                          {p.text && <p class="kd-text-orig">{p.text}</p>}
                          {p.gloss.text && <p class="kd-text-gloss">{p.gloss.text}</p>}
                        </div>
                      </details>
                    )}
                      </div>
                    </li>
                    {/* The clasp: a marker when it only names a seam ("Przerwa"), a sung beat when
                        it brings words back (9 Kart — Psalm 51 returning between the psalms). It is
                        content either way, so it stays in the accessibility tree. */}
                    {p.clasp && (
                      <li
                        class:list={["kd-clasp", { "is-sung": p.claspText || p.gloss.clasp }]}
                      >
                        <span class="kd-clasp-rule reveal"><span>{p.clasp}</span></span>
                        {p.claspText && <p class="kd-clasp-lat reveal">{p.claspText}</p>}
                        {p.gloss.clasp && (
                          <p class="kd-clasp-gloss reveal" data-d="1">{p.gloss.clasp}</p>
                        )}
                      </li>
                    )}
                  </>
                ))}
              </>
            ))}
          </ol>

          {(c.spotify || hasText || c.programNote) && (
            <div class="kd-program-foot reveal">
              {c.programNote && (
                <p class="kd-program-note kd-program-note-lead">{say("programNote", c.programNote)}</p>
              )}
              {hasText && (
                <p class="kd-program-note micro">
                  {/* Not a translation of itself: the sentence states where the glosses PRINTED
                      HERE come from, so an evening that states its own says it per locale and the
                      page's default is written about this locale's texts. */}
                  {sayIf("textNote", c.textNote) ?? ui.program.textNoteDefault}
                </p>
              )}
              {c.spotify && (
                <a
                  class="kd-spotify-link micro"
                  href={c.spotify}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {ui.program.spotify} <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          )}
        </div>
      </section>
    )}

    {/* ── Pull quote: composer voice on a single work in the program ────────── */}
    {c.pullQuote && (
      <section class="kd-band kd-pullquote tone-light" aria-label={ui.quoteAria}>
        <div class="kd-wrap kd-narrow">
          {/* You read the words, then you look for who said them. */}
          <blockquote class="kd-quote">
            <p class="reveal">{say("pullQuote.text", c.pullQuote.text)}</p>
            <cite class="kd-cite reveal reveal-rule" data-d="1">
              <span class="kd-cite-name">{say("pullQuote.attribution", c.pullQuote.attribution)}</span>
              {c.pullQuote.about && (
                <span class="kd-cite-about micro">{say("pullQuote.about", c.pullQuote.about)}</span>
              )}
            </cite>
          </blockquote>
        </div>
      </section>
    )}

    {/* ── Voces: the singers as they stood THAT evening — a per-evening cast, never the
          ensemble's fixed roster (guests happen, people move on). Names are consent-cleared
          for concert pages only. The cast closes with the conductor (from credits — he stood
          there too). The quiet factual footnote (`roster.note`) belongs to the whole block.
          Placed before the film/gallery so the names lead into the images. ── */}
    {c.roster && c.roster.groups.length > 0 && (
      <section class="kd-band kd-band-soft kd-voces tone-light" id="glosy" aria-label={ui.bands.voces}>
        <div class="kd-wrap">
          <h2 class="kd-section-label micro reveal">
            <span class="lat">Voces</span>
            <span class="kd-dot" aria-hidden="true">·</span>
            <span>{ui.bands.voces}</span>
          </h2>
          {/* The cadence steps over FOUR, not three, and the difference is the whole point of it
              being here. This grid is `auto-fit minmax(180px, 1fr)`, which lays five columns
              across `.kd-wrap` — and cells in one grid row share a top edge exactly, so they
              cross the trigger line in a single observer callback every time, at any scroll
              speed. Modulo 3 in a row of five hands out 1 2 3 1 2, i.e. two pairs entering in
              unison, which is the one thing the register language exists to avoid. Modulo 4 uses
              the fourth step registers.css already declares and leaves a single collision at the
              two ENDS of the row, where unison is least legible as unison. If the grid's measure
              or its 180px track ever changes, this number is what has to follow it. */}
          <dl class="kd-voces-grid">
            {c.roster.groups.map((g, i) => (
              <div class="kd-voces-group reveal" data-d={String((i % 4) + 1)}>
                {/* The GROUP is copy — the choral convention, not a literal (Soprany → Sopranos)
                    — and the singers under it are names, which stay themselves everywhere. */}
                <dt class="kd-voces-voice micro">{say(`roster.groups.${i}.voice`, g.voice)}</dt>
                {g.names.map((n) => (
                  <dd class="kd-voces-name">{n}</dd>
                ))}
                {g.detail && (
                  <dd class="kd-voces-detail">{say(`roster.groups.${i}.detail`, g.detail)}</dd>
                )}
              </div>
            ))}
            {/* The conductor stands at index `groups.length`, so his step continues the sequence
                rather than restarting it — otherwise he lights with whichever voice happens to
                share his remainder. */}
            {conductorCredit && (
              <div class="kd-voces-group reveal" data-d={String((c.roster.groups.length % 4) + 1)}>
                <dt class="kd-voces-voice micro">{conductorCredit.role}</dt>
                <dd class="kd-voces-name">{conductorCredit.name}</dd>
              </div>
            )}
          </dl>
          {c.roster.note && (
            <p class="kd-voces-note reveal reveal-rule">{say("roster.note", c.roster.note)}</p>
          )}
        </div>
      </section>
    )}

    {/* ── Film: selected fragments of the evening. The player hydrates eagerly after
          ClientRouter swaps and starts independently from the landing resume state. ── */}
    {c.video && filmVideoSrc && (
      <section class="kd-band kd-film" id="zapis" aria-label={ui.bands.film}>
        <div class="kd-wrap">
          <h2 class="kd-section-label micro reveal">
            <span class="lat">Imago viva</span>
            <span class="kd-dot" aria-hidden="true">·</span>
            <span>{ui.bands.film}</span>
          </h2>
          {/* No register: the player already carries a veil of its own over the poster frame, and
              a light register on top of it would be two veils on one node — the same call the
              landing makes for VoxMoment. The section label above it is what inks. */}
          <div class:list={["kd-film-player", { "is-portrait": c.video.portrait }]}>
            <VideoPlayer
              client:load
              src={filmVideoSrc}
              srcAv1={filmVideoSrcAv1}
              poster={filmPosterSrc}
              caption={sayIf("video.caption", c.video.caption)}
              note={sayIf("video.note", c.video.note)}
              portrait={c.video.portrait}
              tone="dark"
              resume={false}
            />
          </div>
        </div>
      </section>
    )}

    {/* ── Documentary gallery — the evening's own images ────────────────────── */}
    {gallery.length > 0 && (
      <section class="kd-band kd-gallery" id="obrazy" aria-label={ui.bands.gallery}>
        <div class="kd-wrap">
          <h2 class="kd-section-label micro reveal">
            <span class="lat">Imagines</span>
            <span class="kd-dot" aria-hidden="true">·</span>
            <span>{ui.bands.gallery}</span>
          </h2>
          {/* Photographs are LIT, not written: the veil belongs to the image and the run's head
              keeps the ink. `data-d` therefore sits on the figure, not on either register — it is
              the row's cadence, and that is what keeps a grid row from lighting in unison. */}
          {runs.map((run) => (
          <div class="kd-gallery-run">
          {showRunHeads && (
            <p class="kd-run-head micro reveal reveal-rule">
              <span>{run.title}</span>
              {run.date && (
                <>
                  <span class="kd-dot" aria-hidden="true">·</span>
                  <span>{run.date}</span>
                </>
              )}
            </p>
          )}
          <div class="kd-gallery-grid">
            {run.shots.map((g, i) => (
              <figure
                class="kd-shot"
                data-d={String((i % 3) + 1)}
                style={`--share: ${g.share}`}
              >
                {/* The media wrapper IS the trigger — a button rather than an overlaid control,
                    so the whole frame is the target and nothing is drawn on top of the
                    photograph. It contributes no box of its own (`.shot-open`,
                    styles/image-lightbox.css), so the row's geometry is untouched.

                    The set is this evening's gallery and stops there — an arrow that walked on
                    into another concert would take the reader out of the page they are reading
                    without saying so. The exit under the frame goes to /obrazy instead, which is
                    where the other evenings are, and is the same road the gallery's own foot
                    offers one scroll below. */}
                <button
                  type="button"
                  class="kd-shot-media shot-open"
                  data-image-open
                  data-image-group="kd-gallery"
                  data-image-src={g.frame.src}
                  data-image-srcset={g.frame.srcset}
                  data-image-sizes={g.frame.sizes}
                  data-image-alt={g.alt}
                  data-image-caption={[run.title, run.date].filter(Boolean).join(" · ")}
                  data-image-credit={frameCredit(g, lang)}
                  data-image-w={String(g.frame.width)}
                  data-image-h={String(g.frame.height)}
                  data-image-href={`/obrazy#${entry.id}`}
                  data-image-href-label={ui.gallery.allImages}
                >
                  {/* `width` = top of the ladder, which is also `framedShot`'s 1200 candidate:
                      one emitted file serves the grid, its fallback and the lightbox. Without it
                      the fallback comes back at source resolution — see lib/photos.ts. Clamped to
                      the source, because a 1200 request against a narrower scan is still recorded
                      as 1200 and emits a twin of what the ladder already carries. */}
                  <Image
                    src={g.img}
                    widths={[560, 840, 1200]}
                    width={Math.min(g.img.width, 1200)}
                    sizes={`(max-width: 960px) 92vw, ${g.w}px`}
                    alt={g.alt}
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="reveal-light" aria-hidden="true"></span>
                </button>
                {g.caption && <figcaption class="micro reveal">{g.caption}</figcaption>}
              </figure>
            ))}
          </div>
          </div>
          ))}

          {/* The gallery's foot: who held the camera, and the road out to the other evenings.
              The colophon is the only place a photographer is named — a run's head states place
              and date and nothing else.

              The road out carries THIS evening's anchor. The label is still true — the
              destination is the whole archive — but /obrazy is 15 000px long, and a link that
              lands at its head makes the reader find their own place again before they can reach
              the evenings on either side of the one they just read. */}
          <div class="kd-gallery-foot reveal reveal-rule">
            {galleryCredits && <p class="kd-gallery-credit micro">{galleryCredits}</p>}
            <a class="kd-gallery-all" href={`/obrazy#${entry.id}`}>{ui.gallery.allImages}</a>
          </div>
        </div>
      </section>
    )}

    {/* ── Coda: the poster as keepsake, and the Via that runs on ────────────── */}
    <section class="kd-band kd-coda" aria-label={ui.coda.aria}>
      <div class="kd-wrap kd-coda-inner">
        {/* The gold corner is the mount, not the photograph, so it stays outside the media wrapper
            and above the veil: the frame is already standing when the image lights into it. */}
        {posterImg && (
          <figure class="kd-poster">
            <span class="kd-poster-frame" aria-hidden="true"></span>
            <div class="kd-poster-media">
              {/* `width` caps the fallback rendition — see lib/photos.ts. */}
              <Image
                src={posterImg}
                widths={[280, 420, 560]}
                width={560}
                sizes="(max-width: 720px) 62vw, 300px"
                alt={sayIf("posterAlt", c.posterAlt) ?? fill(ui.poster.altFallback, { title: concertTitle })}
                loading="lazy"
                decoding="async"
              />
              <span class="reveal-light" aria-hidden="true"></span>
            </div>
            <figcaption class="micro reveal">{ui.poster.caption}</figcaption>
          </figure>
        )}

        <nav class="kd-vianav reveal" data-d="1" aria-label={ui.coda.navAria}>
          <span class="kd-vianav-label micro">
            <span class="lat">Via</span>
            <span class="kd-dot" aria-hidden="true">·</span>
            <span>{ui.coda.viaLabel}</span>
          </span>
          <div class="kd-vianav-rail">
            {prev ? (
              <a class="kd-vianav-side kd-vianav-prev" href={localizePath(`/koncerty/${prev.id}`, lang)}>
                <span class="kd-vianav-dir micro"><span aria-hidden="true">←</span> {ui.hero.station} {prev.data.roman}</span>
                <span class="kd-vianav-name">{neighbourTitle(prev)}</span>
              </a>
            ) : (
              <span class="kd-vianav-side is-empty" aria-hidden="true"></span>
            )}

            <a class="kd-vianav-all" href={localizePath("/koncerty", lang)}>{ui.coda.allConcerts}</a>

            {next ? (
              <a class="kd-vianav-side kd-vianav-next" href={localizePath(`/koncerty/${next.id}`, lang)}>
                <span class="kd-vianav-dir micro">{ui.hero.station} {next.data.roman} <span aria-hidden="true">→</span></span>
                <span class="kd-vianav-name">{neighbourTitle(next)}</span>
              </a>
            ) : (
              <span class="kd-vianav-side is-empty" aria-hidden="true"></span>
            )}
          </div>
        </nav>
      </div>
    </section>
  </main>

  <SiteFooter />

  <VaultIsland client:idle />
  <ImageLightbox client:idle />
  <script>
    import "../../scripts/vault-triggers.ts";
    import "../../scripts/image-triggers.ts";
  </script>

  {/* Page-scoped behaviour, ClientRouter-safe: re-bound on every page-load, previous bindings
      dropped first. Chrome tone (flip to the paper treatment while a parchment section sits
      under the bar — same contract as /koncerty) and the two disclosures. */}
  <script>
    import { setupDisclosure } from "../../scripts/disclosure";

    let toneIO: IntersectionObserver | undefined;
    let dropDisclosures: (() => void) | undefined;

    const setupKdTone = () => {
      toneIO?.disconnect();
      const chrome = document.getElementById("chrome");
      const light = [...document.querySelectorAll(".tone-light")];
      if (!chrome || light.length === 0) return;
      const active = new Set<Element>();
      toneIO = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) active.add(e.target);
            else active.delete(e.target);
          }
          chrome.classList.toggle("is-light", active.size > 0);
        },
        { rootMargin: "-64px 0px -90% 0px", threshold: 0 },
      );
      light.forEach((el) => toneIO!.observe(el));
    };

    // Both disclosures on the page take one call: a sung text under a work and the transcribed
    // word under the Verbum are the same gesture at two sizes. Neither `.kd-text-cols` nor
    // `.kd-verbum-body` can be the animated box itself — both carry a top margin, which sits
    // OUTSIDE the height and would stand under a closed summary as a gap — so the controller
    // wraps them. That wrapper is created at runtime and therefore carries no scope attribute:
    // nothing in this file's <style> can reach it, and nothing needs to.
    const setupKdDisclosures = () => {
      dropDisclosures?.();
      dropDisclosures = setupDisclosure(document, {
        selector: ".kd-text, .kd-verbum-full",
        bodyClass: "kd-disclosure-body",
      });
    };

    document.addEventListener("astro:page-load", () => {
      setupKdTone();
      setupKdDisclosures();
    });
  </script>
</BaseLayout>

<style>
  /* ── Reset on this page only ────────────────────────────────────────────── */
  /* `:global` is required, not stylistic: <body> is BaseLayout's element and never carries this
     file's `data-astro-cid`, so a bare `.page-koncert-detail` compiles to a selector that matches
     nothing. It was bare until 2026-08-08 and the defect stayed invisible here only because every
     `.kd-band` paints its own ground — /obrazy was built from this page, had no such bands, and
     spent its whole life on parchment with `--paper` text as a result. */
  :global(body.page-koncert-detail) { background: var(--night, #100f0d); color: var(--paper, #f4f1e9); }
  main { display: block; }
  /* Overlay scroll-locks. Each overlay names its own class: the landing's video rule is scoped
     to body.theme-marketing, which this page's body doesn't carry, and the photograph frame is a
     separate overlay rather than a wider reading of the same one — widening a lock is how a page
     ends up unable to scroll after the overlay it belongs to is gone. */
  :global(body.page-koncert-detail.video-open) { overflow: hidden; }
  :global(body.page-koncert-detail.image-open) { overflow: hidden; }

  /* ── Hero ──────────────────────────────────────────────────────────────── */
  .kd-hero { position: relative; min-height: 100svh; display: flex; align-items: flex-end; padding: 0 max(28px, 5vw) clamp(72px, 10vw, 128px); color: var(--paper); overflow: hidden; isolation: isolate; }
  .kd-hero-media { position: absolute; inset: 0; z-index: -2; }
  .kd-hero-media :global(picture),
  .kd-hero-media :global(img) { width: 100%; height: 115%; display: block; object-fit: cover; }
  /* Two standing gradients shaped for a dark church interior — a top wash for the chrome, a foot
     that seats the title, a rake from the left the type hangs on — over a deepened foot the
     station can raise (`heroFoot`, content.config). The standing foot only has to carry type;
     where the photograph's own foreground is loud it also has to SUBDUE, which is a different
     amount and reaches higher up the frame. Kept as its own bottom-anchored layer so raising it
     never touches the light in the upper frame. Unset ⇒ 0, and the heroes that want no more foot
     than they have render exactly as before. */
  .kd-hero-veil { position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      linear-gradient(180deg, rgba(8,8,7,.42) 0%, rgba(8,8,7,.08) 36%, rgba(16,15,13,.86) 100%),
      linear-gradient(72deg, rgba(8,8,7,.74) 0%, rgba(8,8,7,.22) 48%, transparent 74%),
      linear-gradient(0deg, rgba(8,8,7,var(--hero-foot, 0)) 0%, transparent 60%); }

  .kd-hero-inner { max-width: 1180px; width: 100%; margin: 0 auto; }
  .kd-hero-eyebrow { display: inline-flex; align-items: center; gap: 10px; font-family: var(--capitalis); font-size: 11px; letter-spacing: .26em; text-transform: uppercase; color: rgba(244, 241, 233, .72); margin: 0 0 22px; }
  .kd-hero-title { font-family: var(--serif); font-weight: 300; line-height: .98; font-size: clamp(48px, 9vw, 124px); letter-spacing: -.01em; margin: 0; color: var(--paper); }
  .kd-hero-meta { font-family: var(--capitalis); font-size: clamp(11.5px, 1vw, 13px); letter-spacing: .18em; text-transform: uppercase; color: rgba(244, 241, 233, .68); margin: 26px 0 0; }

  .kd-inscriptio { margin: clamp(32px, 4.5vw, 52px) 0 0; max-width: 720px; font-family: var(--serif); font-weight: 300; font-size: clamp(16px, 1.5vw, 20px); line-height: 1.55; color: rgba(244, 241, 233, .82); padding-left: 18px; border-left: 1px solid color-mix(in srgb, var(--candle) 46%, transparent); }
  /* Verse on one line, its gloss on the next, at every width — the pair is one utterance in two
     tongues and the break belongs to that, not to the measure. Run inline behind a separator it
     survived only while the translation fit: the moment it was a word too long it began mid-line
     under the Latin, and the reader lost which language they were in. The separator goes with the
     inline setting, or it hangs at the end of the verse pointing at nothing. */
  .kd-inscriptio-lat { display: block; font-style: italic; color: var(--candle); }
  .kd-inscriptio-line { display: block; margin-top: .35em; }
  .kd-inscriptio-gloss { color: rgba(244, 241, 233, .72); }
  .kd-inscriptio-ref { display: inline-block; margin-left: 14px; font-family: var(--capitalis); font-size: 11px; letter-spacing: .18em; text-transform: uppercase; color: rgba(244, 241, 233, .5); }

  .kd-hero-cue { margin-top: clamp(38px, 5vw, 58px); font-family: var(--capitalis); font-size: 10px; letter-spacing: .26em; text-transform: uppercase; color: rgba(244, 241, 233, .6); display: inline-flex; align-items: center; gap: 12px; }
  .kd-hero-cue::after { content: ""; width: 40px; height: 1px; background: currentColor; opacity: .6; animation: kdCue 3.4s var(--ease-slow) infinite; }

  /* The separator follows the band it lands in. This mark is used on both grounds — the night
     sections and the light ones — so a literal paper value renders it paper-on-paper in the light
     bands and the pair it divides reads as one run-on with a dropped tab. On night `currentColor`
     is `--paper` and 42% reproduces the original appearance exactly.

     ON PARCHMENT IT CANNOT INHERIT, and that is why the second rule is not simply a bigger
     percentage. Every light-band dot sits inside a line that has ALREADY stepped its colour down
     — `--ink-muted` in the inscriptio, `--candle-ink` in the section labels — so `currentColor`
     there compounds two discounts and lands within a few percent of the paper. Taking full `--ink`
     as the base spends the discount once, which puts the mark just under the lighter of the two
     texts it divides: present as structure, never competing as ink. */
  .kd-dot { margin: 0 8px; color: color-mix(in srgb, currentColor 42%, transparent); }
  .tone-light .kd-dot { color: color-mix(in srgb, var(--ink) 42%, transparent); }

  /* ── Bands (body) ──────────────────────────────────────────────────────── */
  .kd-band { padding: clamp(84px, 13vw, 184px) max(28px, 5vw); position: relative; }
  /* Every indexed band is a link target (the chrome's tabula, and `#program`, which has been
     linkable all along and until now landed under the fixed bar). 96 clears the resting chrome
     (~85px) with enough left over that the band's LABEL — the thing that says which section this
     is — arrives below the bar rather than beneath it. Same number as `/obrazy`'s evenings, for
     the same reason; an anchor that hides its own head states nothing. */
  .kd-band[id] { scroll-margin-top: 96px; }
  .kd-band-soft { background: var(--paper, #f4f1e9); color: var(--ink, #161514); }
  .kd-wrap { max-width: 1180px; margin: 0 auto; }
  .kd-narrow { max-width: 760px; }

  .kd-section-head { margin: 0 0 clamp(44px, 6vw, 80px); }
  /* `font-weight` is stated because this label is an <h2>: the heading's UA weight is `bold`,
     and Cinzel is a 400–900 variable face, so leaving it unset renders the section labels at
     700 while every other capitalis micro on the page sits at 400. 400 is what a <span> here
     used to resolve to (body's 300, clamped up by the face) — the value is the old rendering
     written down, not a new one. Same trap, same fix, on `.kd-movement-gloss` inside its <h3>. */
  /* These are the page's real <h2>s — eight of them, one per band — and at 10.5px/400 they were
     what made a composed page read as an undifferentiated wall: a reader who cannot pick out the
     section heads has no way to scan, and length then feels infinite. `.titulus` (base.css) is the
     atom for this job; the values are restated here because this rule is emitted with the page's
     astro cid and so out-specifies it.

     600 is safe on THIS rule specifically because it keeps `--capitalis`: Cinzel is variable
     (400–900). Do not copy the weight to a rubric that falls through to base.css's `:has(.lat)`
     mono swap — Plex Mono ships only 300/400 here and would be synthesized.

     (Worth knowing, not fixed in this pass: because the page bundle loads after base.css and the
     two rules tie at (0,2,0), this declaration silently overrides the two-tier `:has(.lat)`
     treatment — on a concert page both tiers stay Cinzel caps and separate on tracking and colour
     alone, where the rest of the site separates them on face and case as well.) */
  .kd-section-label { display: inline-flex; align-items: center; gap: 8px; font-family: var(--capitalis); font-weight: 600; font-size: 12.5px; letter-spacing: .18em; text-transform: uppercase; color: var(--candle); margin: 0 0 22px; }
  /* Gold that has to be READ, on the two parchment bands. Full candle is 2.10 : 1 there — it
     fails AA outright at every size these labels are set in — and the tint the station carries
     does not change that: the accent is normalized to the candle's own luminance, so all five
     stations land within 2.06–2.13. `--candle-ink` is the same hue at a luminance that clears
     it (4.55–4.80 measured across the five). The split is by ROLE and not by band, so what
     stays on `--candle` below stays there on purpose: hairlines, the rubric lozenge and its
     wash, and display gold, none of which the contrast minimum applies to.

     `--lat-ink` is the second half of that same declaration and must not be separated from it.
     The label's Latin tier (`.lat`, "Programma" / "Voces") is painted by base.css's two-tier
     rubric rule, which matches the CHILD — so setting a colour here reaches the gloss and
     leaves the Latin word behind at full candle, 2.1 : 1, the one string on this band nobody
     could read. On the dark bands both tiers have always been candle together; this is what
     makes parchment behave the same way. */
  .kd-band-soft .kd-section-label { color: var(--candle-ink); --lat-ink: var(--candle-ink); }
  /* The programme's lede, not its heading — it is `programLede` in the schema and reads as one
     ("Dziesięć spojrzeń — i bis"). It scopes nothing the section's own <h2> does not already
     scope, so a heading level here would buy an outline step and hold no content. `text-wrap`
     is restated because a <p> would otherwise take `pretty` from base.css where this display
     line wants a heading's even rag. */
  .kd-section-title { font-family: var(--serif); font-weight: 300; line-height: 1.04; font-size: clamp(34px, 5.2vw, 68px); letter-spacing: -.01em; color: var(--ink); margin: 0; max-width: 20ch; text-wrap: balance; }

  /* ── Verbum: the spoken threshold word — dark register, guillemet quote up top +
     the full transcript under a disclosure (reuses .kd-text-cue/.kd-text-icon). ─────────── */
  .kd-verbum { background: var(--dark, #080807); color: var(--paper, #f4f1e9); }
  .kd-verbum .kd-section-label { color: var(--candle); }
  .kd-verbum-quote { margin: 0; }
  .kd-verbum-quote p { font-family: var(--serif); font-style: italic; font-weight: 300; font-size: clamp(22px, 2.6vw, 34px); line-height: 1.48; color: rgba(244, 241, 233, .94); margin: 0; letter-spacing: -.005em; }
  .kd-verbum-quote p::before { content: "« "; color: var(--candle); }
  .kd-verbum-quote p::after { content: " »"; color: var(--candle); }
  .kd-verbum-cite { margin: clamp(22px, 3vw, 32px) 0 0; font-family: var(--capitalis); font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: rgba(244, 241, 233, .56); }
  .kd-verbum-full { margin: clamp(40px, 5.5vw, 60px) 0 0; }
  .kd-verbum-full summary { list-style: none; display: inline-flex; align-items: center; gap: 10px; cursor: pointer; font-family: var(--capitalis); font-size: 10px; letter-spacing: .2em; text-transform: uppercase; color: var(--candle); padding: 4px 0; transition: color .3s var(--ease, ease); }
  .kd-verbum-full summary::-webkit-details-marker { display: none; }
  .kd-verbum-full summary:hover { color: var(--paper); }
  .kd-verbum-body { margin: 24px 0 0; display: grid; gap: 20px; max-width: 62ch; }
  .kd-verbum-body p { margin: 0; font-family: var(--serif); font-weight: 300; font-size: clamp(16px, 1.4vw, 18px); line-height: 1.68; color: rgba(244, 241, 233, .78); }
  /* The unsigned hand-off out of the word — quieter than the quote, our register. */
  .kd-verbum-bridge { margin: clamp(40px, 5.5vw, 60px) 0 0; max-width: 46ch; font-family: var(--serif); font-style: italic; font-weight: 300; font-size: clamp(17px, 1.6vw, 21px); line-height: 1.6; color: rgba(244, 241, 233, .64); }
  .kd-verbum-note { margin: clamp(22px, 3vw, 32px) 0 0; font-family: var(--mono); font-size: 10.5px; letter-spacing: .1em; color: rgba(244, 241, 233, .48); }

  /* ── Front matter: the evening's contents, printed once (markup above the hero's close) ──
     Deliberately SHALLOWER than a `.kd-band`: this is a leaf between the hero and the threshold,
     not a station of the evening, and full band padding would make the reader cross a screen of
     air to reach a list whose whole job is to be passed through quickly.

     The grammar is the chrome tabula's (numeral · name · leader · figure) because it indexes the
     same eight bands and a second grammar for one page's contents is a second vocabulary. What
     differs is scale and the leader: the bar's is drawn on hover because the bar is a control,
     and this one is standing type, so the hairline is simply there. */
  .kd-tabula-front { background: var(--night, #100f0d); color: var(--paper); padding-top: clamp(48px, 6vw, 78px); padding-bottom: clamp(48px, 6vw, 78px); }
  .kd-tabula-list { list-style: none; margin: 0; padding: 0; max-width: 720px; border-top: 1px solid rgba(244, 241, 233, .14); }
  .kd-tabula-row { border-bottom: 1px solid rgba(244, 241, 233, .14); }
  .kd-tabula-link { display: grid; grid-template-columns: 34px minmax(0, max-content) minmax(24px, 1fr) max-content; align-items: baseline; column-gap: clamp(12px, 1.4vw, 18px); padding: clamp(12px, 1.5vw, 16px) 0; color: inherit; text-decoration: none; transition: color .3s var(--ease); }
  .kd-tabula-link:hover { color: var(--candle); }
  .kd-tabula-roman { font-family: var(--capitalis); font-size: 11px; font-weight: 600; letter-spacing: .12em; color: var(--candle); }
  .kd-tabula-title { font-family: var(--serif); font-weight: 300; font-size: clamp(19px, 1.9vw, 24px); line-height: 1.2; white-space: nowrap; }
  /* Baseline-aligned with the title, so it must not be pushed by a wrapping one — the titles are
     the bands' own short names and none of them wraps at this measure down to 360. */
  .kd-tabula-lead { height: 1px; margin-bottom: 6px; background-color: currentColor; opacity: .2; }
  .kd-tabula-figure { font-family: var(--capitalis); font-size: 11px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: rgba(244, 241, 233, .5); white-space: nowrap; }
  /* The Latin figure is the one part a narrow row can lose: it names the band a second time, in a
     language the title has already said in Polish. Below this the leader takes its column. */
  @media (max-width: 560px) {
    .kd-tabula-link { grid-template-columns: 28px minmax(0, max-content) minmax(16px, 1fr); }
    .kd-tabula-figure { display: none; }
    .kd-tabula-title { font-size: 18px; }
  }

  /* ── Tour (dark, slim) ─────────────────────────────────────────────────── */
  .kd-tour { background: var(--night, #100f0d); color: var(--paper); padding-top: clamp(64px, 8vw, 108px); padding-bottom: clamp(64px, 8vw, 108px); }
  .kd-tour-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid rgba(244,241,233,.14); }
  .kd-tour-row { display: grid; grid-template-columns: minmax(180px, 240px) 1fr max-content; gap: 12px 28px; align-items: baseline; padding: clamp(18px, 2.4vw, 26px) 0; border-bottom: 1px solid rgba(244,241,233,.14); }
  .kd-tour-date { font-family: var(--serif); font-style: italic; font-size: clamp(19px, 2vw, 26px); color: var(--candle); }
  .kd-tour-venue { font-family: var(--serif); font-weight: 300; font-size: clamp(17px, 1.6vw, 21px); color: rgba(244,241,233,.9); }
  .kd-tour-time { font-family: var(--capitalis); font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: rgba(244,241,233,.56); }

  /* ── Reflection ────────────────────────────────────────────────────────── */
  .kd-reflection { background: var(--dark, #080807); color: var(--paper, #f4f1e9); text-align: left; }
  .kd-reflection .kd-section-label { color: var(--candle); }
  .kd-reflection-text { font-family: var(--serif); font-style: italic; font-weight: 300; font-size: clamp(23px, 2.6vw, 36px); line-height: 1.48; color: rgba(244, 241, 233, .94); margin: 18px 0 0; max-width: 760px; letter-spacing: -.005em; }
  .kd-reflection-attrib { margin: clamp(30px, 4vw, 48px) 0 0; color: rgba(244, 241, 233, .56); font-family: var(--capitalis); font-size: 11px; letter-spacing: .2em; text-transform: uppercase; }
  .kd-reflection-note { margin: clamp(28px, 4vw, 44px) 0 0; max-width: 640px; font-family: var(--serif); font-weight: 300; font-size: clamp(16px, 1.5vw, 19px); line-height: 1.62; color: rgba(244, 241, 233, .62); }

  /* ── Prologue: the threshold beat (centered, hushed — the doorway) ──────── */
  .kd-prologue { background: var(--night, #100f0d); color: var(--paper); text-align: center; padding-top: clamp(64px, 9vw, 116px); padding-bottom: clamp(64px, 9vw, 116px); }
  .kd-prologue .kd-narrow { margin-inline: auto; }
  .kd-prologue .kd-section-label { color: var(--candle); margin-bottom: 0; }
  /* 110px is the crossover: the raster master (456px tall) is still 4× oversampled here, while the
     vector's thin arm only just reaches a pixel. See `.brand-glyph-shape` in styles/base.css. */
  .kd-prologue-mark { display: block; width: 50px; height: 110px; margin: 0 auto clamp(24px, 3vw, 34px); background: linear-gradient(165deg, #e6d3a0 0%, #c6a45b 52%, #ad8a44 100%); -webkit-mask: url(/logo-mark.png) center / contain no-repeat; mask: url(/logo-mark.png) center / contain no-repeat; opacity: .82; }
  .kd-prologue-text { margin: clamp(20px, 3vw, 30px) auto 0; max-width: 58ch; font-family: var(--serif); font-weight: 300; font-size: clamp(19px, 2vw, 27px); line-height: 1.56; color: rgba(244, 241, 233, .84); letter-spacing: -.003em; }

  /* ── Program ───────────────────────────────────────────────────────────── */
  .kd-program-band { color: var(--ink); }
  /* Obsada colophon — role → name pairs beneath the founder's title. */
  .kd-credits { margin: clamp(28px, 4vw, 44px) 0 0; display: flex; flex-wrap: wrap; gap: 14px 40px; }
  .kd-credit { display: grid; gap: 3px; }
  .kd-credit dt { font-family: var(--capitalis); font-size: 10px; letter-spacing: .2em; text-transform: uppercase; color: var(--ink-muted, #746d62); }
  .kd-credit dd { margin: 0; font-family: var(--serif); font-size: clamp(17px, 1.5vw, 20px); color: var(--ink); }
  /* Dramaturgy lede — why THIS order. Sets up the reading like a programme-book note. */
  .kd-program-arc { margin: clamp(30px, 4vw, 46px) 0 0; max-width: 62ch; font-family: var(--serif); font-weight: 300; font-size: clamp(18px, 1.7vw, 23px); line-height: 1.6; color: var(--ink-soft, #34302b); letter-spacing: -.003em; padding-left: 18px; border-left: 1px solid color-mix(in srgb, var(--candle) 52%, transparent); }

  /* Movement / act header — the salvation-history acts the work-list travels through. Full-width
     row inside the <ol>; the strong rule above reads as an act divider. The first item under an
     act drops its own hairline so the act header + work don't stack two lines. */
  .kd-movement { list-style: none; padding: clamp(46px, 5.5vw, 74px) 0 clamp(20px, 3vw, 44px); border-top: 1px solid var(--line-strong, rgba(22,21,20,.34)); margin-top: clamp(16px, 2vw, 24px); }
  .kd-movement:first-child { border-top: 0; margin-top: 0; padding-top: clamp(4px, 1vw, 12px); }
  .kd-movement + .kd-program-item { border-top: 0; padding-top: 0; }
  .kd-movement-head { margin: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 16px; }
  .kd-movement-lat { font-family: var(--serif); font-style: italic; font-weight: 300; font-size: clamp(27px, 3.1vw, 42px); line-height: 1; letter-spacing: -.01em; color: var(--candle); }
  /* Weight stated for the same reason `.kd-section-label` states it: this span lives inside the
     act's <h3>, so with nothing declared it inherits the heading's UA `bold` and renders at
     Cinzel 700 — the only bold micro label on the page, and an accident rather than a decision.
     Its Latin sibling escaped it only by setting a weight of its own. */
  /* `--ink-soft`, not `--ink-muted`: muted clears AA on parchment by 0.03, and this is the least
     forgiving setting on the page for it — 10.5px of Cinzel capitals at .24em, where the tracking
     breaks the word shape and the capitals remove the ascender cues that carry it. The hierarchy
     against the Latin above is held by size and tracking, so nothing needs lightness to say it. */
  .kd-movement-gloss { font-family: var(--capitalis); font-weight: 400; font-size: 10.5px; letter-spacing: .24em; text-transform: uppercase; color: var(--ink-soft, #34302b); }
  .kd-movement-line { margin: 14px 0 0; max-width: 56ch; font-family: var(--serif); font-style: italic; font-weight: 300; font-size: clamp(16px, 1.5vw, 20px); line-height: 1.5; color: var(--ink-soft, #34302b); }

  /* Interlude — a full-bleed dark scripture beat at a dramatic hinge. Breaks out of the
     parchment program to the viewport edges (no transform, so `.reveal` translateY is free),
     bringing the night nave back mid-reading. */
  .kd-interlude { list-style: none; width: 100vw; margin-inline: calc(50% - 50vw); margin-block: clamp(48px, 6vw, 92px); padding: clamp(76px, 11vw, 148px) max(28px, 7vw); background: var(--night, #100f0d); color: var(--paper); text-align: center; }
  .kd-interlude::before { content: ""; display: block; width: 34px; height: 1px; margin: 0 auto clamp(28px, 4vw, 42px); background: color-mix(in srgb, var(--candle) 72%, transparent); }
  .kd-interlude-lat { margin: 0 auto; max-width: 22ch; font-family: var(--serif); font-style: italic; font-weight: 300; font-size: clamp(26px, 4vw, 52px); line-height: 1.2; letter-spacing: -.01em; color: var(--candle); }
  .kd-interlude-gloss { margin: clamp(18px, 2.5vw, 28px) auto 0; max-width: 36ch; font-family: var(--serif); font-weight: 300; font-size: clamp(16px, 1.6vw, 21px); line-height: 1.5; color: rgba(244, 241, 233, .74); }
  .kd-interlude-ref { display: block; margin-top: clamp(20px, 3vw, 32px); font-family: var(--capitalis); font-size: 10px; letter-spacing: .24em; text-transform: uppercase; color: rgba(244, 241, 233, .5); }
  /* An act header straight after the interlude drops its own rule + top gap (the dark beat
     already gave the break). */
  .kd-interlude + .kd-movement { border-top: 0; margin-top: 0; padding-top: clamp(6px, 1.5vw, 16px); }

  .kd-program { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--line, rgba(22,21,20,.16)); }
  .kd-program-item { display: grid; grid-template-columns: max-content 1fr; gap: clamp(20px, 3vw, 44px); padding: clamp(28px, 4vw, 44px) 0; border-top: 1px solid var(--line, rgba(22,21,20,.16)); align-items: start; }
  .kd-program-item.is-bis { border-top-style: dashed; }
  .kd-program-num { font-family: var(--capitalis); font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--candle-ink); padding-top: 8px; min-width: 30px; text-align: right; }
  .kd-program-item.is-bis .kd-program-num { color: var(--ink-muted, #746d62); }
  .kd-program-body { display: grid; gap: 8px; min-width: 0; }
  .kd-program-composer { margin: 0; font-family: var(--capitalis); font-size: 11.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--ink, #161514); }
  .kd-program-composer-name { font-weight: 500; }
  .kd-program-years { color: var(--ink-muted, #746d62); font-weight: 300; }
  /* The row gap is not decoration: the title sets at line-height 1.16, which leaves nothing under
     the baseline, so a rail that dropped to the next line landed in the descenders of the work it
     belongs to. It costs nothing while the two share a line. */
  .kd-program-work { margin: 0; font-family: var(--serif); font-size: clamp(23px, 2.5vw, 34px); font-weight: 300; line-height: 1.16; color: var(--ink); letter-spacing: -.005em; display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 12px; }
  .kd-program-work em { font-style: italic; }
  /* One item in the title's row, so the rail breaks away whole. `center` against the title is the
     chips' own alignment, moved up here now that they no longer face it individually; inside the
     rail they sit on a shared baseline. */
  .kd-program-meta { display: flex; flex-wrap: wrap; align-items: baseline; align-self: center; gap: 4px 12px; }
  /* Mono micro chips (year · scoring · duration) — the honesty of the craft. Each carries a
     thin left divider so they read as a metadata rail after the title. ONE INK ACROSS THE THREE:
     they are a single rail read in one glance, so a chip that is lighter than its neighbours
     reads as a different kind of fact rather than as a lesser one. `--ink-soft` for the reason
     `.kd-movement-gloss` takes it — tracked capitals at 11px are where muted's 0.03 of headroom
     stops being enough to read comfortably, whatever the ratio says. */
  .kd-program-year,
  .kd-program-voicing,
  .kd-program-duration { font-family: var(--capitalis); font-style: normal; font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-soft, #34302b); padding-left: 12px; border-left: 1px solid var(--line, rgba(22,21,20,.16)); }

  /* The floor tracks `.kd-program-note-work`'s and must keep tracking it: this motto stands ABOVE
     the wall-label note in the entry's order, so a narrow window that left it the smaller of the
     two inverted the hierarchy at exactly the widths where the column is hardest to read.

     THE CEILING IS ITS OWN RUNG, above the note's 16px rather than level with it. This line is the
     entry's epigraph — the scripture the work is written on — and the note beneath it is apparatus
     explaining it; set at one size the sans note carries more ink per glyph and simply outweighs
     it, which is the apparatus talking over its text. Size does the separating and not colour:
     `--ink-muted` stays, because serif at this size is what that token was drawn for and darkening
     it would close the gap to the work title over it instead. */
  .kd-program-inscriptio { margin: 6px 0 0; font-family: var(--serif); font-size: clamp(15.5px, 1.2vw, 17px); line-height: 1.55; color: var(--ink-muted, #746d62); }
  .kd-program-inscriptio-lat { font-style: italic; color: var(--ink-soft, #34302b); }
  .kd-program-inscriptio-gloss { color: var(--ink-muted, #746d62); }
  .kd-program-inscriptio-ref { font-family: var(--capitalis); font-style: normal; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-muted, #746d62); }

  /* Rubric — the missal's other ink. In a liturgical book the sung text is black and the
     instruction ("open", "kneel") is red; here the register does that work instead of the
     colour, which belongs to the station's candle: a lozenge, a candle rule and the faintest
     candle wash, set in the mono voice the page reserves for facts. `justify-self: start` is
     load-bearing: the body is a grid, which would otherwise stretch it into a banner instead
     of the sentence-wide direction this is. */
  .kd-rubric { margin: 14px 0 2px; justify-self: start; display: flex; align-items: center; gap: 12px; padding: 9px 18px 9px 14px; border-left: 2px solid var(--candle); background: color-mix(in srgb, var(--candle) 9%, transparent); font-family: var(--capitalis); font-size: 10px; letter-spacing: .22em; text-transform: uppercase; line-height: 1.5; color: var(--ink-soft, #34302b); }
  .kd-rubric-mark { width: 6px; height: 6px; flex: none; transform: rotate(45deg); background: var(--candle); }

  /* Per-work note — the "why this work" gloss, a museum wall-label register.
     THE ONLY SANS COPY ON THIS PAGE THAT IS READ IN QUANTITY, and it is set heavier and larger
     than the site's resting 300 for that reason alone. `--ink-muted` measures 4.53 : 1 on
     parchment, which clears AA — but a reader sitting with a whole programme reported eye strain
     at 14px / 300 / 60ch, and the fatigue lives in the stroke and the size, not in the ratio. AA
     is a threshold of perceivability, never one of reading comfort. Raise the colour to
     `--ink-soft` only if weight and size prove not to be enough; dimming this note further to
     match the micro notes beside it is what created the defect. */
  .kd-program-note-work { margin: 10px 0 0; max-width: 60ch; font-family: var(--sans); font-weight: 400; font-size: clamp(15.5px, 1.4vw, 16px); line-height: 1.7; color: var(--ink-muted, #746d62); }

  /* Sung text + translation (native <details>) */
  .kd-text { margin: 14px 0 0; }
  .kd-text summary { list-style: none; display: inline-flex; align-items: center; gap: 10px; cursor: pointer; font-family: var(--capitalis); font-size: 10px; letter-spacing: .2em; text-transform: uppercase; color: var(--candle-ink); padding: 4px 0; transition: color .3s var(--ease, ease); }
  .kd-text summary::-webkit-details-marker { display: none; }
  .kd-text summary:hover { color: var(--ink); }
  .kd-text-icon { position: relative; width: 10px; height: 10px; flex-shrink: 0; }
  .kd-text-icon::before,
  .kd-text-icon::after { content: ""; position: absolute; background: currentColor; transition: transform .35s var(--ease, ease), opacity .35s var(--ease, ease); }
  .kd-text-icon::before { left: 0; top: 4.5px; width: 10px; height: 1px; }
  .kd-text-icon::after { left: 4.5px; top: 0; width: 1px; height: 10px; }
  /* Both disclosures wear this icon, so both close its vertical stroke. The Verbum used to keep
     a plus sign over an open transcript — the one state the mark exists to distinguish. */
  .kd-text[open] .kd-text-icon::after,
  .kd-verbum-full[open] .kd-text-icon::after { transform: scaleY(0); opacity: 0; }
  .kd-text-cols { margin: 16px 0 2px; display: grid; grid-template-columns: 1fr 1fr; gap: clamp(20px, 3vw, 48px); max-width: 720px; padding-left: clamp(14px, 2vw, 22px); border-left: 1px solid var(--line, rgba(22,21,20,.16)); }
  .kd-text-cols.is-single { grid-template-columns: 1fr; }
  /* Sung texts are the longest run of small serif on the site, on parchment, and one of
     them is a Ukrainian hymn — so they get the same optical compensation as the footer's
     small band: more weight and more size to stand in for the `opsz` axis Cormorant does
     not have. Weight 460 matches .foundation-seat; do not lower it without lowering the
     size too. The Cyrillic subset (base.css) only exists for these two rules. */
  .kd-text-orig { margin: 0; font-family: var(--serif); font-style: italic; font-weight: 460; font-size: clamp(16px, 1.45vw, 18px); line-height: 1.62; color: var(--ink-soft, #34302b); white-space: pre-line; }
  .kd-text-gloss { margin: 0; font-family: var(--serif); font-weight: 460; font-size: clamp(16px, 1.45vw, 18px); line-height: 1.62; color: var(--ink-muted, #746d62); white-space: pre-line; }

  /* ── The unfold: what happens inside a disclosure while its box grows ─────────────────────
     The height belongs to scripts/disclosure.ts; this is the word arriving behind the growing
     edge instead of standing complete inside a frame that is still opening. The order is the
     reading order — the Latin is the verse and the Polish is what it says, the same call the
     interlude makes a few rules up — and it is expressed as onsets, never as a mask travelling
     through a line (docs/web-reveal-remediation.md, Rejected).

     Gated twice, like every other motion on this page: `voct-motion` says JS is live and motion
     is allowed (DocumentGates), the media query reads the preference directly. Without JS there
     is no growing box for any of this to sit inside — the <details> is native and snaps. */
  @media (prefers-reduced-motion: no-preference) {
    @keyframes kdUnfold { from { opacity: 0; transform: translateY(6px); } }
    html.voct-motion .kd-text[open] :is(.kd-text-orig, .kd-text-gloss),
    html.voct-motion .kd-verbum-full[open] .kd-verbum-body p {
      animation: kdUnfold .46s var(--ease, ease) both;
    }
    html.voct-motion .kd-text[open] .kd-text-gloss { animation-delay: .12s; }
    /* Every onset has to fall inside the box's own 480ms (DISCLOSURE_OPEN_MS), or the reader is
       watching a queue rather than a page opening. Nine paragraphs is the longest transcript the
       site holds and 50ms clears it with room; the cap is what keeps that true of the tenth. */
    html.voct-motion .kd-verbum-full[open] .kd-verbum-body p {
      animation-delay: min(calc(var(--i, 0) * 50ms), 400ms);
    }
  }

  /* Clasp row — the seam between works. Two registers: a bare label on a rule (Wołanie Gór's
     "Przerwa"), or a sung return that brings its words with it (9 Kart — Psalm 51 coming back
     nine times between the psalms). The label's own rule IS the seam, so the row carries no
     border-top of its own: two hairlines twenty pixels apart read as a misprint, not a decision.
     The words hang below it, centered and candle-lit, the same grammar the dark interlude uses
     — scripture returning, here slim and on parchment. The translation takes the same optical
     compensation as the sung texts above (460, not 300): small Cormorant on parchment, and this
     one is centred on top of that. The measure holds a whole psalm verse — in centred pre-line
     text a wrap is indistinguishable from an authored verse break. */
  .kd-clasp { padding: clamp(14px, 2vw, 20px) 0; }
  /* The label is read and the two hairlines are seen, so they part company here: the word takes
     the ink, the seam keeps the candle. The pseudo-rules state their colour outright rather than
     inheriting `currentColor` precisely so this split costs one declaration. */
  .kd-clasp-rule { display: flex; align-items: center; gap: 16px; font-family: var(--capitalis); font-size: 10px; letter-spacing: .24em; text-transform: uppercase; color: var(--candle-ink); }
  .kd-clasp-rule::before,
  .kd-clasp-rule::after { content: ""; height: 1px; background: color-mix(in srgb, var(--candle) 40%, transparent); flex: 1; }
  .kd-clasp.is-sung { padding-bottom: clamp(32px, 4vw, 48px); }
  /* A bare label has nothing under it, so the work that follows would put its own hairline a
     breath below the label's — the sung variant is spared this by the psalm sitting between. */
  .kd-clasp:not(.is-sung) + .kd-program-item { border-top: 0; }
  .kd-clasp-lat { margin: clamp(22px, 2.8vw, 32px) auto 0; max-width: 56ch; text-align: center; font-family: var(--serif); font-style: italic; font-weight: 300; font-size: clamp(17.5px, 1.7vw, 23px); line-height: 1.5; color: var(--candle); white-space: pre-line; }
  .kd-clasp-gloss { margin: clamp(12px, 1.6vw, 18px) auto 0; max-width: 56ch; text-align: center; font-family: var(--serif); font-weight: 460; font-size: clamp(15.5px, 1.35vw, 18px); line-height: 1.62; color: var(--ink-muted, #746d62); white-space: pre-line; }

  .kd-program-foot { display: flex; flex-wrap: wrap; gap: 12px 32px; align-items: baseline; margin: clamp(40px, 5vw, 64px) 0 0; }
  .kd-program-note { font-family: var(--mono); font-size: 10.5px; letter-spacing: .1em; color: var(--ink-muted, #746d62); margin: 0; text-transform: none; }
  /* A per-concert factual footnote is a sentence, not a timecode — give it the wall-label
     register (as per-work notes) and its own row above the standing micro notes. Weight and size
     track `.kd-program-note-work` exactly, and for its reasons: the two are one register, so a
     divergence here would read as a hierarchy that is not intended. */
  .kd-program-note-lead { flex-basis: 100%; max-width: 62ch; font-family: var(--sans); font-weight: 400; font-size: clamp(15.5px, 1.4vw, 16px); line-height: 1.7; letter-spacing: 0; padding-bottom: 4px; }
  .kd-spotify-link { font-family: var(--mono); font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--candle-ink); border-bottom: 1px solid transparent; padding-bottom: 2px; transition: border-color .3s var(--ease, ease); }
  .kd-spotify-link:hover { border-bottom-color: var(--candle-ink); }

  /* ── Pull quote ────────────────────────────────────────────────────────── */
  .kd-pullquote { background: var(--paper-soft, #ebe6da); color: var(--ink, #161514); }
  .kd-quote { margin: 0; }
  .kd-quote p { font-family: var(--serif); font-style: italic; font-weight: 300; font-size: clamp(22px, 2.6vw, 34px); line-height: 1.45; color: var(--ink); margin: 0; letter-spacing: -.005em; }
  .kd-quote p::before { content: "« "; color: var(--candle); }
  .kd-quote p::after { content: " »"; color: var(--candle); }
  .kd-cite { display: flex; flex-direction: column; gap: 6px; margin-top: clamp(28px, 4vw, 44px); padding-top: 18px; border-top: 1px solid var(--line, rgba(22,21,20,.16)); font-style: normal; }
  .kd-cite-name { font-family: var(--serif); font-style: italic; font-size: clamp(16px, 1.5vw, 20px); color: var(--ink); }
  /* `--ink-soft`, not the `--ink-muted` every other caption on this page takes: this band is the
     page's only `--paper-soft` ground, and muted measures 4.53 : 1 on `--paper` but 4.11 on
     paper-soft — under AA at 10.5px. The step down to the citation's name (`--ink`) survives:
     10.5 : 1 against 15 : 1. Any other small `--ink-muted` string moved onto this band needs
     the same treatment. */
  .kd-cite-about { font-family: var(--capitalis); font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; color: var(--ink-soft, #34302b); }

  /* ── Voces: the evening's cast, grouped by voice part ──────────────────── */
  .kd-voces { padding-top: clamp(72px, 9vw, 120px); padding-bottom: clamp(72px, 9vw, 120px); }
  .kd-voces .kd-section-label { margin-bottom: clamp(36px, 5vw, 56px); }
  .kd-voces-grid { margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(180px, 100%), 1fr)); gap: clamp(28px, 4vw, 44px) clamp(24px, 3vw, 40px); }
  .kd-voces-group { min-width: 0; }
  .kd-voces-voice { margin: 0 0 12px; font-family: var(--capitalis); font-size: 10px; letter-spacing: .22em; text-transform: uppercase; color: var(--candle-ink); }
  .kd-voces-name { margin: 0 0 6px; font-family: var(--serif); font-weight: 300; font-size: clamp(18px, 1.7vw, 22px); line-height: 1.25; color: var(--ink); }
  .kd-voces-detail { margin: 12px 0 0; max-width: 32ch; font-family: var(--sans); font-weight: 300; font-size: clamp(13px, 1vw, 14px); line-height: 1.65; color: var(--ink-muted, #746d62); }
  .kd-voces-note { margin: clamp(40px, 5vw, 60px) 0 0; padding-top: 18px; border-top: 1px solid var(--line, rgba(22,21,20,.16)); max-width: 56ch; font-family: var(--serif); font-style: italic; font-weight: 300; font-size: clamp(15px, 1.3vw, 17px); line-height: 1.6; color: var(--ink-muted, #746d62); }

  /* ── Documentary gallery ───────────────────────────────────────────────── */
  .kd-gallery { background: var(--night, #100f0d); color: var(--paper); }
  .kd-gallery .kd-section-label { margin-bottom: clamp(36px, 5vw, 56px); }
  /* Rows are hung by height, not cut into columns: each shot holds the fraction of the measure
     its own aspect needs at the row height (`--share`, from lib/galleryLayout), so portraits pack
     four to a row where landscapes take three, and the line wraps as soon as the next one stops
     fitting — no breakpoints, because the photographs decide. Nothing grows: a short last row
     hangs centred at the height of the rows above it rather than inflating to fill its line. */
  .kd-gallery-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: clamp(20px, 3vw, 40px); }
  .kd-shot { margin: 0; min-width: 0; flex: 0 1 calc(var(--share) * 100%); max-width: calc(var(--share) * 100%); }
  /* A run's head, and only on an evening that had more than one — the rehearsal, or a city of the
     tour. It is a hairline row rather than a heading: the section already has a label, and what
     this says is which night the frames under it come from, not that a new section began. */
  .kd-gallery-run + .kd-gallery-run { margin-top: clamp(44px, 6vw, 76px); }
  .kd-run-head { margin: 0 0 clamp(20px, 3vw, 30px); padding-top: 16px; border-top: 1px solid rgba(244,241,233,.14); display: flex; flex-wrap: wrap; align-items: baseline; font-family: var(--capitalis); font-size: 10.5px; letter-spacing: .2em; text-transform: uppercase; color: rgba(244,241,233,.62); }
  /* Bounds the veil to the image: `inset: 0` on the figure would also darken the caption, which
     is copy and belongs to the ink. */
  .kd-shot-media { position: relative; display: block; }
  /* One shot per row, full measure, wherever the packing cannot pay for itself. THE NUMBER IS
     §2's, not a phone's: `--share` is computed once against the 1120 measure, so how many frames
     stand in a row is fixed at build and only their SIZE tracks the viewport — there is no
     two-up to fall back to, and this breakpoint is the only lever the layout has. Measured on
     9 Kart's Kraków run (three-up, the page's densest): 660 → 183×122, 768 → 213×142,
     860 → 238×159, i.e. the whole tablet band sat at or under the 240×160 at which §2 says these
     chiaroscuro frames stop being photographs and become black rectangles. Three-up first clears
     that with margin at 960 (266 wide), which is why the break is here and not at the 640 it
     shipped with or the 720 /obrazy uses — that page's rows are a SHEET standing under a plate,
     already the small half of a pair, and this one is the whole gallery.
     `sizes` carries the same number: below it the frame is served at 92vw, and a ladder still
     picking a rendition for the packed width would hand a ~900px frame a 363px file. */
  @media (max-width: 960px) {
    .kd-shot { flex-basis: 100%; max-width: 100%; }
  }
  .kd-shot :global(img) { width: 100%; height: auto; display: block; border: 1px solid rgba(244,241,233,.12); box-shadow: 0 40px 90px -46px rgba(0,0,0,.9); }
