---
/**
 * @file MecenatPage.astro
 * @description Locale-agnostic body of /mecenat — the foundation's letter to a patron. It is reached
 *  by a personal link and from /fundacja, never from the menu, and it reads in one column: the
 *  idea, the current realisation (the same module /fundacja prints), its budget and the areas a
 *  patron may take on, how close a patron may stand to the work, one person to talk to, and the
 *  foundation's page as the proof. Spec: docs/specs/web-foundation-rebuild-2026-09.md §3–§5.
 *
 *  ONE PROJECT, ONE NUMBER, ONE PERSON. No giving amounts, no vault, no form: a patron does not
 *  read beside 50 zł examples, and the conversation is the whole mechanism. The contact is named
 *  and addressed; the budget is the one the board confirmed, with its date.
 *
 *  WHAT IS A FACT AND WHERE IT COMES FROM. The realisation is `lib/realisations` over the corpus
 *  and `data/foundationSupport.ts`; the sheet's labels are /fundacja's copy; the contact's name,
 *  function and address are `data/foundation.ts` through `FOUNDATION_CONTACT`. This page's own
 *  words come from `content/pages/mecenat.yaml`; its chrome from `i18n/content/mecenat.ts`.
 *
 *  STATIC FIRST. Complete with scripts and motion off.
 * @architecture Astro islands 2026
 * @module components/pages/MecenatPage
 */
import { getCollection } from "astro:content";
import { getImage, Picture } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteChrome from "../SiteChrome.astro";
import SiteFooter from "../SiteFooter.astro";
import RealisationModule from "../foundation/RealisationModule.astro";
import { bleedPair, photoOptional } from "../../lib/photos";
import { frameCredit } from "../../lib/photoCredit";
import { pageCopy } from "../../lib/pageCopy";
import { featuredRealisationView } from "../../lib/realisations";
import { FOUNDATION } from "../../data/foundation";
import {
  FEATURED_REALISATION,
  FOUNDATION_CONTACT,
  FOUNDATION_PAGE_LINKED,
  MECENAT_CONTACT,
} from "../../data/foundationSupport";
import { FUNDACJA_PAGE } from "../../i18n/content/fundacja";
import { MECENAT_CHROME, MECENAT_PAGE } from "../../i18n/content/mecenat";
import { UI } from "../../i18n/ui";
import { localizePath, pageI18n, type Locale } from "../../i18n/config";
import { GOALS, goalClass } from "../../lib/plausible";

interface Props {
  /** Which language this render is. Drives the copy, the chrome, the URL and the hreflang graph. */
  lang: Locale;
}
const { lang } = Astro.props;

const copy = pageCopy(MECENAT_PAGE, lang);
const foundationCopy = pageCopy(FUNDACJA_PAGE, lang);
const t = MECENAT_CHROME[lang];
const { path, alternates, available } = pageI18n("/mecenat", lang);
const foundationPath = pageI18n("/fundacja", lang).path;
const hrefFoundation = localizePath("/fundacja", lang);

const fill = (template: string, slots: Record<string, string>): string =>
  template.replace(/\{(\w+)\}/g, (match, name: string) => slots[name] ?? match);

// The lead and the areas are written for one concert; a featured realisation this copy was not
// written for would print the wrong project's areas under the right project's title.
if (copy.realisation.id !== FEATURED_REALISATION) {
  throw new Error(
    `[mecenat] mecenat.yaml is written for realisation "${copy.realisation.id}", but FEATURED_REALISATION is "${FEATURED_REALISATION}". Rewrite the lead and the areas.`,
  );
}
const concerts = await getCollection("concerts");
const eras = await getCollection("repertoire");
const view = featuredRealisationView(concerts, eras, lang);
const aboutBody = fill(copy.about.body, { amount: view.budget.amount, date: view.budget.asOf });

const person = FOUNDATION.board.find((b) => b.id === MECENAT_CONTACT);
if (!person) throw new Error(`[mecenat] MECENAT_CONTACT "${MECENAT_CONTACT}" is not on the board.`);
const personRole = fill(copy.contact.role, {
  function: person.function === "president" ? foundationCopy.mission.president : foundationCopy.mission.vicePresident,
});
const mail = FOUNDATION_CONTACT.mecenat;
const mailHref = `mailto:${mail}?subject=${encodeURIComponent(copy.contact.mailSubject)}`;

const rehearsalPhoto = photoOptional("mecenat-proba-partytury");
const rehearsalCredit = frameCredit({}, lang);

// A shared link previews with the project it is about: the realisation's own key visual, or the
// nave plate /fundacja shares when a realisation has none.
const ogSource = view.visual?.desktop ?? bleedPair("chor-nawa").desktop;
const ogImage = (await getImage({ src: ogSource, width: 1200, format: "webp" })).src;
---

<BaseLayout
  title={copy.meta.title}
  description={copy.meta.description}
  path={path}
  image={ogImage}
  bodyClass="page-mecenat"
  lang={lang}
  alternates={alternates}
  breadcrumb={[
    { name: UI[lang].nav.foundation, path: foundationPath },
    { name: t.crumb, path },
  ]}
>
  <Fragment slot="head">
    {/* Announced together with /fundacja (FOUNDATION_PAGE_LINKED); until then a patron's link
        works and a search engine is kept out — the sitemap filter in astro.config.mjs agrees. */}
    {!FOUNDATION_PAGE_LINKED && <meta name="robots" content="noindex,follow" />}
  </Fragment>

  <a class="skip-link" href="#tresc">{UI[lang].skipToContent}</a>
  <SiteChrome current="/mecenat" lang={lang} availableLocales={available} />

  <main id="tresc" class="mc">
    <div class="mc-wrap">
      <header class="mc-head">
        <p class="mc-eyebrow">{copy.eyebrow}</p>
        <h1 class="mc-title">{copy.h1}</h1>
        <p class="mc-idea">{copy.idea}</p>
      </header>

      <section class="mc-realisation" aria-label={t.realisationAria}>
        <RealisationModule
          view={view}
          rubric={view.ahead ? copy.realisation.rubricAhead : copy.realisation.rubricPast}
          lead={copy.realisation.lead}
          labels={foundationCopy.realisation}
          withNotes={false}
          donateHref={`${localizePath("/", lang)}?donate`}
        />
      </section>

      <section class="mc-block">
        <h2 class="mc-h2">{copy.about.h2}</h2>
        <p class="mc-body">{aboutBody}</p>
        <ul class="mc-areas">
          {copy.realisation.areas.map((area) => <li>{area.text}</li>)}
        </ul>
      </section>

      <section class={rehearsalPhoto ? "mc-block mc-presence mc-presence-with-photo" : "mc-block mc-presence"}>
        <div>
          <h2 class="mc-h2">{copy.presence.h2}</h2>
          <p class="mc-body">{copy.presence.body}</p>
        </div>
        {rehearsalPhoto && (
          <figure class="mc-photo">
            {/* The caption says what the frame shows; the alt stays empty rather than repeat it. */}
            <Picture
              src={rehearsalPhoto}
              formats={["avif", "webp"]}
              widths={[480, 800, 1200, 1600]}
              width={Math.min(rehearsalPhoto.width, 1600)}
              sizes="(min-width: 960px) 420px, 100vw"
              alt=""
              loading="lazy"
              decoding="async"
            />
            <figcaption>{copy.presence.photoCaption} · {rehearsalCredit}</figcaption>
          </figure>
        )}
      </section>

      <p class="mc-coda">{copy.coda}</p>

      <section class="mc-contact" aria-label={t.contactAria}>
        <p class="mc-body mc-contact-lead">{copy.contact.lead}</p>
        <p class="mc-person">{person.name}</p>
        <p class="mc-role">{personRole}</p>
        <p class="mc-mail-line">
          <a class={`mc-mail ${goalClass(GOALS.mailPatronage)}`} href={mailHref}>{mail}</a>
          <button type="button" class="copy-btn" data-copy={mail} data-copied={t.copied} aria-label={t.copyAria.replace("{what}", mail)}>
            <span class="copy-label">{t.copy}</span>
          </button>
        </p>
      </section>

      <p class="mc-proof"><a href={hrefFoundation}>{copy.proof}</a></p>
    </div>
  </main>

  <SiteFooter lang={lang} />

  <script>
    import "../../scripts/copy-fields.ts";
  </script>
</BaseLayout>

<style>
  /* One column in an 880 measure, on the site's paper. The realisation's visual crosses to the
     viewport's right edge — `--vf-bleed` is the distance from this measure's edge to it. */
  .mc { --vf-bleed: max(var(--gutter), calc((100vw - 880px) / 2)); --mc-rule: color-mix(in oklab, var(--ink) 16%, transparent); }
  .mc a:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  .mc-wrap { max-width: 880px; margin: 0 auto; padding: clamp(96px, 9vw, 132px) var(--gutter) clamp(72px, 10vw, 136px); box-sizing: content-box; }

  .mc-eyebrow { margin: 0; font-family: var(--mono); font-size: 12px; font-weight: 500; letter-spacing: .06em; color: var(--ink-muted); }
  .mc-title { margin: 18px 0 0; max-width: 18ch; font-family: var(--sans); font-weight: 600; font-variation-settings: normal; font-size: clamp(34px, 5.2vw, 64px); line-height: 1.04; letter-spacing: -.04em; color: var(--ink); text-wrap: balance; }
  .mc-idea { margin: clamp(22px, 3vw, 32px) 0 0; max-width: 56ch; font-family: var(--sans); font-size: clamp(17px, 1.5vw, 20px); line-height: 1.55; color: var(--ink-soft); }

  .mc-realisation { margin: clamp(56px, 8vw, 96px) 0 0; }

  .mc-block { margin: clamp(48px, 6vw, 72px) 0 0; padding-top: 18px; border-top: 1px solid var(--ink); }
  .mc-h2 { margin: 0; font-family: var(--sans); font-weight: 600; font-size: clamp(22px, 2.2vw, 28px); line-height: 1.15; letter-spacing: -.02em; color: var(--ink); }
  .mc-body { margin: 14px 0 0; max-width: 64ch; font-family: var(--sans); font-size: clamp(16px, 1.2vw, 17px); line-height: 1.65; color: var(--ink-soft); }
  .mc-areas { list-style: none; margin: 14px 0 0; padding: 0; border-top: 1px solid var(--mc-rule); max-width: 34rem; }
  .mc-areas li { padding: 10px 0; border-bottom: 1px solid var(--mc-rule); font-family: var(--sans); font-size: 16px; line-height: 1.45; color: var(--ink); }

  .mc-presence-with-photo { display: grid; gap: clamp(24px, 3vw, 40px); }
  @media (min-width: 960px) { .mc-presence-with-photo { grid-template-columns: minmax(0, 1fr) 380px; align-items: start; } }
  .mc-photo { margin: 0; }
  .mc-photo :global(img) { display: block; width: 100%; height: auto; }
  .mc-photo figcaption { margin: 10px 0 0; font-family: var(--mono); font-size: 12px; line-height: 1.5; color: var(--ink-muted); }

  /* Anna Marcisz's closing sentence — a person's words, so the one italic on the page. */
  .mc-coda { margin: clamp(56px, 8vw, 96px) 0 0; max-width: 30ch; font-family: var(--serif); font-style: italic; font-weight: 400; font-size: clamp(26px, 3.2vw, 40px); line-height: 1.2; color: var(--ink); text-wrap: balance; }

  .mc-contact { margin: clamp(48px, 6vw, 72px) 0 0; padding-top: 18px; border-top: 1px solid var(--ink); }
  .mc-contact-lead { margin-top: 0; }
  .mc-person { margin: 24px 0 0; font-family: var(--sans); font-weight: 600; font-size: 20px; line-height: 1.3; color: var(--ink); }
  .mc-role { margin: 4px 0 0; font-family: var(--mono); font-size: 12px; letter-spacing: .04em; color: var(--ink-muted); }
  .mc-mail-line { margin: 18px 0 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px 16px; }
  .mc-mail { font-family: var(--sans); font-weight: 500; font-size: clamp(20px, 2.4vw, 28px); color: var(--ink); text-decoration: underline; text-decoration-color: color-mix(in oklab, var(--ink) 30%, transparent); text-underline-offset: .2em; text-decoration-thickness: 1px; overflow-wrap: anywhere; transition: text-decoration-color .25s var(--ease); }
  .mc-mail:hover { text-decoration-color: currentColor; }
  .mc :global(.copy-btn) { display: inline-flex; align-items: center; min-height: 32px; font-family: var(--mono); font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-soft); background: transparent; border: 1px solid var(--mc-rule); border-radius: 2px; padding: 0 10px; cursor: pointer; transition: color .25s var(--ease), border-color .25s var(--ease); }
  .mc :global(.copy-btn:hover) { color: var(--ink); border-color: var(--ink); }
  .mc :global(.copy-btn.is-copied) { color: var(--sage); border-color: var(--sage); }

  .mc-proof { margin: clamp(48px, 6vw, 72px) 0 0; }
  .mc-proof a { font-family: var(--sans); font-weight: 500; font-size: 16px; color: var(--ink); text-decoration: underline; text-decoration-color: color-mix(in oklab, var(--ink) 30%, transparent); text-underline-offset: .22em; text-decoration-thickness: 1px; transition: text-decoration-color .25s var(--ease); }
  .mc-proof a:hover { text-decoration-color: currentColor; }
</style>
