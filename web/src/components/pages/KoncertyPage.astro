---
/**
 * @file KoncertyPage.astro
 * @description Locale-agnostic body of the concerts index (/koncerty). Dark full-bleed stations
 *  rendered from the `concerts` collection, then — stepping out of the night nave into parchment
 *  light — the "Reguły wieczoru" rite section and the seven-century repertoire catalog. Program
 *  lists use native <details> (zero JS); the Via rail + chrome light/dark tone are driven by
 *  IntersectionObservers (page-scoped). The three route files (/koncerty, /en/koncerty,
 *  /fr/koncerty) are one-liners that differ only in `lang`.
 *
 *  WHERE EVERY WORD COMES FROM — three sources meet here and keeping them apart is what makes the
 *  page legible:
 *
 *  - What the PAGE says (the hero, the four rules, the two section heads, the unwritten station,
 *    the closing invitation) is Polish prose in `src/content/pages/koncerty.yaml`, read through
 *    `lib/pageCopy` with the copy desk's translations substituted per field.
 *  - What a CONCERT says (its title, essence, dateline, incipit, facts, poster alt, credits) is
 *    `concerts.yaml` read through the desk's overlay by concert key — `say()` below — and NEVER
 *    through `pickLocale`: the corpus has been Polish-only since stage C3, so a `LocalizedText` in
 *    it carries `pl` alone and `pickLocale` would hand back Polish in every locale, silently, on a
 *    page that looked translated. This is exactly what /koncerty/[id] does.
 *  - What the CHROME says (landmarks, affordances, the station numeral's word) is
 *    `i18n/content/koncerty.ts`, `i18n/content/koncert.ts` and `i18n/ui.ts`; era headings are
 *    `i18n/content/repertuar.ts`, because the landing's litany plate prints them too.
 *
 *  Composers, work titles, Latin rubrics, roman numerals and dates are none of the above: names
 *  and structure, printed unchanged or formatted per locale (lib/dates).
 * @architecture Astro islands 2026
 * @module components/pages/KoncertyPage
 */
import { getCollection } from "astro:content";
import { getImage, Picture } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteChrome from "../SiteChrome.astro";
import SiteFooter from "../SiteFooter.astro";
import BleedImage from "../BleedImage.astro";
import { photo, bleedPair } from "../../lib/photos";
import { absolute, musicEvent } from "../../lib/eventSchema";
import { longDate, viaMoment } from "../../lib/dates";
import { formatRef } from "../../lib/scriptureRef";
import { concertKey, withOverlay } from "../../lib/copyOverlay";
import { pageCopy } from "../../lib/pageCopy";
import { KONCERTY_CHROME, KONCERTY_PAGE } from "../../i18n/content/koncerty";
import { CONCERT } from "../../i18n/content/koncert";
import { eraName } from "../../i18n/content/repertuar";
import { UI } from "../../i18n/ui";
import { localizePath, pageI18n, SITE, type Locale } from "../../i18n/config";
import VaultMount from "../../components/VaultMount.astro";
import "../../styles/vault.css";

interface Props {
  /** Which language this render is. Drives the copy, the chrome, the URL and the hreflang graph. */
  lang: Locale;
}
const { lang } = Astro.props;

const copy = pageCopy(KONCERTY_PAGE, lang);
const t = KONCERTY_CHROME[lang];
const concertUi = CONCERT[lang];
// One base path → this render's own URL, its hreflang graph, and the locales the switcher offers.
const { path, alternates, available } = pageI18n("/koncerty", lang);
const hrefContact = localizePath("/kontakt", lang);
const hrefAbout = localizePath("/o-nas", lang);
const hrefDonate = `${localizePath("/", lang)}?donate`;

const hero = bleedPair("koncerty-hero");

/** What this render prints for one of a concert's copy fields: the overlay's translation where one
    exists, the corpus's Polish otherwise. Bound per station, since the key carries the concert's
    own id (copydesk/contract.mjs is the table that decides which text is copy). */
const say = (id: string, field: string, polish: string): string =>
  withOverlay(concertKey(id, field), lang, polish);

const concerts = (await getCollection("concerts")).sort((a, b) => a.data.order - b.data.order);
const stationCount = concerts.length;
const stations = concerts.map((c, i) => ({
  ...c.data,
  id: c.id,
  title: say(c.id, "title", c.data.title),
  essence: say(c.id, "essence", c.data.essence),
  facts: c.data.facts.map((f, fi) => say(c.id, `facts.${fi}`, f)),
  links: c.data.links.map((l, li) => ({ ...l, label: say(c.id, `links.${li}.label`, l.label) })),
  posterAlt: c.data.posterAlt ? say(c.id, "posterAlt", c.data.posterAlt) : undefined,
  realizacja: c.data.realizacja ? say(c.id, "realizacja", c.data.realizacja) : undefined,
  // The evening's motto: the foreign original stands unchanged, its vernacular and the citation
  // that cites it come through the desk. The gloss does two jobs in one slot — the Latin's
  // vernacular where there IS an `inscriptio`, a standalone editorial note where there is not.
  inscriptioGloss: c.data.inscriptioGloss
    ? say(c.id, "inscriptioGloss", c.data.inscriptioGloss.pl)
    : undefined,
  inscriptioRefText: c.data.inscriptioRef
    ? formatRef(
        c.data.inscriptioRef,
        lang,
        c.data.inscriptioRef.source
          ? say(c.id, "inscriptioRef.source", c.data.inscriptioRef.source.pl)
          : undefined,
      )
    : undefined,
  // The dateline is composed here, not stored: place per locale (copy, so it comes through the
  // desk), the moment formatted from the ISO `date` or taken from the vague `dateLabel` (a tour
  // across a year, a season) — which is copy too.
  metaPlace: say(c.id, "metaPlace", c.data.metaPlace.pl),
  // The via-rail's own abbreviation of that same moment — derived, never stored (lib/dates).
  viaDate: viaMoment(c.data, lang),
  meta: [
    say(c.id, "metaPlace", c.data.metaPlace.pl),
    c.data.date
      ? longDate(c.data.date, lang)
      : c.data.dateLabel && say(c.id, "dateLabel", c.data.dateLabel.pl),
  ]
    .filter(Boolean)
    .join(" · "),
  // Via-rail fill is derived from position, not stored per-entry: adding a concert
  // no longer means re-percentaging every other YAML row by hand.
  viaStep: `${Math.round(((i + 1) / stationCount) * 100)}%`,
  // Station backdrops are PRE-BLURRED + pre-darkened WebP files in src/assets/photos,
  // named after the concert's `bg`. Blurring offline means the browser runs ZERO filter
  // passes on six full-bleed layers (the old runtime blur was the jank). Astro emits them
  // as content-hashed asset URLs. Recipe to regenerate them: docs/station-backgrounds.md.
  bgSrc: photo(c.data.bg).src,
  posterImg: c.data.poster ? photo(c.data.poster) : null,
}));

// Era headings are labels rather than prose, so they are a typed triple keyed by the catalogue's
// own id — the landing's litany plate reads the same one (i18n/content/repertuar.ts).
const eras = (await getCollection("repertoire"))
  .sort((a, b) => a.data.order - b.data.order)
  .map((era) => ({ ...era.data, id: era.id, ...eraName(era.id, lang) }));

// Roman numeral for the still-unwritten station (Nondum) — computed, not a fixed lookup
// table, so the sequence keeps going no matter how many concerts eventually land.
const toRoman = (n: number): string => {
  const table: readonly (readonly [number, string])[] = [
    [10, "X"], [9, "IX"], [5, "V"], [4, "IV"], [1, "I"],
  ];
  let out = "";
  let rem = n;
  for (const [value, sym] of table) {
    while (rem >= value) {
      out += sym;
      rem -= value;
    }
  }
  return out;
};

// The list describes one event per CONCERT, not per tour date — a touring programme's
// itinerary belongs to its own page, which emits a node per evening. Node shape (calendar-
// derived status, shared performer/organizer ids, offers only where admission is recorded)
// comes from lib/eventSchema, so this list and the detail pages cannot drift apart.
// The same `bleedPair(heroImg ?? bg)` + 1200/webp call the detail page makes, so getImage
// serves both from one rendition instead of emitting a second copy per station.
const listItems = await Promise.all(
  stations.map(async (s, i) => {
    // A touring programme carries no concert-level day — its `meta` reads "2024" or "jesień
    // 2025" — so the list would describe it with no `startDate` at all, and startDate is one of
    // the three properties schema.org Event actually REQUIRES. The opening evening stands in:
    // it is a real date at a real venue (not an averaged fiction), and `url` carries the reader
    // to the page that lists the whole itinerary. Concerts with a single date are unaffected.
    const opening = s.date ? undefined : s.dates[0];
    return {
      "@type": "ListItem",
      position: i + 1,
      item: musicEvent({
        name: s.title,
        description: s.essence,
        image: absolute(
          (
            await getImage({
              src: bleedPair(s.heroImg ?? s.bg).desktop,
              width: 1200,
              format: "webp",
            })
          ).src,
        ),
        // A station without its own page has no URL to point at; the Offer drops its `url` too.
        ...(s.hasPage ? { url: `${SITE}${localizePath(`/koncerty/${s.id}`, lang)}` } : {}),
        // Still absent when a concert has neither a day nor an itinerary — the node then emits
        // no startDate and no status claim rather than fabricate a date.
        date: s.date ?? opening?.date,
        time: s.time ?? opening?.time,
        // The venue has to travel WITH the date it belongs to: pairing the opening evening's day
        // with the concert-level venue string (which lists all three cities) would describe an
        // evening that never happened.
        venue: opening?.venue ?? s.venue ?? s.metaPlace,
        address: opening ? opening.address : s.address,
        admission: opening ? opening.admission : s.admission,
      }),
    };
  }),
);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: copy.meta.title,
  inLanguage: lang,
  itemListElement: listItems,
};

const ogImage = (await getImage({ src: hero.desktop, width: 1200, format: "webp" })).src;
---

<BaseLayout
  title={copy.meta.title}
  description={copy.meta.description}
  path={path}
  image={ogImage}
  bodyClass="page-koncerty"
  lang={lang}
  alternates={alternates}
  breadcrumb={[{ name: concertUi.meta.breadcrumb, path }]}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <a class="skip-link" href="#tresc">{UI[lang].skipToContent}</a>
  <SiteChrome current="/koncerty" tone="dark" lang={lang} availableLocales={available} />

  {/* Rests hidden until the first station is reached, then the observer writes both slots. The
      SSR'd values still come from the data rather than from a literal: they are what a reader
      with no JS would see if the rail were ever shown, and a hand-typed "I / sty 2024" quietly
      becomes a lie the moment a concert is inserted ahead of Wcielenie. */}
  <aside class="via-rail" aria-hidden="true">
    <span class="via-num">{stations[0]?.roman ?? ""}</span>
    <span class="via-line"><span class="via-fill"></span></span>
    <span class="via-date">{stations[0]?.viaDate ?? ""}</span>
  </aside>

  <main id="tresc">
    {/* ── Intro hero ───────────────────────────────────────────────────── */}
    <section class="intro" aria-label={t.introAria}>
      <div class="intro-media" aria-hidden="true">
        <BleedImage desktop={hero.desktop} mobile={hero.mobile} alt="" position="center 38%" eager animate />
      </div>
      <div class="intro-inner">
        <p class="eyebrow reveal"><span class="lat" lang="la">Via</span>  ·  {copy.intro.eyebrow}</p>
        <h1>
          <span class="line"><span class="reveal ink-press">{copy.intro.title1}</span></span>
          <span class="line"
            ><span class="reveal ink-press" data-d="1" set:html={copy.intro.title2Html} /></span
          >
        </h1>
        <p class="intro-lede reveal" data-d="2">{copy.intro.lede}</p>
        <p class="intro-note reveal" data-d="3" set:html={copy.intro.noteHtml} />
        <span class="scroll-cue reveal" data-d="4">{copy.intro.scrollCue}</span>
      </div>
    </section>

    {/* ── Stations (from the `concerts` collection) ────────────────────── */}
    {
      stations.map((s) => (
        <section
          class:list={[
            "station",
            { reverse: s.reverse, "station--memoriam": s.variant === "memoriam", "station--liturgy": s.variant === "liturgy" },
          ]}
          aria-label={s.title}
          data-via-num={s.roman}
          data-via-date={s.viaDate}
          data-via-step={s.viaStep}
          style={`--accent:${s.accent}`}
        >
          <div
            class="station-bg"
            aria-hidden="true"
            style={`--bg:url('${s.bgSrc}')`}
            data-parallax="0.4"
          />
          {/* The accent light is its OWN plane — it drifts at half the stone's speed (0.2 vs
              0.4), so light and masonry separate on scroll instead of moving as one
              photograph. Reuses the global [data-parallax] controller; the scale path keeps
              its resting position identical to the old static glow.
              Both speeds sit above the drift budget BaseLayout documents (2·cap / (vh +
              frameH) — 0.29 for the backdrop, 0.13 for the light), so each pins against its
              clamp near the ends of a station's pass: ~27% of it for the stone, ~36% for the
              light. Left as authored — the light is a diffuse radial at opacity .5 under
              `screen`, where a 121px pin is not perceptible, and lowering the stone to budget
              would flatten the separation this plane exists to create. */}
          <div
            class="station-light"
            aria-hidden="true"
            data-parallax="0.2"
            data-parallax-scale="1.3"
          />

          {s.variant === "liturgy" ? (
            <div class="station-inner">
              {/* Element by element, like its non-liturgy sibling below. As one 636px node the
                  plate fired on the glyph and everything under the heading reached the reading
                  zone already written. Same `data-d` reads as one utterance, a step as a
                  sequence. */}
              <div class="station-text station-plate">
                <span class="station-glyph reveal" aria-hidden="true" />
                <p class="station-num reveal">{concertUi.hero.station} {s.roman} &nbsp;·&nbsp; <span lang="la">{s.latin}</span></p>
                <h2 class="station-title reveal ink-press" data-d="1">{s.title}</h2>
                <p class="station-meta reveal" data-d="1">{s.meta}</p>
                <p class="station-essence reveal" data-d="2">{s.essence}</p>
                {s.facts.length > 0 && (
                  <div class="station-facts reveal" data-d="3" role="list" aria-label={t.liturgyFactsAria}>
                    {s.facts.map((f) => (
                      <span role="listitem">{f}</span>
                    ))}
                  </div>
                )}
                {s.links.length > 0 && (
                  <div class="station-actions">
                    {s.links.map((l) => (
                      <a class="link-min" href={l.href} target="_blank" rel="noopener noreferrer">
                        {l.label}
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </div>
          ) : (
            <div class="station-inner">
              {s.posterImg && (
                <figure class="station-poster">
                  <span class="frame" aria-hidden="true" />
                  <div class="station-poster-media">
                    {/* `width` caps the fallback rendition — see lib/photos.ts. */}
                    <Picture
                      src={s.posterImg}
                      formats={["avif", "webp"]}
                      widths={[280, 420, 560]}
                      width={560}
                      sizes="(max-width: 820px) 72vw, 348px"
                      alt={s.posterAlt ?? ""}
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="reveal-light" aria-hidden="true"></span>
                  </div>
                </figure>
              )}
              <div class="station-text">
                <p class="station-num reveal">{concertUi.hero.station} {s.roman} &nbsp;·&nbsp; <span lang="la">{s.latin}</span></p>
                <h2 class="station-title reveal ink-press" data-d="1">{s.title}</h2>
                <p class="station-meta reveal" data-d="1">{s.meta}</p>
                <p class="station-essence reveal" data-d="2">{s.essence}</p>
                {/* Ink + lead, the one register pair a single node may wear: the hairline that
                    opens the incipit is drawn, and the words it carries follow it in. The pair
                    pins `transition-delay` at 0.18s over `data-d` (registers.css) — here that
                    is a no-op, because `data-d="2"` IS 0.18s; keep the two in step if either
                    moves. Memoriam centres this block and drops the rule entirely, so it takes
                    ink alone rather than a lead with nothing to draw. */}
                {s.inscriptio && (
                  <p
                    class:list={[
                      "station-inscriptio",
                      "reveal",
                      { "reveal-rule-v": s.variant !== "memoriam" },
                    ]}
                    data-d="2"
                  >
                    <em class="station-inscriptio-src">{s.inscriptio}</em>
                    {s.inscriptioGloss && (
                      <span class="station-inscriptio-gloss">{s.inscriptioGloss}</span>
                    )}
                    {s.inscriptioRefText && (
                      <span class="station-inscriptio-ref">{s.inscriptioRefText}</span>
                    )}
                  </p>
                )}
                {/* One step behind the essence, not level with it. The station speaks in four
                    beats — numeral, then name and date, then what the evening is (its prose and
                    the words it opens with, one utterance), then its apparatus: these chips and
                    the programme disclosure. The essence and the incipit share 0.18s and must:
                    the incipit's ink+lead pair pins that delay regardless of `data-d`, so it is
                    the one node in the stack that cannot be moved. */}
                {s.facts.length > 0 && (
                  <div class="station-facts reveal" data-d="3" role="list" aria-label={t.factsAria}>
                    {s.facts.map((f) => (
                      <span role="listitem">{f}</span>
                    ))}
                  </div>
                )}
                {/* Out of the register deliberately: a half-ink control is a control you are not
                    sure you may press. Everything above it inks; these are simply there. */}
                {(s.hasPage || s.spotify || s.realizacja || s.links.length > 0) && (
                  <div class="station-actions">
                    {s.hasPage && (
                      <a class="pill" href={localizePath(`/koncerty/${s.id}`, lang)}>
                        {t.openConcert}
                      </a>
                    )}
                    {s.spotify && (
                      <a class="pill" href={s.spotify} target="_blank" rel="noopener noreferrer">
                        ▸ {t.spotify}
                      </a>
                    )}
                    {s.realizacja && <span class="station-credit">{s.realizacja}</span>}
                    {s.links.map((l) => (
                      <a class="link-min" href={l.href} target="_blank" rel="noopener noreferrer">
                        {l.label}
                      </a>
                    ))}
                  </div>
                )}
                {s.program.length > 0 && (
                  <details class="prog-d reveal" data-d="3">
                    {/* Six of these stand on one page, so the visible label alone gives a screen
                        reader six identical controls. The concert's name goes in visually hidden
                        rather than into an `aria-label`: a label would REPLACE the visible text,
                        and voice control matches on what is on screen. */}
                    <summary>
                      {t.programSummary}<span class="sr-only"> — {s.title}</span> <span class="chev" aria-hidden="true">↓</span>
                    </summary>
                    <div class="station-program">
                      <ul class="prog-list">
                        {s.program.map((p, i) => (
                          <li class:list={[{ bis: p.bis }]}>
                            <span class="prog-n" aria-hidden="true">{p.bis ? "—" : String(i + 1).padStart(2, "0")}</span>
                            <span class="pc">{p.composer}</span> — {p.work}
                          </li>
                        ))}
                      </ul>
                    </div>
                  </details>
                )}
              </div>
            </div>
          )}
        </section>
      ))
    }

    {/* ── The unwritten station — the Via's payoff. Not a `.station` (the via-rail
          observer only tracks walked concerts); a threshold, not a memory. "No fake
          upcoming concert" holds: we promise nothing but say plainly the next one
          waits on patrons. Numeral continues the sequence. ──────────────── */}
    <section class="station-next" aria-label={t.nextAria}>
      <div class="station-next-inner">
        <span class="station-next-glyph reveal" aria-hidden="true"></span>
        <p class="station-num reveal">{toRoman(stationCount + 1)} &nbsp;·&nbsp; <span class="lat" lang="la">Nondum</span></p>
        <h2 class="station-title reveal ink-press" data-d="1">{copy.next.title}</h2>
        <p class="station-meta reveal" data-d="1">{copy.next.meta}</p>
        <p class="station-essence reveal" data-d="2">{copy.next.essence}</p>
        <div class="station-actions">
          <a class="pill pill-gold" href={hrefDonate} data-vault-open="100">{copy.next.cta}</a>
        </div>
      </div>
    </section>

    {/* ── The evening's four rules — the method behind the walk, read AFTER it (like a
          programme-book essay). Parchment: the page steps out of the night nave into
          light, the same arc a listener walks — enters from the street, leaves quieter.
          Documented practice, not an invented framework (see koncerty.yaml). ─────── */}
    <section class="rite-map tone-light" aria-label={t.ritesAria}>
      <div class="rite-wrap">
        <div class="rite-head reveal">
          <span class="eyebrow"><span class="lat" lang="fr">Concert spirituel</span>  ·  {copy.rites.eyebrow}</span>
          <h2 class="ink-press">{copy.rites.h2}</h2>
          <p set:html={copy.rites.ledeHtml} />
        </div>
        <div class="rite-grid">
          {/* A straight 1→4 step, NOT the `(i % 3) + 1` the repertoire rows use: those are a
              long column where the modulo is a rolling cascade, these are four cards standing
              in one row, where wrapping at three put the fourth card back at 0.09s and it
              entered ahead of its two neighbours — on every breakpoint, since the 2-up and
              1-up folds keep the same order. Four is also the last step registers.css
              defines, hence the clamp: a fifth rule would hold at 0.36s rather than reset. */}
          {
            copy.rites.items.map((r, i) => (
              <article class="rite-card reveal" data-d={String(Math.min(i + 1, 4))}>
                <span class="r-num">{String(i + 1).padStart(2, "0")}</span>
                <h3>{r.title}</h3>
                <p>{r.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    {/* ── Repertoire (from the `repertoire` collection) ────────────────── */}
    <section class="repertoire tone-light" id="repertuar" aria-label={t.repertoireAria}>
      <div class="rep-wrap">
        <div class="rep-head reveal">
          <span class="eyebrow"><span class="lat" lang="la">Repertorium</span>  ·  {copy.repertoire.eyebrow}</span>
          <h2 class="ink-press">{copy.repertoire.h2}</h2>
          <p>{copy.repertoire.lede}</p>
        </div>

        {
          eras.map((era) => {
            // Two explicit column lists (not CSS `columns`): each list's :first-child is
            // deterministically the column top, so it can drop the hairline that would
            // otherwise double the era's own rule. Multicol balances by HEIGHT (entries run
            // 1–3 works), so its column-break index is unpredictable — a count-split is stable.
            const half = Math.ceil(era.entries.length / 2);
            const columns = [era.entries.slice(0, half), era.entries.slice(half)];
            return (
              <div class="rep-era">
                <div class="rep-era-head reveal">
                  <h3 class="rep-era-title">{era.title}</h3>
                  <span class="rep-era-span">{era.span}</span>
                </div>
                <div class="rep-cols">
                  {columns.map(
                    (col, ci) =>
                      col.length > 0 && (
                        <ul class:list={["rep-col", { "rep-col-2": ci === 1 }]}>
                          {col.map((entry, ei) => (
                            <li class="reveal rep-row" data-d={String((ei % 3) + 1)}>
                              <span class="composer">
                                {entry.composer}
                                {entry.years && <span class="years">{entry.years}</span>}
                              </span>
                              <span class="works">
                                {entry.works.map((w, i) => (
                                  <>
                                    {i > 0 && " · "}
                                    {w.title}
                                    {w.year && <span class="yr"> {w.year}</span>}
                                  </>
                                ))}
                              </span>
                            </li>
                          ))}
                        </ul>
                      ),
                  )}
                </div>
              </div>
            );
          })
