    </section>

    {/* ── CTA ──────────────────────────────────────────────────────────── */}
    <section class="cta-band tone-light" aria-label={t.codaAria}>
      <div>
        <h2 class="reveal">{copy.coda.h2}</h2>
        <p class="reveal" data-d="1">{copy.coda.lede}</p>
        <div class="btn-row">
          <a class="btn btn-gold" href={hrefContact}>{copy.coda.contactLink}</a>
          <a class="btn" href={hrefAbout}>{copy.coda.aboutLink}</a>
