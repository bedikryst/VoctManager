  .rep-col .works { display: block; margin-top: 4px; font-size: clamp(14.5px, 1.15vw, 16px); color: var(--ink-soft); }
  .rep-col .works .yr { color: var(--candle-ink); font-family: var(--mono); font-size: .82em; }
  @media (max-width: 720px) {
    .rep-cols { grid-template-columns: 1fr; }
