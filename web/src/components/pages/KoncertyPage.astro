  .rep-col .composer .years { font-size: .62em; color: var(--ink-muted); font-family: var(--mono); letter-spacing: .04em; margin-left: 8px; }
  /* Tracks the composer's own clamp rather than sitting fixed under it — at a flat 14.5px the
     pair drifted from 1.31 on a phone to 1.59 at 1440, so the entry read tighter the wider the
