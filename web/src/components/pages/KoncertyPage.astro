  /* Liturgy station (no poster) */
  .station--liturgy .station-inner { grid-template-columns: 1fr; max-width: 880px; }
  .station-plate { border: 1px solid rgba(244,241,233,.16); padding: clamp(28px,4vw,52px); background: rgba(244,241,233,.03); }
  /* Raster master under ~110px — see the dual-master note on `.brand-glyph-shape` (styles/base.css). */
  .station-glyph { width: 26px; height: 60px; margin-bottom: 20px; background: linear-gradient(165deg, #e6d3a0 0%, #c6a45b 52%, #ad8a44 100%); -webkit-mask: url(/logo-mark.png) center / contain no-repeat; mask: url(/logo-mark.png) center / contain no-repeat; opacity: .8; }

  /* In memoriam (quieter, centered) */
  .station--memoriam .station-inner { grid-template-columns: 1fr; max-width: 720px; justify-items: center; text-align: center; gap: clamp(26px, 4vw, 40px); }
  /* A resting dim over a register-bearing subtree is a FILTER, never `opacity`. Astro scopes page
     rules with `[data-astro-cid-…]` on every compound, so this selector ships at (0,4,0) and
