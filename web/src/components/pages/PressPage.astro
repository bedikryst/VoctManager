  .press-pick-all:hover { color: var(--ink); }
  .press-group-head .press-pick-all,
  .press-block-head .press-pick-all { margin-left: auto; }
  /* On a phone the rubric and the toggle do not fit one line; the toggle takes the next. */
  .press-files .press-rubric-row { flex-wrap: wrap; }

  /* The list gains a first column; each box sits on its title's first line. */
  main.has-basket .press-file-list { grid-template-columns: 18px 24px minmax(0, 1fr) auto auto; }
  .press-file > .press-pick { padding-top: 3px; }

  /* A tile's box sits on the picture's corner, on a plate of paper so it reads over any frame,
     above the veil. It rests hidden, eleven white squares over the photographs being the one
     thing a reader would see first, and shows on a hover or a focus, on every tile at once while
