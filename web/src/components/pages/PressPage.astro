  /* The bar. Night, not gold: gold is spent once, on the head's plate. */
  .press-basket { position: sticky; bottom: 0; z-index: 48; padding: 14px max(28px, 5vw) calc(env(safe-area-inset-bottom, 0px) + 14px); background: rgba(16, 15, 13, .96); border-top: 1px solid rgba(198, 164, 91, .4); color: var(--paper); animation: press-basket-in .45s var(--ease); }
