---
/**
 * @file PressPage.astro
 * @description Locale-agnostic body of /press — a counter an editor, an organiser or a social-media
 *  manager takes materials from, not a page that argues for the ensemble.
 *
 *  THE ORDER IS THE BOARD'S (Ania's sketch, docs/specs/press/), THE DESIGN IS OURS
 *  (docs/specs/web-press-v2-2026-09.md): the next concert with its kit first, then the press
 *  photographs, the social-media texts and graphics, the biograms and the logotype, the
 *  foundation's details, and the press contact. Every file can be seen before it is downloaded —
 *  PDFs open in a tab, images in the site's lightbox, texts in place.
 *
 *  SEVEN SOURCES, AND THEY MUST NOT BE CONFUSED:
 *  - the page's PROSE — `src/content/pages/press.yaml`, through `lib/pageCopy`;
 *  - its CHROME (landmarks, button labels, units, mail subjects) — `i18n/content/press.ts`;
 *  - the concert kit's TEXTS — `src/content/press-kits/`, and every string a Kopiuj button here
 *    writes is built by `lib/pressKit` (`factsText`, `releaseText`, `announceText`, `postText`,
 *    `hashtagsText`), the same functions the pack's files are written with, because the character
 *    limits are measured on them;
 *  - the concert's FACTS — `concerts.yaml`, through `concertFacts`;
 *  - the registry and the accounts — `data/foundation.ts`; the handles — `data/social.ts`;
 *  - the FILES — `public/press/index.json`, through `lib/pressPack`. The page renders a download
 *    only for a file the index lists; without an index the texts stay and every download becomes
 *    one "write to us" mailto. A stale index fails the build (lib/pressPack says why).
 *
 *  THE COMPOSER (scripts/press-basket.ts): a checkbox on every file row and tile, a "select all"
 *  per group, and a bar at the foot of <main> that zips the ticked files in the browser. All of it
 *  renders hidden and the script reveals it; without script, the per-file links and the two
 *  prebuilt ZIPs ARE the page. A box carries only its key into the manifest serialised below.
 *
 *  THE KIT SHOWS ONLY WHILE ITS CONCERT IS AHEAD, by the build-time rule every announcement on
 *  this site follows (`upcomingStation`): the deploy after the concert takes it down.
 *
 *  POLISH-ONLY FOR NOW. `lang` is a real prop and the chrome exists in three locales, but there are
 *  no `/en/press` and `/fr/press` route files and `/press` is NOT in TRANSLATED_ROUTES. The kit's
 *  texts are Polish by nature: they are what a Polish editor pastes.
 * @architecture Astro islands 2026
 * @module components/pages/PressPage
 */
import { getCollection } from "astro:content";
import { getImage, Picture } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteChrome from "../SiteChrome.astro";
import SiteFooter from "../SiteFooter.astro";
import VaultMount from "../VaultMount.astro";
import { ImageLightbox } from "../../islands/landing/ImageLightbox";
import { bleedPair, photoOptional } from "../../lib/photos";
import { framedShot } from "../../lib/galleryFrame";
import { designCredit, frameCredit } from "../../lib/photoCredit";
import { pageCopy } from "../../lib/pageCopy";
import { htmlToPlainText, plainTextLength } from "../../lib/plainText";
import {
  ANNOUNCE_LIMITS,
  announceText,
  charCount,
  concertFacts,
  concertUrl,
  factsText,
  hashtagsText,
  kitProblems,
  latestKit,
  loadPressKits,
  postText,
  releaseText,
  type PressFile,
  type PressGraphic,
  type PressPhoto,
} from "../../lib/pressKit";
import { formatBytes } from "../../lib/fileSize";
import { basketManifest, readPressPack } from "../../lib/pressPack";
import { FOUNDATION } from "../../data/foundation";
import { SOCIAL, SOCIAL_SAME_AS } from "../../data/social";
import { UI } from "../../i18n/ui";
import { LOCALE_META, localizePath, pageI18n, type Locale } from "../../i18n/config";
import { PRESS_CHROME, PRESS_PAGE } from "../../i18n/content/press";
// The declension helper lives with the page that first needed it; /kolofon reaches for it the
// same way. A content module may not re-export it — see the note in `i18n/content/press.ts`.
import { counted } from "../../i18n/content/obrazy";
import "../../styles/vault.css";
import "../../styles/image-lightbox.css";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

const copy = pageCopy(PRESS_PAGE, lang);
const t = PRESS_CHROME[lang];
const { path, alternates, available } = pageI18n("/press", lang);
const htmlLang = LOCALE_META[lang].htmlLang;

const ogImage = (
  await getImage({ src: bleedPair("hero-landing").desktop, width: 1200, format: "webp" })
).src;

const mailto = (address: string, subject: string) =>
  `mailto:${address}?subject=${encodeURIComponent(subject)}`;
const size = (file: PressFile) => formatBytes(file.bytes, htmlLang, t.units);
const dims = (file: PressFile) =>
  file.width && file.height ? `${file.width} × ${file.height} px` : undefined;
const fill = (template: string, key: string, value: string) => template.replace(`{${key}}`, value);

/* The page's one icon set, as path data on a 16 × 16 grid. Each use draws its own <svg> in the
   template, where this file's scoped styles reach it: 16 px, a 1.25 stroke, `currentColor`, so an
   icon takes its control's colour and sits on the label's line. The copy buttons draw `copy` and
   `check` both, and CSS shows `check` while `scripts/copy-fields.ts` holds `.is-copied`. */
const ICON = {
  download: ["M8 2.5v7.75", "M4.75 7 8 10.25 11.25 7", "M2.75 11.25v2h10.5v-2"],
  preview: ["M9.25 2.75h4v4", "M13.25 2.75l-5.5 5.5", "M11.25 9.5v3.75h-8.5v-8.5h3.75"],
  copy: ["M5.75 5.75h7.5v7.5h-7.5z", "M10.25 5.75v-3h-7.5v7.5h3"],
  check: ["M3 8.25l3.5 3.5L13 4.75"],
} as const;

// ── The pack ──────────────────────────────────────────────────────────────────────────────────

/* Present only when the pack is on this host; throws when it is stale — see lib/pressPack. */
const pack = readPressPack();
const href = (file: PressFile) => (pack ? pack.href(file) : "");
const requestHref = mailto(FOUNDATION.mail.press, t.mailSubjectPack);

/* The head's two facts about komplet, both read off the index it was cut with: what it holds
   (a kind is named only when the archive carries it) and the day it was cut, because an editor
   quoting a release wants to know it is the current one. */
const packFacts = pack
  ? {
      contents: [
        ...(pack.index.concert
          ? [t.packItems.release, t.packItems.programme, t.packItems.biograms, t.packItems.poster]
          : []),
        ...(pack.index.photos.length > 0 ? [counted(pack.index.photos.length, t.photos, lang)] : []),
        ...((pack.index.concert?.graphics.length ?? 0) > 0 ? [t.packItems.graphics] : []),
        ...(pack.index.logo.length > 0 ? [t.packItems.logo] : []),
      ].join(", "),
      updated: new Intl.DateTimeFormat(htmlLang, {
        day: "numeric",
        month: "long",
        year: "numeric",
        timeZone: "Europe/Warsaw",
      }).format(new Date(pack.index.generatedAt)),
    }
  : undefined;

// ── The concert kit ───────────────────────────────────────────────────────────────────────────

const concerts = await getCollection("concerts");
const kits = loadPressKits();
/* The generator refuses a kit whose texts name another day; the page refuses it too, so a moved
   concert cannot ship last week's date in a Kopiuj button while its pack is being rebuilt. */
const problems = kits.flatMap((kit) =>
  kitProblems(kit, concerts.find((entry) => entry.id === kit.concert)?.data),
);
if (problems.length > 0) throw new Error(`/press: ${problems.join(" ")}`);

const latest = latestKit(kits, concerts);
const kit = latest?.kit;
const concert = latest?.station;

/* The pack's concert files belong to the kit the pack was cut for. After a concert passes, the
   next kit leads the page before the next pack is cut — its texts render, its files do not. */
const kitFiles = pack && kit && pack.index.concert?.id === kit.concert ? pack.index.concert : undefined;

/* The release closes on the SHORT biogram in Polish, whichever locale renders the page: the kit is
   Polish, and the PDF beside this button was written from the Polish field. */
const shortBioPl = htmlToPlainText(pageCopy(PRESS_PAGE, "pl").about.shortHtml);

const card = concert && kit
  ? await (async () => {
      const facts = concertFacts(concert.data);
      const url = concertUrl(FOUNDATION.site, concert.id);
      const posterImg = concert.data.poster ? photoOptional(concert.data.poster) : undefined;
      const posterCredit = concert.data.posterCredit
        ? designCredit(concert.data.posterCredit, lang)
        : undefined;
      return {
        id: concert.id,
        facts,
        pageHref: concert.data.hasPage ? localizePath(`/koncerty/${concert.id}`, lang) : undefined,
        festivalUrl: concert.data.festival?.url,
        posterImg,
        posterFrame: posterImg ? await framedShot(posterImg) : undefined,
        posterAlt: concert.data.posterAlt ?? facts.title,
        posterCredit,
        factsCopy: factsText(facts, url),
        releaseCopy: releaseText(kit, facts, {
          about: shortBioPl,
          contact: FOUNDATION.mail.press,
          concertUrl: url,
        }),
        announceShort: announceText(kit, "short"),
        announceLong: announceText(kit, "long"),
        post: postText(kit, url),
        hashtags: hashtagsText(kit),
      };
    })()
  : undefined;

/** The lightbox attributes of the concert's poster — the card's sheet and its row's Otwórz. */
const posterAttrs =
  card?.posterFrame
    ? {
        "data-image-open": "",
        "data-image-src": card.posterFrame.src,
        "data-image-srcset": card.posterFrame.srcset,
        "data-image-sizes": card.posterFrame.sizes,
        "data-image-alt": card.posterAlt,
        "data-image-caption": [card.facts.dateline, card.facts.venue].filter(Boolean).join(" · "),
        "data-image-credit": card.posterCredit,
        "data-image-w": String(card.posterFrame.width),
        "data-image-h": String(card.posterFrame.height),
      }
    : undefined;

/** "do 500 znaków" — the measure an editor's form states. */
const measure = (limit: number) => fill(t.upTo, "count", counted(limit, t.characters, lang));
const measured = (text: string) => counted(charCount(text), t.characters, lang);

/** One row of the concert's materials. `text` is shown in place; `copy` is what Kopiuj writes. */
interface FileRow {
  readonly id: string;
  readonly icon: "doc" | "image";
  readonly title: string;
  readonly sub?: string | undefined;
  readonly format: string;
  readonly file?: PressFile | undefined;
  readonly open?: "tab" | "lightbox" | undefined;
  readonly copy?: { readonly label: string; readonly value: string } | undefined;
  readonly text?: string | undefined;
}

const fileRows: FileRow[] = card && kit
  ? [
      {
        id: "release",
        icon: "doc",
        title: copy.latest.release,
        sub: kit.release.title,
        format: "PDF",
        file: kitFiles?.release,
        open: kitFiles ? "tab" : undefined,
        copy: { label: t.copyText, value: card.releaseCopy },
      },
      {
        id: "announce-short",
        icon: "doc",
        title: `${copy.latest.announce} · ${measure(ANNOUNCE_LIMITS.short)}`,
        sub: `${copy.latest.announceShortSub} · ${measured(card.announceShort)}`,
        format: "TXT",
        file: kitFiles?.announceShort,
        copy: { label: t.copy, value: card.announceShort },
        text: card.announceShort,
      },
      {
        id: "announce-long",
        icon: "doc",
        title: `${copy.latest.announce} · ${measure(ANNOUNCE_LIMITS.long)}`,
        sub: `${copy.latest.announceLongSub} · ${measured(card.announceLong)}`,
        format: "TXT",
        file: kitFiles?.announceLong,
        copy: { label: t.copy, value: card.announceLong },
        text: card.announceLong,
      },
      ...(kitFiles
        ? ([
            {
              id: "programme",
              icon: "doc",
              title: copy.latest.programme,
              sub: copy.latest.programmeSub,
              format: "PDF",
              file: kitFiles.programme,
              open: "tab",
            },
            {
              id: "biograms",
              icon: "doc",
              title: copy.latest.biograms,
              // The generator's rule: the ensemble, and each guest whose biogram is on record.
              sub: [FOUNDATION.ensemble, ...kit.guests.filter((g) => g.bio).map((g) => g.name)].join(
                " · ",
              ),
              format: "PDF",
              file: kitFiles.biograms,
              open: "tab",
            },
          ] satisfies FileRow[])
        : []),
      ...(card.posterFrame || kitFiles
        ? [
            {
              id: "poster",
              icon: "image",
              title: copy.latest.poster,
              sub: [card.posterCredit, kitFiles && dims(kitFiles.poster)].filter(Boolean).join(" · "),
              format: "JPG",
              file: kitFiles?.poster,
              open: posterAttrs ? "lightbox" : undefined,
            } satisfies FileRow,
          ]
        : []),
      ...(kitFiles?.posterPrint
        ? [
            {
              id: "poster-print",
              icon: "image",
              title: copy.latest.posterPrint,
              sub: copy.latest.posterPrintSub,
              format: "PDF",
              file: kitFiles.posterPrint,
              open: "tab",
            } satisfies FileRow,
          ]
        : []),
    ]
  : [];

/** A pasted text as the page shows it: paragraphs on blank lines, lines kept inside them. */
const paragraphs = (text: string): string[][] => text.split("\n\n").map((block) => block.split("\n"));

// ── Photographs and graphics ──────────────────────────────────────────────────────────────────

const PHOTO_GROUPS = [
  {
    ratio: "16:9",
    key: "landscape",
    title: copy.photos.landscape,
    use: copy.photos.landscapeUse,
    maxColumns: 3,
    sizes: "(max-width: 560px) 78vw, (max-width: 900px) 46vw, 380px",
  },
  {
    ratio: "4:5",
    key: "portrait",
    title: copy.photos.portrait,
    use: copy.photos.portraitUse,
    maxColumns: 5,
    sizes: "(max-width: 560px) 60vw, (max-width: 1099px) 31vw, 220px",
  },
] as const;

/* The desktop row count follows the number of photographs: the widest row, up to the group's
   maximum, that leaves no tile alone on the last line. A lone portrait under a full row reads as
   a leftover. Narrower screens take fixed counts in the CSS, and a phone one scrolling row per
   group, which is what the `sizes` above describe at 560 px and below. */
const columnsFor = (count: number, max: number): number => {
  for (let columns = Math.min(count, max); columns > 1; columns--) {
    const last = count % columns;
    if (last === 0 || last > 1) return columns;
  }
  return 1;
};

const photoGroups = PHOTO_GROUPS.map((group) => {
  const photos = (pack?.index.photos ?? []).filter((photo: PressPhoto) => photo.ratio === group.ratio);
  return { ...group, photos, columns: columnsFor(photos.length, group.maxColumns) };
}).filter((group) => group.photos.length > 0);

/* The line an editor prints under the picture: the caption, then the credit in brackets. */
const captionLine = (caption: string, credit: string) => `${caption} (${credit})`;

const GRAPHIC_USE: Record<PressGraphic["format"], string> = {
  "4x5": copy.social.graphic4x5,
  "9x16": copy.social.graphic9x16,
  "16x9": copy.social.graphic16x9,
};
const graphics = kitFiles?.graphics ?? [];

/* The logotype, one tile per ground and one for the gold mark, each offering the formats made for
   it (by the names the generator gives them). The SVG and the light PNG are the same drawing, so
   they share a tile rather than render as two identical ones. The usage note is printed on the page, so its .txt
   copy is not offered again on its own: it travels with any logo tile ticked in the composer, as
   it does in komplet. */
const LOGO_GROUNDS = [
  {
    ground: "light",
    label: t.logoOnLight,
    files: [
      { name: "voct-mark.svg", format: "SVG" },
      { name: "voct-mark-na-jasnym.png", format: "PNG" },
    ],
  },
  { ground: "dark", label: t.logoOnDark, files: [{ name: "voct-mark-na-ciemnym.png", format: "PNG" }] },
  { ground: "gold", label: t.logoGold, files: [{ name: "voct-mark-zloty.png", format: "PNG" }] },
] as const;
const logoTiles = LOGO_GROUNDS.flatMap((tile) => {
  const files = tile.files.flatMap((entry) => {
    const file = pack?.index.logo.find((candidate) => candidate.path === `logo/${entry.name}`);
    return file ? [{ format: entry.format, file }] : [];
  });
  // The swatch shows the tile's first file; a ground with no file on this host has no tile.
  const [first] = files;
  return first ? [{ ground: tile.ground, label: tile.label, files, swatch: first.file }] : [];
});
const logoUsage = pack?.index.logo.find((file) => file.path === "logo/UZYCIE.txt");

// ── The composer ──────────────────────────────────────────────────────────────────────────────

/* A checkbox's key is ALL its markup carries. The files it stands for, their sizes and URLs reach
   scripts/press-basket.ts through `basketManifest`, from the index. */
const rowKey = (row: FileRow) => `file:${row.id}`;
const photoKey = (photo: PressPhoto) => `photo:${photo.id}`;
const graphicKey = (graphic: PressGraphic) => `graphic:${graphic.format}`;
const logoKey = (ground: string) => `logo:${ground}`;

const basketEntries: [string, readonly PressFile[]][] = [
  ...fileRows.flatMap((row): [string, readonly PressFile[]][] =>
    row.file ? [[rowKey(row), [row.file]]] : [],
  ),
  ...photoGroups.flatMap((group) =>
    group.photos.map((photo): [string, readonly PressFile[]] => [photoKey(photo), [photo]]),
  ),
  ...graphics.map((graphic): [string, readonly PressFile[]] => [graphicKey(graphic), [graphic]]),
  ...logoTiles.map((tile): [string, readonly PressFile[]] => [
    logoKey(tile.ground),
    [...tile.files.map((entry) => entry.file), ...(logoUsage ? [logoUsage] : [])],
  ]),
];
const basket =
  pack && basketEntries.length > 0
    ? basketManifest(pack, Object.fromEntries(basketEntries), {
        htmlLang,
        units: t.units,
        counts: basketEntries.map((_, i) =>
          fill(t.basketCount, "files", counted(i + 1, t.files, lang)),
        ),
        preparing: t.basketPreparing,
        failed: t.basketFailed,
      })
    : undefined;
/* Serialised into a <script>, where a `</` would end the element: escaped, though no path or
   label holds one today. */
const basketJson = basket ? JSON.stringify(basket).replace(/</g, "\\u003c") : undefined;
const rowsInBasket = fileRows.filter((row) => row.file).length;
const selectAllAria = (group: string) => fill(t.selectAllAria, "group", group);

// ── Biograms and the foundation ───────────────────────────────────────────────────────────────

/* ONE source per measure: the marked-up field. The plain version is derived and the character
   count is measured, so neither can disagree with what is printed above it. */
const BIOS = [
  { id: "short", measure: t.bioShort, html: copy.about.shortHtml },
  { id: "medium", measure: t.bioMedium, html: copy.about.mediumHtml },
  { id: "long", measure: t.bioLong, html: copy.about.longHtml },
].map((bio) => ({
  ...bio,
  text: htmlToPlainText(bio.html),
  length: plainTextLength(bio.html),
}));

/* KRS, NIP and REGON are their own labels in every language — they are the names of Polish
   registers, not words — so only the other four take chrome. */
const LEGAL_ROWS = [
  { id: "name", label: t.legalName, value: FOUNDATION.name, mono: false },
  { id: "address", label: t.legalAddress, value: FOUNDATION.addressLine, mono: false },
  { id: "krs", label: "KRS", value: FOUNDATION.registry.krs, mono: true },
  { id: "nip", label: "NIP", value: FOUNDATION.registry.nip, mono: true },
  { id: "regon", label: "REGON", value: FOUNDATION.registry.regon, mono: true },
  { id: "pln", label: t.legalAccountPln, value: FOUNDATION.accounts.pln.display, mono: true },
  { id: "eur", label: t.legalAccountEur, value: FOUNDATION.accounts.eur.display, mono: true },
] as const;

const JUMP = [
  ...(card ? [{ id: "najnowsze", label: copy.head.nav.latest }] : []),
  { id: "zdjecia", label: copy.head.nav.photos },
  { id: "social", label: copy.head.nav.social },
  { id: "o-zespole", label: copy.head.nav.about },
  { id: "kontakt", label: copy.head.nav.contact },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "MusicGroup",
  // The SAME entity node the landing declares (/#ensemble) — this page describes that
  // MusicGroup, not a twin with a divergent URL. The page is noindex; the graph stays coherent
  // for anything that still reads it.
  "@id": `${FOUNDATION.site}/#ensemble`,
  name: FOUNDATION.ensemble,
  url: FOUNDATION.site,
  description: copy.meta.description,
  founder: { "@type": "Person", name: "Florent de Bazelaire" },
  genre: ["Sacred music", "Choral music", "Polifonia"],
  sameAs: SOCIAL_SAME_AS,
};
---

<BaseLayout
  title={copy.meta.title}
  description={copy.meta.description}
  path={path}
  image={ogImage}
  bodyClass="page-press"
  lang={lang}
  alternates={alternates}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <meta name="robots" content="noindex,follow" />
  </Fragment>

  <a class="skip-link" href="#tresc">{UI[lang].skipToContent}</a>
  <SiteChrome current="/press" tone="dark" lang={lang} availableLocales={available} />

  <main id="tresc" data-basket-root>
    {/* ── HEAD · what this is, the one big download, and the way down ─────── */}
    <section class="press-head" aria-label={t.headAria}>
      <div class="press-inner press-head-inner">
        <h1 class="press-head-title">
          <span>{copy.head.title}</span>
          <em>{copy.head.titleEm}</em>
        </h1>
        <p class="press-head-lede">{pack ? copy.head.lede : copy.head.requestLede}</p>
        {
          pack ? (
            <a class="press-cta" href={href(pack.index.archives.komplet)} download>
              <span class="press-cta-label">{copy.head.downloadLabel}</span>
              <span class="press-cta-meta">ZIP · {size(pack.index.archives.komplet)}</span>
              <span class="press-cta-arrow" aria-hidden="true">↓</span>
            </a>
          ) : (
            <a class="press-cta press-cta--line" href={requestHref}>
              <span class="press-cta-label">{copy.head.requestLabel}</span>
              <span class="press-cta-meta">{FOUNDATION.mail.press}</span>
              <span class="press-cta-arrow" aria-hidden="true">→</span>
            </a>
          )
        }
        <nav class="press-jump" aria-label={t.jumpAria}>
          <ul>
            {JUMP.map((item) => (
              <li>
                <a href={`#${item.id}`}>{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
        {/* The other two things an editor comes for: where to write, and whether the pack is
            current. Beside the plate on a desktop, under the index on a phone. */}
        <dl class="press-head-facts">
          <div class="press-head-fact">
            <dt>{t.headMail}</dt>
            <dd class="press-head-mail">
              <a href={mailto(FOUNDATION.mail.press, t.mailSubjectMedia)}>{FOUNDATION.mail.press}</a>
              <button
                type="button"
                class="press-button"
                data-copy={FOUNDATION.mail.press}
                data-copied={t.copied}
                aria-label={fill(t.copyFieldAria, "field", t.headMail)}
              >
                <svg class="press-icon press-icon--copy" viewBox="0 0 16 16" aria-hidden="true" focusable="false">{ICON.copy.map((d) => <path d={d} />)}</svg>
                <svg class="press-icon press-icon--check" viewBox="0 0 16 16" aria-hidden="true" focusable="false">{ICON.check.map((d) => <path d={d} />)}</svg>
                <span class="copy-label">{t.copy}</span>
              </button>
            </dd>
          </div>
          {packFacts && (
            <>
              <div class="press-head-fact">
                <dt>{t.packContents}</dt>
                <dd>{packFacts.contents}</dd>
              </div>
              <div class="press-head-fact">
                <dt>{t.packUpdated}</dt>
                <dd>{packFacts.updated}</dd>
              </div>
            </>
          )}
        </dl>
      </div>
    </section>

    {/* ── THE INDEX, KEPT · the head's index under the bar once the head has gone ── */}
    {/* Fixed, so it holds no layout, and shown by the script below only once the head has
        scrolled under the bar; the row of the section being read is marked. Tablet and desktop
        only: on a phone the bar, this and the composer would take ≈ 180 px of a small screen. */}
    <nav class="press-index" aria-label={t.jumpAria} data-press-index>
      <div class="press-inner">
        <ul>
          {JUMP.map((item) => (
            <li>
              <a href={`#${item.id}`}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </nav>

    {/* ── NAJNOWSZE · the concert card and its materials ────────────────────── */}
    {
      card && kit && (
        <section class="press-section tone-light" id="najnowsze" aria-label={t.latestAria}>
          <div class="press-inner">
            <div class="press-rubric-row">
              <h2 class="eyebrow titulus press-rubric">{copy.latest.eyebrow}</h2>
              <span class="press-rule" aria-hidden="true" />
            </div>

            <article class="press-concert">
              <div class="press-concert-media">
                {/* The sheet opens alone, as every poster on this site does (lib/imageFrame). Sized
                    by the grid track, never by a `width` on the trigger: `.shot-open` declares
                    `width: 100%` and would win the tie. */}
                {card.posterImg && posterAttrs && (
                  <button type="button" class="press-poster shot-open" {...posterAttrs}>
                    <Picture
                      src={card.posterImg}
                      formats={["avif", "webp"]}
                      widths={[280, 420, 560]}
                      width={560}
                      sizes="(max-width: 760px) 64vw, 300px"
                      alt={card.posterAlt}
                      loading="lazy"
                      decoding="async"
                    />
                  </button>
                )}
                <p class="press-forces">{kit.forces}</p>
                {/* The files are the list right under this card, and komplet is the head's plate:
                    the one link the card owes is the concert's own page. */}
                {card.pageHref && (
                  <a class="press-concert-page" href={card.pageHref}>
                    {t.concertPage} →
                  </a>
                )}
              </div>

              <div class="press-concert-text">
                <h3 class="press-concert-title">
                  {card.pageHref ? <a href={card.pageHref}>{card.facts.title}</a> : card.facts.title}
                </h3>
                <p class="press-concert-dateline">{card.facts.dateline}</p>
                <p class="press-concert-place">
                  {card.facts.venue}
                  {card.facts.address && (
                    <>
                      <br />
                      {card.facts.address}
                    </>
                  )}
                </p>
                {(card.facts.festival || card.facts.admission) && (
                  <p class="press-concert-place">
                    {card.facts.festival &&
                      (card.festivalUrl ? (
                        <a href={card.festivalUrl} target="_blank" rel="noopener">
                          {card.facts.festival}
                        </a>
                      ) : (
                        card.facts.festival
                      ))}
                    {card.facts.festival && card.facts.admission && " · "}
                    {card.facts.admission}
                  </p>
                )}
                {card.facts.lede && <p class="press-concert-lede">{card.facts.lede}</p>}
                {card.facts.composers.length > 0 && (
                  <p class="press-concert-composers">{card.facts.composers.join(" · ")}</p>
                )}
                <button
                  type="button"
                  class="press-button"
                  data-copy={card.factsCopy}
                  data-copied={t.copied}
                  aria-label={fill(t.copyFieldAria, "field", card.facts.title)}
                >
                  <svg class="press-icon press-icon--copy" viewBox="0 0 16 16" aria-hidden="true" focusable="false">{ICON.copy.map((d) => <path d={d} />)}</svg>
                  <svg class="press-icon press-icon--check" viewBox="0 0 16 16" aria-hidden="true" focusable="false">{ICON.check.map((d) => <path d={d} />)}</svg>
                  <span class="copy-label">{t.copyConcert}</span>
                </button>
              </div>
            </article>

            <div class="press-files">
              <div class="press-rubric-row">
                <h3 class="eyebrow press-rubric">{copy.latest.filesEyebrow}</h3>
                <span class="press-rule" aria-hidden="true" />
                {basket && rowsInBasket > 1 && (
                  <label class="press-pick-all">
                    <input
                      type="checkbox"
                      class="press-pick-box"
                      data-basket-all="files"
                      aria-label={selectAllAria(copy.latest.filesEyebrow)}
                    />
                    <span>{t.selectAll}</span>
                  </label>
                )}
              </div>
              <ul class="press-file-list">
                {fileRows.map((row) => (
                  <li class="press-file">
                    {/* Every row keeps the column, so a row without a file still lines up. */}
                    {basket && row.file ? (
                      <label class="press-pick">
                        <input
                          type="checkbox"
                          class="press-pick-box"
                          data-basket-item={rowKey(row)}
                          data-basket-group="files"
                          aria-label={fill(t.selectAria, "file", row.title)}
                        />
                      </label>
                    ) : (
                      <span class="press-pick" aria-hidden="true" />
                    )}
                    <span class="press-file-icon" aria-hidden="true">
                      {row.icon === "doc" ? (
                        <svg viewBox="0 0 20 24" width="20" height="24" fill="none" stroke="currentColor" stroke-width="1.1">
                          <path d="M3.5 1.5h9l4.5 4.5v16.5H3.5z" />
                          <path d="M12.5 1.5V6H17" />
                          <path d="M6.5 11h7M6.5 14h7M6.5 17h4.5" />
                        </svg>
                      ) : (
                        <svg viewBox="0 0 20 24" width="20" height="24" fill="none" stroke="currentColor" stroke-width="1.1">
                          <path d="M2.5 3.5h15v17h-15z" />
                          <path d="M2.5 16.5l4.5-4.5 4 4 2.5-2.5 4 4" />
                          <circle cx="13" cy="8.5" r="1.5" />
                        </svg>
                      )}
                    </span>
                    <div class="press-file-main">
                      <span class="press-file-title">{row.title}</span>
                      {row.sub && <span class="press-file-sub">{row.sub}</span>}
                      {row.text && (
                        <details class="press-d">
                          <summary>
                            {/* Both labels render and CSS shows one — a `content` string could
                                not carry the locale. */}
                            <span class="press-d-open">{t.expand}</span>
                            <span class="press-d-close">{t.collapse}</span>
                          </summary>
                          <div class="press-d-body press-text">
                            {paragraphs(row.text).map((lines) => (
                              <p>
                                {lines.map((line, i) => (
                                  <>
                                    {i > 0 && <br />}
                                    {line}
                                  </>
                                ))}
                              </p>
                            ))}
                          </div>
                        </details>
                      )}
                    </div>
                    <span class="press-file-meta">
                      {row.format}
                      {row.file && ` · ${size(row.file)}`}
                    </span>
                    {/* Secondary actions first, the one boxed download last, so every row's
                        primary lands on the same right edge. */}
                    <div class="press-file-actions">
                      {row.open === "tab" && row.file && (
                        <a
                          class="press-button"
                          href={href(row.file)}
                          target="_blank"
                          rel="noopener"
                          aria-label={fill(t.previewAria, "file", row.title)}
                        >
                          <svg class="press-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">{ICON.preview.map((d) => <path d={d} />)}</svg>
                          <span>{t.preview}</span>
                        </a>
                      )}
                      {row.open === "lightbox" && posterAttrs && (
                        <button
                          type="button"
                          class="press-button"
                          aria-label={fill(t.previewAria, "file", row.title)}
                          {...posterAttrs}
                        >
                          <svg class="press-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">{ICON.preview.map((d) => <path d={d} />)}</svg>
                          <span>{t.preview}</span>
                        </button>
                      )}
                      {row.copy && (
                        <button
                          type="button"
                          class="press-button"
                          data-copy={row.copy.value}
                          data-copied={t.copied}
                          aria-label={fill(t.copyFieldAria, "field", row.title)}
                        >
                          <svg class="press-icon press-icon--copy" viewBox="0 0 16 16" aria-hidden="true" focusable="false">{ICON.copy.map((d) => <path d={d} />)}</svg>
                          <svg class="press-icon press-icon--check" viewBox="0 0 16 16" aria-hidden="true" focusable="false">{ICON.check.map((d) => <path d={d} />)}</svg>
                          <span class="copy-label">{row.copy.label}</span>
                        </button>
                      )}
                      {row.file && (
                        <a
                          class="press-button press-button--primary"
                          href={href(row.file)}
                          download
                          aria-label={fill(t.downloadAria, "file", row.title)}
                        >
                          <svg class="press-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">{ICON.download.map((d) => <path d={d} />)}</svg>
                          <span>{t.download}</span>
                        </a>
                      )}
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </section>
      )
    }

    {/* ── ZDJĘCIA · two ratios, each file what the tile shows ──────────────── */}
    <section class="press-section press-section--soft tone-light" id="zdjecia" aria-label={t.photosAria}>
      <div class="press-inner">
        <div class="press-rubric-row">
          <h2 class="eyebrow titulus press-rubric">{copy.photos.eyebrow}</h2>
          <span class="press-rule" aria-hidden="true" />
        </div>
        <p class="press-lede">{copy.photos.lede}</p>

        {
          photoGroups.map((group) => (
            <div class="press-group">
              <div class="press-group-head">
                <h3 class="press-sub">{group.title}</h3>
                <span class="press-sub-note">{group.use}</span>
                {basket && group.photos.length > 1 && (
                  <label class="press-pick-all">
                    <input
                      type="checkbox"
                      class="press-pick-box"
                      data-basket-all={group.key}
                      aria-label={selectAllAria(group.title)}
                    />
                    <span>{t.selectAll}</span>
                  </label>
                )}
              </div>
              {/* A tile is three rows of its grid (picture, caption, file), so a caption that
                  wraps moves its whole row's files down together. */}
              <ul
                class={`press-tiles press-photo-grid press-photo-grid--${group.key}`}
                style={`--columns: ${group.columns}`}
              >
                {group.photos.map((photo) => {
                  const credit = frameCredit({ credit: photo.credit }, lang);
                  return (
                    <li class="press-tile">
                      {basket && (
                        <label class="press-pick press-pick--tile">
                          <input
                            type="checkbox"
                            class="press-pick-box"
                            data-basket-item={photoKey(photo)}
                            data-basket-group={group.key}
                            aria-label={fill(t.selectAria, "file", photo.caption)}
                          />
                        </label>
                      )}
                      <button
                        type="button"
                        class="press-tile-frame shot-open"
                        aria-label={fill(t.previewAria, "file", photo.caption)}
                        data-image-open
                        data-image-group={`press-${group.key}`}
                        data-image-src={href(photo.preview)}
                        data-image-alt={photo.caption}
                        data-image-caption={photo.caption}
                        data-image-credit={credit}
                        data-image-w={String(photo.preview.width)}
                        data-image-h={String(photo.preview.height)}
                      >
                        <img
                          src={href(photo.thumbs.w640)}
                          srcset={`${href(photo.thumbs.w640)} 640w, ${href(photo.thumbs.w1280)} 1280w`}
                          sizes={group.sizes}
                          width={photo.thumbs.w640.width}
                          height={photo.thumbs.w640.height}
                          alt={photo.caption}
                          loading="lazy"
                          decoding="async"
                        />
                        <span class="press-veil" aria-hidden="true">
                          <svg class="press-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">{ICON.preview.map((d) => <path d={d} />)}</svg>
                          <span>{t.preview}</span>
                        </span>
                      </button>
                      <div class="press-tile-cap">
                        <span class="press-tile-caption">{photo.caption}</span>
                        <span class="press-tile-credit">{credit}</span>
                        <button
                          type="button"
                          class="press-button"
                          data-copy={captionLine(photo.caption, credit)}
                          data-copied={t.copied}
                          aria-label={fill(t.copyCaptionAria, "file", photo.caption)}
                        >
                          <svg class="press-icon press-icon--copy" viewBox="0 0 16 16" aria-hidden="true" focusable="false">{ICON.copy.map((d) => <path d={d} />)}</svg>
                          <svg class="press-icon press-icon--check" viewBox="0 0 16 16" aria-hidden="true" focusable="false">{ICON.check.map((d) => <path d={d} />)}</svg>
                          <span class="copy-label">{t.copyCaption}</span>
                        </button>
                      </div>
                      <div class="press-tile-foot">
                        <span class="press-tile-meta">
                          {dims(photo)} · {size(photo)}
                        </span>
                        <a
                          class="press-button press-button--primary"
                          href={href(photo)}
                          download
                          aria-label={fill(t.downloadAria, "file", photo.caption)}
                        >
                          <svg class="press-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">{ICON.download.map((d) => <path d={d} />)}</svg>
                          <span>{t.download}</span>
                        </a>
                      </div>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))
        }

        {
          pack ? (
            <a class="press-cta press-cta--line press-cta--ink" href={href(pack.index.archives.zdjecia)} download>
              <span class="press-cta-label">{copy.photos.downloadAll}</span>
              <span class="press-cta-meta">ZIP · {size(pack.index.archives.zdjecia)}</span>
              <span class="press-cta-arrow" aria-hidden="true">↓</span>
            </a>
          ) : (
            <a class="press-cta press-cta--line press-cta--ink" href={requestHref}>
              <span class="press-cta-label">{copy.head.requestLabel}</span>
              <span class="press-cta-meta">{FOUNDATION.mail.press}</span>
              <span class="press-cta-arrow" aria-hidden="true">→</span>
            </a>
          )
        }
      </div>
    </section>

    {/* ── SOCIAL · the post, the tags, the graphics, the handles ───────────── */}
    <section class="press-section tone-light" id="social" aria-label={t.socialAria}>
      <div class="press-inner">
        <div class="press-rubric-row">
          <h2 class="eyebrow titulus press-rubric">{copy.social.eyebrow}</h2>
          <span class="press-rule" aria-hidden="true" />
        </div>
        <p class="press-lede">{copy.social.lede}</p>

        <div class="press-social-grid">
          {
            card && kit && (
              <article class="press-block">
                <div class="press-block-head">
                  <h3 class="press-sub">{copy.social.post}</h3>
                  <button
                    type="button"
                    class="press-button"
                    data-copy={card.post}
                    data-copied={t.copied}
                    aria-label={fill(t.copyFieldAria, "field", copy.social.post)}
                  >
                    <svg class="press-icon press-icon--copy" viewBox="0 0 16 16" aria-hidden="true" focusable="false">{ICON.copy.map((d) => <path d={d} />)}</svg>
                    <svg class="press-icon press-icon--check" viewBox="0 0 16 16" aria-hidden="true" focusable="false">{ICON.check.map((d) => <path d={d} />)}</svg>
                    <span class="copy-label">{t.copy}</span>
                  </button>
                </div>
                <p class="press-block-sub">{copy.social.postSub}</p>
                <div class="press-text press-post">
                  {paragraphs(card.post).map((lines) => (
                    <p>
                      {lines.map((line, i) => (
                        <>
                          {i > 0 && <br />}
                          {line}
                        </>
                      ))}
                    </p>
                  ))}
                </div>
              </article>
            )
          }
          <div class="press-social-side">
            {
              card && kit && (
                <article class="press-block">
                  <div class="press-block-head">
                    <h3 class="press-sub">{copy.social.hashtags}</h3>
                    <button
                      type="button"
                      class="press-button"
                      data-copy={card.hashtags}
                      data-copied={t.copied}
                      aria-label={fill(t.copyFieldAria, "field", copy.social.hashtags)}
                    >
                      <svg class="press-icon press-icon--copy" viewBox="0 0 16 16" aria-hidden="true" focusable="false">{ICON.copy.map((d) => <path d={d} />)}</svg>
                      <svg class="press-icon press-icon--check" viewBox="0 0 16 16" aria-hidden="true" focusable="false">{ICON.check.map((d) => <path d={d} />)}</svg>
                      <span class="copy-label">{t.copy}</span>
                    </button>
                  </div>
                  <ul class="press-chips">
                    {kit.social.hashtags.map((tag) => (
                      <li>{tag}</li>
                    ))}
                  </ul>
                </article>
              )
            }
            <article class="press-block">
              <div class="press-block-head">
                <h3 class="press-sub">{copy.social.tag}</h3>
              </div>
              <p class="press-block-sub">{copy.social.tagLede}</p>
              <ul class="press-tags">
                {Object.values(SOCIAL).map((account) => (
                  <li>
                    <span class="press-tag-platform">{account.platform}</span>
                    <a class="press-tag-handle" href={account.url} target="_blank" rel="noopener noreferrer">
                      {account.handle}
                    </a>
                    <button
                      type="button"
                      class="press-button"
                      data-copy={account.handle}
                      data-copied={t.copied}
                      aria-label={fill(t.copyFieldAria, "field", `${account.platform} ${account.handle}`)}
                    >
                      <svg class="press-icon press-icon--copy" viewBox="0 0 16 16" aria-hidden="true" focusable="false">{ICON.copy.map((d) => <path d={d} />)}</svg>
                      <svg class="press-icon press-icon--check" viewBox="0 0 16 16" aria-hidden="true" focusable="false">{ICON.check.map((d) => <path d={d} />)}</svg>
                      <span class="copy-label">{t.copy}</span>
                    </button>
                  </li>
                ))}
              </ul>
            </article>
          </div>
        </div>

        {
          graphics.length > 0 && card && (
            <article class="press-block press-graphics-block">
              <div class="press-block-head">
                <h3 class="press-sub">{copy.social.graphics}</h3>
                {basket && graphics.length > 1 && (
                  <label class="press-pick-all">
                    <input
                      type="checkbox"
                      class="press-pick-box"
                      data-basket-all="graphics"
                      aria-label={selectAllAria(copy.social.graphics)}
                    />
                    <span>{t.selectAll}</span>
                  </label>
                )}
              </div>
              <ul class="press-tiles press-graphics">
                {graphics.map((graphic) => {
                  const label = `${graphic.format.replace("x", ":")} · ${graphic.width} × ${graphic.height}`;
                  return (
                    <li class="press-tile">
                      {basket && (
                        <label class="press-pick press-pick--tile">
                          <input
                            type="checkbox"
                            class="press-pick-box"
                            data-basket-item={graphicKey(graphic)}
                            data-basket-group="graphics"
                            aria-label={fill(t.selectAria, "file", `${copy.social.graphics} ${label}`)}
                          />
                        </label>
                      )}
                      <button
                        type="button"
                        class="press-tile-frame shot-open"
                        aria-label={fill(t.previewAria, "file", `${copy.social.graphics} ${label}`)}
                        data-image-open
                        data-image-group="press-graphics"
                        data-image-src={href(graphic)}
                        data-image-alt={`${card.facts.title} · ${label}`}
                        data-image-caption={`${label} · ${GRAPHIC_USE[graphic.format]}`}
                        data-image-credit={card.posterCredit}
                        data-image-w={String(graphic.width)}
                        data-image-h={String(graphic.height)}
                      >
                        <img
                          src={href(graphic.thumb)}
                          width={graphic.thumb.width}
                          height={graphic.thumb.height}
                          alt={`${card.facts.title} · ${label}`}
                          loading="lazy"
                          decoding="async"
                        />
                        <span class="press-veil" aria-hidden="true">
                          <svg class="press-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">{ICON.preview.map((d) => <path d={d} />)}</svg>
                          <span>{t.preview}</span>
                        </span>
                      </button>
                      <div class="press-tile-cap">
                        <span class="press-tile-caption">{label}</span>
                        <span class="press-tile-credit">{GRAPHIC_USE[graphic.format]}</span>
                      </div>
                      <div class="press-tile-foot">
                        <span class="press-tile-meta">JPG · {size(graphic)}</span>
                        <a
                          class="press-button press-button--primary"
                          href={href(graphic)}
                          download
                          aria-label={fill(t.downloadAria, "file", label)}
                        >
                          <svg class="press-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">{ICON.download.map((d) => <path d={d} />)}</svg>
                          <span>{t.download}</span>
                        </a>
                      </div>
                    </li>
                  );
                })}
              </ul>
            </article>
          )
        }
      </div>
    </section>

    {/* ── O ZESPOLE · three biograms, each one paste-ready, and the logotype ── */}
    <section class="press-section press-section--soft tone-light" id="o-zespole" aria-label={t.aboutAria}>
      <div class="press-inner">
        <div class="press-rubric-row">
          <h2 class="eyebrow titulus press-rubric">{copy.about.eyebrow}</h2>
          <span class="press-rule" aria-hidden="true" />
        </div>
        <p class="press-lede">{copy.about.lede}</p>

        {/* Biograms beside the logotype on a desktop, under it on anything narrower. */}
        <div class="press-about">
          {/* ONE card, three measures. The measures are radios, so the switch needs no script:
              the chosen one shows its text, its count and its copy button, and the other two are
              hidden in the stylesheet. A browser without `:has()` shows all three, stacked. */}
          <div class="press-bios">
            <div class="press-bios-head">
              <fieldset class="press-measures">
                <legend class="sr-only">{t.bioMeasureAria}</legend>
                {BIOS.map((bio) => (
                  <label class="press-measure">
                    <input
                      type="radio"
                      class="press-measure-input"
                      name="press-bio-measure"
                      value={bio.id}
                      checked={bio.id === "short"}
                    />
                    <span>{bio.measure}</span>
                  </label>
                ))}
              </fieldset>
              {BIOS.map((bio) => (
                <div class="press-bio-tools" data-measure={bio.id}>
                  <span class="press-bio-count">{counted(bio.length, t.characters, lang)}</span>
                  <button
                    type="button"
                    class="press-button"
                    data-copy={bio.text}
                    data-copied={t.copied}
                    aria-label={fill(t.copyAria, "measure", bio.measure)}
                  >
                    <svg class="press-icon press-icon--copy" viewBox="0 0 16 16" aria-hidden="true" focusable="false">{ICON.copy.map((d) => <path d={d} />)}</svg>
                    <svg class="press-icon press-icon--check" viewBox="0 0 16 16" aria-hidden="true" focusable="false">{ICON.check.map((d) => <path d={d} />)}</svg>
                    <span class="copy-label">{t.copy}</span>
                  </button>
                </div>
              ))}
            </div>
            {BIOS.map((bio) => (
              <div class="press-bio-text press-text" data-measure={bio.id} set:html={bio.html} />
            ))}
          </div>

          <div class="press-logo">
            <div class="press-group-head">
              <h3 class="press-sub">{copy.about.logo}</h3>
              {basket && logoTiles.length > 1 && (
                <label class="press-pick-all">
                  <input
                    type="checkbox"
                    class="press-pick-box"
                    data-basket-all="logo"
                    aria-label={selectAllAria(copy.about.logo)}
                  />
                  <span>{t.selectAll}</span>
                </label>
              )}
            </div>
            <p class="press-block-sub press-logo-usage">{copy.about.logoUsage}</p>
            {
              logoTiles.length > 0 && (
                <ul class="press-tiles press-logo-grid">
                  {logoTiles.map((tile) => (
                    <li class="press-tile">
                      {basket && (
                        <label class="press-pick press-pick--tile">
                          <input
                            type="checkbox"
                            class="press-pick-box"
                            data-basket-item={logoKey(tile.ground)}
                            data-basket-group="logo"
                            aria-label={fill(t.selectAria, "file", `${copy.about.logo} — ${tile.label}`)}
                          />
                        </label>
                      )}
                      {/* Not a `.press-tile-frame`: that frame paints a paper ground under a loading
                          photograph, which would cover a light mark on the dark swatch. */}
                      <span class={`press-logo-swatch press-logo-swatch--${tile.ground}`}>
                        <img src={href(tile.swatch)} alt="" loading="lazy" decoding="async" />
                      </span>
                      <div class="press-tile-cap">
                        <span class="press-tile-caption">{tile.label}</span>
                      </div>
                      <ul class="press-tile-foot press-logo-files">
                        {tile.files.map((entry) => (
                          <li>
                            <span class="press-tile-meta">
                              {entry.format}
                              {dims(entry.file) && ` · ${dims(entry.file)}`} · {size(entry.file)}
                            </span>
                            <a
                              class="press-button press-button--primary"
                              href={href(entry.file)}
                              download
                              aria-label={fill(
                                t.downloadAria,
                                "file",
                                `${copy.about.logo} — ${tile.label}, ${entry.format}`,
                              )}
                            >
                              <svg class="press-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">{ICON.download.map((d) => <path d={d} />)}</svg>
                              <span>{t.download}</span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </li>
                  ))}
                </ul>
              )
            }
          </div>
        </div>
      </div>
    </section>

    {/* ── FUNDACJA · who signs, and the details a contract needs ───────────── */}
    <section class="press-section tone-light" id="fundacja" aria-label={t.foundationAria}>
      <div class="press-inner">
        <div class="press-rubric-row">
          <h2 class="eyebrow titulus press-rubric">{copy.foundation.eyebrow}</h2>
          <span class="press-rule" aria-hidden="true" />
        </div>
        <p class="press-lede">{copy.foundation.lede}</p>
        <dl class="press-legal-grid">
          {
            LEGAL_ROWS.map((row) => (
              <div class="press-legal-row">
                <dt class="eyebrow">{row.label}</dt>
                <dd>
                  <span class:list={["press-legal-value", { "is-ledger": row.mono }]}>{row.value}</span>
                  <button
                    type="button"
                    class="press-button"
                    data-copy={row.value}
                    data-copied={t.copied}
                    aria-label={fill(t.copyFieldAria, "field", row.label)}
                  >
                    <svg class="press-icon press-icon--copy" viewBox="0 0 16 16" aria-hidden="true" focusable="false">{ICON.copy.map((d) => <path d={d} />)}</svg>
                    <svg class="press-icon press-icon--check" viewBox="0 0 16 16" aria-hidden="true" focusable="false">{ICON.check.map((d) => <path d={d} />)}</svg>
                    <span class="copy-label">{t.copy}</span>
                  </button>
                </dd>
              </div>
            ))
          }
        </dl>
        {
          pack && (
            <p class="press-invoice">
              <a class="press-button press-button--primary" href={href(pack.index.invoice)} download>
                <svg class="press-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">{ICON.download.map((d) => <path d={d} />)}</svg>
                <span>{t.invoiceFile}</span>
              </a>
              <span class="press-file-meta">TXT · {size(pack.index.invoice)}</span>
            </p>
          )
        }
      </div>
    </section>

    {/* ── KONTAKT · the press address, and what only a mail can get ────────── */}
    <section class="press-contact" id="kontakt" aria-label={t.contactAria}>
      <div class="press-inner">
        <div class="press-rubric-row">
          <h2 class="eyebrow titulus press-rubric">{copy.contact.eyebrow}</h2>
          <span class="press-rule" aria-hidden="true" />
        </div>
        {/* The address and, beside it on a desktop, the one request only a mail can make. */}
        <div class="press-contact-grid">
          <div class="press-contact-main">
            <p class="press-contact-lede">{copy.contact.lede}</p>
            <a class="press-contact-card" href={mailto(FOUNDATION.mail.press, t.mailSubjectMedia)}>
              <span class="press-contact-mail">{FOUNDATION.mail.press}</span>
              <span class="press-contact-arrow" aria-hidden="true">→</span>
            </a>
          </div>
          {/* A named person and a phone join this section only once the board supplies them. */}
          <div class="press-broadcast">
            <h3 class="press-broadcast-title">{copy.contact.broadcastTitle}</h3>
            <p class="press-broadcast-body">{copy.contact.broadcastBody}</p>
            <a class="press-broadcast-cta" href={mailto(FOUNDATION.mail.press, t.mailSubjectBroadcast)}>
              {copy.contact.broadcastCta} →
            </a>
          </div>
        </div>
      </div>
    </section>

    {/* ── THE BASKET · what is ticked, and the one button that takes it ────── */}
    {/* Last in <main> and sticky to the viewport's foot: over the sections while they scroll, at
        rest above the footer at the end, so it never hides the footer's last lines. */}
    {
      basket && (
        <>
          <script is:inline type="application/json" id="press-basket-data" set:html={basketJson} />
          <div class="press-basket" data-basket-bar role="region" aria-label={t.basketAria} hidden>
            <div class="press-inner press-basket-inner">
              <p class="press-basket-sum" aria-live="polite">
                <span class="press-basket-count" data-basket-count />
                <span class="press-basket-size" data-basket-size />
              </p>
              <button type="button" class="press-basket-get" data-basket-get>
                <svg class="press-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">{ICON.download.map((d) => <path d={d} />)}</svg>
                <span>{t.basketDownload}</span>
              </button>
              <button type="button" class="press-basket-clear" data-basket-clear>
                {t.basketClear}
              </button>
            </div>
          </div>
        </>
      )
    }
  </main>

  <SiteFooter lang={lang} />

  <VaultMount lang={lang} />
  <ImageLightbox client:idle />
  <script>
    import "../../scripts/vault-triggers.ts";
    // Every `[data-copy]` control on this page: the concert's facts, the kit's texts, the handles,
    // the biograms and the invoicing rows.
    import "../../scripts/copy-fields.ts";
    import "../../scripts/image-triggers.ts";
    // The composer: the checkboxes, the bar, and the archive of the ticked files.
    import "../../scripts/press-basket.ts";

    import { setupDisclosure } from "../../scripts/disclosure";

    type LenisJump = {
      scrollTo: (target: number, options: { immediate: boolean; force: boolean }) => void;
    };

    /* The kept index (`.press-index`). It shows once the head's foot has passed under the bar,
       marks the section whose top has passed under the index itself, and takes that section's
       ground, night over the contact band and paper everywhere else. One scroll reader per frame:
       seven rectangles are cheaper than an observer per question. */
    const setupIndex = (chrome: HTMLElement): (() => void) | undefined => {
      const index = document.querySelector<HTMLElement>("[data-press-index]");
      const head = document.querySelector<HTMLElement>(".press-head");
      if (!index || !head) return undefined;
      const links = [...index.querySelectorAll<HTMLAnchorElement>("a[href^='#']")];
      const sections = [...document.querySelectorAll<HTMLElement>("#tresc > section[id]")];

      let frame = 0;
      const update = () => {
        frame = 0;
        const top = chrome.getBoundingClientRect().bottom;
        index.style.setProperty("--press-index-top", `${Math.round(top)}px`);
        index.toggleAttribute("data-shown", head.getBoundingClientRect().bottom <= top);
        const line = top + index.offsetHeight;
        let current: HTMLElement | undefined;
        for (const section of sections) {
          if (section.getBoundingClientRect().top <= line + 1) current = section;
        }
        index.dataset.ground = current && !current.classList.contains("tone-light") ? "night" : "paper";
        for (const link of links) {
          if (current && link.hash === `#${current.id}`) link.setAttribute("aria-current", "location");
          else link.removeAttribute("aria-current");
        }
      };
      const schedule = () => {
        if (!frame) frame = requestAnimationFrame(update);
      };

      // Its rows are hit mid-scroll by construction, and where Lenis owns the scroll it reasserts
      // its own position on the next frame, undoing the anchor's jump. So there the jump goes
      // through Lenis, as a cut, to where the anchor would have landed: the target's own
      // `scroll-margin-top`, which the stylesheet sets to clear the bar and this index.
      const jump = (event: MouseEvent) => {
        const link = (event.target as Element | null)?.closest<HTMLAnchorElement>("a[href^='#']");
        const lenis = (window as unknown as { __lenis?: LenisJump }).__lenis;
        if (!link || !lenis || event.defaultPrevented) return;
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const target = document.getElementById(link.hash.slice(1));
        if (!target) return;
        event.preventDefault();
        const margin = Number.parseFloat(getComputedStyle(target).scrollMarginTop) || 0;
        lenis.scrollTo(window.scrollY + target.getBoundingClientRect().top - margin, {
          immediate: true,
          force: true,
        });
        window.history.pushState(null, "", link.hash);
      };

      update();
      window.addEventListener("scroll", schedule, { passive: true });
      window.addEventListener("resize", schedule, { passive: true });
      index.addEventListener("click", jump);
      return () => {
        cancelAnimationFrame(frame);
        window.removeEventListener("scroll", schedule);
        window.removeEventListener("resize", schedule);
        index.removeEventListener("click", jump);
      };
    };

    // Chrome tone flips to light over .tone-light sections (the /koncerty pattern).
    // ClientRouter-safe: drops stale observers and listeners and rebinds on each page-load.
    let toneIO: IntersectionObserver | undefined;
    let dropTexts: (() => void) | undefined;
    let dropIndex: (() => void) | undefined;

    const setupPress = () => {
      toneIO?.disconnect();
      dropTexts?.();
      dropIndex?.();
      dropIndex = undefined;

      // The file rows' texts open in place. NOT exclusive: an editor comparing two before choosing
      // one should not have the first close under them.
      dropTexts = setupDisclosure(document, {
        selector: ".press-d",
        bodyClass: "press-d-body",
      });

      const chrome = document.getElementById("chrome");
      if (!chrome) return;
      if (!document.body.classList.contains("page-press")) return;

      dropIndex = setupIndex(chrome);

      const lightSections = [...document.querySelectorAll(".tone-light")];
      const activeLight = new Set<Element>();
      toneIO = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) activeLight.add(e.target);
            else activeLight.delete(e.target);
          }
          chrome.classList.toggle("is-light", activeLight.size > 0);
        },
        { rootMargin: "-64px 0px -90% 0px", threshold: 0 },
      );
      lightSections.forEach((el) => toneIO!.observe(el));
    };

    document.addEventListener("astro:page-load", setupPress);
  </script>
</BaseLayout>

<style>
  /* Surface as an opaque image, colour slot left to the iOS edge band — see `--edge-band`.
     A plain `background: var(--paper)` here would put page content back into the band. */
  :global(body.page-press) {
    background-image: linear-gradient(var(--paper), var(--paper));
    background-color: var(--edge-band);
    color: var(--ink);
  }
  /* The photograph frame's scroll-lock, named for THIS body class rather than declared in
     image-lightbox.css — the same shape /obrazy, /kolofon and /koncerty use. */
  :global(body.page-press.image-open) { overflow: hidden; }

  /* ── Shared primitives ───────────────────────────────────────────── */
  /* THE RUBRIC ATOM IS NOT DECLARED HERE. Every rubric on this page is `.eyebrow` (base.css):
     its face, size, weight, tracking and case belong there, and a page rule naming that class
     would silently beat it on bundle order. `.press-rubric` is this page's own handle and carries
     only layout; the dark sections state their ground's colour, nothing else. */
  .press-inner { max-width: 1180px; margin: 0 auto; }
  /* What covers the top of the screen once the head is gone: the bar at rest (16 + 40 + 14 px in
     SiteChrome), and from a tablet up the kept index under it. A section reached by its anchor
     lands with its rubric 20 px below that, whatever its own top padding. */
  main { --press-index-h: 44px; --press-bars: calc(env(safe-area-inset-top, 0px) + 70px); }
  @media (min-width: 760px) and (min-height: 600px) {
    main { --press-bars: calc(env(safe-area-inset-top, 0px) + 70px + var(--press-index-h)); }
  }
  /* A tool's rhythm, not a landing's: the reader scrolls to a file, not through a story. */
  .press-section { --press-pad: clamp(52px, 6.3vw, 90px); padding: var(--press-pad) max(28px, 5vw); background: var(--paper); scroll-margin-top: calc(var(--press-bars) + 20px - var(--press-pad)); }
  .press-section--soft { background: var(--paper-soft); }

  .press-rubric-row { display: flex; align-items: center; gap: 12px 20px; margin: 0 0 clamp(20px, 2.1vw, 28px); }
  .press-rubric { margin: 0; flex: 0 0 auto; }
  .press-rule { flex: 1 1 auto; height: 1px; background: var(--line-strong); }
  .press-lede { margin: 0 0 clamp(26px, 3.1vw, 42px); max-width: 60ch; font-family: var(--serif); font-weight: 300; font-size: clamp(18px, 1.45vw, 21px); line-height: 1.55; color: var(--ink-soft); }

  .press-sub { margin: 0; font-family: var(--serif); font-weight: 400; font-size: clamp(22px, 2vw, 28px); line-height: 1.2; color: var(--ink); }
  .press-sub-note { font-size: 14px; line-height: 1.5; color: var(--ink-muted); }
  .press-group-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 16px; margin: 0 0 18px; }

  /* ONE ACTION HIERARCHY. The download is the only boxed control: ink border, sans, a drawn icon.
     Preview and copy are an icon and a word with no box, ink-soft until approached. Mono capitals
     stay for figures (format, size, dimensions, counts) and "select all", never for an action. */
  .press-icon { flex: 0 0 auto; width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.25; stroke-linecap: round; stroke-linejoin: round; }
  .press-button { display: inline-flex; align-items: center; gap: 7px; padding: 6px 2px; border: 0; background: transparent; font-family: var(--sans); font-size: 13px; line-height: 1.2; letter-spacing: .01em; color: var(--ink-soft); white-space: nowrap; cursor: pointer; transition: color .35s var(--ease), border-color .35s var(--ease), background-color .35s var(--ease); }
  .press-button > span { text-decoration: underline transparent; text-decoration-thickness: 1px; text-underline-offset: 3px; transition: text-decoration-color .35s var(--ease); }
  .press-button:hover { color: var(--ink); }
  .press-button:hover > span { text-decoration-color: currentColor; }
  .press-button:focus-visible { outline: 1px solid var(--candle); outline-offset: 3px; }
  .press-button--primary { padding: 7px 12px 7px 10px; border: 1px solid var(--ink); color: var(--ink); }
  .press-button--primary:hover { border-color: var(--candle); background: rgba(198, 164, 91, .12); }
  .press-button--primary:hover > span { text-decoration-color: transparent; }
  /* A copy confirms in place: copy-fields.ts turns the word, and the icon turns into a check. */
  .press-icon--check { display: none; }
  .press-button.is-copied { color: var(--ink); }
  .press-button.is-copied .press-icon--copy { display: none; }
  .press-button.is-copied .press-icon--check { display: block; }

  /* A text shown as it is pasted: paragraphs, and the lines inside a paragraph kept. */
  .press-text { display: grid; gap: 12px; }
  .press-text :global(p) { margin: 0; font-family: var(--serif); font-weight: 300; font-size: clamp(16px, 1.2vw, 18px); line-height: 1.6; color: var(--ink); }
  .press-text :global(strong) { font-weight: 400; }
  .press-text :global(em) { font-style: italic; }

  /* The disclosure. `scripts/disclosure.ts` animates the body's height and writes `open` itself,
     so the marker is removed and the summary is styled as the quiet control it is — the loud
     control is the copy button, which is never inside it. */
  .press-d > summary { list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; padding: 4px 0; font-family: var(--sans); font-size: 13px; line-height: 1.2; color: var(--ink-soft); transition: color .35s var(--ease); }
  .press-d > summary::-webkit-details-marker { display: none; }
  .press-d > summary::after { content: "+"; font-family: var(--serif); font-size: 15px; line-height: 1; transition: transform .35s var(--ease); }
  .press-d[open] > summary::after { transform: rotate(45deg); }
  .press-d > summary:hover { color: var(--ink); }
  .press-d[open] .press-d-open,
  .press-d:not([open]) .press-d-close { display: none; }
  .press-d-body { margin-top: 14px; }

  /* The big plate. Gold once, in the head; a hairline everywhere else. */
  .press-cta { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 22px; padding: clamp(20px, 2.4vw, 30px) clamp(22px, 2.8vw, 36px); background: var(--candle); color: var(--ink); transition: background-color .4s var(--ease), border-color .4s var(--ease); }
  .press-cta:hover { background: #d8b96b; }
  .press-cta-label { font-family: var(--serif); font-weight: 300; font-size: clamp(22px, 2.2vw, 30px); line-height: 1; }
  .press-cta-meta { font-family: var(--mono); font-size: 10.5px; letter-spacing: .12em; text-transform: uppercase; color: rgba(22, 21, 20, .7); }
  .press-cta-arrow { margin-left: auto; font-family: var(--serif); font-size: clamp(24px, 2.4vw, 30px); }
  .press-cta--line { background: transparent; border: 1px solid rgba(244, 241, 233, .28); color: var(--paper); }
  .press-cta--line:hover { background: rgba(198, 164, 91, .1); border-color: var(--candle); }
  .press-cta--line .press-cta-meta { color: rgba(244, 241, 233, .62); }
  .press-cta--ink { margin-top: clamp(28px, 3.5vw, 44px); border-color: var(--line-strong); color: var(--ink); }
  .press-cta--ink .press-cta-meta { color: var(--ink-muted); }

  /* ── HEAD ────────────────────────────────────────────────────────── */
  /* Not 100svh, and short enough that at 1440 × 900 the next concert's title is on screen: a
     reader who came for a file should see where the files begin without a scroll. */
  .press-head { position: relative; padding: clamp(112px, 15vh, 150px) max(28px, 5vw) clamp(40px, 6vh, 64px); background: var(--night); color: var(--paper); overflow: hidden; }
  .press-head::before { content: ""; position: absolute; inset: 0; background: radial-gradient(80% 60% at 50% 0%, rgba(232, 207, 144, 0.06), transparent 65%), linear-gradient(180deg, rgba(8,8,7,0) 0%, rgba(8,8,7,0.55) 100%); pointer-events: none; }
  .press-head-inner { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(18px, 2.2vw, 28px); justify-items: start; }
  .press-head-title { margin: 0; font-family: var(--serif); font-weight: 300; font-size: clamp(52px, 7vw, 96px); line-height: 0.94; letter-spacing: -.01em; color: var(--paper); display: grid; gap: clamp(6px, .8vw, 12px); }
  .press-head-title em { font-style: italic; font-size: .36em; line-height: 1.1; color: var(--candle); }
  .press-head-lede { margin: 0; max-width: 52ch; font-family: var(--serif); font-weight: 300; font-size: clamp(18px, 1.7vw, 23px); line-height: 1.5; color: rgba(244, 241, 233, 0.9); }
  .press-head .press-cta { width: min(100%, 560px); }
  /* The index sits on a hairline as wide as the plate above it, so plate and index read as one
     block, and speaks in the page's tool register (mono, tracked capitals) rather than as underlined
     body links. No arrow: on this page ↓ means a download. */
  .press-jump { width: min(100%, 560px); padding-top: 16px; border-top: 1px solid rgba(244, 241, 233, .16); }
  .press-jump ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 12px 28px; }
  .press-jump a { display: inline-block; padding-bottom: 3px; border-bottom: 1px solid transparent; font-family: var(--mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; line-height: 1.4; color: rgba(244, 241, 233, .7); transition: color .35s var(--ease), border-color .35s var(--ease); }
  .press-jump a:hover { color: var(--paper); border-color: var(--candle); }

  /* The press address, what komplet holds, and the day it was cut. Under the index on a phone; on
     a desktop the column the plate leaves empty, its foot level with the index. */
  .press-head-facts { width: min(100%, 560px); margin: 0; padding-top: 16px; border-top: 1px solid rgba(244, 241, 233, .16); display: grid; gap: 14px; }
  .press-head-fact { display: grid; gap: 3px; }
  .press-head-fact dt { font-family: var(--sans); font-size: 12px; letter-spacing: .02em; color: rgba(244, 241, 233, .55); }
  .press-head-fact dd { margin: 0; font-family: var(--serif); font-size: clamp(16px, 1.25vw, 18px); line-height: 1.45; color: rgba(244, 241, 233, .9); font-variant-numeric: lining-nums; }
  .press-head-mail { display: flex; flex-wrap: wrap; align-items: center; gap: 2px 16px; }
  .press-head-mail a { color: var(--candle); border-bottom: 1px solid rgba(198, 164, 91, .4); word-break: break-word; transition: border-color .35s var(--ease); }
  .press-head-mail a:hover { border-color: var(--candle); }
  .press-head .press-button { color: rgba(244, 241, 233, .7); }
  .press-head .press-button:hover,
  .press-head .press-button.is-copied { color: var(--paper); }
  @media (min-width: 1000px) {
    .press-head-inner { grid-template-columns: minmax(0, 1fr) minmax(0, 360px); column-gap: clamp(40px, 5vw, 80px); }
    .press-head-inner > :not(.press-head-facts) { grid-column: 1; }
    .press-head-facts { grid-column: 2; grid-row: 1 / span 4; align-self: end; width: 100%; }
  }

  /* ── THE KEPT INDEX ──────────────────────────────────────────────── */
  /* In the bar's own glass, one tier under it and ruled at its foot, so bar and index read as one
     band. `--press-index-top` is the bar's measured foot (the script), since the bar changes height
     as it turns solid. Hidden takes `visibility` as well as opacity, so its rows leave the tab order
     and the accessibility tree while the head's own index is on screen. The ground follows the
     section under it: paper glass, and night glass over the contact band. */
  .press-index { display: none; }
  @media (min-width: 760px) and (min-height: 600px) {
    .press-index { position: fixed; top: var(--press-index-top, 70px); left: 0; right: 0; z-index: 49; display: flex; align-items: center; height: var(--press-index-h); padding: 0 max(28px, 5vw); background-color: color-mix(in srgb, var(--chrome-paper, var(--paper)) 82%, transparent); backdrop-filter: blur(20px) saturate(1.1); -webkit-backdrop-filter: blur(20px) saturate(1.1); border-bottom: 1px solid rgba(22, 21, 20, .1); color: var(--ink); opacity: 0; visibility: hidden; transition: opacity .35s var(--ease), visibility 0s linear .35s, background-color .5s var(--ease), border-color .5s var(--ease), color .5s var(--ease); }
    .press-index[data-shown] { opacity: 1; visibility: visible; transition: opacity .35s var(--ease), visibility 0s, background-color .5s var(--ease), border-color .5s var(--ease), color .5s var(--ease); }
    .press-index[data-ground="night"] { background-color: rgba(16, 15, 13, .72); border-bottom-color: rgba(244, 241, 233, .12); color: var(--paper); }
  }
  @media (prefers-reduced-motion: reduce) { .press-index, .press-index[data-shown] { transition: none; } }
  .press-index .press-inner { width: 100%; }
  .press-index ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 28px; }
  /* The head index's register, mono and tracked, in the ink of whichever ground it stands on,
     receded. The row being read, and the one under the pointer, take the full ink and a candle rule. */
  .press-index a { display: inline-block; padding: 4px 0 3px; border-bottom: 1px solid transparent; font-family: var(--mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; line-height: 1.4; color: color-mix(in srgb, currentColor 62%, transparent); transition: color .35s var(--ease), border-color .35s var(--ease); }
  .press-index a:hover,
  .press-index a[aria-current] { color: currentColor; border-color: var(--candle); }
  .press-index a:focus-visible { outline: 1px solid var(--candle); outline-offset: 3px; }

  /* ── NAJNOWSZE ───────────────────────────────────────────────────── */
  /* The poster's size comes from the TRACK: a `width` on `.shot-open` would lose to its reset. */
  .press-concert { display: grid; grid-template-columns: minmax(0, 300px) minmax(0, 1fr); gap: clamp(28px, 4.5vw, 72px); align-items: start; }
  .press-concert-media { display: grid; gap: 18px; justify-items: start; }
  .press-poster :global(img) { display: block; width: 100%; height: auto; box-shadow: 0 18px 40px -24px rgba(22, 21, 20, .45); }
  .press-forces { margin: 0; padding: 5px 12px; border: 1px solid var(--line-strong); font-family: var(--sans); font-size: 13px; letter-spacing: .04em; color: var(--ink-soft); }
  .press-concert-page { font-size: 15px; color: var(--ink); border-bottom: 1px solid var(--candle); padding-bottom: 1px; transition: color .35s var(--ease); }
  .press-concert-page:hover { color: var(--candle-ink); }

  .press-concert-title { margin: 0; font-family: var(--serif); font-weight: 300; font-size: clamp(40px, 5.4vw, 72px); line-height: 1; letter-spacing: -.01em; color: var(--ink); }
  .press-concert-title a { color: inherit; transition: color .35s var(--ease); }
  .press-concert-title a:hover { color: var(--candle-ink); }
  .press-concert-dateline { margin: clamp(18px, 2vw, 26px) 0 0; font-family: var(--serif); font-size: clamp(19px, 1.6vw, 23px); line-height: 1.35; color: var(--ink); font-variant-numeric: lining-nums; }
  .press-concert-place { margin: 8px 0 0; font-size: 15px; line-height: 1.55; color: var(--ink-soft); }
  .press-concert-place a { color: inherit; border-bottom: 1px solid var(--line-strong); transition: border-color .35s var(--ease); }
  .press-concert-place a:hover { border-color: var(--candle); }
  .press-concert-lede { margin: clamp(20px, 2.2vw, 28px) 0 0; max-width: 58ch; font-family: var(--serif); font-weight: 300; font-size: clamp(17px, 1.35vw, 20px); line-height: 1.6; color: var(--ink); }
  .press-concert-composers { margin: 16px 0 0; max-width: 64ch; font-family: var(--serif); font-style: italic; font-size: 16px; line-height: 1.6; color: var(--ink-soft); }
  .press-concert-text .press-button { margin-top: clamp(20px, 2.4vw, 30px); }

  .press-files { margin-top: clamp(40px, 4.6vw, 62px); }
  /* ONE grid for the whole list, every row a subgrid of it: the meta and the actions of each row
     sit in shared columns, however many actions a row carries. */
  .press-file-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 24px minmax(0, 1fr) auto auto; column-gap: 20px; }
  .press-file { grid-column: 1 / -1; display: grid; grid-template-columns: subgrid; align-items: start; row-gap: 6px; padding: 16px 0; border-bottom: 1px solid var(--line); }
  .press-file:first-child { border-top: 1px solid var(--line-strong); }
  .press-file-icon { color: var(--ink-muted); padding-top: 1px; }
  .press-file-main { display: grid; gap: 4px; justify-items: start; }
  .press-file-title { font-family: var(--serif); font-size: clamp(17px, 1.3vw, 19px); line-height: 1.35; color: var(--ink); }
  .press-file-sub { font-size: 14px; line-height: 1.5; color: var(--ink-soft); }
  .press-file-main .press-d { margin-top: 4px; justify-self: stretch; }
  .press-file-main .press-d-body { max-width: 64ch; }
  /* Format and size — a figure a reader checks, so mono and lining. */
  .press-file-meta { padding-top: 5px; font-family: var(--mono); font-size: 11px; letter-spacing: .08em; color: var(--ink-muted); white-space: nowrap; font-variant-numeric: lining-nums; }
  /* Pulled up by half the box's excess over the title's first line, so the download sits on it. */
  .press-file-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 18px; justify-content: flex-end; margin-top: -4px; }
  @media (max-width: 760px) {
    .press-concert { grid-template-columns: minmax(0, 1fr); }
    .press-concert-media { grid-template-columns: minmax(0, 220px); }
    .press-file-list { grid-template-columns: 22px minmax(0, 1fr); }
    .press-file-meta, .press-file-actions { grid-column: 2; }
    .press-file-meta { padding-top: 0; }
    .press-file-actions { justify-content: flex-start; margin-top: 4px; }
  }

  /* ── TILES · photographs, graphics, the logotype ────────────────── */
  /* A tile is three rows of its list's grid (picture, caption, file) as a subgrid, so a caption
     that wraps moves its whole row's file lines down together. The list's row gap is the gap
     INSIDE a tile; the space between rows of tiles is the foot's padding. */
  .press-tiles { --tile-gap: clamp(16px, 1.8vw, 26px); list-style: none; margin: 0; padding: 0; display: grid; column-gap: var(--tile-gap); row-gap: 10px; }
  .press-tile { position: relative; grid-row: span 3; display: grid; grid-template-rows: subgrid; }
  /* `align-self: end`, never stretch: the lightbox's gold edge is drawn on this box. */
  .press-tile-frame { align-self: end; }
  .press-tile-frame img { display: block; width: 100%; height: auto; background: var(--paper); }
  .press-tile-cap { display: grid; gap: 2px; align-content: start; justify-items: start; font-size: 13.5px; line-height: 1.45; }
  .press-tile-caption { color: var(--ink); }
  .press-tile-credit { color: var(--ink-soft); }
  .press-tile-cap .press-button { margin-top: 2px; }
  .press-tile-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; align-content: start; gap: 8px 12px; padding-bottom: clamp(16px, 1.8vw, 26px); }
  .press-tile-meta { font-family: var(--mono); font-size: 10.5px; letter-spacing: .06em; color: var(--ink-muted); font-variant-numeric: lining-nums; }

  /* On approach a picture takes a quiet veil with the word; on a touch screen there is no approach
     to answer, and a tap goes straight to the lightbox. */
  .press-veil { position: absolute; inset: 0; z-index: 1; display: flex; align-items: center; justify-content: center; gap: 8px; background: rgba(16, 15, 13, .38); color: var(--paper); font-family: var(--sans); font-size: 13px; opacity: 0; pointer-events: none; transition: opacity .35s var(--ease); }
  .press-tile-frame:hover .press-veil,
  .press-tile-frame:focus-visible .press-veil { opacity: 1; }
  @media (hover: none) { .press-veil { display: none; } }

  /* ── ZDJĘCIA ─────────────────────────────────────────────────────── */
  .press-group + .press-group { margin-top: clamp(26px, 3vw, 40px); }
  /* `--columns` is set per group from its count (the page's `columnsFor`); below 1100 px the counts
     are fixed. */
  .press-photo-grid { grid-template-columns: repeat(var(--columns, 3), minmax(0, 1fr)); }
  @media (max-width: 1099px) {
    .press-photo-grid--portrait { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 900px) {
    .press-photo-grid--landscape { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  /* On a phone each group is ONE row that scrolls sideways and snaps a tile to the text's edge,
     the next tile showing past the screen's so the row says it goes on. Still three subgrid rows,
     one column per tile, so the captions and files of a row stay level. The row runs to the
     screen's edges; its padding and snap padding are the section's gutter, and its top padding
     keeps a ticked tile's outline inside the scroller's clip. Widths are the `sizes` in the
     page's PHOTO_GROUPS. */
  @media (max-width: 560px) {
    .press-photo-grid { --press-gutter: max(28px, 5vw); grid-template-columns: none; grid-template-rows: repeat(3, auto); grid-auto-flow: column; grid-auto-columns: 78vw; margin: 0 calc(-1 * var(--press-gutter)); padding: 6px var(--press-gutter) 0; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scroll-padding-inline: var(--press-gutter); scrollbar-width: none; }
    .press-photo-grid::-webkit-scrollbar { display: none; }
    .press-photo-grid--portrait { grid-template-columns: none; grid-auto-columns: 60vw; }
    .press-photo-grid > .press-tile { scroll-snap-align: start; }
  }

  /* ── SOCIAL ──────────────────────────────────────────────────────── */
  .press-social-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: clamp(32px, 4vw, 64px); align-items: start; }
  .press-social-side { display: grid; gap: clamp(24px, 2.6vw, 34px); }
  .press-block { display: grid; gap: 14px; align-content: start; padding-top: 18px; border-top: 1px solid var(--line-strong); }
  .press-block-head { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; }
  .press-block-head .press-button { margin-left: auto; }
  .press-block-sub { margin: 0; font-size: 14px; line-height: 1.55; color: var(--ink-soft); }
  .press-post { padding: clamp(18px, 2vw, 26px); background: var(--paper-soft); border: 1px solid var(--line); }
  .press-chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .press-chips li { padding: 5px 12px; border: 1px solid var(--line-strong); border-radius: 999px; font-size: 14px; line-height: 1.4; color: var(--ink); }
  .press-tags { list-style: none; margin: 0; padding: 0; display: grid; gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .press-tags li { display: grid; grid-template-columns: 6.5rem minmax(0, 1fr) auto; align-items: center; gap: 12px; padding: 12px 16px; background: var(--paper); }
  .press-tag-platform { font-size: 13px; color: var(--ink-muted); }
  .press-tag-handle { font-family: var(--serif); font-size: 18px; color: var(--ink); word-break: break-word; transition: color .35s var(--ease); }
  .press-tag-handle:hover { color: var(--candle-ink); }
  /* Three ratios in one row at ONE height: each track's share is its image's width at height 1. */
  .press-graphics-block { margin-top: clamp(28px, 3.2vw, 44px); }
  .press-graphics { grid-template-columns: .8fr .5625fr 1.7778fr; }
  @media (max-width: 760px) {
    .press-social-grid { grid-template-columns: minmax(0, 1fr); }
    .press-graphics { grid-template-columns: .8fr .5625fr; }
    .press-graphics > .press-tile:last-child { grid-column: 1 / -1; }
    .press-tags li { grid-template-columns: minmax(0, 1fr) auto; }
    .press-tag-platform { grid-column: 1 / -1; }
  }

  /* ── O ZESPOLE ───────────────────────────────────────────────────── */
  .press-bios { max-width: 820px; display: grid; gap: clamp(18px, 1.8vw, 24px); padding-top: 18px; border-top: 1px solid var(--line-strong); }
  .press-bios-head { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 18px; }
  .press-bio-tools { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 18px; margin-left: auto; }
  /* The measured length. Mono because it is a number a reader checks against a brief. */
  .press-bio-count { font-family: var(--mono); font-size: 11px; letter-spacing: .08em; color: var(--ink-muted); font-variant-numeric: lining-nums; }
  .press-bio-text { gap: clamp(14px, 1.3vw, 20px); }
  /* Only the chosen measure's text, count and copy button are on the page. */
  .press-bios:not(:has(.press-measure-input[value="short"]:checked)) [data-measure="short"],
  .press-bios:not(:has(.press-measure-input[value="medium"]:checked)) [data-measure="medium"],
  .press-bios:not(:has(.press-measure-input[value="long"]:checked)) [data-measure="long"] { display: none; }

  /* The three measures as one segmented control: hairline segments in the action register, the
     chosen one filled with ink as a ticked box is. The radio itself is kept for the keyboard and
     the accessibility tree, and drawn by its label. */
  .press-measures { display: inline-flex; margin: 0; padding: 0; border: 1px solid var(--line-strong); min-inline-size: 0; }
  .press-measure { position: relative; display: inline-flex; align-items: center; padding: 8px 16px; font-family: var(--sans); font-size: 13px; line-height: 1.2; color: var(--ink-soft); cursor: pointer; transition: color .35s var(--ease), background-color .35s var(--ease); }
  .press-measure + .press-measure { border-left: 1px solid var(--line-strong); }
  .press-measure:hover { color: var(--ink); }
  .press-measure-input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; }
  .press-measure:has(.press-measure-input:checked) { background: var(--ink); color: var(--paper); }
  .press-measure:has(.press-measure-input:focus-visible) { outline: 1px solid var(--candle); outline-offset: 3px; z-index: 1; }
  @media (forced-colors: active) { .press-measure-input { opacity: 1; position: static; width: auto; height: auto; margin-right: 6px; } }

  .press-logo { margin-top: clamp(40px, 4.6vw, 62px); padding-top: 18px; border-top: 1px solid var(--line-strong); }
  .press-logo-usage { max-width: 64ch; margin-bottom: clamp(18px, 2vw, 26px); }
  /* One tile per ground and the gold mark; capped so a swatch stays a sample. */
  .press-logo-grid { grid-template-columns: repeat(3, minmax(0, 260px)); }
  @media (max-width: 620px) { .press-logo-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  /* The mark is tall (810 × 2000 in the PNGs, a bare viewBox in the SVG). Placed out of flow, it
     takes its box from the swatch and never lends its intrinsic size to the swatch or the track. */
  .press-logo-swatch { position: relative; display: block; aspect-ratio: 4 / 3; border: 1px solid var(--line); background: var(--paper); }
  .press-logo-swatch--dark,
  .press-logo-swatch--gold { background: var(--night); border-color: var(--night); }
  .press-logo-swatch img { position: absolute; inset: 0; margin: auto; width: 100%; height: 62%; object-fit: contain; }
  /* A tile's formats, one line each: the figure, then its download. */
  .press-logo-files { list-style: none; margin: 0; padding-left: 0; display: grid; gap: 8px; }
  .press-logo-files li { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 6px 12px; }

  /* On a desktop the biograms take seven twelfths and the logotype the rest, both opening on the
     same hairline. In the narrow column a logo tile lies on its side, the swatch beside its name
     and files, one tile a line: three swatches abreast would leave each file line two lines. */
  @media (min-width: 1000px) {
    .press-about { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: clamp(40px, 5vw, 80px); align-items: start; }
    .press-about .press-bios { max-width: none; }
    .press-about .press-logo { margin-top: 0; }
    .press-logo-grid { grid-template-columns: minmax(0, 1fr); row-gap: 16px; }
    .press-logo-grid > .press-tile { grid-row: auto; grid-template-rows: auto minmax(0, 1fr); grid-template-columns: 128px minmax(0, 1fr); column-gap: 18px; row-gap: 8px; }
    .press-logo-grid .press-logo-swatch { grid-row: 1 / span 2; align-self: start; }
    .press-logo-grid .press-tile-foot { padding-bottom: 0; }
  }

  /* ── FUNDACJA ────────────────────────────────────────────────────── */
  .press-legal-grid { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .press-legal-row { display: grid; gap: 8px; padding: clamp(16px, 1.8vw, 24px); background: var(--paper); }
  /* An odd last row takes the whole line: an empty eighth cell would show the grid's hairline
     ground as a grey slab. */
  .press-legal-row:last-child:nth-child(odd) { grid-column: 1 / -1; }
  .press-legal-row dd { margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; font-family: var(--serif); font-size: clamp(16px, 1.2vw, 19px); color: var(--ink); }
  /* A LEDGER, not a terminal: these are strings an organiser copies into a bank or a contract
     form and verifies character by character. That is the one job mono keeps on this site. Named
     on the value itself, so the copy button's label beside it keeps the button's size. */
  .press-legal-value.is-ledger { font-family: var(--mono); font-size: clamp(14px, 1vw, 16px); letter-spacing: .04em; font-variant-numeric: lining-nums; word-break: break-word; }
  .press-legal-row dd .press-button { margin-left: auto; }
  .press-invoice { margin: clamp(20px, 2.2vw, 28px) 0 0; display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; }
  .press-invoice .press-file-meta { padding-top: 0; }
  @media (max-width: 720px) { .press-legal-grid { grid-template-columns: minmax(0, 1fr); } }

  /* ── KONTAKT · dark closure ──────────────────────────────────────── */
  .press-contact { --press-pad: clamp(56px, 7vw, 98px); position: relative; padding: var(--press-pad) max(28px, 5vw); background: linear-gradient(180deg, var(--ink) 0%, var(--night) 100%); color: rgba(244, 241, 233, 0.84); overflow: hidden; scroll-margin-top: calc(var(--press-bars) + 20px - var(--press-pad)); }
  .press-contact .press-rubric { color: rgba(244, 241, 233, 0.58); }
  .press-contact .press-rule { background: rgba(244, 241, 233, 0.16); }
  .press-contact-lede { margin: 0; max-width: 52ch; font-family: var(--serif); font-weight: 300; font-size: clamp(18px, 1.5vw, 22px); line-height: 1.55; color: rgba(244, 241, 233, 0.78); }
  .press-contact-card { margin: clamp(20px, 2.4vw, 28px) 0 0; display: flex; align-items: baseline; gap: 18px; max-width: 760px; padding: clamp(22px, 2.6vw, 32px) clamp(24px, 3vw, 36px); border: 1px solid rgba(244, 241, 233, 0.16); background: rgba(16, 15, 13, 0.92); transition: background-color .4s var(--ease), border-color .4s var(--ease); }
  .press-contact-card:hover { background: rgba(8, 8, 7, 1); border-color: var(--candle); }
  .press-contact-mail { font-family: var(--serif); font-size: clamp(20px, 2.2vw, 30px); color: var(--candle); word-break: break-word; }
  .press-contact-arrow { margin-left: auto; font-family: var(--serif); font-size: clamp(22px, 2.2vw, 28px); color: var(--candle); }
  .press-broadcast { margin-top: clamp(32px, 3.5vw, 48px); padding-top: clamp(22px, 2.4vw, 30px); border-top: 1px solid rgba(244, 241, 233, 0.16); display: grid; gap: 10px; justify-items: start; max-width: 60ch; }
  .press-broadcast-title { margin: 0; font-family: var(--serif); font-weight: 400; font-size: clamp(22px, 2vw, 28px); line-height: 1.2; color: var(--paper); }
  .press-broadcast-body { margin: 0; font-size: clamp(15px, 1.1vw, 17px); line-height: 1.6; color: rgba(244, 241, 233, 0.74); }
  .press-broadcast-cta { margin-top: 6px; font-size: 15px; color: var(--candle); border-bottom: 1px solid rgba(198, 164, 91, .4); padding-bottom: 1px; transition: border-color .35s var(--ease); }
  .press-broadcast-cta:hover { border-color: var(--candle); }
  /* On a desktop the broadcast request stands beside the address, on the same seven and five
     twelfths as O zespole, its hairline turned to the left so both columns open at the lede. */
  @media (min-width: 1000px) {
    .press-contact-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: clamp(40px, 5vw, 80px); align-items: start; }
    .press-contact-grid .press-contact-card { max-width: none; }
    .press-contact-grid .press-broadcast { align-self: stretch; margin-top: 0; padding: 0 0 0 clamp(28px, 3vw, 44px); border-top: 0; border-left: 1px solid rgba(244, 241, 233, 0.16); }
  }

  /* ── THE COMPOSER ────────────────────────────────────────────────── */
  /* Hidden until scripts/press-basket.ts adds `has-basket` to <main>: a box with no script behind
     it would promise an archive that never comes. The rules name `main` because a bare runtime
     class could as well sit on <html>, where this file's scope attribute never is (audit R11). */
  .press-pick,
  .press-pick-all { display: none; }
  main.has-basket .press-pick { display: flex; justify-content: center; align-items: flex-start; cursor: pointer; }
  main.has-basket .press-pick-all { display: inline-flex; }

  /* Drawn, not native: a native box is the one grey system widget on a page of hairlines. The
     tick is a data URI, so its colour is the paper's value written out (#F4F1E9 = --paper). */
  .press-pick-box { appearance: none; flex: 0 0 auto; width: 18px; height: 18px; margin: 0; border: 1px solid var(--ink-muted); border-radius: 0; background: var(--paper) no-repeat center / 12px 12px; cursor: pointer; transition: background-color .25s var(--ease), border-color .25s var(--ease); }
