---
/**
 * @file NotFoundPage.astro
 * @description Locale-agnostic body of the not-found page. The three route files (/404, /en/404,
 *  /fr/404) are one-liners that differ only in `lang`; each is emitted as `<locale>/404.html`
 *  (build.format "file") and served by nginx's `error_page 404` for its own prefix — WITH a 404
 *  status. Before the page existed at all, the marketing fallback answered every unmatched path
 *  with the landing at 200, so a typo, a stale inbound link or a trailing slash all became soft
 *  404s that Google indexed as duplicates of "/".
 *
 *  `noindex` is the point of the head fragment: the body is a real page on a real URL, and the
 *  only thing worse than a soft 404 is a hard one that ranks. It stays `follow` so the way out is
 *  still crawlable. For the same reason this page is NOT in `TRANSLATED_ROUTES`: that ledger
 *  lights up links, a language switcher and an hreflang graph, and a noindex leaf that nothing
 *  links to wants none of the three. Three documents, no ledger entry — the canonical below is
 *  therefore composed from `lang` rather than looked up.
 *
 *  Register: a `vacat` — the bibliographic term for a leaf a book leaves blank. The page does not
 *  apologise or explain the error; it names the blank and points back into the volume.
 *
 *  WHERE EVERY WORD COMES FROM. The two sentences and the two metadata lines are Polish prose in
 *  `src/content/pages/404.yaml`, read through `lib/pageCopy` with the desk's translations
 *  substituted per field. Everything else is owned elsewhere and is READ here: the five Latin
 *  rubrics are locale-neutral markup, `404` is a number, and each way's vernacular name is the
 *  name the chrome already prints for that destination (see `i18n/content/notFound.ts`).
 * @architecture Astro islands 2026
 * @module components/pages/NotFoundPage
 */
import { getImage } from "astro:assets";

import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteChrome from "../SiteChrome.astro";
import SiteFooter from "../SiteFooter.astro";
import { DEFAULT_LOCALE, localizePath, type Locale } from "../../i18n/config";
import { CONCERT } from "../../i18n/content/koncert";
import { NOT_FOUND_CHROME, NOT_FOUND_PAGE } from "../../i18n/content/notFound";
import { UI } from "../../i18n/ui";
import { pageCopy } from "../../lib/pageCopy";
import { bleedPair } from "../../lib/photos";

interface Props {
  lang?: Locale;
}
const { lang = DEFAULT_LOCALE } = Astro.props;

const copy = pageCopy(NOT_FOUND_PAGE, lang);
const t = NOT_FOUND_CHROME[lang];
const ui = UI[lang];

/* This document's own URL. Composed rather than looked up — see the header: `/404` is
   deliberately outside `TRANSLATED_ROUTES`, because that set exists to light LINKS and nothing
   links here. */
const path = lang === DEFAULT_LOCALE ? "/404" : `/${lang}/404`;

/* The four ways out. Each row is a Latin rubric over a name the chrome ALREADY prints for that
   destination — never a fifth wording invented here, which is what a reader comparing this list
   with the footer under it would otherwise find. The hrefs go through `localizePath`, so a way
   out of the English blank leaf lands on the English page wherever one exists. */
const ways = [
  { href: localizePath("/", lang), lat: "Limen", name: ui.footer.home },
  { href: localizePath("/koncerty", lang), lat: "Concentus", name: CONCERT[lang].meta.breadcrumb },
  { href: localizePath("/o-nas", lang), lat: "Vocatio", name: ui.nav.about },
  { href: localizePath("/kontakt", lang), lat: "Epistula", name: ui.nav.contact },
];

const ogImage = (
  await getImage({ src: bleedPair("hero-landing").desktop, width: 1200, format: "webp" })
).src;
---

<BaseLayout
  title={copy.meta.title}
  description={copy.meta.description}
  path={path}
  image={ogImage}
  bodyClass="page-404"
  lang={lang}
>
  <Fragment slot="head">
    <meta name="robots" content="noindex,follow" />
  </Fragment>

  <a class="skip-link" href="#tresc">{ui.skipToContent}</a>
  <SiteChrome current="/404" tone="dark" lang={lang} />

  <main id="tresc">
    <section class="nf-hero" aria-labelledby="nf-title">
      <div class="nf-inner">
        <p class="nf-eyebrow micro reveal">
          <span class="lat" lang="la">Vacat</span>
          <span class="nf-dot" aria-hidden="true">·</span>
          <span>404</span>
        </p>
        <h1 id="nf-title" class="nf-title reveal ink-press" data-d="1">{copy.head.title}</h1>
        <p class="nf-lede reveal" data-d="2">{copy.head.lede}</p>

        <nav class="nf-ways reveal" data-d="3" aria-label={t.waysAria}>
          <ul>
            {
              ways.map((w) => (
                <li>
                  <a href={w.href}>
                    <span class="lat" lang="la">{w.lat}</span>
                    <span class="nf-way-name">{w.name}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </section>
  </main>

  <SiteFooter lang={lang} />
</BaseLayout>

<style>
  /* One dark band that fills the viewport minus the chrome — the page has no second section,
     so a short body must not leave the footer floating halfway up the screen. */
  .nf-hero {
    background: var(--dark);
    color: var(--paper);
    min-height: 78svh;
    display: flex;
    align-items: center;
    padding: clamp(140px, 18vw, 220px) var(--gutter) clamp(80px, 11vw, 140px);
  }
  .nf-inner { max-width: 760px; margin: 0 auto; width: 100%; }

  .nf-dot { opacity: 0.45; margin: 0 0.5em; }

  .nf-title {
    font-family: var(--serif);
    font-weight: 300;
    line-height: 0.95;
    font-size: clamp(46px, 7vw, 104px);
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--paper);
  }
  .nf-lede {
    margin: clamp(28px, 4vw, 44px) 0 0;
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(18px, 1.8vw, 24px);
    line-height: 1.5;
    color: rgba(244, 241, 233, 0.82);
    max-width: 46ch;
  }

  .nf-ways { margin-top: clamp(44px, 6vw, 72px); }
  .nf-ways ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(244, 241, 233, 0.14);
  }
  .nf-ways li { border-bottom: 1px solid rgba(244, 241, 233, 0.14); }
  .nf-ways a {
    display: flex;
    align-items: baseline;
    gap: clamp(16px, 3vw, 32px);
    padding: clamp(14px, 2vw, 20px) 0;
    text-decoration: none;
    color: inherit;
    /* Colour only — the rows are a list, and a row that also slides turns four quiet ways
       out into four competing animations. */
    transition: color var(--ink-in, 0.9s) ease;
  }
  .nf-ways a:hover,
  .nf-ways a:focus-visible { color: var(--candle); }
  /* The Latin rubric's family/caps come from base.css's two-voice `.lat` rule — setting them
     here would tie specificity and win on bundle order. Only the measure is ours, so the
     vernacular names line up in a column. It is `em`, so a longer name in another language
     widens the gutter with the type rather than colliding with it. */
  .nf-ways .lat { flex: 0 0 auto; min-width: 8.5em; }
  .nf-way-name { font-family: var(--serif); font-size: clamp(19px, 2vw, 26px); font-weight: 300; }

  @media (max-width: 560px) {
    .nf-ways a { flex-direction: column; gap: 4px; }
    .nf-ways .lat { min-width: 0; }
  }
</style>
