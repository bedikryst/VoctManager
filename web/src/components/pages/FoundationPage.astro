---
/**
 * @file FoundationPage.astro
 * @description Locale-agnostic body of /fundacja — the foundation's home on the ensemble's site.
 *  It explains what allows VoctEnsemble's music to continue and gives a person or an organisation
 *  a practical way to help. The three route files (/fundacja, /en/fundacja, /fr/fundacja) differ
 *  only in `lang`. Brief: docs/specs/web-foundation-brief-2026-09.md.
 *
 *  THE SAME PAPER, CLOSER TO THE WORK. The opening is the foundation's own voice, not the
 *  ensemble's: a poster-scale sans-serif headline across the whole measure with one cobalt
 *  accent, then a row that parts the lead and its two acts from a rehearsal photograph, then a
 *  numbered index of the page — static, with no reveal or ink press, so it reads the same with
 *  motion off (spec: docs/specs/web-foundation-hero-2026-09.md). Below it the composition is the practical pages of
 *  a concert programme: a paper-soft band where the current undertaking stands beside its
 *  material needs, the record, the two plain ways to give with the transfer block both share,
 *  the companies' route, and a second quiet administrative band that ends on the patronage
 *  address. No coda: the page closes on who answers, not on a manifesto.
 *
 *  WHAT IS A FACT AND WHERE IT COMES FROM. The recipient, accounts and registry numbers are
 *  `data/foundation.ts`; the transfer title is the vault's; the featured concert and the two
 *  record programmes are read from the corpus by the ids `data/foundationSupport.ts` chooses;
 *  the board's role lines are /o-nas's copy and the mission sentence is /kontakt's, so neither
 *  has a second home here. This page's own words come from `content/pages/fundacja.yaml` through
 *  `lib/pageCopy`; its chrome from `i18n/content/fundacja.ts`.
 *
 *  NO NUMBERS THAT ARE NOT APPROVED. The costs band names what a concert is made of and what each
 *  line enables — no totals, no goal, no progress. That is the complete launch state the brief
 *  defines, not a placeholder for one.
 *
 *  ONE-OFF GIVING IS THE VAULT'S. "Wpłać online" opens the existing donation vault in place
 *  (`data-vault-open`, with `/?donate` as the no-JS fallback); this page builds no checkout.
 * @architecture Astro islands 2026
 * @module components/pages/FoundationPage
 */
import { getCollection } from "astro:content";
import { getImage, Picture } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteChrome from "../SiteChrome.astro";
import SiteFooter from "../SiteFooter.astro";
import VaultMount from "../VaultMount.astro";
import { PatronInterestForm } from "../../islands/landing/PatronInterestForm";
import { bleedPair, photo, photoOptional } from "../../lib/photos";
import { frameCredit } from "../../lib/photoCredit";
import { pageCopy } from "../../lib/pageCopy";
import { concertKey, overlayValue } from "../../lib/copyOverlay";
import { chromeHtmlForIsland } from "../../lib/islandCopy";
import { longDate, viaMoment } from "../../lib/dates";
import { upcomingStation } from "../../lib/cycle";
import { FOUNDATION } from "../../data/foundation";
import { FOUNDATION_PAGE_LINKED, FOUNDATION_SUPPORT } from "../../data/foundationSupport";
import { VAULT_CONFIG } from "../../islands/landing/constants/vaultConfig";
import { FOUNDATION_CHROME, FUNDACJA_PAGE } from "../../i18n/content/fundacja";
import { ABOUT_PAGE } from "../../i18n/content/o-nas";
import { KONTAKT_PAGE } from "../../i18n/content/kontakt";
import { UI } from "../../i18n/ui";
import { localizePath, pageI18n, pickLocale, SITE, type Locale } from "../../i18n/config";
import "../../styles/vault.css";

interface Props {
  /** Which language this render is. Drives the copy, the chrome, the URL and the hreflang graph. */
  lang: Locale;
}
const { lang } = Astro.props;

const copy = pageCopy(FUNDACJA_PAGE, lang);
const t = FOUNDATION_CHROME[lang];
const { path, alternates, available } = pageI18n("/fundacja", lang);
const hrefConcerts = localizePath("/koncerty", lang);
// The vault opens in place; the href is the no-JS road to the landing that auto-opens it, and
// has to be THIS locale’s landing or a reader with scripts off lands in Polish.
const hrefDonate = `${localizePath("/", lang)}?donate`;
const hrefPrivacy = localizePath("/polityka-prywatnosci", lang);

// Two sentences this page prints but does not own: the mission as /kontakt states it, and the
// board's remits as /o-nas states them. Read from their pages rather than copied.
const mission = pageCopy(KONTAKT_PAGE, lang).locus.mission;
const aboutRoles = pageCopy(ABOUT_PAGE, lang).governance.roles;
const boardMembers = [
  { id: "florent", name: "Florent de Bazelaire" },
  { id: "ania", name: "Anna Marcisz" },
  { id: "krystian", name: "Krystian Bugalski" },
] as const;
const board = boardMembers.map((member) => {
  const role = aboutRoles.find((r) => r.id === member.id);
  if (!role) throw new Error(`[fundacja] no governance role on /o-nas for board member "${member.id}".`);
  return { ...member, role: role.role };
});

// ── Concerts, by the ids the support record chooses ──────────────────────────────────────────
const concerts = await getCollection("concerts");
const concertById = (id: string) => {
  const entry = concerts.find((c) => c.id === id);
  if (!entry) throw new Error(`[fundacja] data/foundationSupport.ts names concert "${id}", which is not in the corpus.`);
  return entry;
};
const concertView = (id: string) => {
  const entry = concertById(id);
  const translated = (field: string) => overlayValue(concertKey(entry.id, field), lang);
  const a = entry.data.about;
  return {
    id: entry.id,
    title: translated("title") ?? entry.data.title,
    essence: translated("essence") ?? entry.data.essence,
    place: translated("about.place") ?? a?.place ?? entry.data.venue ?? pickLocale(entry.data.metaPlace, lang),
    moment: viaMoment(entry.data, lang),
    date: entry.data.date,
    time: entry.data.time,
    admission: entry.data.admission,
    img: a?.img ? photoOptional(a.img) : undefined,
    // Every concert with a page is in TRANSLATED_ROUTES (i18n/config), so the localised
    // /koncerty prefix plus the id is that concert's page in this locale.
    href: entry.data.hasPage ? `${hrefConcerts}/${entry.id}` : undefined,
  };
};

// The current work: a chosen concert, in the present tense only while it is still ahead — read at
// build, the same standing obligation lib/cycle documents. After the evening the page keeps the
// same concert in the past tense; it never slides to the next one on its own.
const featured = concertView(FOUNDATION_SUPPORT.featuredConcertId);
const featuredAhead = upcomingStation(concerts)?.id === featured.id;
const featuredDate = featured.date ? longDate(featured.date, lang) : featured.moment;
const record = FOUNDATION_SUPPORT.recordConcertIds.map(concertView);

// ── Giving ────────────────────────────────────────────────────────────────────────────────────
const amounts = new Intl.ListFormat(lang, { type: "disjunction" }).format(
  FOUNDATION_SUPPORT.monthlyExamples.map((n) => String(n)),
);
const monthlyAmounts = copy.support.monthly.amounts.replace("{amounts}", amounts);
const transferTitle = VAULT_CONFIG.recipient.title;
const patronMail = FOUNDATION.mail.patronage;
const partnershipHref = `mailto:${patronMail}?subject=${encodeURIComponent(copy.partnership.mailSubject)}`;
const bookingHref = `mailto:${FOUNDATION.mail.booking}?subject=${encodeURIComponent(copy.partnership.bookingSubject)}`;

const formProps = {
  chrome: t.form,
  copy: {
    consentHtml: chromeHtmlForIsland(copy.join.consentHtml, lang),
    successTitle: copy.join.successTitle,
    successBody: copy.join.successBody,
  },
  contactEmail: patronMail,
} as const;

// ── Images ────────────────────────────────────────────────────────────────────────────────────
// The opening's photograph is a rehearsal, not a concert: the foundation makes the preparation
// visible, the ensemble's pages show the result. The frame is one of the `wcielenie` gallery's,
// found by image identity so its translated alt (keyed by the image's name, never by position)
// and its credit come with it. The rehearsal's date and place are not on record, so the caption
// says only what the frame shows — it inherits nothing from the concert's own dateline.
const rehearsalConcertId = "wcielenie";
const rehearsalImgName = "kd-wcielenie-1";
const rehearsalFrame = concertById(rehearsalConcertId).data.gallery.find((g) => g.img === rehearsalImgName);
if (!rehearsalFrame) {
  throw new Error(`[fundacja] concert "${rehearsalConcertId}" has no gallery frame "${rehearsalImgName}".`);
}
const rehearsalPhoto = photo(rehearsalImgName);
const rehearsalCaption =
  overlayValue(concertKey(rehearsalConcertId, `gallery.${rehearsalImgName}.alt`), lang) ?? rehearsalFrame.alt ?? "";
const rehearsalCredit = frameCredit(rehearsalFrame, lang);

// The social card keeps the nave plate the landing's ensemble section shows: a 1200-wide
// landscape of the ensemble singing reads as "the music" on a feed, which is what a shared link
// to the foundation is for. The page's own photograph is the hero's.
const ogImage = (await getImage({ src: bleedPair("chor-nawa").desktop, width: 1200, format: "webp" })).src;

// The foundation as the subject, the ensemble as its music group — two objects, never one as the
// other's alternate name.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: copy.meta.title,
  url: `${SITE}${path}`,
  inLanguage: lang,
  about: {
    "@type": "Organization",
    name: FOUNDATION.name,
    url: SITE,
    email: patronMail,
    identifier: [
      { "@type": "PropertyValue", propertyID: "KRS", value: FOUNDATION.registry.krs },
      { "@type": "PropertyValue", propertyID: "NIP", value: FOUNDATION.registry.nip },
      { "@type": "PropertyValue", propertyID: "REGON", value: FOUNDATION.registry.regon },
    ],
    address: {
      "@type": "PostalAddress",
      streetAddress: FOUNDATION.seat.street,
      postalCode: FOUNDATION.seat.postalCode,
      addressLocality: FOUNDATION.seat.city,
      addressCountry: FOUNDATION.seat.countryCode,
    },
    subOrganization: { "@type": "MusicGroup", name: FOUNDATION.ensemble, url: SITE },
  },
};
---

<BaseLayout
  title={copy.meta.title}
  description={copy.meta.description}
  path={path}
  image={ogImage}
  bodyClass="page-fundacja"
  lang={lang}
  alternates={alternates}
  breadcrumb={[{ name: UI[lang].nav.foundation, path }]}
>
  <Fragment slot="head">
    {/* Deployed but not yet announced: until FOUNDATION_PAGE_LINKED the page is reachable through
        the footers and the vault, and kept out of the index (and, by hand, out of the sitemap —
        astro.config.mjs) so a search result never becomes its first door. */}
    {!FOUNDATION_PAGE_LINKED && <meta name="robots" content="noindex,follow" />}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <a class="skip-link" href="#tresc">{UI[lang].skipToContent}</a>
  <SiteChrome current="/fundacja" lang={lang} availableLocales={available} />

  <main id="tresc">
    {/* ── Opening — the institution, the work it makes possible, the ways to act ──
          A poster: the headline runs the full measure, and under it one row parts the lead
          with its two acts (left, the narrow column) from the rehearsal frame (right, the
          wide one); the numbered index closes the opening across the whole measure. Below
          960px the row stacks in DOM order, actions before the photograph, so helping never
          means scrolling past a large image. Nothing here waits for motion: no `reveal`, no
          `ink-press` (its axis would override the headline's weight), no gate — a reader with
          JavaScript or motion off sees the same opening. */}
    <section class="foundation-hero" aria-label={t.heroAria}>
      <p class="foundation-hero-identity">{copy.hero.eyebrow}</p>
      <h1 class="foundation-hero-title">
        <span class="foundation-hero-line">{copy.hero.title1}</span>
        <span class="foundation-hero-line" set:html={copy.hero.title2Html} />
      </h1>
      <div class="foundation-hero-row">
        <div class="foundation-hero-text">
          <p class="foundation-hero-lead">{copy.hero.lede}</p>
          {/* The arrows are decoration on a link that already reads as one — hidden from
              assistive technology, drawn in the text's own colour. */}
          <div class="foundation-hero-actions">
            <a class="foundation-hero-primary plausible-event-name=fundacja+wsparcie" href="#wsparcie">
              {copy.hero.primary}
              <svg class="foundation-hero-arrow" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false"><path d="M2 8h11M9 3.5 13.5 8 9 12.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </a>
            <a class="foundation-hero-secondary" href="#partnerstwo">
              {copy.hero.secondary}
              <svg class="foundation-hero-arrow" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false"><path d="M2 8h11M9 3.5 13.5 8 9 12.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </a>
          </div>
        </div>
        {/* The complete landscape frame, straight-edged, no card and nothing over it. The
            visible caption is the frame's own alt, so the image's alt is empty rather than
            saying the same sentence twice; the figure stays in the accessibility tree.
            `width` = top of the ladder, which keeps the fallback the same file as the widest
            candidate (lib/photos.ts). `sizes` follows the row: 7/12 of the measure from 960px,
            the full measure below. */}
        <figure class="foundation-hero-figure">
          <Picture
            src={rehearsalPhoto}
            formats={["avif", "webp"]}
            widths={[480, 768, 1024, 1536, 1920]}
            width={1920}
            sizes="(min-width: 960px) min(52vw, 690px), calc(100vw - 2 * max(28px, 5vw))"
            alt=""
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <figcaption class="foundation-hero-caption">
            {rehearsalCaption}<span class="foundation-hero-credit"> · {rehearsalCredit}</span>
          </figcaption>
        </figure>
      </div>
      {/* The page's table of contents, numbered by CSS (the counter idiom of PrivacyPage's
          `.toc-list`); each cell is the link, so the whole row under the hand is the target. */}
      <nav class="foundation-hero-index" aria-label={t.indexAria}>
        <span class="foundation-hero-index-label">{copy.hero.indexLabel}</span>
        <ol class="foundation-hero-index-list">
          {copy.hero.index.map((entry) => (
            <li><a href={`#${entry.anchor}`}>{entry.label}</a></li>
          ))}
        </ol>
      </nav>
    </section>

    {/* ── What a concert is made of ─────────────────────────────────────────────────
          Desktop: the current undertaking on the left, its material needs on the right,
          parted by the site's rule. Categories and what each enables — no amounts. */}
    <section class="costs" id="na-co-ida-srodki" aria-label={t.costsAria}>
      <div class="wrap">
        <div class="col-head reveal">
          <span class="eyebrow"><span class="lat">Impensae</span>  ·  {copy.costs.eyebrow}</span>
          <h2 class="ink-press">{copy.costs.h2}</h2>
        </div>
        <p class="intro reveal" data-d="1">{copy.costs.intro}</p>
        <p class="body reveal" data-d="2">{copy.costs.body}</p>

        <div class="costs-grid">
          <article class="current reveal" data-d="1">
            <h3 class="rubric">{featuredAhead ? copy.costs.current.labelAhead : copy.costs.current.labelPast}</h3>
            <p class="current-title">{featured.title}</p>
            <p class="current-facts">
              {featured.date ? <time datetime={featured.date}>{featuredDate}</time> : featuredDate}
              {featured.time && featuredAhead && <>{" · "}{featured.time}</>}
              {" · "}{featured.place}
              {featured.admission && <>{" · "}{featured.admission === "free" ? t.admissionFree : t.admissionPaid}</>}
            </p>
            <p class="current-essence">{featured.essence}</p>
            {featured.href && (
              <p class="more"><a class="quiet-link" href={featured.href}>{copy.costs.current.programLink}</a></p>
            )}
            <p class="current-note">{copy.costs.current.note}</p>
          </article>

          <div class="cost-lines reveal" data-d="2">
            <h3 class="rubric">{copy.costs.itemsLabel}</h3>
            <dl class="rows">
              {copy.costs.items.map((item) => (
                <div class="row">
                  <dt>{item.term}</dt>
                  <dd>{item.what}</dd>
                </div>
              ))}
            </dl>
          </div>
        </div>
      </div>
    </section>

    {/* ── The record — the ensemble's, not the donors' ───────────────────────────── */}
    <section class="record" id="dorobek" aria-label={t.recordAria}>
      <div class="wrap">
        <div class="col-head reveal">
          <span class="eyebrow"><span class="lat">Opera</span>  ·  {copy.record.eyebrow}</span>
          <h2 class="ink-press">{copy.record.h2}</h2>
        </div>
        <p class="intro reveal" data-d="1">{copy.record.intro}</p>
        <ol class="record-list">
          {record.map((c, i) => (
            <li class="record-item reveal" data-d={String((i % 3) + 1)}>
              {c.img && (
                <div class="record-figure">
                  {/* `width` caps the fallback rendition — see lib/photos.ts. */}
                  <Picture
                    src={c.img}
                    formats={["avif", "webp"]}
                    widths={[320, 480, 640, 840]}
                    width={840}
                    sizes="(max-width: 700px) min(92vw, 420px), clamp(200px, 22vw, 300px)"
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              )}
              <div class="record-body">
                <p class="record-meta"><span>{c.moment}</span><span class="dot" aria-hidden="true"> · </span><span>{c.place}</span></p>
                <h3 class="record-title">{c.href ? <a href={c.href}>{c.title}</a> : c.title}</h3>
                <p class="record-essence">{c.essence}</p>
              </div>
            </li>
          ))}
        </ol>
        <p class="more reveal"><a class="quiet-link" href={hrefConcerts}>{copy.record.allLink}</a></p>
      </div>
    </section>

    {/* ── Individual support — regular first, because it answers the continuity argument.
          One transfer block serves both, statically: selectable numbers on the same phone
          the reader banks on, copy as a convenience. Then the optional "let us know". ── */}
    <section class="support" id="wsparcie" aria-label={t.supportAria}>
      <div class="wrap">
        <div class="col-head reveal">
          <span class="eyebrow"><span class="lat">Auxilium</span>  ·  {copy.support.eyebrow}</span>
          <h2 class="ink-press">{copy.support.h2}</h2>
        </div>
        <p class="intro reveal" data-d="1">{copy.support.intro}</p>

        <div class="ways">
          <article class="way reveal" id="mecenat" data-d="1">
            <h3 class="way-label">{copy.support.monthly.label}</h3>
            <p class="way-body">{copy.support.monthly.body}</p>
            <p class="way-amounts">{monthlyAmounts}</p>
            <p class="way-act"><a class="capsule" href="#przelew">{copy.support.monthly.transferLink}</a></p>
          </article>
          <article class="way reveal" data-d="2">
            <h3 class="way-label">{copy.support.once.label}</h3>
            <p class="way-body">{copy.support.once.body}</p>
            <p class="way-act">
              <a class="capsule plausible-event-name=fundacja+wplata" href={hrefDonate} data-vault-open="100">{copy.support.once.vaultAction}</a>
              <a class="quiet-link" href="#przelew">{copy.support.once.transferLink}</a>
            </p>
          </article>
        </div>

        <div class="transfer reveal reveal-rule" id="przelew" aria-label={t.transferAria}>
          <h3 class="rubric">{copy.transfer.h3}</h3>
          <dl class="transfer-rows">
            <div class="transfer-row">
              <dt>{copy.transfer.recipientLabel}</dt>
              <dd>
                <span class="transfer-value">{FOUNDATION.name}</span>
                <button type="button" class="copy-btn plausible-event-name=fundacja+copy+odbiorca" data-copy={FOUNDATION.name} data-copied={t.copied} aria-label={t.copyAria.replace("{what}", copy.transfer.recipientLabel)}>
                  <span class="copy-label">{t.copy}</span>
                </button>
              </dd>
            </div>
            <div class="transfer-row">
              <dt>{copy.transfer.accountLabel} <span class="currency">PLN</span></dt>
              <dd>
                <span class="transfer-value transfer-iban">{FOUNDATION.accounts.pln.display}</span>
                <button type="button" class="copy-btn plausible-event-name=fundacja+copy+PLN" data-copy={FOUNDATION.accounts.pln.iban} data-copied={t.copied} aria-label={t.copyAria.replace("{what}", `${copy.transfer.accountLabel} PLN`)}>
                  <span class="copy-label">{t.copy}</span>
                </button>
              </dd>
            </div>
            <div class="transfer-row">
              <dt>{copy.transfer.eurLabel} <span class="currency">EUR</span></dt>
              <dd>
                <span class="transfer-value transfer-iban">{FOUNDATION.accounts.eur.display}</span>
                <button type="button" class="copy-btn plausible-event-name=fundacja+copy+EUR" data-copy={FOUNDATION.accounts.eur.iban} data-copied={t.copied} aria-label={t.copyAria.replace("{what}", `${copy.transfer.eurLabel} EUR`)}>
                  <span class="copy-label">{t.copy}</span>
                </button>
                <span class="transfer-note">{copy.transfer.eurNote}</span>
              </dd>
            </div>
            <div class="transfer-row">
              <dt>{copy.transfer.titleLabel}</dt>
              <dd>
                <span class="transfer-value" lang="pl">{transferTitle}</span>
                <button type="button" class="copy-btn plausible-event-name=fundacja+copy+tytul" data-copy={transferTitle} data-copied={t.copied} aria-label={t.copyAria.replace("{what}", copy.transfer.titleLabel)}>
                  <span class="copy-label">{t.copy}</span>
                </button>
              </dd>
            </div>
          </dl>
          <p class="transfer-hint">{copy.transfer.standingOrderHint}</p>
          <p class="transfer-scope">{copy.transfer.scope}</p>
        </div>

        <div class="join reveal reveal-rule" id="zglos">
          <h3 class="rubric">{copy.join.h3}</h3>
          <p class="join-body">{copy.join.body}</p>
          <PatronInterestForm client:visible {...formProps} />
          <noscript>
            <p class="join-noscript">{t.form.noscript}</p>
          </noscript>
          <p class="join-contact">
            {copy.join.contactLead}{" "}
            <a href={`mailto:${patronMail}`}>{patronMail}</a>
          </p>
        </div>
      </div>
    </section>

    {/* ── Companies and institutions — three things to discuss, one address, no packages ── */}
    <section class="partnership" id="partnerstwo" aria-label={t.partnershipAria}>
      <div class="wrap">
        <div class="col-head reveal">
          <span class="eyebrow"><span class="lat">Societas</span>  ·  {copy.partnership.eyebrow}</span>
          <h2 class="ink-press">{copy.partnership.h2}</h2>
        </div>
        <p class="intro reveal" data-d="1">{copy.partnership.intro}</p>
        <dl class="rows partner-rows">
          {copy.partnership.rows.map((row, i) => (
            <div class="row reveal" data-d={String((i % 3) + 1)}>
              <dt>{row.term}</dt>
              <dd>{row.what}</dd>
            </div>
          ))}
        </dl>
        <div class="partner-next reveal">
          <p class="body">{copy.partnership.next}</p>
          <p class="partner-thanks">{copy.partnership.thanks}</p>
          <p class="mail-line">
            <span class="rubric">{copy.partnership.mailLabel}</span>
            <a class="mail plausible-event-name=fundacja+partnerstwo+mail" href={partnershipHref}>{patronMail}</a>
            <button type="button" class="copy-btn" data-copy={patronMail} data-copied={t.copied} aria-label={t.copyAria.replace("{what}", patronMail)}>
              <span class="copy-label">{t.copy}</span>
            </button>
          </p>
          <p class="partner-booking">
            {copy.partnership.bookingLead}{" "}
            <a class="quiet-link" href={bookingHref}>{copy.partnership.bookingLink}</a>
          </p>
        </div>
      </div>
    </section>

    {/* ── Who answers — the second quiet band. Ends on the patronage address. ─────── */}
    <section class="who" id="fundacja-i-dokumenty" aria-label={t.whoAria}>
      <div class="wrap">
        <div class="col-head reveal">
          <span class="eyebrow"><span class="lat">Fundatio</span>  ·  {copy.who.eyebrow}</span>
          <h2 class="ink-press">{copy.who.h2}</h2>
        </div>
        <p class="intro reveal" data-d="1">{copy.who.relation}</p>
        <p class="body reveal" data-d="2">{mission}</p>

        <div class="who-grid">
          <div class="who-block reveal" data-d="1">
            <h3 class="rubric">{copy.who.boardLabel}</h3>
            <ul class="board">
              {board.map((b) => (
                <li>
                  <span class="board-name">{b.name}</span>
                  <span class="board-role">{b.role}</span>
                </li>
              ))}
            </ul>
            <p class="who-note">{copy.who.boardNote}</p>
          </div>
          <div class="who-block reveal" data-d="2">
            <h3 class="rubric">{copy.who.identityLabel}</h3>
            <p class="identity">
              {FOUNDATION.name}<br />
              {FOUNDATION.addressLine}<br />
              KRS {FOUNDATION.registry.krs}<br />
              NIP {FOUNDATION.registry.nip}<br />
              REGON {FOUNDATION.registry.regon}
            </p>
          </div>
          <div class="who-block reveal" data-d="3">
            <h3 class="rubric">{copy.who.documentsLabel}</h3>
            <ul class="documents">
              <li><a href={FOUNDATION_SUPPORT.statutePath}>{copy.who.statuteLink}</a></li>
              <li><a href={hrefPrivacy}>{copy.who.privacyLink}</a></li>
              <li><a href={hrefDonate} data-vault-open="100">{copy.who.termsLink}</a></li>
            </ul>
          </div>
        </div>

        <div class="help reveal reveal-rule">
          <h3 class="rubric">{copy.who.help.label}</h3>
          <dl class="help-list">
            {copy.who.help.items.map((item) => (
              <div class="help-item">
                <dt>{item.q}</dt>
                <dd>{item.a}</dd>
              </div>
            ))}
          </dl>
        </div>

        <p class="who-contact reveal">
          <span class="rubric">{copy.who.contactLabel}</span>
          <a class="mail" href={`mailto:${patronMail}`}>{patronMail}</a>
        </p>
      </div>
    </section>
  </main>

  <SiteFooter lang={lang} />

  <VaultMount lang={lang} />
  <script>
