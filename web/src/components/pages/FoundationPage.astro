</BaseLayout>

<style>
  /* ── Shared measure and heads ─────────────────────────────────────────────────────────────
     The reading measure of /kontakt (920px), the same section head, and the rubric tier at
     `--ink-soft` for the reason ContactPage records: muted is nearly invisible at 10px here. */
  .wrap { max-width: 920px; margin: 0 auto; }
  .col-head { margin: 0; }
  .col-head .eyebrow { display: block; margin-bottom: 16px; color: var(--ink-soft); }
  .col-head h2 { font-family: var(--serif); font-weight: 300; font-size: clamp(30px, 3.6vw, 48px); line-height: 1.05; color: var(--ink); margin: 0; letter-spacing: -.01em; }
  .intro { font-family: var(--serif); font-style: italic; font-weight: 300; font-size: clamp(19px, 2vw, 25px); line-height: 1.5; color: var(--ink-soft); max-width: 40ch; margin: 18px 0 0; }
  .body { margin: 18px 0 0; max-width: 62ch; font-size: clamp(15px, 1.15vw, 16.5px); line-height: 1.72; color: var(--ink-soft); }
  .rubric { font-family: var(--capitalis); font-size: 10px; letter-spacing: .24em; text-transform: uppercase; color: var(--ink-soft); margin: 0 0 14px; font-weight: 400; }
  .more { margin: 18px 0 0; }
  .quiet-link { font-family: var(--mono); font-size: 10.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-muted); border-bottom: 1px solid var(--line-strong); padding-bottom: 3px; transition: color .3s var(--ease), border-color .3s var(--ease); }
  .quiet-link:hover { color: var(--candle-blue); border-color: var(--candle-blue); }
  /* Rows of term + explanation, the ledger's shape: a hairline over each, the term as a rubric. */
  .rows { margin: 0; }
  .row { display: grid; gap: 8px; padding: clamp(18px, 2.4vw, 26px) 0; border-top: 1px solid var(--line); }
  .row:last-of-type { border-bottom: 1px solid var(--line); }
  .row dt { font-family: var(--capitalis); font-size: 10.5px; letter-spacing: .18em; text-transform: uppercase; color: var(--candle-ink); margin: 0; }
  .row dd { margin: 0; max-width: 56ch; font-size: clamp(14.5px, 1.1vw, 16px); line-height: 1.7; color: var(--ink-soft); }
  /* The real border stays for no-JS and reduced motion; under the motion gate the drawn rule
     takes over (`--rule-ink` defaults to `var(--line)`). Same call as ContactPage's `.voices`. */
  :global(html.voct-motion) .reveal-rule { border-top-color: transparent; }
  /* Copy capsule — ContactPage's `.channel-copy`, the site's one shape for "copy this". */
  .copy-btn { display: inline-flex; align-items: center; gap: 6px; vertical-align: middle; font-family: var(--capitalis); font-size: 9.5px; letter-spacing: .16em; text-transform: uppercase; color: var(--ink-muted); background: transparent; border: 1px solid var(--line); border-radius: 999px; padding: 5px 12px; cursor: pointer; transition: color .3s var(--ease), border-color .3s var(--ease); }
  .copy-btn:hover { color: var(--ink); border-color: var(--line-strong); }
  .copy-btn.is-copied { color: var(--sage); border-color: var(--sage); }
  .mail { font-family: var(--serif); font-size: clamp(20px, 2.6vw, 30px); color: var(--ink); border-bottom: 1px solid transparent; transition: border-color .3s var(--ease); overflow-wrap: anywhere; }
  .mail:hover { border-bottom-color: var(--candle); }

  /* The capsule: outlined at rest, filled under the hand — the shape the contact door's act
     uses, for the giving band's two acts further down the page. */
  .capsule { display: inline-flex; align-items: center; padding: 12px 22px; border: 1px solid color-mix(in srgb, var(--candle-ink) 62%, transparent); border-radius: 999px; color: var(--candle-ink); font-family: var(--capitalis); font-size: 10.5px; font-weight: 600; letter-spacing: .16em; line-height: 1.2; text-transform: uppercase; white-space: nowrap; transition: color .3s var(--ease), border-color .3s var(--ease), background-color .3s var(--ease); }
  .capsule:hover, .capsule:focus-visible { background: var(--candle-ink); border-color: var(--candle-ink); color: var(--paper); }
  .capsule:focus-visible { outline: 2px solid var(--candle-ink); outline-offset: 4px; }

  /* ── Opening — the foundation's own voice ───────────────────────────────────────────────────
     A poster, not a two-column landing: the headline takes the whole 1240px measure at a
     display size, and only under it does the measure part 5:7 into the lead with its acts and
     the rehearsal frame. The frame is the wide column so the gesture in it (the conductor's
     hand, the singers at the table) reads at the size the headline sets. Nothing is centred
     vertically: both columns hang from the same top edge, the way a programme page does. The
     opening is still static — the developer weighed an entrance against the site's own doctrine
     (registers.css: no offset, no blur, nothing from zero) and kept it to hover.

     One cobalt accent, this page's, defined here and never on :root: the ensemble's pages keep
     the candle. Contrast: #2446cf measures ~6.5:1 on --paper and >7:1 under white text; change
     the colour only with the ratio re-checked. The index numerals rest in muted ink and take
     the cobalt only under the hand, so the accent stays where the spec puts it: the emphasis,
     the primary act, the focus ring, the hover.

     The headline carries no `.ink-press`. That mechanism drives the weight axis through
     `font-variation-settings`, an INHERITED property that overrides `font-weight` outright, so
     a press on the heading — or on any ancestor — would render this 600 as the site's resting
     300. `font-variation-settings: normal` is stated on the title for the same reason: it cuts
     the inheritance should a press ever be placed above it. Plex Sans is self-hosted 100–700
     in the upright only, which is why the emphasis resets to upright instead of asking for an
     italic that does not exist (base.css). */
  .foundation-hero {
    --foundation-accent: #2446cf;
    --foundation-accent-hover: #1b35a5;
    padding: clamp(96px, 9vw, 128px) var(--gutter) clamp(40px, 4vw, 56px);
  }
  .foundation-hero > * { max-width: 1240px; margin-inline: auto; }
  .foundation-hero-identity { font-family: var(--sans); font-weight: 500; font-size: 14px; line-height: 1.4; letter-spacing: .02em; color: var(--ink-soft); margin-block: 0; }
  /* The measure is the limit, not a column: line 2 ("miała ciąg dalszy.", ~7.3em with the
     tracking) holds on one line from 390px up and the French first line (~8.5em) fits inside
     1240px at the cap. Above 960px the size climbs to poster scale (82px at 960, ~124 at 1440). */
  .foundation-hero-title { font-family: var(--sans); font-weight: 600; font-style: normal; font-variation-settings: normal; font-size: clamp(40px, 9vw, 80px); line-height: 1; letter-spacing: -.045em; margin-block: 18px 0; color: var(--ink); text-wrap: balance; }
  /* Each line is a block, not a masked `.line`: the split is the copy's (a translation decides
     its own), and a long translated line wraps inside its block instead of being clipped. */
  .foundation-hero-line { display: block; }
  /* `:global(em)`: the second line arrives through `set:html` and carries no scope attribute.
     Global `em` is Cormorant italic; the emphasis here is the same face, upright, in cobalt.
     The emphasised phrase stays on one line — it is the point of the sentence and reads as one
     unit — while the rest of the line wraps freely; at 320px that turns "miała ciąg / dalszy."
     into "miała / ciąg dalszy.". The phrase is at most ~4.5em in every locale, so it fits. */
  .foundation-hero-title :global(em) { font-family: inherit; font-style: normal; font-weight: inherit; color: var(--foundation-accent); white-space: nowrap; }
  .foundation-hero-row { margin-block: clamp(32px, 4vw, 56px) 0; }
  .foundation-hero-lead { font-family: var(--sans); font-weight: 400; font-style: normal; font-size: 17px; line-height: 1.55; max-width: 40ch; margin: 0; color: var(--ink-soft); }
  .foundation-hero-actions { margin: 28px 0 0; display: flex; flex-wrap: wrap; align-items: center; gap: 16px 28px; }
  .foundation-hero-primary { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 52px; padding: 0 26px; border-radius: 2px; background: var(--foundation-accent); color: #fff; font-family: var(--sans); font-weight: 500; font-size: 16px; line-height: 1.2; transition: background-color .25s var(--ease); }
  .foundation-hero-primary:hover, .foundation-hero-primary:focus-visible { background: var(--foundation-accent-hover); }
  .foundation-hero-secondary { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font-family: var(--sans); font-weight: 500; font-size: 16px; line-height: 1.2; color: var(--ink); text-decoration: underline; text-decoration-color: transparent; text-decoration-thickness: 1px; text-underline-offset: .22em; transition: text-decoration-color .25s var(--ease), color .25s var(--ease); }
  .foundation-hero-secondary:hover, .foundation-hero-secondary:focus-visible { color: var(--foundation-accent); text-decoration-color: currentColor; }
  /* The arrow is the only thing that moves in the opening: a 3px nudge along the reading
     direction, transform only, so the hover says "onward" without a colour change on the glyph. */
  .foundation-hero-arrow { flex: none; transition: transform .25s var(--ease); }
  .foundation-hero-primary:hover .foundation-hero-arrow, .foundation-hero-primary:focus-visible .foundation-hero-arrow,
  .foundation-hero-secondary:hover .foundation-hero-arrow, .foundation-hero-secondary:focus-visible .foundation-hero-arrow { transform: translateX(3px); }
  /* Cobalt ring for every act in the opening — above the zero-specificity candle floor base.css lays. */
  .foundation-hero a:focus-visible { outline: 2px solid var(--foundation-accent); outline-offset: 3px; }
  .foundation-hero-figure { margin: clamp(36px, 6vw, 48px) 0 0; }
  .foundation-hero-figure :global(img) { width: 100%; height: auto; }
  .foundation-hero-caption { font-family: var(--sans); font-weight: 400; font-size: 13px; line-height: 1.45; color: var(--ink-soft); margin: 10px 0 0; }
  .foundation-hero-credit { color: var(--ink-muted); }
  /* The index — the page's own table of contents. Rows ruled top and bottom, a two-digit mono
     numeral before each label, and the whole cell is the link, so the hit area is the row. */
  .foundation-hero-index { margin-block: clamp(40px, 5vw, 64px) 0; }
  .foundation-hero-index-label { display: block; font-family: var(--sans); font-weight: 500; font-size: 14px; line-height: 1.4; letter-spacing: .02em; color: var(--ink-soft); margin: 0 0 12px; }
  .foundation-hero-index-list { list-style: none; margin: 0; padding: 0; counter-reset: idx; border-top: 1px solid var(--line); display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 24px; }
  .foundation-hero-index-list li { counter-increment: idx; }
  .foundation-hero-index-list a { display: grid; grid-template-columns: auto 1fr; gap: 14px; align-items: baseline; min-height: 56px; padding: 16px 0; border-bottom: 1px solid var(--line); font-family: var(--sans); font-weight: 500; font-size: 16px; line-height: 1.3; color: var(--ink); text-decoration: underline; text-decoration-color: transparent; text-decoration-thickness: 1px; text-underline-offset: .22em; overflow-wrap: anywhere; transition: text-decoration-color .25s var(--ease), color .25s var(--ease); }
  .foundation-hero-index-list a::before { content: counter(idx, decimal-leading-zero); font-family: var(--mono); font-weight: 500; font-size: 12px; line-height: 1; letter-spacing: .06em; font-variant-numeric: tabular-nums; color: var(--ink-muted); transition: color .25s var(--ease); }
  .foundation-hero-index-list a:hover, .foundation-hero-index-list a:focus-visible { color: var(--foundation-accent); text-decoration-color: currentColor; }
  .foundation-hero-index-list a:hover::before, .foundation-hero-index-list a:focus-visible::before { color: var(--foundation-accent); }
  @media (min-width: 960px) {
    .foundation-hero-title { font-size: clamp(80px, 8.6vw, 132px); }
    .foundation-hero-row { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(40px, 4vw, 64px); align-items: start; }
    .foundation-hero-lead { font-size: clamp(18px, 1.45vw, 21px); line-height: 1.5; }
    .foundation-hero-figure { margin: 0; }
    .foundation-hero-index-list { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0 32px; }
  }
  @media (max-width: 760px) {
    .foundation-hero-primary { width: 100%; }
  }
  @media (max-width: 420px) {
    .foundation-hero-index-list { grid-template-columns: 1fr; }
  }

  /* ── Costs — paper-soft; the undertaking beside its needs ───────────────────────────────── */
  .costs { background: var(--paper-soft); padding: clamp(72px, 11vw, 150px) var(--gutter); --lat-ink: var(--candle-ink); }
  .costs-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(36px, 6vw, 88px); align-items: start; margin-top: clamp(40px, 5vw, 64px); }
  @media (max-width: 720px) { .costs-grid { grid-template-columns: 1fr; gap: 44px; } }
  .current { margin: 0; }
  .current-title { font-family: var(--serif); font-weight: 300; font-size: clamp(26px, 3vw, 36px); line-height: 1.1; letter-spacing: -.01em; color: var(--ink); margin: 0; }
  .current-facts { margin: 10px 0 0; font-family: var(--mono); font-size: 11px; letter-spacing: .04em; line-height: 1.8; color: var(--ink-muted); font-variant-numeric: lining-nums; }
  .current-essence { margin: 16px 0 0; max-width: 46ch; font-size: clamp(14.5px, 1.1vw, 16px); line-height: 1.72; color: var(--ink-soft); }
  .current-note { margin: 18px 0 0; max-width: 42ch; font-size: 13.5px; line-height: 1.65; color: var(--ink-muted); }
  .cost-lines { margin: 0; }

  /* ── Record ─────────────────────────────────────────────────────────────────────────────── */
  .record { padding: clamp(72px, 11vw, 150px) var(--gutter); --lat-ink: var(--candle-ink); }
  .record-list { list-style: none; margin: clamp(36px, 5vw, 56px) 0 0; padding: 0; }
  .record-item { display: grid; grid-template-columns: clamp(200px, 22vw, 300px) minmax(0, 1fr); gap: clamp(22px, 3.4vw, 44px); align-items: start; padding: clamp(26px, 3.6vw, 40px) 0; border-top: 1px solid var(--line); }
  .record-item:last-of-type { border-bottom: 1px solid var(--line); }
  @media (max-width: 700px) { .record-item { grid-template-columns: 1fr; gap: 18px; } }
  .record-figure { margin: 0; aspect-ratio: 4 / 3; overflow: hidden; background: var(--paper-soft); }
  .record-figure :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .record-meta { margin: 0; font-family: var(--mono); font-size: 10.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-muted); font-variant-numeric: lining-nums; }
  .record-meta .dot { color: var(--candle-ink); }
  .record-title { font-family: var(--serif); font-weight: 300; font-size: clamp(24px, 2.8vw, 34px); line-height: 1.1; letter-spacing: -.01em; color: var(--ink); margin: 10px 0 0; }
  .record-title a { border-bottom: 1px solid transparent; transition: border-color .3s var(--ease); }
  .record-title a:hover { border-bottom-color: var(--candle); }
  .record-essence { margin: 14px 0 0; max-width: 56ch; font-size: clamp(14.5px, 1.1vw, 16px); line-height: 1.72; color: var(--ink-soft); }

  /* ── Support ────────────────────────────────────────────────────────────────────────────── */
  .support { padding: clamp(72px, 11vw, 150px) var(--gutter); --lat-ink: var(--candle-ink); }
  .ways { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(30px, 5vw, 64px); margin-top: clamp(40px, 5vw, 64px); }
  @media (max-width: 680px) { .ways { grid-template-columns: 1fr; gap: 40px; } }
  .way { margin: 0; padding-top: clamp(20px, 2.6vw, 28px); border-top: 1px solid var(--line); }
  .way-label { font-family: var(--serif); font-weight: 300; font-size: clamp(24px, 2.8vw, 32px); line-height: 1.1; letter-spacing: -.01em; color: var(--ink); margin: 0; }
  .way-body { margin: 14px 0 0; max-width: 44ch; font-size: clamp(14.5px, 1.1vw, 16px); line-height: 1.72; color: var(--ink-soft); }
  .way-amounts { margin: 12px 0 0; max-width: 44ch; font-size: 13.5px; line-height: 1.65; color: var(--ink-muted); font-variant-numeric: lining-nums; }
  .way-act { margin: 22px 0 0; display: flex; flex-wrap: wrap; align-items: center; gap: 14px 24px; }

  /* The transfer block: one row per field, the value in mono (an IBAN is checked digit by
     digit), the capsule at the line's end; the values wrap at phone width rather than scroll. */
  .transfer { margin-top: clamp(48px, 6vw, 80px); padding-top: clamp(28px, 3.6vw, 40px); border-top: 1px solid var(--line); }
  .transfer-rows { margin: 0; display: grid; gap: 18px; }
  .transfer-row { display: grid; grid-template-columns: minmax(120px, 160px) minmax(0, 1fr); gap: 6px 24px; align-items: baseline; }
  @media (max-width: 560px) { .transfer-row { grid-template-columns: 1fr; gap: 4px; } }
  .transfer-row dt { font-family: var(--capitalis); font-size: 10px; letter-spacing: .2em; text-transform: uppercase; color: var(--ink-soft); }
  .transfer-row dt .currency { color: var(--candle-ink); }
  .transfer-row dd { margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; }
  .transfer-value { font-family: var(--mono); font-size: clamp(14px, 1.3vw, 17px); letter-spacing: .04em; color: var(--ink); user-select: all; overflow-wrap: anywhere; font-variant-numeric: lining-nums; }
  .transfer-iban { letter-spacing: .06em; }
  .transfer-note { flex-basis: 100%; font-size: 13px; line-height: 1.6; color: var(--ink-muted); }
  .transfer-hint { margin: 24px 0 0; max-width: 56ch; font-size: 13.5px; line-height: 1.65; color: var(--ink-muted); }
  .transfer-scope { margin: 10px 0 0; max-width: 62ch; font-size: clamp(14.5px, 1.1vw, 16px); line-height: 1.7; color: var(--ink-soft); }

  /* The optional "let us know": the island's markup is React's and carries no scope attribute,
     so every inner selector is `:global()`. Writing lines, not boxes — the doors' grammar. */
  .join { margin-top: clamp(48px, 6vw, 80px); padding-top: clamp(28px, 3.6vw, 40px); border-top: 1px solid var(--line); }
  .join-body { margin: 0 0 24px; max-width: 56ch; font-size: clamp(14.5px, 1.1vw, 16px); line-height: 1.72; color: var(--ink-soft); }
  .join :global(.patron-form) { display: grid; gap: 22px; max-width: 640px; }
  .join :global(.patron-fields) { display: grid; grid-template-columns: 1fr 1fr; gap: 18px 24px; }
  @media (max-width: 560px) { .join :global(.patron-fields) { grid-template-columns: 1fr; } }
  .join :global(.patron-field) { display: grid; gap: 6px; min-width: 0; }
  .join :global(.patron-field-wide) { grid-column: 1 / -1; }
  .join :global(.patron-label) { font-family: var(--capitalis); font-size: 10px; letter-spacing: .2em; text-transform: uppercase; color: var(--candle-ink); }
  .join :global(.patron-input) { display: block; width: 100%; padding: 6px 0; border: 0; border-bottom: 1px solid var(--line-strong); background: none; color: var(--ink); caret-color: var(--ink); font-family: var(--serif); font-size: clamp(19px, 2vw, 24px); font-weight: 300; line-height: 1.3; border-radius: 0; transition: border-color .3s var(--ease); }
  .join :global(.patron-input:focus) { outline: none; border-bottom-color: var(--candle); }
  .join :global(.patron-input[aria-invalid="true"]) { border-bottom-color: #9b4f38; }
  .join :global(.patron-input:disabled) { opacity: .6; }
  .join :global(.patron-consent) { display: grid; grid-template-columns: 18px minmax(0, 1fr); gap: 12px; align-items: start; cursor: pointer; }
  .join :global(.patron-consent-input) { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .join :global(.patron-consent-box) { display: block; width: 18px; height: 18px; margin-top: 2px; border: 1px solid var(--line-strong); background: transparent; transition: background-color .3s var(--ease), border-color .3s var(--ease); }
  .join :global(.patron-consent-input:checked + .patron-consent-box) { background: var(--candle-ink); border-color: var(--candle-ink); }
