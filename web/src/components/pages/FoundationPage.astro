---
/**
 * @file FoundationPage.astro
 * @description Locale-agnostic body of /fundacja — the foundation's institutional page: what
 *  VoctFoundation is, what it has made, where it comes from, who answers for it, how to support
 *  it, and its registry. The three route files differ only in `lang`.
 *  Spec: docs/specs/web-foundation-rebuild-2026-09.md.
 *
 *  THE FOUNDATION SPEAKS IN THE GRID. Twelve columns in the 1240 measure; from 1024px the first
 *  three are a sticky rail carrying the page's numbered index, and everything else reads in the
 *  other nine. Below 1024px the rail becomes the hero's contents and each section prints its own
 *  numbered label. IBM Plex Sans is the institution's display voice, Plex Mono its data; Cormorant
 *  is kept for people's words only — the motto and the three supporters' sentences.
 *
 *  NO ACCENT COLOUR. The foundation is ink, paper and black-and-white photography; emphasis is
 *  weight (the headline's second line at 300 against 600), filled actions are ink. The only colour
 *  on the page is a realisation's own (RealisationModule). The foundation's social profiles take
 *  their look from here, not the other way round. It closes on a night band with the registry and
 *  a full-measure wordmark, on the same ground as the site's footer below it.
 *
 *  WHAT IS A FACT AND WHERE IT COMES FROM. Registry, board functions, accounts and addresses are
 *  `data/foundation.ts`; realisations, budgets and the switches that wait on a person are
 *  `data/foundationSupport.ts`; concerts and the record's counts are the corpus, resolved in
 *  `lib/realisations`; the board's domains and the statutory goals are /o-nas's copy, their one
 *  home. This page's own words come from `content/pages/fundacja.yaml`; its chrome from
 *  `i18n/content/fundacja.ts`.
 *
 *  STATIC FIRST. Every section reads complete with scripts and motion off; nothing waits on a
 *  reveal. The rail's current-section mark and the page's entrances are a later stage.
 *
 *  ONE-OFF GIVING IS THE VAULT'S. "Wpłać online" opens the existing donation vault in place
 *  (`data-vault-open`, with this locale's `/?donate` as the no-JS road); this page builds no
 *  checkout.
 * @architecture Astro islands 2026
 * @module components/pages/FoundationPage
 */
import { getCollection } from "astro:content";
import { getImage, Picture } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteChrome from "../SiteChrome.astro";
import SiteFooter from "../SiteFooter.astro";
import VaultMount from "../VaultMount.astro";
import ActArrow from "../foundation/ActArrow.astro";
import RealisationModule from "../foundation/RealisationModule.astro";
import { PatronInterestForm } from "../../islands/landing/PatronInterestForm";
import { bleedPair, photoOptional } from "../../lib/photos";
import { frameCredit } from "../../lib/photoCredit";
import { pageCopy } from "../../lib/pageCopy";
import { chromeHtmlForIsland } from "../../lib/islandCopy";
import { longDate } from "../../lib/dates";
import { assertPolishForm, formatPln, realisationViews, recordBeforeFoundation } from "../../lib/realisations";
import { FOUNDATION } from "../../data/foundation";
import {
  FEATURED_REALISATION,
  FOUNDATION_PAGE_LINKED,
  REALISATIONS,
  SCALE_MONTHLY_PLN,
  STATUTE_PATH,
  TAX_LINE_CONFIRMED,
} from "../../data/foundationSupport";
import { VAULT_CONFIG } from "../../islands/landing/constants/vaultConfig";
import { FOUNDATION_CHROME, FUNDACJA_PAGE } from "../../i18n/content/fundacja";
import { ABOUT_PAGE } from "../../i18n/content/o-nas";
import { UI } from "../../i18n/ui";
import { localizePath, pageI18n, SITE, type Locale } from "../../i18n/config";
import { GOALS, goalClass } from "../../lib/plausible";
import "../../styles/vault.css";

interface Props {
  /** Which language this render is. Drives the copy, the chrome, the URL and the hreflang graph. */
  lang: Locale;
}
const { lang } = Astro.props;

const copy = pageCopy(FUNDACJA_PAGE, lang);
const t = FOUNDATION_CHROME[lang];
const { path, alternates, available } = pageI18n("/fundacja", lang);
// The vault opens in place; the href is the no-JS road to the landing that auto-opens it, and has
// to be THIS locale's landing or a reader with scripts off lands in Polish.
const hrefDonate = `${localizePath("/", lang)}?donate`;
const hrefConcerts = localizePath("/koncerty", lang);
const hrefMecenat = localizePath("/mecenat", lang);
const hrefAbout = localizePath("/o-nas", lang);
const hrefPrivacy = localizePath("/polityka-prywatnosci", lang);
const hrefTerms = localizePath("/regulamin-darowizn", lang);
const hrefPress = localizePath("/press", lang);

const fill = (template: string, slots: Record<string, string>): string =>
  template.replace(/\{(\w+)\}/g, (match, name: string) => slots[name] ?? match);

// ── The index: the rail on a desktop, the hero's contents on a phone, each section's label ────
// One concert that has not happened yet is not "Realizacje": the entry says "Pierwsza realizacja"
// until a second realisation exists.
const indexItems = copy.index.items.map((item, i) => ({
  ...item,
  label: item.id === "realizacje" && REALISATIONS.length === 1 ? copy.index.firstRealisation : item.label,
  number: String(i + 1).padStart(2, "0"),
}));
const indexById = (id: string) => {
  const item = indexItems.find((entry) => entry.id === id);
  if (!item) throw new Error(`[fundacja] the page index has no entry "${id}".`);
  return item;
};
const sections = {
  realisations: indexById("realizacje"),
  record: indexById("dorobek"),
  mission: indexById("misja"),
  support: indexById("wsparcie"),
  registry: indexById("dokumenty"),
};

// ── 01 · Realisations ─────────────────────────────────────────────────────────────────────────
const concerts = await getCollection("concerts");
const eras = await getCollection("repertoire");
// The rubric names the form and the year only: the section's label already says what the module is.
const realisations = realisationViews(concerts, eras, lang).map((view) => {
  const lead = copy.realisation.leads.find((l) => l.id === view.id);
  if (!lead) throw new Error(`[fundacja] realisation "${view.id}" has no lead in fundacja.yaml (realisation.leads).`);
  return {
    view,
    leadHtml: lead.textHtml,
    rubric: view.cycle ? `${copy.realisation.formCycle} · ${view.year}` : view.year,
  };
});
const featured = realisations[0]?.view;

// ── 02 · The ensemble's record before the foundation ─────────────────────────────────────────
const record = recordBeforeFoundation(concerts, lang);
assertPolishForm(record.programmes, "many", "record.statProgrammes");
assertPolishForm(record.concerts, "many", "record.statConcerts");
const recordSpan = record.from === record.to ? record.from : `${record.from}–${record.to}`;
const rehearsalPhoto = photoOptional("fundacja-proba-florent");
const rehearsalCredit = frameCredit({}, lang);

// ── 03 · Mission and people ───────────────────────────────────────────────────────────────────
// The function is the register's (data), its words are copy; the domain is /o-nas's line, read
// by id so an editor reordering either list cannot slide one person's remit under another name.
const about = pageCopy(ABOUT_PAGE, lang);
const board = FOUNDATION.board.map((member) => {
  const role = about.governance.roles.find((r) => r.id === member.id);
  if (!role) throw new Error(`[fundacja] no governance role on /o-nas for board member "${member.id}".`);
  return {
    ...member,
    functionLabel: member.function === "president" ? copy.mission.president : copy.mission.vicePresident,
    domain: role.role,
    portrait: photoOptional(`fundacja-zarzad-${member.id}`),
  };
});
// All or none: one face beside two blank cells reads worse than three names. The portraits are
// real black-and-white photographs made to one brief (4:5, same head size, same light); none is
// drawn or generated, because a made-up face costs a trust page more than no face.
const boardPortraits = board.every((b) => b.portrait);

// ── 04 · Support ──────────────────────────────────────────────────────────────────────────────
// The scale sentence belongs to a budget that is still being raised, so it prints only while the
// featured realisation is ahead — and only in the grammatical form its sentence was written in.
const featuredBudget = REALISATIONS.find((r) => r.id === FEATURED_REALISATION)?.budget.amountPln;
const scalePeople = featured?.ahead && featuredBudget ? Math.ceil(featuredBudget / (SCALE_MONTHLY_PLN * 12)) : undefined;
if (scalePeople !== undefined) assertPolishForm(scalePeople, "few", "support.donation.scale");
const scaleLine =
  scalePeople !== undefined
    ? fill(copy.support.donation.scale, { people: String(scalePeople), monthly: formatPln(SCALE_MONTHLY_PLN, lang) })
    : undefined;

const transferTitle = VAULT_CONFIG.recipient.title;
const foundationMail = FOUNDATION.mail.foundation;
const partnershipHref = `mailto:${foundationMail}?subject=${encodeURIComponent(copy.support.partnership.mailSubject)}`;
const bookingHref = `mailto:${FOUNDATION.mail.booking}?subject=${encodeURIComponent(copy.support.partnership.bookingSubject)}`;

const formProps = {
  chrome: t.form,
  copy: {
    consentHtml: chromeHtmlForIsland(copy.join.supportConsentHtml, lang),
    successTitle: copy.join.successTitle,
    successBody: copy.join.successBody,
  },
  contactEmail: foundationMail,
} as const;

// ── 05 · Registry ─────────────────────────────────────────────────────────────────────────────
const firstYear = Number(FOUNDATION.foundedOn.slice(0, 4));
const reportsLine = fill(copy.registry.reports, { year: String(firstYear), approvalYear: String(firstYear + 1) });
const registryRows = [
  { term: copy.registry.name, value: FOUNDATION.name },
  { term: copy.registry.seat, value: FOUNDATION.addressLine },
  { term: "KRS", value: FOUNDATION.registry.krs },
  { term: "NIP", value: FOUNDATION.registry.nip },
  { term: "REGON", value: FOUNDATION.registry.regon },
  { term: copy.registry.founded, value: longDate(FOUNDATION.foundedOn, lang) },
  { term: copy.registry.supervisionLabel, value: copy.registry.supervision },
  { term: copy.registry.representationLabel, value: copy.registry.representation },
];
const SOCIAL_NAMES = { facebook: "Facebook", instagram: "Instagram" } as const;

// The social card keeps the nave plate the landing's ensemble section shows: a 1200-wide landscape
// of the ensemble singing reads as "the music" on a feed.
const ogImage = (await getImage({ src: bleedPair("chor-nawa").desktop, width: 1200, format: "webp" })).src;

// The foundation as the subject, the ensemble as its music group — two objects, never one as the
// other's alternate name.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: copy.meta.title,
  url: `${SITE}${path}`,
  inLanguage: lang,
  about: {
    "@type": "Organization",
    name: FOUNDATION.name,
    url: SITE,
    email: foundationMail,
    foundingDate: FOUNDATION.foundedOn,
    identifier: [
      { "@type": "PropertyValue", propertyID: "KRS", value: FOUNDATION.registry.krs },
      { "@type": "PropertyValue", propertyID: "NIP", value: FOUNDATION.registry.nip },
      { "@type": "PropertyValue", propertyID: "REGON", value: FOUNDATION.registry.regon },
    ],
    address: {
      "@type": "PostalAddress",
      streetAddress: FOUNDATION.seat.street,
      postalCode: FOUNDATION.seat.postalCode,
      addressLocality: FOUNDATION.seat.city,
      addressCountry: FOUNDATION.seat.countryCode,
    },
    subOrganization: { "@type": "MusicGroup", name: FOUNDATION.ensemble, url: SITE },
  },
};
---

<BaseLayout
  title={copy.meta.title}
  description={copy.meta.description}
  path={path}
  image={ogImage}
  bodyClass="page-fundacja"
  lang={lang}
  alternates={alternates}
  breadcrumb={[{ name: UI[lang].nav.foundation, path }]}
>
  <Fragment slot="head">
    {/* Deployed but not yet announced: until FOUNDATION_PAGE_LINKED the page is reachable through
        the footers and the vault, and kept out of the index (and, by hand, out of the sitemap —
        astro.config.mjs) so a search result never becomes its first door. */}
    {!FOUNDATION_PAGE_LINKED && <meta name="robots" content="noindex,follow" />}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <a class="skip-link" href="#tresc">{UI[lang].skipToContent}</a>
  <SiteChrome current="/fundacja" ground="paper" lang={lang} availableLocales={available} />

  <main id="tresc" class="vf">
    <div class="vf-frame">
      <div class="vf-grid">
        {/* ── Hero — type only; the LCP is the headline. Its two doors serve the page's two
              readers: the one who came to give, and the one checking the foundation. /mecenat
              stays one click away in the support section, never at the hero's weight. ───── */}
        <header class="vf-hero">
          <p class="vf-eyebrow">{copy.hero.eyebrow}</p>
          <h1 class="vf-title">
            <span class="vf-title-line">{copy.hero.title1}</span>
            <span class="vf-title-line" set:html={copy.hero.title2Html} />
          </h1>
          <p class="vf-lead">{copy.hero.lead}</p>
          <p class="vf-hero-links">
            <a class="vf-act vf-act-primary" href="#wsparcie">{copy.hero.supportLink}<ActArrow /></a>
            <a class="vf-act" href="#fundacja-i-dokumenty">{copy.hero.registryLink}<ActArrow /></a>
          </p>
        </header>

        {/* ── The rail — the page's numbered index. Sticky beside the sections from 1024px;
              on a phone it follows the hero as its contents. ──────────────────────────── */}
        <nav class="vf-rail" aria-label={t.indexAria}>
          <div class="vf-rail-inner">
            <p class="vf-rail-label">{copy.index.label}</p>
            <ol class="vf-rail-list">
              {indexItems.map((item) => (
                <li>
                  <a href={`#${item.anchor}`}><span class="vf-num">{item.number}</span><span>{item.label}</span></a>
                </li>
              ))}
            </ol>
          </div>
        </nav>

        {/* ── 01 · Realisations — the section opens on the module, whose own accent rule is
              the section's top edge (`vf-section-module`), so the page draws no second rule. ── */}
        <section class="vf-section vf-section-module" id="realizacja" aria-label={t.realisationsAria}>
          <p class="vf-label"><span class="vf-num">{sections.realisations.number}</span>{sections.realisations.label}</p>
          {realisations.map((r) => (
            <RealisationModule
              view={r.view}
              rubric={r.rubric}
              leadHtml={r.leadHtml}
              labels={copy.realisation}
              withNotes={true}
              donateHref={hrefDonate}
            />
          ))}
        </section>

        {/* ── 02 · Where the foundation comes from ─────────────────────────────────────── */}
        <section class="vf-section" id="dorobek" aria-label={t.recordAria}>
          <p class="vf-label"><span class="vf-num">{sections.record.number}</span>{sections.record.label}</p>
          <div class={rehearsalPhoto ? "vf-record vf-record-with-photo" : "vf-record"}>
            <div class="vf-record-text">
              <h2 class="vf-h2">{copy.record.h2}</h2>
              <p class="vf-body" set:html={copy.record.bodyHtml} />
              <p class="vf-span">{recordSpan}</p>
              <dl class="vf-stats">
                <div><dt class="vf-stat-figure">{record.programmes}</dt><dd>{copy.record.statProgrammes}</dd></div>
                <div><dt class="vf-stat-figure">{record.concerts}</dt><dd>{copy.record.statConcerts}</dd></div>
                <div><dt class="vf-stat-figure">{record.free}</dt><dd>{copy.record.statFree}</dd></div>
              </dl>
              <dl class="vf-timeline">
                {record.years.map((year) => (
                  <div class="vf-timeline-year">
                    <dt>{year.year}</dt>
                    <dd>
                      <ul>
                        {year.items.map((item) => (
                          <li>{item.href ? <a href={item.href}>{item.title}</a> : item.title}</li>
                        ))}
                      </ul>
                    </dd>
                  </div>
                ))}
              </dl>
              <p class="vf-more"><a class="vf-link" href={hrefConcerts}>{copy.record.allLink}<ActArrow /></a></p>
            </div>
            {rehearsalPhoto && (
              <figure class="vf-record-photo">
                {/* The visible caption says what the frame shows, so the image's alt is empty
                    rather than the same sentence twice. `width` = top of the ladder. */}
                <Picture
                  src={rehearsalPhoto}
                  formats={["avif", "webp"]}
                  widths={[400, 640, 900, 1200]}
                  width={Math.min(rehearsalPhoto.width, 1200)}
                  sizes="(min-width: 1024px) 30vw, 100vw"
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
                <figcaption>{copy.record.photoCaption} · {rehearsalCredit}</figcaption>
              </figure>
            )}
          </div>
        </section>

        {/* ── 03 · Mission and people ───────────────────────────────────────────────────── */}
        <section class="vf-section" id="misja" aria-label={t.missionAria}>
          <p class="vf-label"><span class="vf-num">{sections.mission.number}</span>{sections.mission.label}</p>
          {/* One sentence per line, as the hero sets its two; only the word for the human being is
              italic, as Anna Marcisz set the motto. */}
          <h2 class="vf-motto">
            <span class="vf-motto-line">{copy.mission.motto1}</span>
            <span class="vf-motto-line" set:html={copy.mission.motto2Html} />
          </h2>
          <p class="vf-body">{copy.mission.body}</p>
          <div class="vf-board" id="ludzie">
            <h3 class="vf-rubric">{copy.mission.boardLabel}</h3>
            <ul class="vf-board-list">
              {board.map((member) => (
                <li class="vf-member">
                  {boardPortraits && member.portrait && (
                    <figure class="vf-portrait">
                      {/* A face beside the name it belongs to: decorative, empty alt. */}
                      <Picture
                        src={member.portrait}
                        formats={["avif", "webp"]}
                        widths={[320, 480, 720]}
                        width={Math.min(member.portrait.width, 720)}
                        sizes="(min-width: 1024px) 22vw, (min-width: 640px) 30vw, 70vw"
                        alt=""
                        loading="lazy"
                        decoding="async"
                      />
                    </figure>
                  )}
                  <p class="vf-member-name">{member.name}</p>
                  <p class="vf-member-function">{member.functionLabel}</p>
                  <p class="vf-member-domain">{member.domain}</p>
                </li>
              ))}
            </ul>
            <p class="vf-more"><a class="vf-link" href={hrefAbout}>{copy.mission.aboutLink}<ActArrow /></a></p>
          </div>
        </section>

        {/* ── 04 · Support — three forms, one transfer panel, one optional form ─────────── */}
        <section class="vf-section" id="wsparcie" aria-label={t.supportAria}>
          <p class="vf-label"><span class="vf-num">{sections.support.number}</span>{sections.support.label}</p>
          <h2 class="vf-h2">{copy.support.h2}</h2>
          <div class="vf-ways">
            <article class="vf-way" id="darowizna">
              <h3 class="vf-way-label">{copy.support.donation.label}</h3>
              <p class="vf-quote">{copy.support.donation.quote}</p>
              <p class="vf-way-body">{copy.support.donation.body}</p>
              {scaleLine && <p class="vf-way-note">{scaleLine}</p>}
              <p class="vf-way-note">{copy.support.donation.promise}</p>
              <p class="vf-way-acts">
                <a class="vf-act vf-act-primary" href={hrefDonate} data-vault-open="100">{copy.support.donation.vaultAction}</a>
                <a class="vf-link" href="#przelew">{copy.support.donation.transferLink}</a>
              </p>
            </article>
            <article class="vf-way" id="mecenat">
              <h3 class="vf-way-label">{copy.support.mecenat.label}</h3>
              <p class="vf-quote">{copy.support.mecenat.quote}</p>
              <p class="vf-way-body">{copy.support.mecenat.body}</p>
              <p class="vf-way-acts"><a class="vf-link" href={hrefMecenat}>{copy.support.mecenat.link}<ActArrow /></a></p>
            </article>
            <article class="vf-way" id="partnerstwo">
              <h3 class="vf-way-label">{copy.support.partnership.label}</h3>
              <p class="vf-quote">{copy.support.partnership.quote}</p>
              <p class="vf-way-body">{copy.support.partnership.body}</p>
              <ul class="vf-way-links">
                <li><a class={`vf-link ${goalClass(GOALS.mailPatronage)}`} href={partnershipHref}>{copy.support.partnership.mailLink}</a></li>
                <li><a class="vf-link" href={hrefPress}>{copy.support.partnership.pressLink}</a></li>
                <li><a class={`vf-link ${goalClass(GOALS.mailBooking)}`} href={bookingHref}>{copy.support.partnership.bookingLink}</a></li>
              </ul>
            </article>
          </div>

          {/* One transfer panel serves every way of giving, statically: selectable numbers on the
              same phone the reader banks on, copy as a convenience. */}
          <div class="vf-transfer" id="przelew" aria-label={t.transferAria}>
            <h3 class="vf-rubric">{copy.transfer.h3}</h3>
            <dl class="vf-transfer-rows">
              <div class="vf-transfer-row">
                <dt>{copy.transfer.recipientLabel}</dt>
                <dd>
                  <span class="vf-transfer-value">{FOUNDATION.name}</span>
                  <button type="button" class="copy-btn" data-copy={FOUNDATION.name} data-copied={t.copied} aria-label={t.copyAria.replace("{what}", copy.transfer.recipientLabel)}>
                    <span class="copy-label">{t.copy}</span>
                  </button>
                </dd>
              </div>
              <div class="vf-transfer-row">
                <dt>{copy.transfer.accountLabel} <span class="vf-currency">PLN</span></dt>
                <dd>
                  <span class="vf-transfer-value">{FOUNDATION.accounts.pln.display}</span>
                  <button type="button" class={`copy-btn ${goalClass(GOALS.accountCopied)}`} data-copy={FOUNDATION.accounts.pln.iban} data-copied={t.copied} aria-label={t.copyAria.replace("{what}", `${copy.transfer.accountLabel} PLN`)}>
                    <span class="copy-label">{t.copy}</span>
                  </button>
                </dd>
              </div>
              {/* A transfer from abroad needs the BIC as well as the IBAN — outside SEPA always,
                  and in many banks' forms inside it — so it stands on this row, copyable too. */}
              <div class="vf-transfer-row">
                <dt>{copy.transfer.eurLabel} <span class="vf-currency">EUR</span></dt>
                <dd>
                  <span class="vf-transfer-value">{FOUNDATION.accounts.eur.display}</span>
                  <button type="button" class={`copy-btn ${goalClass(GOALS.accountCopied)}`} data-copy={FOUNDATION.accounts.eur.iban} data-copied={t.copied} aria-label={t.copyAria.replace("{what}", `${copy.transfer.eurLabel} EUR`)}>
                    <span class="copy-label">{t.copy}</span>
                  </button>
                  <span class="vf-transfer-sub">
                    <span class="vf-currency">BIC</span>
                    <span class="vf-transfer-value">{FOUNDATION.accounts.bic}</span>
                    <button type="button" class="copy-btn" data-copy={FOUNDATION.accounts.bic} data-copied={t.copied} aria-label={t.copyAria.replace("{what}", "BIC")}>
                      <span class="copy-label">{t.copy}</span>
                    </button>
                  </span>
                </dd>
              </div>
              <div class="vf-transfer-row">
                <dt>{copy.transfer.titleLabel}</dt>
                <dd>
                  <span class="vf-transfer-value" lang="pl">{transferTitle}</span>
                  <button type="button" class="copy-btn" data-copy={transferTitle} data-copied={t.copied} aria-label={t.copyAria.replace("{what}", copy.transfer.titleLabel)}>
                    <span class="copy-label">{t.copy}</span>
                  </button>
                </dd>
              </div>
            </dl>
            <p class="vf-transfer-note">{copy.transfer.scope}</p>
            <p class="vf-transfer-note">{copy.transfer.namesRule}</p>
            <p class="vf-transfer-note">{copy.transfer.surplusRule}</p>
            {TAX_LINE_CONFIRMED && <p class="vf-transfer-note">{copy.transfer.tax}</p>}
          </div>

          {/* Optional, and collapsed: most givers never need it. The island hydrates when the
              reader opens it (`client:visible` inside a closed <details> is never visible). */}
          <details class="vf-join" id="zglos">
            <summary>{copy.join.summary}</summary>
            <div class="vf-join-body">
              <p class="vf-join-note">{copy.join.note}</p>
              <PatronInterestForm client:visible {...formProps} />
              <noscript>
                <p class="vf-join-note">{t.form.noscript} <a href={`mailto:${foundationMail}`}>{foundationMail}</a></p>
              </noscript>
            </div>
          </details>
        </section>
      </div>
    </div>

    {/* ── 05 · Registry — the closing night band, then the wordmark ─────────────────────── */}
    <section class="vf-registry" id="fundacja-i-dokumenty" aria-label={t.registryAria}>
      <div class="vf-frame">
        <div class="vf-grid vf-registry-grid">
          <div class="vf-registry-head">
            <p class="vf-registry-num"><span class="vf-num">{sections.registry.number}</span></p>
            <h2 class="vf-registry-h2">{copy.registry.h2}</h2>
          </div>
          <div class="vf-registry-body">
            <dl class="vf-registry-rows">
              {registryRows.map((row) => (
                <div class="vf-registry-row">
                  <dt>{row.term}</dt>
                  <dd>{row.value}</dd>
                </div>
              ))}
            </dl>
            <p class="vf-registry-text">{copy.registry.relation}</p>

            <h3 class="vf-registry-label">{copy.registry.goalsLabel}</h3>
            <ol class="vf-goals">
              {about.foundation.goals.map((goal) => <li>{goal.text}</li>)}
            </ol>
            <p class="vf-registry-text vf-registry-muted">{about.foundation.legalNote}</p>

            <h3 class="vf-registry-label">{copy.registry.documentsLabel}</h3>
            <ul class="vf-documents">
              <li><a href={STATUTE_PATH}>{copy.registry.statuteLink}</a></li>
              <li><a href={hrefPrivacy}>{copy.registry.privacyLink}</a></li>
              <li><a href={hrefTerms}>{copy.registry.termsLink}</a></li>
              <li><a href={hrefPress}>{copy.registry.pressLink}</a></li>
            </ul>
            <p class="vf-registry-text vf-registry-muted">{reportsLine}</p>

            {FOUNDATION.socials.length > 0 && (
              <p class="vf-registry-text">
                {copy.registry.socialLead}{" "}
                {FOUNDATION.socials.map((profile, i) => (
                  <>{i > 0 && " · "}<a href={profile.url} rel="me noopener">{SOCIAL_NAMES[profile.network]}</a></>
                ))}
              </p>
            )}
            <p class="vf-registry-contact">
              <span class="vf-registry-label">{copy.registry.contactLead}</span>
              <a class="vf-registry-mail" href={`mailto:${foundationMail}`}>{foundationMail}</a>
              <button type="button" class="copy-btn" data-copy={foundationMail} data-copied={t.copied} aria-label={t.copyAria.replace("{what}", foundationMail)}>
                <span class="copy-label">{t.copy}</span>
              </button>
            </p>
          </div>
          {/* The wordmark, fitted to the measure by the SVG itself — `textLength` holds the
              word to the viewBox at every width, with no script. The name is already in the
              band's rows, so the drawing is hidden from assistive technology. */}
          {/* 730 is the word's natural advance in Plex Sans 600 at 100px (measured 729.6), so
              `textLength` fits it without pulling the letters together. */}
          <svg class="vf-wordmark" viewBox="0 0 730 74" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
            <text x="0" y="72" textLength="730" lengthAdjust="spacing">{FOUNDATION.nameShort}</text>
          </svg>
        </div>
      </div>
    </section>
  </main>

  {/* The band above already prints the foundation's full registry; the footer's Fundatio stanza
      would repeat it a hand's breadth lower. */}
  <SiteFooter lang={lang} registry={false} />

  <VaultMount lang={lang} />
  <script>
    import "../../scripts/vault-triggers.ts";
    import "../../scripts/copy-fields.ts";
  </script>
</BaseLayout>

<style>
  /* ── The page scope ─────────────────────────────────────────────────────────────────────────
     Ink on paper, no accent (see the header). `--vf-bleed` is the distance from the grid's right
     edge to the viewport's, which the realisation's visual crosses. */
  .vf {
    --vf-rule: color-mix(in oklab, var(--ink) 16%, transparent);
    --vf-bleed: max(var(--gutter), calc((100vw - 1240px) / 2));
  }
  .vf a:focus-visible, .vf summary:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  .vf-frame { padding-inline: var(--gutter); }
  .vf > .vf-frame:first-child { padding-top: clamp(96px, 9vw, 132px); }
  .vf-grid { max-width: 1240px; margin-inline: auto; display: grid; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 1024px) {
    .vf-grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(20px, 2vw, 32px); }
    .vf-grid > * { grid-column: 4 / -1; }
    .vf-grid > .vf-rail { grid-column: 1 / 4; grid-row: 1 / span 5; }
  }
  .vf-num { font-family: var(--mono); font-weight: 500; font-size: 12px; letter-spacing: .06em; font-variant-numeric: tabular-nums; color: var(--ink-muted); }

  /* ── Hero ───────────────────────────────────────────────────────────────────────────────────
     No `.ink-press` on the headline: that mechanism drives the weight axis through the INHERITED
     `font-variation-settings`, which would override the 600 here; `normal` is stated to cut any
     press above it. The emphasis is weight — the `<em>` line at 300 against 600 — because the page
     carries no accent colour and Plex Sans ships no italic. */
  .vf-eyebrow { margin: 0; font-family: var(--sans); font-weight: 500; font-size: 14px; line-height: 1.4; letter-spacing: .02em; color: var(--ink-soft); }
  .vf-title { margin: 18px 0 0; font-family: var(--sans); font-weight: 600; font-style: normal; font-variation-settings: normal; font-size: clamp(40px, 11vw, 64px); line-height: 1; letter-spacing: -.045em; color: var(--ink); text-wrap: balance; }
  .vf-title-line { display: block; }
  /* `:global(em)`: the second line arrives through `set:html` and carries no scope attribute. */
  .vf-title :global(em) { font-family: inherit; font-style: normal; font-weight: 300; color: var(--ink); white-space: nowrap; }
  .vf-lead { margin: clamp(24px, 3vw, 36px) 0 0; max-width: 58ch; font-family: var(--sans); font-size: clamp(17px, 1.45vw, 20px); line-height: 1.55; color: var(--ink-soft); }
  .vf-hero-links { margin: 28px 0 0; display: flex; flex-wrap: wrap; align-items: center; gap: 12px 28px; }
  @media (min-width: 1024px) {
    .vf-title { font-size: clamp(64px, 7.2vw, 104px); }
  }

  /* Acts: the primary is a filled ink block — the same block the realisation uses to open the
     vault — and the rest are underlined words. The arrow (ActArrow) is the only thing that moves
     under the hand. */
  .vf-act { display: inline-flex; align-items: center; gap: 10px; min-height: 48px; font-family: var(--sans); font-weight: 500; font-size: 16px; line-height: 1.2; color: var(--ink); text-decoration: underline; text-decoration-color: transparent; text-underline-offset: .22em; text-decoration-thickness: 1px; transition: text-decoration-color .25s var(--ease), background-color .25s var(--ease); }
  .vf-act:hover, .vf-act:focus-visible { text-decoration-color: currentColor; }
  .vf-act-primary { padding: 0 24px; border-radius: 2px; background: var(--ink); color: var(--paper); text-decoration: none; }
  .vf-act-primary:hover, .vf-act-primary:focus-visible { background: var(--ink-soft); color: var(--paper); }
  .vf-act :global(svg) { margin-left: 0; transition: transform .25s var(--ease); }
  .vf-act:hover :global(svg), .vf-act:focus-visible :global(svg) { transform: translateX(3px); }
  .vf-link { font-family: var(--sans); font-weight: 500; font-size: 15px; color: var(--ink); text-decoration: underline; text-decoration-color: color-mix(in oklab, var(--ink) 30%, transparent); text-underline-offset: .22em; text-decoration-thickness: 1px; transition: text-decoration-color .25s var(--ease); }
  .vf-link:hover, .vf-link:focus-visible { text-decoration-color: currentColor; }
  .vf-link :global(svg) { transition: transform .25s var(--ease); }
  .vf-link:hover :global(svg), .vf-link:focus-visible :global(svg) { transform: translateX(3px); }

  /* ── The rail ──────────────────────────────────────────────────────────────────────────────── */
  .vf-rail { margin: clamp(36px, 6vw, 56px) 0 0; }
  .vf-rail-label { margin: 0 0 10px; font-family: var(--sans); font-weight: 500; font-size: 14px; color: var(--ink-soft); }
  .vf-rail-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--vf-rule); }
  .vf-rail-list a { display: grid; grid-template-columns: 2.4em 1fr; align-items: baseline; min-height: 48px; padding: 13px 0; border-bottom: 1px solid var(--vf-rule); font-family: var(--sans); font-weight: 500; font-size: 15px; line-height: 1.3; color: var(--ink); text-decoration: none; transition: color .25s var(--ease); }
  .vf-rail-list a:hover, .vf-rail-list a:focus-visible { color: var(--ink); }
  .vf-rail-list a:hover .vf-num, .vf-rail-list a:focus-visible .vf-num { color: var(--ink); }
  @media (min-width: 1024px) {
    .vf-rail { margin: 0; }
    .vf-rail-inner { position: sticky; top: clamp(96px, 12vh, 128px); }
    .vf-rail-label { display: none; }
    .vf-rail-list { border-top: 0; }
    .vf-rail-list a { min-height: 0; padding: 7px 0; border-bottom: 0; font-size: 14px; color: var(--ink-soft); }
  }

  /* ── Sections ──────────────────────────────────────────────────────────────────────────────── */
  /* A phone ruled by each section's own label; a desktop by the section's top edge, the rail
     naming it. */
  .vf-section { padding-top: clamp(64px, 9vw, 120px); }
  .vf-section:last-child { padding-bottom: clamp(72px, 10vw, 136px); }
  .vf-label { display: flex; gap: 12px; align-items: baseline; margin: 0 0 clamp(20px, 3vw, 28px); padding-top: 12px; border-top: 1px solid var(--ink); font-family: var(--sans); font-weight: 500; font-size: 14px; color: var(--ink); }
  @media (min-width: 1024px) {
    .vf-label { display: none; }
    .vf-section { margin-top: clamp(72px, 8vw, 120px); padding-top: 22px; border-top: 1px solid var(--ink); }
  }
  /* A section that opens on a realisation module has the module's accent rule for its top edge:
     no section rule on a desktop, no label rule on a phone — one rule, not two 23px apart. */
  .vf-section-module .vf-label { padding-top: 0; border-top: 0; }
  @media (min-width: 1024px) {
    .vf-section-module { padding-top: 0; border-top: 0; }
  }
  .vf-h2 { margin: 0; max-width: 22ch; font-family: var(--sans); font-weight: 600; font-size: clamp(28px, 3.4vw, 44px); line-height: 1.08; letter-spacing: -.03em; color: var(--ink); text-wrap: balance; }
  .vf-body { margin: 20px 0 0; max-width: 64ch; font-family: var(--sans); font-size: clamp(16px, 1.2vw, 17px); line-height: 1.65; color: var(--ink-soft); }
  /* A title or foreign term in body copy (set:html, so `:global`). Plex Sans ships no italic;
     this is the browser's slanted roman. */
  .vf-body :global(em) { font-style: italic; }
  .vf-rubric { margin: 0 0 14px; font-family: var(--mono); font-size: 11px; font-weight: 500; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-muted); }
  .vf-more { margin: 24px 0 0; }

  /* ── 02 · Record ───────────────────────────────────────────────────────────────────────────── */
  .vf-record-with-photo { display: grid; gap: clamp(32px, 4vw, 48px); }
  @media (min-width: 1024px) {
    .vf-record-with-photo { grid-template-columns: minmax(0, 5fr) minmax(0, 4fr); align-items: start; }
  }
  .vf-span { margin: clamp(28px, 3.4vw, 40px) 0 0; font-family: var(--mono); font-size: 12px; letter-spacing: .06em; color: var(--ink-muted); font-variant-numeric: tabular-nums; }
  .vf-stats { margin: 8px 0 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; border-top: 1px solid var(--vf-rule); padding-top: 14px; }
  .vf-stats div { display: flex; flex-direction: column; }
  .vf-stat-figure { font-family: var(--sans); font-weight: 300; font-size: clamp(44px, 6vw, 72px); line-height: 1; letter-spacing: -.03em; color: var(--ink); font-variant-numeric: lining-nums tabular-nums; }
  .vf-stats dd { margin: 8px 0 0; font-family: var(--sans); font-size: 14px; line-height: 1.35; color: var(--ink-soft); }
  .vf-timeline { margin: clamp(28px, 3.4vw, 40px) 0 0; }
  .vf-timeline-year { display: grid; grid-template-columns: 4.5em minmax(0, 1fr); gap: 16px; padding: 12px 0; border-top: 1px solid var(--vf-rule); }
  .vf-timeline-year:last-child { border-bottom: 1px solid var(--vf-rule); }
  .vf-timeline dt { font-family: var(--mono); font-size: 13px; color: var(--ink-muted); font-variant-numeric: tabular-nums; padding-top: 2px; }
  .vf-timeline dd { margin: 0; }
  .vf-timeline ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .vf-timeline li { font-family: var(--sans); font-size: 16px; line-height: 1.45; color: var(--ink); }
  .vf-timeline a { color: inherit; text-decoration: underline; text-decoration-color: color-mix(in oklab, var(--ink) 25%, transparent); text-underline-offset: .2em; text-decoration-thickness: 1px; transition: color .25s var(--ease), text-decoration-color .25s var(--ease); }
  .vf-timeline a:hover, .vf-timeline a:focus-visible { text-decoration-color: currentColor; }
  .vf-record-photo { margin: 0; }
  .vf-record-photo :global(img) { display: block; width: 100%; height: auto; }
  .vf-record-photo figcaption { margin: 10px 0 0; font-family: var(--mono); font-size: 12px; line-height: 1.5; color: var(--ink-muted); }

  /* ── 03 · Mission and people ───────────────────────────────────────────────────────────────── */
  .vf-motto { margin: 0; font-family: var(--serif); font-style: normal; font-weight: 400; font-size: clamp(34px, 4.6vw, 60px); line-height: 1.08; letter-spacing: -.01em; color: var(--ink); }
  .vf-motto-line { display: block; text-wrap: balance; }
  .vf-motto :global(em) { font-style: italic; }
  .vf-board { margin: clamp(40px, 5vw, 64px) 0 0; }
  .vf-board-list { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(28px, 3vw, 40px) clamp(20px, 2.4vw, 32px); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 640px) { .vf-board-list { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .vf-member { border-top: 1px solid var(--vf-rule); padding-top: 14px; }
  /* Black-and-white photographs at 4:5, head and shoulders; `cover` holds all three to one frame
     even if an original arrives a few pixels off the ratio. */
  .vf-portrait { margin: 0 0 14px; aspect-ratio: 4 / 5; max-width: 320px; overflow: hidden; }
  .vf-portrait :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .vf-member-name { margin: 0; font-family: var(--sans); font-weight: 600; font-size: 18px; line-height: 1.3; color: var(--ink); }
  .vf-member-function { margin: 4px 0 0; font-family: var(--mono); font-size: 12px; letter-spacing: .04em; color: var(--ink-muted); }
  .vf-member-domain { margin: 8px 0 0; font-family: var(--sans); font-size: 15px; line-height: 1.5; color: var(--ink-soft); }

  /* ── 04 · Support ──────────────────────────────────────────────────────────────────────────── */
  .vf-ways { margin: clamp(32px, 4vw, 48px) 0 0; display: grid; gap: clamp(36px, 4vw, 48px) clamp(20px, 2.4vw, 32px); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 1024px) { .vf-ways { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .vf-way { display: flex; flex-direction: column; border-top: 1px solid var(--vf-rule); padding-top: 14px; }
  .vf-way-label { margin: 0; font-family: var(--mono); font-size: 11px; font-weight: 500; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-muted); }
  .vf-quote { margin: 16px 0 0; font-family: var(--serif); font-style: italic; font-weight: 400; font-size: clamp(24px, 2.2vw, 30px); line-height: 1.2; color: var(--ink); text-wrap: balance; }
  .vf-way-body { margin: 16px 0 0; font-family: var(--sans); font-size: 15.5px; line-height: 1.6; color: var(--ink-soft); }
  .vf-way-note { margin: 12px 0 0; font-family: var(--sans); font-size: 14px; line-height: 1.55; color: var(--ink-muted); }
  .vf-way-acts { margin: 20px 0 0; display: flex; flex-wrap: wrap; align-items: center; gap: 12px 22px; }
  .vf-way-links { list-style: none; margin: 18px 0 0; padding: 0; display: grid; gap: 10px; }

  .vf-transfer { margin: clamp(48px, 6vw, 72px) 0 0; padding-top: 14px; border-top: 1px solid var(--ink); }
  .vf-transfer-rows { margin: 0; display: grid; }
  .vf-transfer-row { display: grid; grid-template-columns: minmax(0, 1fr); gap: 4px; padding: 12px 0; border-bottom: 1px solid var(--vf-rule); }
  @media (min-width: 720px) { .vf-transfer-row { grid-template-columns: minmax(12rem, 16rem) minmax(0, 1fr); gap: 24px; align-items: baseline; } }
  .vf-transfer-row dt { font-family: var(--sans); font-size: 14px; line-height: 1.4; color: var(--ink-soft); }
  .vf-currency { font-family: var(--mono); font-size: 11px; letter-spacing: .06em; color: var(--ink-muted); }
  .vf-transfer-row dd { margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; }
  .vf-transfer-value { font-family: var(--mono); font-size: clamp(15px, 1.3vw, 17px); letter-spacing: .03em; color: var(--ink); user-select: all; overflow-wrap: anywhere; font-variant-numeric: tabular-nums; }
  /* A second value on the same row (the EUR account's BIC), on its own line under the IBAN. */
  .vf-transfer-sub { flex-basis: 100%; display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 14px; }
  .vf-transfer-note { margin: 12px 0 0; max-width: 64ch; font-family: var(--sans); font-size: 14px; line-height: 1.55; color: var(--ink-soft); }
  .vf-transfer-note + .vf-transfer-note { margin-top: 6px; }

  /* The copy capsule — the site's one shape for "copy this", in this page's type. */
  .vf :global(.copy-btn) { display: inline-flex; align-items: center; min-height: 32px; font-family: var(--mono); font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-soft); background: transparent; border: 1px solid var(--vf-rule); border-radius: 2px; padding: 0 10px; cursor: pointer; transition: color .25s var(--ease), border-color .25s var(--ease); }
  .vf :global(.copy-btn:hover) { color: var(--ink); border-color: var(--ink); }
  .vf :global(.copy-btn.is-copied) { color: var(--ink); border-color: var(--ink); }

  /* The optional form, collapsed behind a line. The island's markup is React's and carries no
     scope attribute, so every inner selector is `:global()`. */
  .vf-join { margin: clamp(32px, 4vw, 48px) 0 0; border-top: 1px solid var(--vf-rule); border-bottom: 1px solid var(--vf-rule); }
  .vf-join summary { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 56px; cursor: pointer; list-style: none; font-family: var(--sans); font-weight: 500; font-size: 16px; color: var(--ink); }
  .vf-join summary::-webkit-details-marker { display: none; }
  .vf-join summary::after { content: "+"; font-family: var(--mono); font-size: 18px; color: var(--ink-muted); }
  .vf-join[open] summary::after { content: "−"; }
  .vf-join-body { padding: 4px 0 28px; }
  .vf-join-note { margin: 0 0 22px; max-width: 60ch; font-family: var(--sans); font-size: 14.5px; line-height: 1.6; color: var(--ink-soft); }
  .vf-join-note a { color: inherit; }
  .vf-join :global(.patron-form) { display: grid; gap: 22px; max-width: 640px; }
  .vf-join :global(.patron-fields) { display: grid; grid-template-columns: 1fr 1fr; gap: 18px 24px; }
  @media (max-width: 560px) { .vf-join :global(.patron-fields) { grid-template-columns: 1fr; } }
  .vf-join :global(.patron-field) { display: grid; gap: 6px; min-width: 0; }
  .vf-join :global(.patron-field-wide) { grid-column: 1 / -1; }
  .vf-join :global(.patron-label) { font-family: var(--mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-muted); }
  .vf-join :global(.patron-input) { display: block; width: 100%; padding: 6px 0; border: 0; border-bottom: 1px solid var(--line-strong); background: none; color: var(--ink); caret-color: var(--ink); font-family: var(--sans); font-size: 18px; line-height: 1.4; border-radius: 0; transition: border-color .25s var(--ease); }
  .vf-join :global(.patron-input:focus) { outline: none; border-bottom-color: var(--ink); }
  .vf-join :global(.patron-input[aria-invalid="true"]) { border-bottom-color: #9b4f38; }
  .vf-join :global(.patron-input:disabled) { opacity: .6; }
  .vf-join :global(.patron-consent) { display: grid; grid-template-columns: 18px minmax(0, 1fr); gap: 12px; align-items: start; cursor: pointer; }
  .vf-join :global(.patron-consent-input) { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .vf-join :global(.patron-consent-box) { display: block; width: 18px; height: 18px; margin-top: 2px; border: 1px solid var(--line-strong); background: transparent; transition: background-color .25s var(--ease), border-color .25s var(--ease); }
  .vf-join :global(.patron-consent-input:checked + .patron-consent-box) { background: var(--ink); border-color: var(--ink); }
  .vf-join :global(.patron-consent-input:focus-visible + .patron-consent-box) { outline: 2px solid var(--ink); outline-offset: 3px; }
  .vf-join :global(.patron-consent-input[aria-invalid="true"] + .patron-consent-box) { border-color: #9b4f38; }
  .vf-join :global(.patron-consent-text) { font-family: var(--sans); font-size: 13.5px; line-height: 1.6; color: var(--ink-soft); text-wrap: pretty; }
  .vf-join :global(.patron-consent-text a) { color: var(--ink); text-decoration: underline; text-underline-offset: .2em; }
  .vf-join :global(.patron-error) { margin: -6px 0 0; color: #9b4f38; font-family: var(--sans); font-size: 13.5px; line-height: 1.5; }
  .vf-join :global(.patron-error a) { color: inherit; text-decoration: underline; }
  .vf-join :global(.patron-submit) { justify-self: start; display: inline-flex; align-items: center; min-height: 48px; padding: 0 24px; border: 1px solid var(--ink); border-radius: 2px; background: transparent; color: var(--ink); cursor: pointer; font-family: var(--sans); font-weight: 500; font-size: 15px; transition: color .25s var(--ease), background-color .25s var(--ease), opacity .25s var(--ease); }
