---
/**
 * @file ExcerptsGlyph.astro
 * @description One concert's excerpts glyph: the island (`ExcerptsPlayer`) alone. Without
 *  JavaScript nothing stands in for it (styles/excerpts.css hides the inert button), because the
 *  only stand-in would be a link to the file, and the recordings are not offered for download
 *  (lib/audio). The props come from `lib/excerpts` `concertExcerpts`, so a page prints this only
 *  when that returned a reel. Where it stands, what wraps it and how it is dressed are the page's:
 *  the page imports `styles/excerpts.css` itself, so the sheet keeps its place in that page's
 *  cascade.
 * @module components/ExcerptsGlyph
 */
import type { Locale } from "../i18n/config";
import type { ConcertChrome } from "../i18n/content/koncert";
import { ExcerptsPlayer } from "../islands/landing/excerpts/ExcerptsPlayer";
import type { ConcertExcerpts } from "../lib/excerpts";

interface Props {
  excerpts: ConcertExcerpts;
  labels: ConcertChrome["excerpts"];
  lang: Locale;
  /** The concert's candle colour, for the bar the island portals out of the page. */
  candle: string;
  /** The concert's title, as the system's media controls name the reel. */
  title: string;
}

const { excerpts, labels, lang, candle, title } = Astro.props;
---

<ExcerptsPlayer
  client:load
  src={excerpts.src}
  duration={excerpts.duration}
  chapters={excerpts.chapters}
  labels={labels}
  lang={lang}
  candle={candle}
  title={title}
  artwork={excerpts.artwork}
/>
