---
/**
 * @file RealisationModule.astro
 * @description One realisation of the foundation, as /fundacja and /mecenat print it: the rubric,
 *  the concert's title and a lead, the project's key visual, and a fact sheet — when, where, who,
 *  what, within what, admission, budget. /fundacja adds what the budget covers, who pays for it and
 *  a way to support the concert; /mecenat says those things in its own prose and asks for the
 *  sheet alone. The account, once entered, prints on both.
 *
 *  THE ONE COLOUR FIELD. The foundation's pages are monochrome; a realisation is where a project's
 *  own identity enters — its accent from the corpus tints the ground, its poster art bleeds to the
 *  right edge of the viewport. Each project keeps its own look inside the foundation's neutral
 *  frame, which is the rule the ensemble's pages follow for each evening.
 *
 *  THE SHEET SAYS WHAT A SENTENCE WOULD HAVE TO. "Wstęp: wolny" and the budget sit in neighbouring
 *  cells at the same size, so the page never states the juxtaposition. Both pages share one host
 *  ground (the site's paper and its three families), which is why one skin serves both.
 *
 *  Static by contract: every part reads complete with scripts and motion off. The visual's entrance
 *  and the rules' drawing are the page's motion stage, not this component's.
 * @architecture Astro islands 2026
 * @module components/foundation/RealisationModule
 */
import { Picture } from "astro:assets";

import type { FoundationCopy } from "../../i18n/content/fundacja";
import type { RealisationView } from "../../lib/realisations";

interface Props {
  view: RealisationView;
  /** The line above the title — "Realizacje / 01 · 2026" on /fundacja, "W realizacji" on /mecenat. */
  rubric: string;
  lead: string;
  /** /fundacja's realisation copy — the sheet's labels and notes, shared by both pages. */
  labels: FoundationCopy["realisation"];
  /** Print what the budget covers, who pays, and the vault link. /fundacja only. */
  withNotes: boolean;
  /** The no-JS road to the vault in this locale; the click opens it in place. */
  donateHref: string;
}

const { view, rubric, lead, labels, withNotes, donateHref } = Astro.props;

const fill = (template: string, slots: Record<string, string>): string =>
  template.replace(/\{(\w+)\}/g, (match, name: string) => slots[name] ?? match);

const admission =
  view.admission === "free" ? labels.admissionFree : view.admission === "paid" ? labels.admissionPaid : undefined;
const whoPays = view.ahead ? labels.whoPaysAhead : view.account ? undefined : labels.whoPaysPast;
const accountLabel: Record<string, string> = {
  total: labels.account.total,
  patrons: labels.account.patrons,
  donors: labels.account.donors,
  partners: labels.account.partners,
  grants: labels.account.grants,
  own: labels.account.own,
};
const titleId = `realizacja-${view.id}`;
---

<article class="rm" style={`--rm-accent: ${view.accent}`} aria-labelledby={titleId}>
  <header class="rm-head">
    <p class="rm-rubric">{rubric}</p>
    <h2 class="rm-title" id={titleId}>{view.title}</h2>
    <p class="rm-lead">{lead}</p>
  </header>

  {view.visual && (
    <figure class="rm-visual">
      {/* The poster art, whole. Decorative beside a title that already names the concert.
          `width` = top of the ladder (lib/photos.ts). */}
      <Picture
        src={view.visual.desktop}
        formats={["avif", "webp"]}
        widths={[640, 960, 1280, 1920, 2560]}
        width={Math.min(view.visual.desktop.width, 2560)}
        sizes="(min-width: 1024px) 78vw, 100vw"
        alt=""
        loading="lazy"
        decoding="async"
      />
    </figure>
  )}

  <dl class="rm-sheet">
    <div class="rm-cell">
      <dt>{labels.sheet.when}</dt>
      <dd><time datetime={view.dateIso}>{view.when}</time></dd>
    </div>
    <div class="rm-cell">
      <dt>{labels.sheet.where}</dt>
      <dd>{view.where}</dd>
    </div>
    <div class="rm-cell rm-cell-wide">
      <dt>{labels.sheet.performers}</dt>
      <dd>
        <ul class="rm-lines">
          {view.performers.map((p) => <li>{p}</li>)}
        </ul>
      </dd>
    </div>
    <div class="rm-cell rm-cell-wide">
      <dt>{labels.sheet.programme}</dt>
      <dd>{view.programme}</dd>
    </div>
    {view.festival && (
      <div class="rm-cell rm-cell-wide">
        <dt>{labels.sheet.within}</dt>
        <dd><a href={view.festival.url} rel="noopener">{fill(labels.festival, { name: view.festival.name })}</a></dd>
      </div>
    )}
    {admission && (
      <div class="rm-cell rm-cell-figure">
        <dt>{labels.sheet.admission}</dt>
        <dd><span class="rm-figure">{admission}</span></dd>
      </div>
    )}
    <div class="rm-cell rm-cell-figure">
      <dt>{labels.sheet.budget}</dt>
      <dd>
        <span class="rm-figure">{fill(labels.budgetAmount, { amount: view.budget.amount })}</span>
        <span class="rm-asof">{fill(labels.budgetAsOf, { date: view.budget.asOf })}</span>
      </dd>
    </div>
  </dl>

  {withNotes && (
    <div class="rm-notes">
      <p>{labels.budgetNote}</p>
      {whoPays && <p>{whoPays}</p>}
    </div>
  )}

  {view.account && (
    <section class="rm-account" aria-labelledby={`${titleId}-rozliczenie`}>
      <h3 class="rm-account-head" id={`${titleId}-rozliczenie`}>{labels.account.heading}</h3>
      <dl class="rm-account-rows">
        {view.account.rows.map((row) => (
          <div class={row.key === "total" ? "rm-account-row rm-account-total" : "rm-account-row"}>
            <dt>{accountLabel[row.key]}</dt>
            <dd>{row.amount} zł</dd>
          </div>
        ))}
      </dl>
      <p class="rm-account-note">{fill(labels.account.note, { date: view.account.asOf })}</p>
    </section>
  )}

  {(view.href || (withNotes && view.ahead)) && (
    <p class="rm-links">
      {view.href && <a class="rm-link" href={view.href}>{labels.concertLink}</a>}
      {withNotes && view.ahead && (
        <a class="rm-link rm-link-act" href={donateHref} data-vault-open="100">{labels.supportLink}</a>
      )}
    </p>
  )}
</article>

<style>
  /* The module owns its ground: the project's accent, a tenth of it over the paper. Text stays in
     ink — the accent is the ground, the rules and the rubric's numeral, never body copy, so the
     contrast is the paper's whatever colour a project brings. */
  .rm {
    --rm-ground: color-mix(in oklab, var(--rm-accent) 11%, var(--paper));
    --rm-rule: color-mix(in oklab, var(--rm-accent) 55%, var(--ink));
    position: relative;
    background: var(--rm-ground);
    border-top: 2px solid var(--rm-accent);
    padding: clamp(24px, 3vw, 40px) clamp(20px, 3vw, 40px) clamp(28px, 3.4vw, 44px);
  }
  .rm + :global(.rm) { margin-top: clamp(40px, 5vw, 64px); }
  .rm-rubric { margin: 0; font-family: var(--mono); font-size: 12px; font-weight: 500; letter-spacing: .06em; line-height: 1.4; color: var(--ink-soft); font-variant-numeric: tabular-nums; }
  .rm-title { margin: 14px 0 0; font-family: var(--sans); font-weight: 600; font-size: clamp(32px, 4.6vw, 60px); line-height: 1.02; letter-spacing: -.035em; color: var(--ink); text-wrap: balance; }
  .rm-lead { margin: 18px 0 0; max-width: 60ch; font-family: var(--sans); font-size: clamp(16px, 1.3vw, 18px); line-height: 1.6; color: var(--ink-soft); }

  /* The visual leaves the module on the right and runs to the viewport's edge (`--vf-bleed`,
     set by the page); on a phone it takes the whole width. */
  .rm-visual { margin: clamp(28px, 3.4vw, 44px) calc(-1 * clamp(20px, 3vw, 40px)) 0; overflow: hidden; background: var(--rm-accent); }
  .rm-visual :global(img) { display: block; width: 100%; height: auto; }
  @media (max-width: 1023.98px) {
    .rm { margin-inline: calc(-1 * var(--gutter)); }
    .rm-visual { margin-inline: calc(-1 * clamp(20px, 3vw, 40px)); }
  }
  @media (min-width: 1024px) {
    .rm-visual { margin-inline-end: calc(-1 * clamp(20px, 3vw, 40px) - var(--vf-bleed, 0px)); }
  }

  /* The sheet — cells under hairlines, label in mono, value in Plex. Four columns on a desktop,
     two on a phone; admission and budget close it side by side as figures. */
  .rm-sheet { margin: clamp(28px, 3.4vw, 44px) 0 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 clamp(16px, 2.4vw, 32px); }
  .rm-cell { padding: 14px 0 16px; border-top: 1px solid color-mix(in oklab, var(--rm-rule) 40%, transparent); min-width: 0; }
  .rm-cell-wide { grid-column: 1 / -1; }
  .rm-cell dt { font-family: var(--mono); font-size: 11px; font-weight: 500; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-muted); }
  .rm-cell dd { margin: 6px 0 0; font-family: var(--sans); font-size: 16px; line-height: 1.5; color: var(--ink); overflow-wrap: anywhere; }
  .rm-cell a { color: inherit; text-decoration: underline; text-decoration-color: color-mix(in oklab, var(--ink) 30%, transparent); text-underline-offset: .2em; text-decoration-thickness: 1px; transition: text-decoration-color .25s var(--ease); }
  .rm-cell a:hover { text-decoration-color: currentColor; }
  .rm-lines { list-style: none; margin: 0; padding: 0; }
  .rm-figure { display: block; font-family: var(--sans); font-weight: 300; font-size: clamp(28px, 3.6vw, 44px); line-height: 1.1; letter-spacing: -.02em; color: var(--ink); font-variant-numeric: lining-nums; }
  .rm-asof { display: block; margin-top: 6px; font-family: var(--mono); font-size: 12px; letter-spacing: .02em; color: var(--ink-muted); }
  @media (min-width: 720px) {
    .rm-sheet { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .rm-cell-wide { grid-column: span 2; }
    .rm-cell-figure { grid-column: span 2; }
  }

  .rm-notes { margin: clamp(20px, 2.4vw, 28px) 0 0; max-width: 64ch; }
  .rm-notes p { margin: 0; font-family: var(--sans); font-size: 15px; line-height: 1.65; color: var(--ink-soft); }
  .rm-notes p + p { margin-top: 10px; }

  .rm-account { margin: clamp(24px, 3vw, 36px) 0 0; padding-top: 16px; border-top: 1px solid var(--rm-rule); max-width: 34rem; }
  .rm-account-head { margin: 0 0 10px; font-family: var(--mono); font-size: 11px; font-weight: 500; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-muted); }
  .rm-account-rows { margin: 0; }
  .rm-account-row { display: flex; justify-content: space-between; gap: 16px; padding: 6px 0; border-bottom: 1px solid color-mix(in oklab, var(--rm-rule) 25%, transparent); font-family: var(--sans); font-size: 15px; line-height: 1.5; }
  .rm-account-row dt { color: var(--ink-soft); }
  .rm-account-row dd { margin: 0; font-family: var(--mono); font-variant-numeric: tabular-nums; color: var(--ink); white-space: nowrap; }
  .rm-account-total { font-weight: 600; }
  .rm-account-note { margin: 10px 0 0; font-family: var(--mono); font-size: 12px; color: var(--ink-muted); }

  .rm-links { margin: clamp(22px, 2.6vw, 30px) 0 0; display: flex; flex-wrap: wrap; align-items: center; gap: 12px 28px; }
  .rm-link { display: inline-flex; align-items: center; min-height: 44px; font-family: var(--sans); font-weight: 500; font-size: 16px; color: var(--ink); text-decoration: underline; text-decoration-color: color-mix(in oklab, var(--ink) 30%, transparent); text-underline-offset: .22em; text-decoration-thickness: 1px; transition: text-decoration-color .25s var(--ease); }
  .rm-link:hover, .rm-link:focus-visible { text-decoration-color: currentColor; }
  .rm-link-act { padding: 0 22px; border: 1px solid var(--ink); border-radius: 2px; text-decoration: none; transition: background-color .25s var(--ease), color .25s var(--ease); }
  .rm-link-act:hover, .rm-link-act:focus-visible { background: var(--ink); color: var(--paper); }
  .rm a:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
</style>
