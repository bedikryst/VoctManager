---
/**
 * @file ProximumSection.astro
 * @description The one evening that has not happened yet, announced between the Imagines band and
 *  the register — the page's only entry in the future tense, standing directly above "Co już
 *  zabrzmiało." It is DORMANT by construction: with no future-dated station in the corpus it
 *  renders nothing at all, which is the state this site was in for its whole life until 2026.
 *
 *  WHY IT IS A SEPARATE OBJECT AND NOT A SIXTH ROW OF THE REGISTER. The register's claim is that it
 *  is typographic — evenings set as type, in order, with nothing sold — and a row carrying a poster
 *  turns it into a catalogue listing (docs/web-landing-guardrails §1, which allows exactly this:
 *  a separate object standing BEFORE the register). The announcement is also not of the same kind
 *  as the rows: they are memories and it is an invitation, and it is the invitation that may carry
 *  the practical facts a reader acts on — the hour, the door, where.
 *
 *  IT NAMES THE EVENING ONCE. The title, the place, the invitation and the poster all come from
 *  `concerts.yaml` through the copy overlay, exactly as /koncerty and the concert pages read them;
 *  the moment is formatted from the ISO `date` (lib/dates) and the open door is read off
 *  `admission`. This band's own words are two lines in `landing.yaml`, and neither may name a
 *  programme, a venue or a date — the band is dormant most of the year and lights up on whichever
 *  evening is next.
 *
 *  IT CARRIES ONE MARK, NOT A ROW OF THEM. The `facts` chips belong to the station on /koncerty,
 *  where a reader is already walking the cycle and wants the evening's particulars; repeated here
 *  they turned an invitation into a catalogue entry (the guardrail cited above) and restated, in
 *  three tracked capitals, sentences the paragraph beside them had already said. The open door is
 *  the exception and content.config states why: whether a reader can simply walk in is the first
 *  thing they need, and it is structured data rather than a hand-translated chip.
 *
 *  IT IS THE ONLY REASON THE LANDING CARRIES THE PHOTOGRAPH FRAME. The poster opens in the shared
 *  ImageLightbox, and LandingPage mounts that island, `scripts/image-triggers.ts` and
 *  `styles/image-lightbox.css` for this band alone — the Imagines panels above it are doors to
 *  their evening and trigger nothing. If the band is ever removed, those three go with it.
 *
 *  IT GOES DOWN BY DEPLOY. `upcomingStation` is resolved at build, so the band outlives its own
 *  concert until the next build — the same trade `lib/eventSchema` documents for `eventStatus`,
 *  and the reason a deploy belongs in the week after a concert.
 * @architecture Astro islands 2026
 * @module components/landing/ProximumSection
 */
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import { photoOptional } from "../../lib/photos";
import { framedShot } from "../../lib/galleryFrame";
import { designCredit } from "../../lib/photoCredit";
import { longDate } from "../../lib/dates";
import { upcomingStation } from "../../lib/cycle";
import { concertKey, withOverlay } from "../../lib/copyOverlay";
import { localizePath, type Locale } from "../../i18n/config";
import type { LandingChrome, LandingCopy } from "../../i18n/content/landing";
import { NUNTIUS } from "../../i18n/content/nuntius";

interface Props {
  copy: LandingCopy["proximum"];
  chrome: LandingChrome;
  lang: Locale;
}
const { copy, chrome, lang } = Astro.props;

const upcoming = upcomingStation(await getCollection("concerts"));
const hrefConcerts = localizePath("/koncerty", lang);
// The band that takes the consent, on the page that says why there is one — the same door the
// hero's dateline, the open card and /kontakt already point at.
const hrefNotice = `${hrefConcerts}#nuntius`;
const invitation = NUNTIUS[lang].invitation;

/** This evening's words, in this locale: the overlay's translation where one exists, the corpus's
    Polish otherwise. Never `pickLocale` — the corpus is Polish-only (spec §7). */
const say = (field: string, polish: string): string =>
  upcoming ? withOverlay(concertKey(upcoming.id, field), lang, polish) : polish;

// `photoOptional`, so a poster named in the corpus before the file lands leaves the band standing
// as type rather than failing the landing's build.
const posterImg = upcoming?.data.poster ? photoOptional(upcoming.data.poster) : undefined;
/** The poster's full-size renditions for the frame it opens in. The same pair the two galleries
    publish (lib/galleryFrame), so the 1200 step is one emitted file across the whole site.

    `framedShot` never upscales, so how legible the opened poster is, is decided by the DELIVERED
    artwork and by nothing on this page: ask the designer for an export at least 2000px wide, or
    the frame will open at whatever the print file happened to be flattened to. */
const posterFrame = posterImg ? await framedShot(posterImg) : undefined;

const announced = upcoming
  ? {
      // An evening with no page of its own is still a PLACE on /koncerty: the station carries the
      // anchor, so this door lands on the announcement rather than at the head of the walk.
      href: upcoming.data.hasPage
        ? `${hrefConcerts}/${upcoming.id}`
        : `${hrefConcerts}#${upcoming.id}`,
      title: say("title", upcoming.data.title),
      // The landing's own paragraph where the desk has written one, the station's programme note
      // otherwise. The branch chooses the overlay KEY as well as the Polish: asking for
      // `invitation` on an evening that has none would miss, and a French reader would then get
      // the corpus's Polish essence instead of the French one sitting in the overlay.
      invitation: upcoming.data.invitation
        ? say("invitation", upcoming.data.invitation)
        : say("essence", upcoming.data.essence),
      place: say("metaPlace", upcoming.data.metaPlace.pl),
      // The date is data and the hour is data; neither is ever typed into copy (spec §5).
      moment: [upcoming.data.date && longDate(upcoming.data.date, lang), upcoming.data.time]
        .filter(Boolean)
        .join(" · "),
      free: upcoming.data.admission === "free",
      poster: posterImg,
      posterAlt: upcoming.data.posterAlt ? say("posterAlt", upcoming.data.posterAlt) : "",
      // Never through the overlay: the label is translated, the hands are names (glossary §1).
      posterCredit: upcoming.data.posterCredit
        ? designCredit(upcoming.data.posterCredit, lang)
        : undefined,
    }
  : undefined;
---

{
  announced && (
    <section class="section proximum" id="najblizej" aria-label={chrome.proximumAria}>
      <div class="section-grid">
        <div class="section-label micro titulus">
          <span>
            <span class="lat" lang="la">
              Proximum
            </span>
          </span>
        </div>
        <div class="proximum-body">
          <p class="proximum-rubric reveal">
            <span class="proximum-dot" aria-hidden="true" />
            {copy.label}
          </p>
          {/* The poster is the evening's own object and the only image it has — held at the
              register's rail width so the band sits in the page's grid rather than beside it.

              IT OPENS RATHER THAN LEADING AWAY, and that is the correction: at the rail's 300px a
              poster carrying a festival, ten works and an address is an ILLUSTRATION of an
              announcement the reader cannot actually read, and a second door to a page the title
              and the two actions beside it already open three times over. The frame is not a dead
              end — it carries this evening's own exit (`href` / `hrefLabel`), so the door survives
              one press deeper — and it is the one surface on which the poster's hands can be named
              without the band growing a colophon.

              A <button>, and the `aria-hidden` / `tabindex="-1"` it used to carry are gone with the
              anchor: those said "this is the title's link twice over, skip it", which was true of a
              duplicate door and is false of a control that opens something nothing else on this
              page opens. Its accessible name is the poster's own alt, exactly as the gallery
              triggers on /obrazy are named. */}
          <div class="proximum-card">
            {announced.poster && posterFrame && (
              <button
                type="button"
                class="proximum-poster shot-open"
                data-image-open
                data-image-src={posterFrame.src}
                data-image-srcset={posterFrame.srcset}
                data-image-sizes={posterFrame.sizes}
                data-image-alt={announced.posterAlt}
                data-image-caption={[announced.moment, announced.place]
                  .filter(Boolean)
                  .join(" · ")}
                data-image-credit={announced.posterCredit}
                data-image-w={String(posterFrame.width)}
                data-image-h={String(posterFrame.height)}
                data-image-href={announced.href}
                data-image-href-label={announced.title}
              >
                <span class="frame" />
                <Picture
                  src={announced.poster}
                  formats={["avif", "webp"]}
                  widths={[280, 420, 560]}
                  width={560}
                  sizes="(max-width: 820px) 60vw, 300px"
                  alt={announced.posterAlt}
                  loading="lazy"
                  decoding="async"
                />
              </button>
            )}
            <div class="proximum-text">
              <h2 class="proximum-title reveal ink-press">
                <a class="proximum-link plausible-event-name=proximum+concert" href={announced.href}>
                  {announced.title}
                </a>
              </h2>
              <p class="proximum-lede reveal">{copy.lede}</p>
              <p class="proximum-when reveal">
                {announced.moment}
                {announced.moment && announced.place ? " · " : ""}
                {announced.place}
              </p>
              <p class="proximum-invitation reveal">{announced.invitation}</p>
              {announced.free && <p class="proximum-door reveal">{chrome.proximumFree}</p>}
              <div class="proximum-actions">
                <a class="proximum-cta plausible-event-name=proximum+program" href={announced.href}>
                  {chrome.proximumCta}
                </a>
                <a class="proximum-notice plausible-event-name=proximum+nuntius" href={hrefNotice}>
                  {invitation.cta}
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
