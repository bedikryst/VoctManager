---
/**
 * @file PathSection.astro
 * @description "Co już zabrzmiało" — typographic register of past Concerts Spirituels.
 *  Read as a memorium on an altar, not as a portfolio grid: roman numeral + year + tag in the
 *  left rail, title + place + lead in the right rail, and one uniform expandable "Program
 *  koncertu" (works in order, derived from the concerts collection) + optional credit below.
 *  Hairline rules separate entries. No poster images — the rite doesn't market itself by face.
 *  Each entry's native <details> snap open/close is upgraded to an animated, exclusive
 *  accordion by scripts/landing.ts (same `.path-card-detail` hook so the JS contract holds).
 *
 *  THREE SOURCES MEET IN ONE ROW, and the split is the point. `data/landing/paths` carries the
 *  structure (the numbering, the year, the video files); `landing.yaml` carries this register's
 *  own editorial layer (tag, place line, lead, credit) through the copy desk; and the TITLE and
 *  the programme come from `concerts.yaml` through the concert overlay, because an evening names
 *  itself once and every surface reads that name. The section's accessible name is the heading it
 *  already prints.
 *
 *  THE NOTICE LIST IS THE REGISTER'S LINIATURA — the ruled lines under the announced evening, the
 *  first of them written by the reader (`.path-liniatura`). It is the landing's one FIELD for the
 *  list (the announcement's quiet link, `ProximumSection`, leads to /newsletter): under the
 *  evenings rather than among them, on the section's full width rather than in the register's
 *  column, and not an object laid beside them.
 * @architecture Astro islands 2026
 * @module components/landing/PathSection
 */
import { getCollection } from "astro:content";
import { PATHS, ROMAN } from "../../data/landing/paths";
import { upcomingStation } from "../../lib/cycle";
import { longMoment } from "../../lib/dates";
import { concertKey, overlayValue } from "../../lib/copyOverlay";
import { localizePath, type Locale } from "../../i18n/config";
import type { LandingChrome, LandingCopy } from "../../i18n/content/landing";
import { NUNTIUS } from "../../i18n/content/nuntius";
import NoticeSignup from "../NoticeSignup.astro";

interface Props {
  copy: LandingCopy["register"];
  chrome: LandingChrome;
  /** The word the hero's dateline uses for the evening that is ahead, handed down rather than
      restated: this register closes on the same claim and one claim has one wording. It lives in
      the hero's copy slot because that is where it is first said, not because it is the hero's. */
  announceLabel: string;
  lang: Locale;
}
const { copy, chrome, announceLabel, lang } = Astro.props;

// SSoT: program lists live in the `concerts` collection (src/content/concerts.yaml) —
// the same source the /koncerty stations and concert pages read. The register derives
// each card's repertoire from it by concert id, so there is no second copy to drift.
const concerts = await getCollection("concerts");
const byId = new Map(concerts.map((c) => [c.id, c.data] as const));
/** The evening that is announced, if one is — which decides which of the register's two closings
    stands. Read from the corpus, not from this register's own list: the register holds what has
    SOUNDED and an announced evening is by definition not in it, so the list can never see the
    collision on its own. */
const upcoming = upcomingStation(concerts);
const announced = upcoming !== undefined;
const hrefConcerts = localizePath("/koncerty", lang);
const nuntius = NUNTIUS[lang];

// One row per evening, with its three sources joined. A structural entry whose editorial copy has
// been removed is loud rather than blank: the row would otherwise print a numeral, a year and
// nothing else, and nothing in the build would say why.
const entries = PATHS.map((path, i) => {
  const words = copy.entries.find((entry) => entry.id === path.concertId);
  if (!words) throw new Error(`[path] no register copy for the evening "${path.concertId}".`);
  return {
    ...path,
    ...words,
    roman: ROMAN[i],
    title:
      overlayValue(concertKey(path.concertId, "title"), lang) ??
      byId.get(path.concertId)?.title ??
      "",
    program: byId.get(path.concertId)?.program ?? [],
  };
});

/** The register's closing when an evening IS announced — the counterpart of the open card below,
    and the reason this is not simply "the card stands down". The card carried the gold hairline
    that CLOSES the register, so removing it removed the closing line with it: the section ended
    on the last memory and then on nothing at all. What belongs in that slot is the one thing the
    register cannot hold — an evening that has not sounded — said the way the hero says it, and
    not as a sixth row.

    NO NUMERAL AND NO POSTER, and only those two. The numeral because `PATHS` counts what has
    SOUNDED and this has not, so a number here would collide with the open card's (guardrails,
    "the open card is an understudy"); the poster because guardrail §1 is precisely the question
    "does a row of the register now carry a face?" — a thumbnail beside a row turns the register
    into a catalogue listing. The PROGRAMME is neither of those and it used to be refused here
    citing the same §1, which that section does not say: a folded list of works carries no face,
    and it is the disclosure every entry above already offers. Encores are filtered off it
    (`bis`, below) — the one thing an evening that has not happened cannot print. */
const ahead = upcoming
  ? {
      // An evening with no page of its own is still a PLACE on /koncerty: the station carries the
      // anchor, so the door lands on the announcement rather than at the head of the walk.
      href: upcoming.data.hasPage
        ? `${hrefConcerts}/${upcoming.id}`
        : `${hrefConcerts}#${upcoming.id}`,
      title: overlayValue(concertKey(upcoming.id, "title"), lang) ?? upcoming.data.title,
      // The date is data and the hour is data; neither is ever typed into copy (spec §5).
      moment: [longMoment(upcoming.data, lang), upcoming.data.time].filter(Boolean).join(" · "),
      /** THE PLACE IS WHAT MADE THIS ROW AN ORPHAN. Every entry in the register states where it
          sounded; this one stated only a name and a month, so it sat among peers missing the one
          line they all carry. It is four screens from the band that announces this evening in
          full, which is far enough that a reader arriving here has no memory of the address — the
          same reading `ProximumSection` records for the open door standing twice. */
      place: overlayValue(concertKey(upcoming.id, "metaPlace"), lang) ?? upcoming.data.metaPlace.pl,
      free: upcoming.data.admission === "free",
      /** NO ENCORES ON AN EVENING THAT HAS NOT HAPPENED. `/koncerty` filters `bis` off the
          upcoming station for the same reason: a bis is what was given beyond the programme, so
          printing one in advance either spoils it or promises it. The filter also keeps the
          numbering honest — the entries above mark a bis with an em-dash instead of a number, and
          with none present every line here simply counts. */
      program: (upcoming.data.program ?? []).filter((p) => !p.bis),
    }
  : undefined;
---

<section class="section path" id="droga" aria-label={copy.title}>
  <div class="section-grid">
    <div class="section-label micro titulus"><span>{copy.label}</span></div>
    <div class="path-body">
      {/* No hard break: three short words split by <br> leave a lopsided two-word
          first line. Let the title set on one line and wrap only if it must. */}
      <h2 class="section-title reveal ink-press">{copy.title}</h2>
      <p class="path-lede reveal">{copy.lede}</p>

      {/* Every entry rules its own opening hairline as it arrives — including the register's
          first line, which is the first entry's own top rule (the <ol> carries no border and
          so is not a register node). This register is the pattern the site-wide LEAD register
          was generalised from; it now goes through that shared mechanism (`.reveal-rule` +
          its pseudo-rule, landing/06-footer.css).

          An entry carries LEAD only — that opening rule. The INK is on its parts, because an
          entry is ~380px tall and one `.reveal` on the whole card means one trigger at the
          card's TOP: the title was watched being written while the summary 200px below it had
          finished before the reader's eye ever got there. Each part now crosses the trigger on
          its own, so the entry is written down the page the way it is read. The controls below
          stay out of the register — a control that is half-ink is a control you are not sure
          you are allowed to press yet. */}
      <ol class="path-register" aria-label={chrome.registerListAria}>
        {
          entries.map((entry) => (
            <li class="path-entry reveal-rule">
              <div class="path-entry-rail reveal">
                <span class="path-entry-roman">{entry.roman}</span>
                <span class="path-entry-year">{entry.year}</span>
                <span class="path-entry-tag">{entry.tag}</span>
              </div>
              <div class="path-entry-body" data-cursor="no-snap">
                {/* The anchor sits INSIDE the heading rather than replacing it: `.path-entry-title`
                    owns the ink register and a hand-merged hover transition (04-rooms-interludes),
                    and moving that contract onto an <a> would rebuild it for no gain. The card's
                    existing gold illumination already reads as "this entry is live" — the link
                    only has to name where it goes, which the hairline does on its own hover. */}
                <h3 class="path-entry-title reveal">
                  <a class="path-entry-link" href={`${hrefConcerts}/${entry.concertId}`}
                  >{entry.title}</a>
                </h3>
                <p class="path-entry-place reveal">{entry.place}</p>
                <p class="path-entry-summary reveal">{entry.note}</p>
                {entry.video && (
                  <button
                    type="button"
                    class="path-entry-video"
                    data-video-open
                    data-video-src={entry.video.src}
                    data-video-src-av1={entry.video.srcAv1}
                    data-video-caption={`${entry.title} · ${entry.year}`}
                    data-video-portrait={entry.video.portrait ? "true" : undefined}
                    data-video-note={entry.videoNote}
                  >
                    <span class="path-entry-video-glyph" aria-hidden="true">▸</span>
                    {copy.videoLabel}
                  </button>
                )}
                <details class="path-card-detail path-entry-detail">
                  <summary>
                    <span>{copy.programLabel}</span>
                    <span class="path-detail-icon" aria-hidden="true" />
                  </summary>
                  {entry.program.length > 0 && (
                    <ol class="path-works">
                      {entry.program.map((p, i) => (
                        <li class:list={[{ "path-works-bis": p.bis }]} style={`--i:${i}`}>
                          <span class="path-works-n" aria-hidden="true">{p.bis ? "—" : String(i + 1).padStart(2, "0")}</span>
                          {/* The work is MARKUP — a line may italicise a foreign title inside a
                              vernacular phrase (content.config) — and the whole line is italic
                              here, so the emphasis is silent on this surface and shows on the
                              compact list. */}
                          {p.composer} · <em><Fragment set:html={p.work} />{p.year ? ` · ${p.year}` : ""}</em>
                        </li>
                      ))}
                    </ol>
                  )}
                  {entry.credit && <p class="path-works-note">{entry.credit}</p>}
                </details>
              </div>
            </li>
          ))
        }
      </ol>

      {/* The register's open card — the narrative payoff of the whole section:
          manifest → memory of past concerts → the next one depends on you. The numeral
          continues the sequence, and the card states the two real preconditions for the
          cycle's next evening: a host who invites the ensemble, and the fees for the
          singers. The ensemble does not book venues on its own, so promising a date here
          would be false.

          AND IT STANDS DOWN THE MOMENT AN EVENING IS ANNOUNCED, which is not a refinement but the
          repair of a contradiction the card cannot see from inside its own list. Its numeral is
          `ROMAN[PATHS.length]` — the next after the ones that have SOUNDED — and an announced
          evening has not sounded, so the two claim the SAME numeral in the same year: the page
          carried "VI · MMXXVI · czeka na zaproszenie · Wieczór bez daty" two sections under a
          Proximum band announcing evening VI of MMXXVI with a date, a place and a poster. The
          card was the understudy for an announcement this page had no way to make; ProximumSection
          took that job, and an understudy who stays on stage denies the performance.

          Nothing is lost while it is down. Its gold CTA is the vault at 100, and the offering band
          (`Sustinete nos` → FinalSupportSection) is the very next section; the list is asked for
          in the liniatura that follows either closing. When the evening passes, `upcomingStation`
          goes quiet on the next deploy and the card takes its seat again — which is also what
          makes the deploy after a concert an obligation rather than housekeeping (lib/cycle). */}
      {!announced && (
      <aside class="path-entry path-next reveal-rule" aria-label={chrome.nextAria}>
        <div class="path-entry-rail reveal">
          <span class="path-entry-roman">{ROMAN[PATHS.length]}</span>
          <span class="path-entry-year">MMXXVI</span>
          <span class="path-entry-tag">{copy.next.tag}</span>
        </div>
        <div class="path-entry-body">
          <h3 class="path-entry-title reveal">{copy.next.title}</h3>
          <p class="path-entry-place reveal">{copy.next.place}</p>
          <p class="path-entry-summary reveal">{copy.next.summary}</p>
          <a
            class="primary-link path-next-cta"
            href="#wesprzyj"
            data-no-lenis
            data-vault-open="100"
          >
            {copy.next.cta}
          </a>
          {/* ONE ASK ON THE CARD. The list is not offered here as a second link under the gold
              CTA: the liniatura below the card asks for the address in full, and a sentence
              pointing at it from inside the card would be the same ask twice within one screen. */}
        </div>
      </aside>
      )}

      {/* And this is what stands in that slot instead.

          NO RAIL, and its absence is the composition. Every entry above is indented past a rail
          holding its numeral; this evening has none, because a register of what has sounded cannot
          number what has not. An empty rail left a hole where a numeral goes and indented the
          announcement anyway, so the row read as an entry that had lost its number. Taking the full
          measure instead makes the break in axis say what the copy says: this one is not of the
          register, and it is the only thing on the page still in the future tense. */}
      {ahead && (
        <aside class="path-entry path-ahead reveal-rule" aria-label={chrome.nextAria}>
          {/* The ink is on the LINE, never on the anchor — the same split every entry above makes
              (`.path-entry-title.reveal` holding `.path-entry-link`). The register's reveal writes
              `transition: opacity` at a specificity the element cannot clear, so a control that
              wears it loses its own hover transition. */}
          {/* The name takes the left edge, the facts the right, and the two rules this row already
              has — the entry hairline above, the candle rule below — are what hold them together.
              That is the same shape the hero's foot uses and it is earned here for the reason it is
              earned there: a composition may put two groups on two edges when something is drawn
              across between them. It is also what the full measure is FOR. */}
          <div class="path-ahead-line reveal">
            <a class="path-ahead-link" href={ahead.href}>
              {/* Tag, then title — the shape every entry above uses, so this row outranks them by
                  the axis it stands on rather than by shouting. The rubric carries the label alone:
                  the moment moved to the facts, where it stands beside the hour it belongs to. */}
              <span class="path-ahead-rubric">
                <span class="path-ahead-dot" aria-hidden="true"></span>
                {announceLabel}
              </span>
              <span class="path-ahead-name">{ahead.title}</span>
            </a>
          </div>

          {/* The three facts a reader acts on, on the measure's other edge. NOT a second door: the
              evening's name is already the link to its programme, and two anchors to one
              destination inside one row is a menu. */}
          <div class="path-ahead-facts reveal">
            {ahead.moment && <p class="path-ahead-fact">{ahead.moment}</p>}
            {ahead.place && <p class="path-ahead-fact">{ahead.place}</p>}
            {ahead.free && <p class="path-ahead-fact path-ahead-door">{chrome.proximumFree}</p>}
          </div>

          {/* The same disclosure every entry above carries, and it is what finally makes this row a
              PEER of them rather than a headline about one. The guardrail this used to cite against
              itself (§1) is about poster images — "does a row of the register now carry a face?" —
              and a folded list of works carries none; the poster stays out for that reason and this
              does not. It is also the one place on the landing where what the evening will actually
              sound can be read without leaving the page. */}
          {ahead.program.length > 0 && (
            <details class="path-card-detail path-entry-detail path-ahead-detail">
              <summary>
                <span>{copy.programLabel}</span>
                <span class="path-detail-icon" aria-hidden="true" />
              </summary>
              <ol class="path-works">
                {ahead.program.map((p, i) => (
                  <li style={`--i:${i}`}>
                    <span class="path-works-n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                    {/* The work is MARKUP — a line may italicise a foreign title inside a
                        vernacular phrase (content.config) — and the whole line is italic here, so
                        the emphasis is silent on this surface, exactly as in the entries. */}
                    {p.composer} · <em><Fragment set:html={p.work} />{p.year ? ` · ${p.year}` : ""}</em>
                  </li>
                ))}
              </ol>
            </details>
          )}
        </aside>
      )}

    </div>
  </div>

  {/* LINIATURA — the register's next page, and its one inked line is blank.

      The register closes on the evening that is announced. The page does not: under that closing
      rule it goes on as what it has been all along, a ruled page. Six evenings above are named at
      a display grade; here the page rules the next leaf and inks ONE of its lines — the blank one,
      because it is the only line on this page the ensemble cannot write itself. The address is
      written on it at the register's own title grade and the act's seal stands at that line's end,
      where the hand stops; the verb and the clause stand on the line below; the two under them have
      nothing on them yet. Once the address is sent the page writes its receipt back on those same
      lines, without one rule moving.

      THE BLANK IS THE FIGURE, WHICH IS WHY IT IS THE LARGEST THING HERE. A block whose biggest
      object was its own headline was read as a footnote to the announcement, because dimensionally
      it was one. A blank line outranks nothing — it carries no claim until the reader supplies one
      — so the announced evening 300px above keeps the page's one future-tense voice, and the key
      that names the line stands above it rather than on it, the way every row of the register sets
      a label over a display line.

      IT IS THE REGISTER'S BODY COLUMN, WHOLE: it begins where every row of the register begins
      and ends where every row ends, and the act stands at that end. Three other placements were
      built and refused — a ribbon in the left margin, the sheet starting at the section's edge and
      stopping a rail short of the right one, the say moved into the margin column against the
      paper — and every one of them moved the sheet to answer a complaint about the FIELD. What
      answered that was the dotted leader under the unwritten address. The margin column is
      `Z drogi`'s alone. It is the grid's sibling, not its item (04-rooms-interludes says why),
      and pays the rail and the gap as padding on its left.

      THE SHEET HAS A HEADLINE, because it stands among headed things: the headline names the
      benefit, the promise under it says what a letter carries, and the blank under them is what
      the reader came to do. Both sentences are the list's own (`koncerty.yaml`, `notice.*`) and
      are read by the component, so this register and the three other placements say one thing.
      One pitch for every line it rules, written or not (04-rooms-interludes, `--lin-pitch`).

      `web:landing` is its own consent surface for the reason every placement is: the column
      records the screen a clause was read on, and this is the only screen a reader reaches without
      having gone looking for the list. The headline is an `h3`, a peer of the entries' headings,
      because the sheet stands among them. */}
  {/* `data-spine-clear`: the act stands at the register's right edge and its seal rises to a ~74px
      ring, while the movement spine floats 2vw from the VIEWPORT's edge — inside the grid at every width
      under ~1780 (at 1440 it reaches 100px past the register's edge and prints "Vox memoriae"
      across the verb). The spine withdraws while the sheet holds the viewport centre, the way it
      does over the Imagines plate: the spine is orientation, the sheet is the page. Marked on the
      sheet and not on `.path`, so the register's own rows keep their index. */}
  <aside class="path-liniatura" aria-label={nuntius.form.bandAria} data-spine-clear>
    <NoticeSignup lang={lang} surface="web:landing" level={3} />

    {/* The unwritten lines. They carry no text and name nothing, so they are out of the
        accessibility tree entirely — a screen reader that announced two blank rules would be
        reading the paper instead of the page. They are real borders, present without JavaScript
        and under a declined motion preference; the ruling is what the scroll adds
        (04-rooms-interludes, "the ruling of the liniatura"). TWO: the block is four lines and the
        form writes two, so when the receipt takes three the sheet puts the first of these out and
        no rule moves. Two is also the floor — one empty rule under the clause is a separator after
        nothing, not ruled paper. */}
    <div class="path-liniatura-void" aria-hidden="true">
      <span class="path-liniatura-line"></span>
      <span class="path-liniatura-line"></span>
    </div>
  </aside>
</section>
