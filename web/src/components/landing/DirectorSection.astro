---
/**
 * @file DirectorSection.astro
 * @description Florent de Bazelaire — artistic direction. Side-by-side portrait (<Picture>,
 *  optimized AVIF/WebP) + bio. Lives inside the dark "wnętrze chóru" sequence
 *  (Litany → Ensemble → Director) — the .director-dark wrapper turns the section dark
 *  and is also registered in StickyHeader's DARK_SELECTORS so the chrome inverts here.
 *  Copy policy: only verified public facts (the 1725 Concert Spirituel history, the
 *  cycle's real venues and intentions). Florent's personal biography (Warsaw, studies,
 *  Jesuit years) is deliberately ABSENT until he supplies an authorized biogram — never
 *  publish unconfirmed life details. The words are on the copy desk (`landing.yaml`); the NAME
 *  in the heading is not, because a name is never translated.
 *
 *  The section's accessible name is the rubric it already prints. A name printed twice is read
 *  twice and drifts on the first edit, so `aria-label` reads the copy rather than restating it.
 * @architecture Astro islands 2026
 * @module components/landing/DirectorSection
 */
import { Picture } from "astro:assets";
import { photo } from "../../lib/photos";
import type { LandingCopy } from "../../i18n/content/landing";

interface Props {
  copy: LandingCopy["director"];
}
const { copy } = Astro.props;

const florent = photo("florent");
---

{/* `.reveal-cue` on the section drives one thing only: the gold hairline at its top edge
    (`.director-dark::after`), which is ruled outward from the centre as the dark room opens. */}
<section id="dyrygent" class="section director-dark reveal-cue" aria-label={copy.role}>
  <div class="director-grid">
    <div class="portrait">
      {/* `width` is the top of the `widths` ladder: it makes the fallback image the widest
          candidate instead of a full-resolution rendition. See lib/photos.ts. */}
      <Picture
        src={florent}
        formats={["avif", "webp"]}
        widths={[480, 760, 1040]}
        width={1040}
        sizes="(max-width: 980px) 100vw, 46vw"
        alt={copy.portraitAlt}
        loading="lazy"
        decoding="async"
      />
      {/* A portrait is lit, not written: the veil lifts instead of the old scale(1.12)→1
          de-zoom, which was the landing's only use of that idiom and so never read as one. */}
      <span class="reveal-light" aria-hidden="true"></span>
    </div>
    {/* Per-element ink (not one block) so the copy is written line-by-line as you scroll,
        the granular feel of the "Z drogi" register — the phone no longer resolves the whole
        column at once. */}
    <div class="director-copy">
      <div class="director-lede reveal">
        <div class="role micro titulus">{copy.role}</div>
        <h2>Florent<br />de Bazelaire</h2>
      </div>
      <p class="reveal">{copy.p1}</p>
      <p class="reveal" set:html={copy.p2Html} />
      <p class="reveal">{copy.p3}</p>
    </div>
  </div>
</section>
