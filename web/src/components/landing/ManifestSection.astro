---
/**
 * @file ManifestSection.astro
 * @description Three-stanza ensemble manifest + the answer line. Rigid editorial grid;
 *  ONE motion system (setupManifestLight in landing.ts + 03-manifest-rite.css): a soft
 *  light edge sweeps each line-group once, left to right, from half-light to full ink —
 *  time-based and one-shot, never scroll-scrubbed. The line-groups deliberately carry NO
 *  entrance register: the sweep is their arrival, and the page's moving light belongs here.
 *  "Odsłania." is its own group with no numeral — the manifest's reply — and it takes that
 *  same light a beat behind stanza III; gold, italic and the beat set it apart, never a
 *  second effect.
 * @architecture Astro islands 2026
 * @module components/landing/ManifestSection
 */
import { MANIFEST_ANSWER, MANIFEST_LINES } from "../../data/landing/manifestLines";
---

<section class="section manifest" id="manifest" aria-label="Manifest chóru VoctEnsemble">
  <div class="manifest-container">
    {/* Ink + lead on one node: the header's existing border-bottom is ruled, and the two
        labels are inked a beat behind it — ruling precedes writing. */}
    <div class="manifest-top reveal reveal-rule">
      <div class="manifest-meta-col">
        <span class="manifest-label">Manifest</span>
      </div>
      <div class="manifest-meta-col" style="text-align: right;">
        <span class="manifest-label">VoctEnsemble</span>
      </div>
    </div>

    <div class="manifest-content">
      {
        MANIFEST_LINES.map((line) => (
          <div class="manifest-line-group">
            <div class="manifest-roman">{line.index}</div>
            {/* Set plain: the build pass (lib/typo.ts) pins the orphans. At this display size a
                one-letter Polish preposition left at a line end ("…duszy w / czasie.") is the
                most visible typographic fault on the page — check it here first. */}
            <p class="manifest-statement">{line.text}</p>
          </div>
        ))
      }

      {/* The answer — no numeral (it is not a fourth thesis), its own beat on the same light. */}
      <div class="manifest-line-group manifest-answer">
        <div class="manifest-roman" aria-hidden="true"></div>
        <p class="manifest-statement">
          <em class="manifest-emphasis">{MANIFEST_ANSWER}</em>
        </p>
      </div>
    </div>
  </div>
</section>
