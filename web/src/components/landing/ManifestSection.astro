---
/**
 * @file ManifestSection.astro
 * @description The ensemble manifest: two quoted theses, then the page's own statement and its
 *  answer, on a rigid editorial grid. The composition spans the opening rule at BOTH terminals —
 *  the first thesis hangs on its left end, the response block is flush to its right — so that
 *  hairline is a measure the type uses rather than a frame nothing touches.
 *
 *  ONE motion system (setupManifestLight in landing.ts + 03-manifest-rite.css): a soft light edge
 *  sweeps each line once, left to right, from half-light to full ink — time-based and one-shot,
 *  never scroll-scrubbed. The lines deliberately carry NO entrance register: the sweep is their
 *  arrival, and the page's moving light belongs here.
 *
 *  NO STANZA NUMERALS, and that is a constraint rather than a simplification. They were roman,
 *  capitalis and hairline-small in the left margin — the same object MovementSpine draws at the
 *  right edge for the page's three actual movements, at nearly the same baseline, so a reader saw
 *  two I/II/III indices facing each other with no way to tell they count different things. The
 *  page numbers its movements; the manifest numbers nothing.
 *
 *  THE THESES ARE QUOTED, not written for the site — they come from the ensemble's founding text
 *  and the response is the page's own single not-X-but-Y figure, the one negation the copy system
 *  allows anywhere. Both live in `landing.yaml` on the copy desk, where the contract says so; the
 *  desk is where a translation of quoted text can be reviewed against it.
 * @architecture Astro islands 2026
 * @module components/landing/ManifestSection
 */
import type { LandingCopy } from "../../i18n/content/landing";

interface Props {
  copy: LandingCopy["manifest"];
  /** The section's name for a screen reader; nothing on screen states it. */
  aria: string;
}
const { copy, aria } = Astro.props;
---

<section class="section manifest" id="manifest" aria-label={aria}>
  <div class="manifest-container">
    {/* Ink + lead on one node: the header's existing border-bottom is ruled, and the label is
        inked a beat behind it — ruling precedes writing. The rule carries ONE label; the right
        end is left open on purpose, because the only thing that stood there was the wordmark the
        fixed chrome already prints a hundred pixels higher. */}
    <div class="manifest-top reveal reveal-rule">
      <span class="manifest-label">{copy.label}</span>
    </div>

    <div class="manifest-content">
      {/* Set plain: the build pass (lib/typo.ts) pins the orphans. At this display size a
          one-letter Polish preposition left at a line end ("…duszy w / czasie.") is the most
          visible typographic fault on the page — check it here first. */}
      {
        copy.lines.map((line, index) => (
          <p class:list={["manifest-line", index > 0 && "manifest-line-step"]}>{line.text}</p>
        ))
      }

      {/* One utterance, one block: statement and answer are right-anchored together and share a
          left datum, so the reply reads as a reply. The answer takes the same light a beat
          behind — gold, italic and that beat set it apart, never a second effect. */}
      <div class="manifest-response">
        <p class="manifest-line">{copy.statement}</p>
        <p class="manifest-line manifest-answer">
          <em class="manifest-emphasis">{copy.answer}</em>
        </p>
      </div>
    </div>
  </div>
</section>
