---
/**
 * @file HeroSection.astro
 * @description Opening threshold — full-bleed sacred fresco via <BleedImage> (art-directed
 *  AVIF/WebP, Ken Burns, parallax). hero-grid holds the optional "next concert" dateline → kicker
 *  → h1 → response → strap braid; hero-rail holds the CTA anchors (the film reel +
 *  koncerty) + downward cue. The
 *  kinetic "breath" on .hero-title is driven
 *  by scripts/landing.ts; the dark dimming filter is applied in landing.css (.hero-media .bleed img).
 *
 *  Its words come from `landing.yaml` through the copy desk (lib/pageCopy); `Concerts Spirituels`
 *  is the French name of the historical form and stays in the markup with the site's other
 *  locale-neutral tier. Every text node that stands beside an expression writes its own space —
 *  Astro drops the whitespace between the two, and a word-stream proof cannot see it.
 * @architecture Astro islands 2026
 * @module components/landing/HeroSection
 */
import { getCollection } from "astro:content";
import BleedImage from "../BleedImage.astro";
import { bleedPair } from "../../lib/photos";
import { longMoment } from "../../lib/dates";
import { upcomingStation } from "../../lib/cycle";
import { concertKey, overlayValue } from "../../lib/copyOverlay";
import { localizePath, type Locale } from "../../i18n/config";
import type { LandingCopy } from "../../i18n/content/landing";
import { MODAL_VIDEO } from "../../data/landing/video";

interface Props {
  copy: LandingCopy["hero"];
  /** The film's caption, which belongs to the Vox moment and travels with the trigger: the button
      here opens the same reel, and one film may not carry two captions. */
  videoCaption: string;
  lang: Locale;
}
const { copy, videoCaption, lang } = Astro.props;

const hero = bleedPair("hero-landing");
const hrefConcerts = localizePath("/koncerty", lang);

// Announcement dateline — dormant by design. A standing "next concert" line shows ONLY while
// concerts.yaml carries a station whose `date` is still ahead (lib/cycle, which is also what the
// Proximum band and the station's own marker read, so the three cannot name two different
// evenings). This is the "pulse" the hero otherwise lacks: the whole site speaks in the eternal
// past tense until a date lands here.
const upcoming = upcomingStation(await getCollection("concerts"));
// The evening names itself, in this locale, from its own entry in the corpus — never from a
// second copy on the landing.
const upcomingTitle = upcoming
  ? (overlayValue(concertKey(upcoming.id, "title"), lang) ?? upcoming.data.title)
  : "";
---

<section class="hero" id="top" aria-label="VoctEnsemble">
  <div class="hero-media" aria-hidden="true">
    <BleedImage desktop={hero.desktop} mobile={hero.mobile} alt="" eager animate />
  </div>

  <div class="hero-inner">
    <div class="hero-grid">
      {/* An evening with no page of its own is still a place on /koncerty rather than the top of
          it: the station carries the anchor, so the dateline lands the reader on the announcement
          instead of at the head of six evenings that are already over. */}
      {upcoming && (
        <a
          class="hero-announce intro-stage plausible-event-name=hero+najblizej"
          href={upcoming.data.hasPage ? `${hrefConcerts}/${upcoming.id}` : `${hrefConcerts}#${upcoming.id}`}
        >
          <span class="hero-announce-dot" aria-hidden="true"></span>
          {/* `longMoment`, not `viaMoment`: the Proximum band prints this same date in full four
              screens down, and the ribbons' abbreviation ("paź 2026") appeared nowhere else on
              this page. The two marks stay: the em-dash introduces the label, the middot separates
              two peer facts — the register the whole site dates things in (`.proximum-when`).

              The moment is its own element and the middot is DRAWN by the sheet, not typed: this
              line cannot fit a phone column, so at that width it becomes two authored tiers and
              the mark that joined two facts on one line has to go with it. Written unbroken —
              whitespace between these nodes would print inside the line. */}
          <span class="hero-announce-text">{`${copy.announceLabel} — `}<strong>{upcomingTitle}</strong><span class="hero-announce-when">{longMoment(upcoming.data, lang)}</span></span>
        </a>
      )}
      <div class="hero-kicker micro intro-stage">Concerts Spirituels</div>
      <h1 class="hero-title">
        <span class="intro-stage s2">{copy.title1}</span>
        <span class="intro-stage s3"><em>{copy.title2}</em></span>
      </h1>
      <p class="hero-response intro-stage s4">{copy.response}</p>
      {/* The link inside the strap is the copy's own — the name is bound by the sheet
          (`white-space: nowrap`), so no hard space is ever typed into a field an editor edits. */}
      <p class="hero-strap intro-stage s5" set:html={copy.strapHtml} />
    </div>

    <div class="hero-rail intro-stage s6">
      {/* The hero's one standing invitation is the experience itself: the concert video
          projected in the lightbox. The donation line moved to movement III (Sustinete nos),
          where the asks concentrate; the "next concert" dateline (top of hero-grid) is what lights
          up when a real date lands. */}
      <div class="hero-actions">
        <button
          type="button"
          class="primary-link plausible-event-name=hero+wideo"
          data-video-open
          data-video-src={MODAL_VIDEO.src}
          data-video-src-av1={MODAL_VIDEO.srcAv1}
          data-video-caption={videoCaption}
        >
          {/* The runtime is part of the invitation, not a footnote to it: "I do not know what is
              behind this" is answered by saying what it costs, and a number in the label does that
              where the play mark alone only says "a film". One flex item, so the mid-dot keeps its
              own spacing instead of taking the label-to-mark gap. */}
          <span>
            {copy.videoLabel}{" "}
            <span class="primary-link-meta">{copy.videoMeta}</span>
          </span>
        </button>
        <a class="secondary-link plausible-event-name=hero+koncerty" href={hrefConcerts}>
          {copy.concertsLink}
        </a>
      </div>
      <span class="hero-cue" aria-hidden="true">{copy.cue}</span>
    </div>
  </div>
</section>
