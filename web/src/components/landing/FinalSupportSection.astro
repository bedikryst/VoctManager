---
/**
 * @file FinalSupportSection.astro
 * @description Closing patronage section over the krzyż-światło backdrop: direct-contact card
 *  (Florent's email), donation tier rows, and a bank-card with copyable IBANs (PLN + EUR) and
 *  foundation address. The "Wesprzyj" trigger dispatches `voct:open-vault` (handled by the
 *  vault island in Faza 3c); IBAN copy is delegated in scripts/landing.ts (`data-copy`).
 * @architecture Astro islands 2026
 * @module components/landing/FinalSupportSection
 */
import BleedImage from "../BleedImage.astro";
import { bleedPair } from "../../lib/photos";

const bg = bleedPair("swiatlo-krzyz");

const ROWS = [
  { amount: "100 zł", text: "dokłada się do najbliższego wieczoru cyklu" },
  { amount: "500 zł", text: "wspiera próby i partytury między koncertami" },
  { amount: "2 500 zł", text: "współtworzy następny wieczór cyklu" },
] as const;
---

<section class="final-support" id="wesprzyj" aria-label="Wesprzyj VoctEnsemble">
  {/* No light register here, and the measurement says why: the photograph itself is fine —
      swiatlo-krzyz reads p90 64, which the veil would move 32 levels, comfortably above the bar
      the rest of the site clears. What spends it is this section's OWN 0.78–0.88 gradient, which
      crushes the image to 26–41/255 before the veil touches it, leaving the register 10–19 levels
      to work with. A register must not claim a gesture the design has already decided against, and
      leaving it here invites the one fix that is forbidden: deepening --veil-ink, which reaches
      threshold only by taking the photograph to 18/255 and breaking "never blank, only unlit" in
      order to rescue the register whose whole promise that is. If the gradient is ever lightened,
      the register can come back unchanged. */}
  <div class="final-support-media" aria-hidden="true">
    <BleedImage desktop={bg.desktop} mobile={bg.mobile} alt="" position="center" />
  </div>
  <div class="section">
    <div class="final-grid">
      {/* Each block is its own .reveal (not one column-sized block) so the entrance reads
          element-by-element as you scroll — the granular feel of the "Z drogi" register —
          instead of a whole tall column popping in at once on the phone. */}
      <div class="final-copy">
        {/* Eyebrow and heading are one utterance and share a node; the paragraph is read after
            them and takes its own, so the queue gives it the beat it needs. As one 424px node the
            copy under the display heading was already written when the eye arrived. */}
        <div class="final-lede">
          <div class="final-lede-head reveal">
            <div class="micro">Patronat · darowizna · partnerstwo</div>
            <h2 class="ink-press">Niech muzyka ma swoje miejsce.</h2>
          </div>
          {/* Names the real cost structure instead of a metaphor: the singers are the
              largest item, and saying so is the honest case for a donation. Deliberately
              no amounts per item — the tiers below stay qualitative, because published
              rates for musicians would be both volatile and indiscreet. */}
          <p class="reveal">
            Największy koszt koncertu to honoraria śpiewaków; potem partytury, dźwięk,
            światło i dojazdy. Na to idą darowizny. Można też zaprosić nas do
            siebie: śpiewamy koncerty i liturgie, msze ślubne, jubileusze.
          </p>
        </div>
        <div class="final-contact reveal">
          <span class="micro">Kontakt do kierownictwa artystycznego</span>
          <a
            class="final-contact-name plausible-event-name=florent+mail"
            href="mailto:florent.de.bazelaire@voctensemble.com?subject=Patronat%20VoctEnsemble"
          >
            Florent de Bazelaire
          </a>
          <span class="final-contact-mail">florent.de.bazelaire@voctensemble.com</span>
        </div>
        {/* Unlike the hero's two parallel invitations, these are NOT equal: this section
            exists to open the vault, and writing an email is the fallback. The donation
            trigger leads and carries the candle-gold emphasis (.final-actions rule in
            04-rooms-interludes.css); plausible event names stay as they were so the
            existing funnel keeps comparing like with like. */}
        <div class="final-actions reveal">
          <a
            class="primary-link plausible-event-name=wesprzyj+dol"
            href="#wesprzyj"
            data-no-lenis
            data-vault-open="100"
          >
            Wesprzyj
          </a>
          <a
            class="secondary-link plausible-event-name=napisz+do+nas+dol"
            href="mailto:patronat@voctensemble.com?subject=Patronat%20VoctEnsemble"
          >
            Napisz do nas
          </a>
        </div>
      </div>

      {/* The ledger's rule is drawn on the wrapper, the tiers are inked inside it — two nodes,
          because a node may hold ink and lead together only when the rule is its own. */}
      <div class="donation-list reveal-rule">
        <div class="donation-rows reveal">
          {
            ROWS.map((row) => (
              <div class="donation-row">
                <strong>{row.amount}</strong>
                <span>{row.text}</span>
              </div>
            ))
          }
        </div>

        <div class="bank-card reveal reveal-rule" id="przelew" aria-label="Dane do przelewu">
          <div class="bank-row">
            <span class="currency">PLN</span>
            <span class="iban">PL26 1600 1013 1724 4184 1000 0001</span>
            <button
              type="button"
              class="copy-account plausible-event-name=przelew+copy+PLN"
              data-copy="PL26160010131724418410000001"
            >
              Kopiuj
            </button>
          </div>
          <div class="bank-row">
            <span class="currency">EUR</span>
            <span class="iban">PL96 1600 1013 1724 4184 1000 0002</span>
            <button
              type="button"
              class="copy-account plausible-event-name=przelew+copy+EUR"
              data-copy="PL96160010131724418410000002"
            >
              Kopiuj
            </button>
          </div>
          <div class="foundation-data">
            Fundacja VoctFoundation · KRS 0001237252 · NIP 6762718992 · REGON 544621525
            <br />
            Tytuł przelewu: Darowizna na cele statutowe VoctFoundation
            <br />
            Św. Filipa 23 / 3, 31-150 Kraków, Polska
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
