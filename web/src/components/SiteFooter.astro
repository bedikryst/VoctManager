---
/**
 * @file SiteFooter.astro
 * @description Shared marketing footer for every page EXCEPT the landing (Fundatio identity ·
 *  the leaves the bar does not name · the notice list · contact/socials), on the site-wide
 *  night ground.
 *
 *  IT IS NOT THE LANDING'S FOOTER AND MUST NOT BE REPLACED BY IT, which has been asked twice.
 *  The landing's plate numbers itself `IV · INSCRIPTIO FINALIS` and closes the sequence
 *  I · Lumen Christi, II · Vox memoriae, III · Sustinete nos — on `/kontakt` there is no I, II
 *  or III, and a fourth movement without them is a false claim of the same class the concert
 *  register's roman numbering is protected from. Both are translated now — this one takes `lang`
 *  as a prop and the landing's island has since stage K — so language is not one of the reasons;
 *  the numbering is.
 *
 *  WHAT THE INDEX COLUMN IS, AND WHY IT IS THREE LINES. It was the whole site map, nine entries,
 *  and six of them (Strona główna, O nas, Koncerty, Kontakt, Wesprzyj, and Obrazy through the
 *  KONCERTY register) are named by `SiteChrome` on every page of this site — a bar that is
 *  `position: fixed`, i.e. ON SCREEN at the exact moment a reader is reading this footer. A
 *  footer site map earns its place where the navigation has scrolled away; here it never does,
 *  and the phone's card carries a FULLER index than this column ever did (it prints the Via, every
 *  concert by name). So the column answers the only question the bar leaves open — what else is
 *  under here that you were never offered — and holds exactly the leaves with no slot in it:
 *  `/obrazy` (a subordinate line inside the KONCERTY register, reachable on desktop by hover
 *  alone), `/kolofon` and `/polityka-prywatnosci`.
 *
 *  THE INVITATION LIST IS AN ASK, NOT A PAGE, and filed among the pages it read as a genre label
 *  saying nothing about concerts or about signing up. It is a STANZA OF ITS OWN
 *  RANK, beside the registry and the addresses, in the wording the site already owns
 *  (`NUNTIUS[lang].invitation`, the same sentence `/kontakt` and the landing print): the rubric
 *  names it, the line says what arrives, the link says what to do. It stands next to `Vox`
 *  because those two are the two directions of one correspondence — we write to you, you write
 *  to us — which is the order `/kontakt` puts them in on the page itself.
 *
 *  It was briefly a centred band under the grid and that was the wrong shelf: a lone centred
 *  object under three columns that hang from the left of the measure belongs to nothing, which
 *  is the same failure the landing's dateline had and the guardrails record. Four stanzas of one
 *  rank is this house's own form — the landing's register is four.
 *
 *  What this footer shares with the landing's: the two-voice rubric (`· LATIN gloss`), the
 *  statute, the data-protection route, and an entrance in the site's own registers.
 * @architecture Astro islands 2026
 * @module components/SiteFooter
 */
import { tempusForDate } from "../lib/tempusLiturgicus";
import { SOCIAL } from "../data/social";
import { UI } from "../i18n/ui";
import { NUNTIUS } from "../i18n/content/nuntius";
import { localizePath, DEFAULT_LOCALE, type Locale } from "../i18n/config";

interface Props {
  /** Page locale — selects footer labels and localizes the site-map links. Defaults to Polish,
      so every un-migrated caller renders byte-identical to before. */
  lang?: Locale;
  /** Whether to print the `Nuntius` stanza. The footer is furniture and repeats on every page, so
      the bar for withholding it is narrow: pass `false` ONLY where the ask would point at the
      page the reader is standing on (`/newsletter`, `/nuntius`), where the identical sentence is
      already set in the body a screen above (`/kontakt`), or where a page has deliberately chosen
      silence about the list (a concert page whose evening is already announced — see its rail).
      Distance is not duplication: `/koncerty` carries the form itself two screens up and still
      prints this, because a reader who reached the foot of the page has left that band behind.
      With the stanza off the grid closes to three columns (`data-stanzas`). */
  notice?: boolean;
}
const { lang = DEFAULT_LOCALE, notice = true } = Astro.props;
const t = UI[lang].footer;
const nuntius = NUNTIUS[lang];
const year = new Date().getFullYear();
const tempus = tempusForDate(new Date());
const tempusGloss = tempus.gloss[lang];
---

<footer class="site-foot">
  {/* Four stanzas of one rank, all hanging from one line across the measure, written left to
      right: `data-d` sets the offset for a whole SUBTREE, so the stanza carries the cadence and
      its head, mark and list all take it. The ink is on the stanzas rather than on the grid
      because one onset cannot cover a 220px block and still be one utterance. The cadence is
      handed out in reading order and CLOSES UP when Nuntius is absent — a hole in a stagger
      reads as a stall, not as an omission. */}
  <div class="foot-grid" data-stanzas={notice ? "4" : "3"}>
    <div class="foot-col reveal" data-d="1">
      {/* The two-voice rubric this site's registers speak: Latin in the inscriptional capital,
          the gloss in mono minuscule. The split is not decorative — Cinzel has no lowercase, so
          a gloss set in it would return small caps and start competing with the Latin it is
          supposed to footnote. Still an `h3` because every page opens its sections at `h2`; the
          tag carries the outline, the spans carry the voice. */}
      <h3>
        <span class="dot" aria-hidden="true">·</span>
        <span class="lat" lang="la">Fundatio</span>
        <span class="gloss">{t.foundation}</span>
      </h3>
      <p class="foot-mark">VoctFoundation</p>
      <p class="foot-seat">ul. Św. Filipa 23/3 · 31-150 Kraków</p>
      {/* The registers, one row each rather than one paragraph of `<br>`s, because the phone
          prints the KRS and drops the other two (see the subset at the foot of this sheet) and a
          text node between line breaks cannot be addressed. Same key/val shape the landing's
          Fundatio stanza uses. The acronyms are the Polish registers' own and are never
          translated. */}
      <ul class="foot-registry">
        <li><span class="key">KRS</span><span class="val">0001237252</span></li>
        <li><span class="key">NIP</span><span class="val">6762718992</span></li>
        <li><span class="key">REGON</span><span class="val">544621525</span></li>
      </ul>
      <p class="foot-note">{t.donationNote}</p>
      {/* The founding document, beside the numbers that register it and directly under the note
          that names its purposes ("cele statutowe"). It is deliberately NOT in the index column:
          that column is the site's own leaves, and a PDF is not a page of this site. */}
      <p class="foot-doc">
        <a
          href="/docs/Statut-VoctFoundation.pdf"
          target="_blank"
          rel="noopener"
          aria-label={t.statuteAria}
        >
          {t.statute} <span class="doc-tag" aria-hidden="true">PDF</span>
        </a>
      </p>
    </div>

    <div class="foot-col reveal" data-d="2">
      <h3>
        <span class="dot" aria-hidden="true">·</span>
        <span class="lat" lang="la">Index</span>
        <span class="gloss">{t.site}</span>
      </h3>
      <ul>
        {/* The archive has no nav slot by decision (docs/specs/web-imagines-spec.md §7) — what it has
            is a subordinate line inside the KONCERTY register, which on desktop opens on hover
            alone. This is its one standing entrance, on every page, for a reader who never
            brushes the bar. It belongs on THIS shelf and not beside the statute: filed among
            documents an image archive reads as an administrative record, and that shelf was
            weighed and rejected when the entrance was placed. */}
        <li><a href={localizePath("/fundacja", lang)}>{t.foundationPage}</a></li>
        <li><a href={localizePath("/obrazy", lang)}>{t.images}</a></li>
        <li><a href={localizePath("/kolofon", lang)}>{t.colophon}</a></li>
        <li><a href={localizePath("/polityka-prywatnosci", lang)}>{t.privacy}</a></li>
      </ul>
    </div>

    {/* THE ASK — the one stanza here that leads FORWARD, and the one sentence in this footer
        written to a person rather than filed. It stands immediately before `Vox` because the two
        are the two directions of one correspondence, which is the order the contact page itself
        puts them in: the three doors a reader writes through, then the one route that runs the
        other way.
        Every word is read from `NUNTIUS`, never written here — the same invitation stands on
        /kontakt and on the landing, and one fact may have only one wording. The destination is
        `/newsletter`, the page built to be TOLD to someone out loud, and not the form's anchor on
        /koncerty: a reader arriving from the foot of /o-nas has not been walking the cycle and
        would land two screens below that page's head. */}
    {
      notice && (
        <div class="foot-col foot-col-nuntius reveal" data-d="3">
          <h3>
            <span class="dot" aria-hidden="true">·</span>
            <span class="lat" lang="la">Nuntius</span>
            <span class="gloss">{nuntius.page.eyebrow}</span>
          </h3>
          <p class="foot-say">{nuntius.invitation.line}</p>
          {/* The act, set as this footer's other act is — the statute's route two stanzas left:
              mono, a permanent hairline, no `↗`. The arrow that IS here is `→`, and it means
              direction rather than "opens elsewhere in the browser"; it is the same arrow
              /kontakt puts on the same words. */}
          <p class="foot-act">
            <a href={localizePath("/newsletter", lang)}>
              {nuntius.invitation.cta}&nbsp;<span aria-hidden="true">→</span>
            </a>
          </p>
        </div>
      )
    }

    <div class="foot-col reveal" data-d={notice ? "4" : "3"}>
      <h3>
        <span class="dot" aria-hidden="true">·</span>
        <span class="lat" lang="la">Vox</span>
        <span class="gloss">{t.contactMedia}</span>
      </h3>
      <ul>
        <li><a href="mailto:kontakt@voctensemble.com">kontakt@voctensemble.com</a></li>
        {/* The address is one door to patronage; the page that explains the relationship is the
            other, keyed beside it in the same grade the duty route's key uses below. */}
        <li class="foot-vox-patronage">
          <a href="mailto:patronat@voctensemble.com">patronat@voctensemble.com</a>
          <a class="foot-vox-mecenat" href={`${localizePath("/fundacja", lang)}#mecenat`}>
            {t.patronage}&nbsp;<span aria-hidden="true">→</span>
          </a>
        </li>
        {/* An obligation, not an invitation — hence the key in front of it and the quieter
            grade. It stays with the other addresses because it IS a way of writing to us, and
            it is the one route here the phone keeps: a duty a reader may need to exercise from
            whatever page they are standing on. */}
        <li class="foot-rodo">
          <span class="key">{t.dataProtection}</span>
          <a href="mailto:rodo@voctensemble.com">rodo@voctensemble.com</a>
        </li>
      </ul>
      {/* A list of its own so the phone can set the three on one wrapped row while the desktop
          keeps them stacked under the addresses — one DOM, two compositions, nothing duplicated.
          The `↗` is this site's mark for a link that opens elsewhere IN THE BROWSER; the
          addresses above carry none because a `mailto:` hands off to a mail client instead. */}
      <ul class="foot-social">
        {
          Object.values(SOCIAL).map((account) => (
            <li>
              <a href={account.url} target="_blank" rel="noopener noreferrer">{account.platform} ↗</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  {/* The season, named in stone and glossed in speech — the same two-voice rubric the columns
      above use, which is why the gloss takes their minuscule: the accessible name below carries
      the authored case, so "Eastertide" is only lowercased where it is SET, never where it is
      read aloud.
      It shares the last stanza's `data-d` rather than taking a fifth step: the cadence stops at
      four (styles/registers.css), and the season arriving with the register's final column is
      the right reading anyway — it is the register's own dateline, not a fifth entry. */}
  <p class="foot-incipit reveal" data-d="4" aria-label={`${tempus.incipit} — ${tempusGloss}`}>
    <em>{tempus.incipit}</em>
    <span class="foot-incipit-dot" aria-hidden="true">·</span>
    <span class="foot-incipit-gloss">{tempusGloss}</span>
  </p>

  {/* INK + LEAD, the one pair the register language allows: this band's top border is the only
      hairline this footer carries, so it is the only thing here that can be ruled — and nothing
      was invented to have something to draw. Rule first, imprint a beat behind. */}
  <div class="foot-base reveal reveal-rule">
    <span>© {year} Fundacja VoctFoundation</span>
    {/* No `↗`: a `mailto:` hands off to a mail client rather than opening elsewhere in the
        browser, which is what the arrow marks. The address is the author's own domain because
        this line credits the person who built the site, not a role inside the foundation; the
        foundation's own addresses are in the Vox column. The phone drops this line and the one
        after it — both are set again, in full, on /kolofon under `Auctor`. */}
    <span class="foot-base-author">
      {t.realizedBy} · <a href="mailto:krystian@bugalski.dev" rel="author">Krystian Bugalski</a>
    </span>
    <a class="foot-base-home" href={localizePath("/", lang)}>voctensemble.com</a>
  </div>
</footer>

<style>
  /* The foot is the page's last band, so under `viewport-fit=cover` (BaseLayout) it owns the strip
     behind the home indicator — its bottom padding absorbs that inset rather than printing the
     colophon under the bar. Sides take the landscape notch the same way. */
  .site-foot { background: var(--night); color: rgba(244, 241, 233, .72); padding: clamp(56px, 7vw, 88px) max(28px, 5vw, env(safe-area-inset-right, 0px)) calc(env(safe-area-inset-bottom, 0px) + 40px) max(28px, 5vw, env(safe-area-inset-left, 0px)); }
  /* Fundatio carries an address, three registry rows and a document, so it takes the widest
     measure; the other three are set to hold their longest single string without wrapping —
     `patronat@voctensemble.com` at 12px mono and, in the index, the French `Politique de
     confidentialité`. The three-stanza template is the same grid with the ask withheld. */
  .foot-grid { max-width: 1180px; margin: 0 auto; display: grid; grid-template-columns: 1.2fr 1fr 1fr 1fr; gap: clamp(28px, 3.6vw, 48px); }
  .foot-grid[data-stanzas="3"] { grid-template-columns: 1.4fr 1fr 1fr; gap: clamp(32px, 5vw, 64px); }
  /* Selector follows the tag: these are `h3` because every page opens its sections at `h2` and
     an `h4` here skipped a level in the outline. Styled by tag, so the two must move together.
     Two voices on one baseline — stone and speech, the same rubric the landing's register
     carries. Latin takes the full candle because this ground is night: 8.46:1, where the same
     paint on parchment is 2.10 (see --candle-ink in tokens.css). */
  .foot-col h3 { display: flex; align-items: baseline; gap: 9px; margin: 0 0 18px; font-family: var(--mono); font-size: 10px; letter-spacing: .18em; line-height: 1.45; font-weight: 400; color: rgba(244, 241, 233, .46); text-transform: none; }
  .foot-col h3 .dot { color: var(--candle); opacity: .6; letter-spacing: 0; transform: translateY(-.05em); }
  .foot-col h3 .lat { font-family: var(--capitalis); font-size: 11.5px; font-weight: 500; letter-spacing: .18em; text-transform: uppercase; color: var(--candle); }
  /* The gloss stays 1.5px smaller than the Latin and in the other face: the contrast is carried
     by three things at once — face, letter case and colour — and if both halves grow together
     the two-voice reading collapses into one tracked label. */
  .foot-col h3 .gloss { text-transform: lowercase; letter-spacing: .1em; }
  .foot-mark { font-family: var(--serif); font-style: italic; font-size: 26px; color: var(--paper); margin: 0 0 10px; }
  .foot-seat { font-family: var(--mono); font-size: 11.5px; line-height: 1.75; letter-spacing: .03em; color: rgba(244, 241, 233, .6); margin: 0; }
  /* A RULED TABLE, not three lines of running text: the keys share a column and the numbers all
     start on one axis, which is what makes three identifiers scan as a register instead of as
     prose that happens to contain digits. Two grid columns rather than a `min-width` on the key,
     because `REGON` is two glyphs longer than `KRS` and any hand-set width is a guess that the
     longest acronym eventually outgrows — the column measures itself.
     Selector note: `.foot-col ul` below sets `display: grid` at two compounds and would beat a
     bare `.foot-registry` once Astro appends its scope attribute to both, so this states its own
     display through `.foot-col` as well.
     `display: contents` on the row is what lets the two spans BE the grid items; the `<li>` is
     kept in the markup so the three identifiers remain a list to a screen reader.
     `tabular-nums` is belt-and-braces on a monospaced face, and it is the pair of digits in
     `0001237252` that it protects: a reader checks these against a register entry. */
  .foot-col .foot-registry { list-style: none; margin: 10px 0 0; padding: 0; display: grid; grid-template-columns: max-content 1fr; column-gap: 14px; row-gap: 3px; align-items: baseline; }
  .foot-registry li { display: contents; }
  .foot-registry .key { font-size: 9px; letter-spacing: .22em; text-transform: uppercase; color: rgba(244, 241, 233, .42); }
  .foot-registry .val { font-family: var(--mono); font-size: 11.5px; letter-spacing: .06em; font-variant-numeric: tabular-nums lining-nums; color: rgba(244, 241, 233, .6); }
  .foot-note { font-family: var(--mono); font-size: 11.5px; line-height: 1.75; letter-spacing: .03em; color: rgba(244, 241, 233, .6); margin: 14px 0 0; }
  /* The statute sits under the note that names its purposes, and it is marked as a DOCUMENT
     rather than as a route: PDF tag and a permanent hairline, no arrow. The arrow belongs to
     the links that open another site; a hairline is what this footer's only file gets, the
     same way the landing's Corpus column underlines its two documents and its addresses. */
  .foot-doc { margin: 16px 0 0; }
  .foot-doc a { display: inline-flex; align-items: baseline; gap: 10px; font-family: var(--mono); font-size: 12px; letter-spacing: .08em; color: rgba(244, 241, 233, .78); border-bottom: 1px solid rgba(244, 241, 233, .22); padding-bottom: 3px; transition: color .3s var(--ease), border-color .3s var(--ease); }
  .foot-doc a:hover { color: var(--candle); border-color: var(--candle); }
  .foot-doc .doc-tag { font-size: 9px; letter-spacing: .22em; color: rgba(244, 241, 233, .46); transform: translateY(-.22em); }

  .foot-col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .foot-col ul a { font-family: var(--mono); font-size: 12px; letter-spacing: .08em; color: rgba(244, 241, 233, .78); transition: color .3s var(--ease); }
  .foot-col ul a:hover { color: var(--candle); }
  /* Reads as a continuation of the addresses above it, so the step matches their own gap.
     Written as a COMPOUND with `.foot-col`, and the phone's row rule below is too: Astro appends
     `[data-astro-cid-…]` to every compound in a scoped block, so the two-compound `.foot-col ul`
     above lands at (0,4,0) and a bare `.foot-social` at (0,2,0) would silently lose its `margin`
     and its `display` to it. Same trap the register audit exists to catch. */
  .foot-col .foot-social { margin-top: 10px; }

  /* The duty route reads a grade quieter than the two invitations above it, and its key is what
     says which duty. Baseline row so the 9px key hangs off the address rather than above it.
     The address rule carries `.foot-col` for the same reason `.foot-social` does: bare
     `.foot-rodo a` loses its size and colour to `.foot-col ul a` once both are scoped. */
  .foot-rodo { display: flex; align-items: baseline; gap: 10px; }
  .foot-rodo .key { font-size: 9px; letter-spacing: .22em; text-transform: uppercase; color: rgba(244, 241, 233, .46); }
  .foot-col .foot-rodo a { font-size: 11px; color: rgba(244, 241, 233, .6); }
  /* The patronage row keys its page beside the address, in the key's own grade. Written as a
     three-compound selector so it outranks `.foot-col ul a` above (see the compound note there). */
  .foot-vox-patronage { display: flex; align-items: baseline; flex-wrap: wrap; gap: 10px; }
  .foot-col .foot-vox-patronage .foot-vox-mecenat { font-size: 9px; letter-spacing: .22em; text-transform: uppercase; color: rgba(244, 241, 233, .46); }
  .foot-col .foot-vox-patronage .foot-vox-mecenat:hover { color: var(--candle); }

  /* THE ASK. Serif at reading size — it is the one sentence in this footer written TO a person,
     and everything around it is a register in the typewriter voice; matched to them it would
     file the invitation among the numbers. It sits on the stanza's own measure, so it takes the
     column rather than a `max-width` of its own. */
  .foot-say { font-family: var(--serif); font-size: 16.5px; line-height: 1.55; color: rgba(244, 241, 233, .8); margin: 0; }
  /* The act, in the grammar the statute's route already uses two stanzas left: mono, a permanent
     hairline, candle on arrival rather than on hover — this is the footer's one forward door and
     a reader must be able to see that it is one without touching it. */
  .foot-act { margin: 16px 0 0; }
  .foot-act a { display: inline-flex; align-items: baseline; font-family: var(--mono); font-size: 12px; letter-spacing: .08em; color: var(--candle); border-bottom: 1px solid color-mix(in srgb, var(--candle) 40%, transparent); padding-bottom: 3px; transition: border-color .3s var(--ease); }
  .foot-act a:hover { border-color: var(--candle); }

  .foot-incipit { max-width: 1180px; margin: clamp(40px, 5vw, 60px) auto 0; padding: 0; text-align: center; font-family: var(--mono); font-size: 11px; letter-spacing: .14em; color: rgba(244, 241, 233, .42); }
  .foot-incipit em { font-family: var(--serif); font-style: italic; font-size: 15px; letter-spacing: .02em; color: rgba(244, 241, 233, .68); margin-right: 10px; }
  .foot-incipit-dot { margin: 0 8px; color: rgba(244, 241, 233, .28); }
  /* Minuscule because it is a GLOSS, exactly as the column heads' `.gloss` is — the house's
     second voice under a Latin capital, in every language it speaks. */
  .foot-incipit-gloss { text-transform: lowercase; letter-spacing: .12em; }
  .foot-base { max-width: 1180px; margin: clamp(22px, 3vw, 36px) auto 0; padding-top: 22px; border-top: 1px solid rgba(244, 241, 233, .12); display: flex; flex-wrap: wrap; gap: 12px 24px; justify-content: space-between; font-family: var(--capitalis); font-size: 10.5px; letter-spacing: .14em; text-transform: uppercase; color: rgba(244, 241, 233, .46); }
  .foot-base a { color: inherit; transition: color .3s var(--ease); }
  .foot-base a:hover { color: var(--candle); }

  /* LEAD register. The real border stays for a no-JS or reduced-motion visitor; only under the
     motion gate is it handed to the pseudo-rule that can be drawn (styles/registers.css). The
     hairline is top-anchored, which is where the trigger fires — a rule drawn on a bottom
     border is drawn off-screen. `html` takes no `data-astro-cid`, so this scoped selector still
     matches the document element. */
  html.voct-motion .foot-base.reveal-rule { border-top-color: transparent; --rule-ink: rgba(244, 241, 233, .12); }

  /* ── THE PHONE PRINTS A SUBSET ────────────────────────────────────────────────────────────
     One DOM, two compositions — the rules below are the only thing that decides which, so there
     is no second tree and no duplicated link to keep in sync. Stacked into one narrow column the
     three registers ran past twenty lines, which is a footer nobody reaches the end of.

     WHAT THE PHONE DOES NOT PRINT, and why none of it is lost: NIP, REGON, the donation note and
     the statute are all set — in a fuller form, under their own heads — on /kolofon and /o-nas,
     and the phone's own menu card links /kolofon in its fine print; `patronat@` is one of the
     four routes /kontakt sets out in full, and KONTAKT is a voice in that same card. What stays
     is what a foundation's footer owes on a phone: who we are, where we sit, the KRS that proves
     it, one way to write, the duty address, where we can be seen, the leaves the card does not
     name — and the ask. */
  @media (max-width: 760px) {
    .foot-grid,
    .foot-grid[data-stanzas="3"] { grid-template-columns: 1fr; gap: 32px; }
    .foot-registry li + li,
    .foot-note,
    .foot-doc,
    .foot-vox-patronage,
    .foot-base-author,
    .foot-base-home { display: none; }
    /* Three names on one wrapped row instead of three lines of a list. */
    .foot-col .foot-social { display: flex; flex-wrap: wrap; gap: 8px 18px; }
    .foot-mark { font-size: 23px; }
    .foot-base { justify-content: flex-start; }
  }
</style>
