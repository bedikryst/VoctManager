---
/**
 * @file SiteIcons.astro
 * @description Shared browser and home-screen icons for the public site's document shells.
 */
const iconVersion = "20261001";
const faviconSizes = [16, 32, 48];
---

<link rel="icon" type="image/x-icon" href={`/favicon-${iconVersion}.ico`} />
{
  faviconSizes.map((size) => (
    <link
      rel="icon"
      type="image/png"
      sizes={`${size}x${size}`}
      href={`/favicon-${size}-${iconVersion}.png`}
    />
  ))
}
<link
  rel="apple-touch-icon"
  sizes="180x180"
  href={`/apple-touch-icon-${iconVersion}.png`}
/>
