---
/**
 * @file BleedImage.astro
 * @description Art-directed full-bleed image for heroes / full-screen sections. Takes
 *  separate desktop + mobile source imports (originals living under src/assets) and emits an
 *  optimized <picture>: AVIF + WebP at responsive widths, generated at build time by Astro's
 *  image pipeline (Sharp). Carries its own cover crop + native scroll-driven parallax (zero JS).
 *  Content (in-flow) images should use <Image> directly; this is only for edge-to-edge media.
 *
 *  The `mobile` source is ART DIRECTION and not a convenience: `bleedPair` (lib/photos) falls
 *  back to the desktop file when no `-mobile` exists, and a landscape frame in a full-height
 *  portrait box is drawn ~3.9 screen widths across — soft at any rendition, and holding a
 *  quarter of the photograph besides. `coverVw` below states that magnification honestly, which
 *  keeps a missing crop merely expensive rather than blurred; the crop is what makes it neither.
 * @architecture Astro islands 2026
 * @module components/BleedImage
 */
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  desktop: ImageMetadata;
  mobile: ImageMetadata;
  alt: string;
  /** object-position for the cover crop, e.g. "center 40%". */
  position?: string;
  /** Above-the-fold hero → eager + high fetch priority. */
  eager?: boolean;
  /** max-width (px) below which the mobile crop is served. */
  breakpoint?: number;
  /** Add slow Ken Burns animation. */
  animate?: boolean;
  /**
   * Drift speed against scroll distance, for the `[data-parallax]` controller in BaseLayout.
   * The default suits a section about as tall as the viewport. A SHORT band must lower it or
   * the drift runs out of room partway through and visibly stops: the room is `±10%` of the
   * frame, the pass is `vh + frameH` long, so the ceiling is `0.2 · frameH / (vh + frameH)`.
   * The controller's header states the same arithmetic from its side.
   */
  parallax?: number;
}

const {
  desktop,
  mobile,
  alt,
  position = "center",
  eager = false,
  breakpoint = 760,
  animate = false,
  parallax = 0.16,
} = Astro.props;

const DESKTOP_WIDTHS = [1280, 1920, 2560];
// Reaches 1600 because the phone regime genuinely needs it — see `coverVw` below for the
// arithmetic. The ladder, not `sizes`, is where the byte budget is stated: `sizes` tells the
// browser the truth about how wide the photograph is drawn, and if the truth is past the last
// candidate the browser takes the last candidate. That is the trade being made deliberately at
// 3× — 1600 against a ~1900px need is a rendition nobody can tell from exact, and 1920 for a
// hero on a phone is not.
const MOBILE_WIDTHS = [640, 900, 1200, 1600];

/** The bleed box's height as a multiple of its section, which this site always gives a full
 *  viewport: `.bleed` below is `height: 120%`, and the drift room is real pixels the photograph
 *  has to fill. */
const BOX_HEIGHT = 1.2;
/** The narrowest viewport aspect (w ÷ h) a phone in portrait presents — 393 × 852. The
 *  NARROWEST and not an average, because `cover` magnifies a photograph most where the box is
 *  tallest against its width, and an average is exactly what leaves the tall phones this crop
 *  exists for under-served. */
const PHONE_ASPECT = 0.46;

/**
 * How wide the photograph is really DRAWN, in vw, once `cover` has scaled it to fill a box that
 * is proportionally taller than the photograph is deep. This — not 100vw — is what `sizes` must
 * say on the phone: the box is 100vw, but the browser then picks a rendition it has to scale UP
 * by this factor, and it has no way to know the crop is happening. A 3:2 photograph with no
 * portrait variant, in a 120%-tall box on a 393px phone, is drawn across 3.9 screen widths. That
 * is why an uncropped hero looks the way it does there, and why a `-mobile` file has to be a
 * genuine tall CROP rather than merely a smaller copy: the factor falls with the source's own
 * aspect, and only a crop near the phone's own shape brings it to 1.
 */
const coverVw = (img: ImageMetadata): string =>
  `${Math.max(100, Math.round((100 * BOX_HEIGHT * (img.width / img.height)) / PHONE_ASPECT))}vw`;

async function srcset(
  img: ImageMetadata,
  widths: number[],
  format: "avif" | "webp",
): Promise<string> {
  const usable = widths.filter((w) => w <= img.width);
  if (usable.length === 0) usable.push(img.width);
  const built = await Promise.all(
    usable.map((w) => getImage({ src: img, width: w, format })),
  );
  return built.map((b, i) => `${b.src} ${usable[i]}w`).join(", ");
}

const [dAvif, dWebp, mAvif, mWebp, fallback] = await Promise.all([
  srcset(desktop, DESKTOP_WIDTHS, "avif"),
  srcset(desktop, DESKTOP_WIDTHS, "webp"),
  srcset(mobile, MOBILE_WIDTHS, "avif"),
  srcset(mobile, MOBILE_WIDTHS, "webp"),
  getImage({ src: desktop, width: 1920, format: "webp" }),
]);

const mq = `(max-width: ${breakpoint}px)`;
const mSizes = coverVw(mobile);
---

<picture class="bleed" style={`--bleed-pos:${position}`} data-parallax={String(parallax)}>
  <source media={mq} type="image/avif" srcset={mAvif} sizes={mSizes} />
  <source media={mq} type="image/webp" srcset={mWebp} sizes={mSizes} />
  {/* The desktop pair keeps a flat 100vw, and that is the correct number rather than an
      omission: with a landscape source the desktop box is WIDTH-driven, so `cover` does not
      magnify at all. It would only begin to above a 1.5 source in a window narrower than 1.8
      aspect — a short or squared window — and by ~10% even there. Computing it would push every
      ordinary 1920 desktop off the 1920 candidate and onto 2560 to buy that 10% back. */}
  <source type="image/avif" srcset={dAvif} sizes="100vw" />
  <source type="image/webp" srcset={dWebp} sizes="100vw" />
  <img
    src={fallback.src}
    width={desktop.width}
    height={desktop.height}
    alt={alt}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : "auto"}
    decoding="async"
    class={animate ? "is-animated" : undefined}
  />
</picture>

<style>
  .bleed {
    display: block;
    position: absolute;
    top: -10%;
    left: 0;
    width: 100%;
    height: 120%;
    will-change: transform;
    /* The photo's own ground, for every moment it has not painted yet — a cold cache, a
       cross-page navigation, a failed decode. #080807 is the same bedrock the page transition
       sits on, so an unpainted hero reads as the site's dark ground rather than as the parchment
       body showing through, which is what made a navigation flash white. */
    background-color: #080807;
  }
  .bleed img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--bleed-pos, center);
  }
  /* A photo that lands after its section is already on screen otherwise appears in a
     single frame — the one motion this site never makes. The class is added by the
     script below ONLY to an image that is still in flight (it has no pixels to hide, so
     nothing can flash), and removed when it can paint. An already-loaded photo is never
     touched: hiding one mid-navigation is exactly how the hero used to flash. */
  .bleed img.is-arriving {
    opacity: 0;
  }
  .bleed img {
    transition: opacity 0.9s ease;
  }
  .bleed img.is-animated {
    will-change: transform;
    animation: bleedKenBurns 38s ease-in-out infinite alternate;
  }
  @keyframes bleedKenBurns {
    0% { transform: scale(1.06) translate3d(0, 0, 0); }
    50% { transform: scale(1.12) translate3d(-1.4%, -0.8%, 0); }
    100% { transform: scale(1.08) translate3d(1.2%, 0.6%, 0); }
  }
  /* Parallax drift is applied via JS (the [data-parallax] controller in BaseLayout) so it
     works in every browser — native scroll-driven animation-timeline is still partial in
     Firefox / older Safari. The 120% height gives the drift room to never expose an edge. */
  @media (prefers-reduced-motion: reduce) {
    .bleed { top: 0; height: 100%; transform: none !important; }
    .bleed img.is-animated { animation: none; transform: scale(1.02); }
    .bleed img { transition: none; }
  }
</style>

<script>
  // Marks the bleed photos that are still in flight, so CSS can bring them in instead of
  // letting them appear in one frame. Deliberately one-directional: an image that is
  // already complete is left alone entirely — the fade exists for arrivals, and hiding a
  // painted hero for even a frame is the flash the transition work went to remove.
  const settleBleeds = (): void => {
    const arriving = document.querySelectorAll<HTMLImageElement>("picture.bleed img");
    arriving.forEach((img) => {
      if (img.complete || img.dataset.arriving === "1") return;
      img.dataset.arriving = "1";
      img.classList.add("is-arriving");
      const reveal = (): void => img.classList.remove("is-arriving");
      img.addEventListener("load", reveal, { once: true });
      img.addEventListener("error", reveal, { once: true });
    });
  };

  settleBleeds();
  document.addEventListener("astro:page-load", settleBleeds);
</script>
