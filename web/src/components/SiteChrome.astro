---
/**
 * @file SiteChrome.astro
 * @description Shared marketing navigation (header). Lifted from MarketingChrome.tsx +
 *  the chrome CSS the SPA duplicated in every page stylesheet — now scoped once here.
 *  The scroll/menu behavior is a tiny document-delegated script (no per-element rebinding),
 *  so it survives ClientRouter swaps without leaking listeners.
 * @architecture Astro islands 2026
 * @module components/SiteChrome
 */
import { getCollection } from "astro:content";
import { toRibbons } from "../lib/registrum";
import type { TabulaEntry } from "../lib/tabula";
import { UI } from "../i18n/ui";
import { localizePath, LOCALE_META, DEFAULT_LOCALE, LANG_SWITCHER_ENABLED, type Locale } from "../i18n/config";
import "../styles/tabula.css";

interface Props {
  /** Base path of the current page (locale-neutral, e.g. "/o-nas") so the matching nav link gets
      aria-current — concert pages pass their FULL path ("/koncerty/wcielenie") so the matching
      ribbon can carry the crimson stitch, and the bare KONCERTY link takes the SECTION state
      (see onKoncerty). Also the anchor the language switcher localizes into each locale. */
  current?: string;
  /** "dark" pages (koncerty) get a night solid header + an is-light state over paper sections. */
  tone?: "light" | "dark";
  /** Page locale — selects the vernacular nav labels and localizes the site links (Latin rubrics
      stay put). Defaults to Polish, so every un-migrated caller renders byte-identical to before. */
  lang?: Locale;
  /** Locales this page actually exists in. The language switcher appears only when there is a real
      choice beyond Polish; a Polish-only page (the default) shows none. */
  availableLocales?: Locale[];
  /** The page's OWN sections, in reading order — its table of contents (styles/tabula.css). Pass
      them and the bar grows a "tabula" that a run back UP the document summons; pass none (the
      default) and neither the markup nor the scroll listener exists. Only worth passing on a page
      long enough that its head has scrolled out of reach — see the header of tabula.css. */
  index?: readonly TabulaEntry[];
}
const {
  current,
  tone = "light",
  lang = DEFAULT_LOCALE,
  availableLocales = [DEFAULT_LOCALE],
  index = [],
} = Astro.props;
const t = UI[lang];

/* The "registrum" — desktop register ribbons under KONCERTY (styles/registrum.css),
   derived from the concerts collection (page-bearing entries only, Via order). Ribbon hrefs point
   at concert pages, which stay Polish-only for now, so they are NOT localized. */
const ribbons = toRibbons(await getCollection("concerts"));
/* SECTION state, not page state — `data-section` is the visual "you are somewhere in here"
   and it is a separate attribute from `aria-current` on purpose. `aria-current="page"` is a
   claim that THIS LINK POINTS AT THE PAGE YOU ARE ON, so on /koncerty/wcielenie it belongs to
   the ribbon alone; the bare KONCERTY link points at /koncerty, which is not that page. Left
   on both, a screen reader announced "current page" twice in one nav, at two different URLs.
   The mobile card resolves the same question the same way — its Koncerty voice takes no
   aria-current on a concert page, because the Via row underneath is where the reader is. */
const onKoncerty = current === "/koncerty" || current?.startsWith("/koncerty/");

/* The mobile "Vitta" ribbon's resting line, in the card's two units (nave-menu.css GEOMETRY):
   --vb whole bands, --vr Via rows. The four voices sit at band i + 1.5; a concert page sits in
   the Via register, five bands down and (k + 1.5) rows into it — so the ribbon points at the
   exact concert being read rather than parking on KONCERTY. Null on pages the card does not
   index (press/kolofon), where the ribbon ships shut (no `is-set`, height 0).
   NOTE: the bare /koncerty page is voice 2; its own concert pages are NOT (see naveConcert),
   which is also what keeps tapping KONCERTY from a concert page a real navigation instead of
   a dismissal. */
const naveConcert = ribbons.findIndex((r) => r.href === current);
const naveRest =
  naveConcert >= 0
    ? { vb: 5, vr: naveConcert + 1.5 }
    : current === "/"
      ? { vb: 1.5, vr: 0 }
      : current === "/o-nas"
        ? { vb: 2.5, vr: 0 }
        : current === "/koncerty"
          ? { vb: 3.5, vr: 0 }
          : current === "/kontakt"
            ? { vb: 4.5, vr: 0 }
            : null;

/* Localized destinations — Polish returns the bare path (identical output), other locales get a
   prefix ONLY for pages that are translated (localizePath falls back to the Polish URL otherwise). */
const hrefHome = localizePath("/", lang);
const hrefAbout = localizePath("/o-nas", lang);
const hrefConcerts = localizePath("/koncerty", lang);
const hrefContact = localizePath("/kontakt", lang);

/* Language switcher: hidden globally for now (LANG_SWITCHER_ENABLED) — EN/FR stay reachable by
   direct link only. When on, it shows only where the page has a real alternate (more than Polish);
   each option localizes the current base path into its locale (same page, other language). */
const showLang = LANG_SWITCHER_ENABLED && availableLocales.length > 1 && !!current;
const langOptions = showLang
  ? availableLocales.map((loc) => ({
      loc,
      href: localizePath(current as string, loc),
      // The vernacular's own endonym (Polski / English / Français) — the choice of tongue named
      // in that tongue, not an ISO code. Locale-neutral proper names, so never translated.
      name: LOCALE_META[loc].name,
      isCurrent: loc === lang,
    }))
  : [];
---

<header class="chrome" id="chrome" data-tone={tone} aria-label={t.nav.ariaHeader}>
  {/* The brand is part of the page root snapshot — it fades through the dark threshold with
      everything else (transitions.css) rather than morphing as a shared element. A shared
      element only ever showed artifacts here (position slip vs. is-solid padding, ink↔candle
      colour flip, and a different glyph anatomy on the landing), so it was removed. */}
  <a class="chrome-brand" href={hrefHome} aria-label={t.nav.brandAria}>
    <span class="brand-mark" aria-hidden="true"></span>
    <span>VoctEnsemble</span>
  </a>

  <nav class="chrome-nav" aria-label={t.nav.ariaPrimary}>
    <a href={hrefAbout} aria-current={current === "/o-nas" ? "page" : undefined}>{t.nav.about}</a>
    {/* "Registrum" — hover/focus on KONCERTY lets mute breviary register silks slip from
        under the bar beside an ink index; each row's hairline leader runs to its silk's
        tip (registrum.css). Pure CSS state — the link itself stays a plain navigation to
        /koncerty (the drop is enhancement only). */}
    <div class="registrum">
      <a
        href={hrefConcerts}
        aria-current={current === "/koncerty" ? "page" : undefined}
        data-section={onKoncerty ? "" : undefined}>{t.nav.concerts}</a>
      {/* The hush: full-viewport fixed layer quieting the whole page while the register
          hangs open — a SIBLING of the drop (the drop's transform would hijack its fixed
          containing block, see registrum.css traps). */}
      <span class="registrum-hush" aria-hidden="true"></span>
      <div class="registrum-drop">
        <div class="registrum-sleeve" style={`--n: ${ribbons.length};`}>
          {
            ribbons.map((r, i) => (
              <a
                class="ribbon"
                href={r.href}
                style={`--rib: ${r.accent}; --i: ${i};`}
                aria-current={current === r.href ? "page" : undefined}
              >
                <span class="ribbon-line">
                  <span class="ribbon-roman">{r.roman}</span>
                  <span class="ribbon-title">{r.title}</span>
                  <span class="ribbon-thread" aria-hidden="true"></span>
                </span>
                <span class="ribbon-meta">{r.meta}</span>
                <span class="ribbon-silk" aria-hidden="true">
                  <span class="ribbon-cord"></span>
                  <span class="ribbon-strip"></span>
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
    <a href={hrefContact} aria-current={current === "/kontakt" ? "page" : undefined}>{t.nav.contact}</a>
    <a class="nav-support" href="/?donate" data-vault-open="100">{t.nav.support}</a>
    {
      showLang && (
        <span class="chrome-lang" role="group" aria-label={t.nav.langAria}>
          {langOptions.map((o, i) => (
            <Fragment>
              {i > 0 && (
                <span class="chrome-lang-sep" aria-hidden="true">
                  ·
                </span>
              )}
              <a
                class="chrome-lang-opt"
                href={o.href}
                hreflang={o.loc}
                lang={o.loc}
                aria-current={o.isCurrent ? "true" : undefined}
              >
                {o.name}
              </a>
            </Fragment>
          ))}
        </span>
      )
    }
  </nav>

  {/* "Tabula" — the page's own table of contents, and the bar's second register: a band in the
      bar's own material that unrolls from its line when the reader runs back UP the document
      (styles/tabula.css; the gesture is at the foot of this file). It exists only where a page
      passed one. The mobile card indexes the SITE and this indexes the PAGE — different
      questions, and the reason both exist on a phone.

      A real <nav> landmark, because a table of contents is exactly what that landmark is for, and
      it costs nothing at rest: `visibility: hidden` takes the whole subtree out of the
      accessibility tree until the gesture asks for it. The sheet is a wrapper the band's own
      height animation clips against — see the unrolling note in the stylesheet; it is NOT
      decoration and must not be flattened away. */}
  {
    index.length > 0 && (
      <nav class="tabula" aria-label={t.nav.tabulaAria}>
        <div class="tabula-sheet">
          <div class="tabula-wrap">
            {index.map((e, i) => (
              <a class="tabula-entry" href={`#${e.id}`} style={`--i: ${i};`}>
                <span class="tabula-roman">{e.roman}</span>
                <span class="tabula-title">{e.title}</span>
                <span class="tabula-lead" aria-hidden="true" />
                {e.figure && (
                  <span class="tabula-figure" lang={e.figureLang}>
                    {e.figure}
                  </span>
                )}
                {e.latin && (
                  <span class="tabula-meta micro">
                    <span class="lat" lang="la">
                      {e.latin}
                    </span>
                    {e.meta && (
                      <>
                        <span class="tabula-dot" aria-hidden="true">
                          {" · "}
                        </span>
                        <span>{e.meta}</span>
                      </>
                    )}
                  </span>
                )}
              </a>
            ))}
          </div>
        </div>
      </nav>
    )
  }

  <button
    class="nav-toggle"
    id="navToggle"
    type="button"
    aria-expanded="false"
    aria-controls="navMenu"
    aria-label={t.nav.menu}></button>

  {/* "Vitta" — the shared mobile overlay (nave-menu.css): a ruled parchment page whose every
      line sits on one band — the hour's antiphon, the four index entries, the Wesprzyj line —
      with ONE crimson ribbon falling down the left margin from the head rule to the current
      voice: the book is open where you are. Concert accents stay OUT of this card (see the DYE note
      in nave-menu.css). The card carries NO brand of its own: the bar's .chrome-brand persists
      ABOVE the overlay (z-index 61, tinted to ink — see the style block), so the mark never
      blinks. There is exactly ONE ribbon element; `--vb`/`--vr` set its resting row and the
      script below RETARGETS it on commit so it runs through the slot (never two ribbons swapping
      — see nave-menu.css). On a /koncerty/* page the ribbon stands at that concert's VIA ROW,
      not at the Koncerty voice: crimson marks the page you are on, in exactly one place, and
      the voice above it stays plain ink so tapping it is a real navigation (see naveRest). */}
  <nav class="nave" id="navMenu" aria-label={t.nav.ariaPrimary}>
    <div class="nave-veil"></div>

    <div class="nave-inner">
      <div class="nave-top">
        <button class="nave-close" id="menuClose" type="button" aria-label={t.nav.closeAria}>{t.nav.close}</button>
      </div>

      <div class="nave-list">
        <span
          class={`vitta${naveRest ? " is-set" : ""}`}
          style={naveRest ? `--vb: ${naveRest.vb}; --vr: ${naveRest.vr};` : undefined}
          aria-hidden="true"
        >
          <span class="vitta-cord"></span>
          <span class="vitta-strip"></span>
        </span>
        {/* The antiphon names its hour — the page's first ruled line, name left and poem right
            across the measure, the card's one living element; filled with the live canonical
            hour on open (script below). */}
        <span class="nave-antiphon">
          <span id="naveHoraName">Hora</span>
          <em id="naveHoraPoem">canonica</em>
        </span>
        {/* Each voice is one index entry — word · leader · incipit (nave-menu.css). The leader
            is drawn furniture, hence aria-hidden; the vernacular word leads in the DOM so the
            reading order is the same as the reading order on the page. */}
        <a
          class="voice"
          href={hrefHome}
          style="--i: 0; --vb: 1.5; --vr: 0"
          aria-current={current === "/" ? "page" : undefined}
        >
          <span class="voice-pl">{t.nav.home}</span>
          <span class="voice-lead" aria-hidden="true"></span>
          <span class="voice-lat">Introitus</span>
        </a>
        <a
          class="voice"
          href={hrefAbout}
          style="--i: 1; --vb: 2.5; --vr: 0"
          aria-current={current === "/o-nas" ? "page" : undefined}
        >
          <span class="voice-pl">{t.nav.about}</span>
          <span class="voice-lead" aria-hidden="true"></span>
          <span class="voice-lat">De nobis</span>
        </a>
        <a
          class="voice"
          href={hrefConcerts}
          style="--i: 2; --vb: 3.5; --vr: 0"
          aria-current={current === "/koncerty" ? "page" : undefined}
        >
          <span class="voice-pl">{t.nav.concerts}</span>
          <span class="voice-lead" aria-hidden="true"></span>
          <span class="voice-lat">Via</span>
        </a>
        <a
          class="voice"
          href={hrefContact}
          style="--i: 3; --vb: 4.5; --vr: 0"
          aria-current={current === "/kontakt" ? "page" : undefined}
        >
          <span class="voice-pl">{t.nav.contact}</span>
          <span class="voice-lead" aria-hidden="true"></span>
          <span class="voice-lat">Scribe nobis</span>
        </a>

        {/* THE VIA — the concert register (nave-menu.css): the site's own depth printed in the
            card, and the phone's only road to the pages the desktop hangs under KONCERTY.
            Rows are the desktop register's grammar one step down (roman · title · leader ·
            date), all of it derived from concerts.yaml. Concert pages stay Polish-only, so the
            hrefs are NOT localized — same rule as the desktop ribbons. The label counts as the
            register's first --vrow (see GEOMETRY), which is why row k sits at --vr: k + 1.5.
            That one number is load-bearing twice over: it places the ribbon's tip on the row AND
            paces the register's entrance, since (--vr − 0.5) is the row's ordinal in the run
            (nave-menu.css). No separate `--i` in here for that reason — a second index could
            drift out of step with the first. */}
        <div class="via">
          <span class="via-label">Via</span>
          {
            ribbons.map((r, i) => (
              <a
                class="via-row"
                href={r.href}
                style={`--vb: 5; --vr: ${i + 1.5}`}
                aria-current={current === r.href ? "page" : undefined}
              >
                <span class="via-roman">{r.roman}</span>
                <span class="via-title">{r.title}</span>
                <span class="via-lead" aria-hidden="true" />
                <span class="via-date">{r.viaDate}</span>
              </a>
            ))
          }
        </div>
      </div>

      {/* Translated pages close with the language imprint under the Wesprzyj line (has-lang
          widens the foot's breathing room); untranslated feet end at the closing line. */}
      <div class:list={["nave-foot", { "has-lang": showLang }]}>
        {/* The closing line of the page — the same entry grammar as the voices above, one step
            smaller, under the foot's gold rule. Not a button: see nave-menu.css. */}
        <a class="nave-cta" href="/?donate" data-vault-open="100">
          <span class="nave-cta-word">{t.nav.support}</span>
          <span class="voice-lead" aria-hidden="true"></span>
          <em class="voice-lat">Sustinete nos</em>
        </a>
        {/* The page's fine print — Kolofon is a real page with no other road from the phone
            (nave-menu.css). /press stays out on purpose: a noindex press kit is addressed to
            journalists, not to a reader opening the menu. */}
        <span class="nave-fine">
          <a href="/kolofon" aria-current={current === "/kolofon" ? "page" : undefined}>Kolofon</a>
        </span>
        {
          showLang && (
            <div class="nave-imprint">
              <span class="nave-lang" role="group" aria-label={t.nav.langAria}>
                {langOptions.map((o, i) => (
                  <Fragment>
                    {i > 0 && (
                      <span class="nave-lang-sep" aria-hidden="true">
                        ·
                      </span>
                    )}
                    <a
                      class="nave-lang-opt"
                      href={o.href}
                      hreflang={o.loc}
                      lang={o.loc}
                      aria-current={o.isCurrent ? "true" : undefined}
                    >
                      {o.name}
                    </a>
                  </Fragment>
                ))}
              </span>
            </div>
          )
        }
      </div>
    </div>
  </nav>
</header>

<style>
  /* Padding is written out in all four sides deliberately. The safe-area inset belongs to the TOP
     alone — under `viewport-fit=cover` (BaseLayout) a two-value shorthand would hand the same
     ~59px notch calc to the bottom and swell the resting bar. The side gutters take the landscape
     insets via `max()`, so a rotated phone never sets the brand or the toggle under the camera. */
  .chrome { position: fixed; inset: 0 0 auto 0; z-index: 50; display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: calc(env(safe-area-inset-top, 0px) + 22px) max(28px, 5vw, env(safe-area-inset-right, 0px)) 22px max(28px, 5vw, env(safe-area-inset-left, 0px)); color: var(--paper); background: transparent; border-bottom: 1px solid transparent; transition: color .5s var(--ease), background-color .5s var(--ease), border-color .5s var(--ease), padding .5s var(--ease), backdrop-filter .5s var(--ease); }
  .chrome::before { content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none; background: linear-gradient(180deg, rgba(8,8,7,.5) 0%, rgba(8,8,7,0) 100%); opacity: 1; transition: opacity .5s var(--ease); }
  /* Glass rides a ::after LAYER, not the .chrome root. A non-`none` backdrop-filter turns its
     element into the containing block for `position: fixed` descendants — and the "Antyfona"
     overlay (.nave) is a fixed child of .chrome. On the root, a scrolled (solid) bar clipped the
     mobile overlay to the bar height; keeping the root filter-free lets .nave fill the viewport. */
  /* Do NOT bleed this pane above the bar to cover the band iOS Safari opens over a fixed header
     — `fixed` layers are clipped to the layout viewport there and an overhang paints nothing
     (measured; sticky and visualViewport offsets fail too). That band is filled by the body's
     background-color instead — see `--edge-band` in tokens.css. */
  .chrome::after { content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none; border-bottom: 1px solid transparent; opacity: 0; transition: opacity .5s var(--ease), background-color .5s var(--ease), border-color .5s var(--ease); }
  .chrome.is-solid::after { opacity: 1; background-color: rgba(244, 241, 233, 0.82); backdrop-filter: blur(20px) saturate(1.5); -webkit-backdrop-filter: blur(20px) saturate(1.5); border-bottom-color: rgba(22, 21, 20, 0.08); }
  .chrome.is-solid { color: var(--ink); padding-top: calc(env(safe-area-inset-top, 0px) + 16px); padding-bottom: 14px; }
  .chrome.is-solid::before { opacity: 0; }

  /* z-index 61 lifts the brand ABOVE the "Antyfona" overlay (.nave, z:60) — it is the ONE bar
     element that persists while the card is open, so the mark never blinks out and back in. */
  .chrome-brand { display: inline-flex; align-items: center; gap: 12px; font-family: var(--serif); font-size: 21px; font-weight: 300; letter-spacing: .03em; color: inherit; position: relative; z-index: 61; }
  /* Raster master at this size — the vector's thin arm is 0.19px here and drops out on repaint.
     See the dual-master note on `.brand-glyph-shape` in styles/base.css. */
  .chrome-brand .brand-mark { width: 17px; height: 40px; flex-shrink: 0; background: var(--candle); -webkit-mask: url(/logo-mark.png) center / contain no-repeat; mask: url(/logo-mark.png) center / contain no-repeat; transition: background-color .5s var(--ease); }
  .chrome.is-solid .chrome-brand .brand-mark { background: var(--ink); }

  .chrome-nav { display: flex; align-items: center; gap: clamp(16px, 2.4vw, 34px); }
  /* Direct children (+ the registrum's trigger link) ONLY — a bare `.chrome-nav a` also
     dressed the registrum's ribbon anchors (scoped attribute selectors out-specify the
     global registrum.css), turning the index rows into tracked-uppercase mono chips. */
  /* Capitalis, not mono: this is the most-repeated rubric on the site and it sits inches
     from the wordmark — left on the typewriter voice it read as a different system from
     every eyebrow beneath it. Tracking drops .2em → .14em because Cinzel's capitals are
     already wide; at .2em the five items stopped fitting between brand and language
     switcher at the 760px floor. Weight 500 for the same reason .eyebrow uses it. */
  .chrome-nav > a, .chrome-nav .registrum > a { font-family: var(--capitalis); font-size: 10.5px; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; color: inherit; opacity: .82; position: relative; padding-bottom: 3px; transition: opacity .35s var(--ease); }
  .chrome-nav > a::after, .chrome-nav .registrum > a::after { content: ""; position: absolute; left: 0; bottom: 0; width: 100%; height: 1px; background: currentColor; transform: scaleX(0); transform-origin: left; transition: transform .4s var(--ease); }
  .chrome-nav > a:hover, .chrome-nav .registrum > a:hover { opacity: 1; }
  /* The marked state is keyed to `[data-section]` for KONCERTY and to `[aria-current]` for
     everything else: the concert pages hang under KONCERTY, so the bar has to show the section
     while the exact-page claim stays on the ribbon inside the drop (see onKoncerty). Both
     attributes are present on /koncerty itself; the two rules land the same look either way. */
  .chrome-nav > a:hover::after, .chrome-nav .registrum > a:hover::after,
  .chrome-nav > a[aria-current="page"]::after, .chrome-nav .registrum > a[data-section]::after { transform: scaleX(1); }
  /* GOLD THAT IS READ FOLLOWS THE BAR'S OWN GROUND, and `--chrome-candle` (foot of this sheet) is
     where that is decided once. Full candle is 8.08 : 1 over night and 2.10 : 1 over parchment, so
     a single value cannot serve a bar that changes ground under the scroll — and WESPRZYJ is set
     at 10.5px in tracked capitals, i.e. the least forgiving text on the site. Marks are exempt and
     stay on `--candle`: the brand mark carries no contrast minimum and flips to ink on its own. */
  .chrome-nav > a[aria-current="page"], .chrome-nav .registrum > a[data-section] { opacity: 1; color: var(--chrome-candle); }
  .chrome-nav .nav-support { color: var(--chrome-candle); opacity: 1; }

  /* Language switcher — the choice of vernacular, each tongue named in its own word and set in the
     site's serif-italic "voice" register (not the mono rubric of the links beside it), a hairline
     rule setting the trio apart. The current tongue reads in candle with its hairline underline
     drawn; the alternates recede until hover — the same underline grammar as every other nav link.
     Middot separators are neutral (their own colour), so the active option can't tint them. */
  .chrome-lang { display: inline-flex; align-items: baseline; gap: 9px; margin-left: 4px; padding-left: 18px; border-left: 1px solid color-mix(in srgb, currentColor 20%, transparent); }
  .chrome-lang-opt { position: relative; font-family: var(--serif); font-style: italic; font-size: 14px; line-height: 1; color: color-mix(in srgb, currentColor 52%, transparent); padding-bottom: 3px; transition: color .35s var(--ease); }
  .chrome-lang-opt::after { content: ""; position: absolute; left: 0; bottom: 1px; width: 100%; height: 1px; background: currentColor; transform: scaleX(0); transform-origin: left; transition: transform .4s var(--ease); }
  .chrome-lang-opt:hover { color: inherit; }
  .chrome-lang-opt:hover::after, .chrome-lang-opt[aria-current="true"]::after { transform: scaleX(1); }
  .chrome-lang-opt[aria-current="true"] { color: var(--chrome-candle); }
  .chrome-lang-sep { font-family: var(--serif); font-style: italic; font-size: 14px; line-height: 1; color: color-mix(in srgb, currentColor 30%, transparent); }

  /* Mobile switcher — the same vernacular voice, printed a touch larger as an imprint line in the
     card foot (its column placement lives in nave-menu.css). Touch surface → :active, no :hover. */
  .nave-lang { display: inline-flex; align-items: baseline; gap: 11px; }
  .nave-lang-opt { position: relative; font-family: var(--serif); font-style: italic; font-size: 17px; line-height: 1; color: color-mix(in srgb, var(--ink) 48%, transparent); padding-bottom: 3px; transition: color .3s var(--ease); }
  .nave-lang-opt::after { content: ""; position: absolute; left: 0; bottom: 1px; width: 100%; height: 1px; background: currentColor; transform: scaleX(0); transform-origin: left; transition: transform .4s var(--ease); }
  .nave-lang-opt:active::after, .nave-lang-opt[aria-current="true"]::after { transform: scaleX(1); }
  .nave-lang-opt[aria-current="true"] { color: var(--candle); }
  .nave-lang-sep { font-family: var(--serif); font-style: italic; font-size: 17px; line-height: 1; color: color-mix(in srgb, var(--ink) 28%, transparent); }

  /* Mobile menu */
  .nav-toggle { display: none; position: relative; width: 26px; height: 14px; border: 0; background: transparent; color: inherit; cursor: pointer; padding: 0; }
  .nav-toggle::before, .nav-toggle::after { content: ""; position: absolute; right: 0; height: 1px; background: currentColor; transition: width .35s var(--ease); }
  .nav-toggle::before { top: 4px; width: 26px; }
  .nav-toggle::after { top: 10px; width: 15px; }
  .nav-toggle:hover::after { width: 26px; }

  /* When the "Antyfona" card opens, only the TOGGLE clears (the card carries "Zamknij"); the
     brand stays put above the card and eases to ink with the card's fade — see the menu-open
     overrides at the END of this block (they must follow the dark-tone rules to win the tie). */
  .nav-toggle { transition: opacity .3s var(--ease); }
  .chrome.menu-open .nav-toggle,
  .chrome.menu-closing .nav-toggle { opacity: 0; pointer-events: none; transition: opacity .12s var(--ease); }
  .chrome-brand { transition: color .32s var(--ease); }

  /* 759.98 / 760 boundary matches nave-menu.css so no fractional viewport falls between
     "hamburger shown" and "overlay available". */
  @media (max-width: 759.98px) {
    .chrome-nav { display: none; }
    .nav-toggle { display: inline-flex; }
  }

  /* ── Dark-tone pages (koncerty) ─────────────────────────────────────────
     Solid header is night (not paper); when a light section scrolls under it,
     the page toggles .is-light to flip to the paper treatment. */
  .chrome[data-tone="dark"].is-solid::after {
    opacity: 1;
    background-color: rgba(16, 15, 13, 0.72);
    backdrop-filter: blur(20px) saturate(1.2);
    -webkit-backdrop-filter: blur(20px) saturate(1.2);
    border-bottom-color: rgba(244, 241, 233, 0.12);
  }
  .chrome[data-tone="dark"].is-solid { color: var(--paper); }
  .chrome[data-tone="dark"].is-solid .chrome-brand .brand-mark { background: var(--candle); }

  /* is-light can be set independently of is-solid (a paper section under a not-yet-scrolled bar),
     so the paper glass must carry its own opacity rather than borrow it from is-solid::after. */
  .chrome[data-tone="dark"].is-light::after {
    opacity: 1;
    background-color: rgba(244, 241, 233, 0.82);
    backdrop-filter: blur(20px) saturate(1.1);
    -webkit-backdrop-filter: blur(20px) saturate(1.1);
    border-bottom-color: rgba(22, 21, 20, 0.1);
  }
  .chrome[data-tone="dark"].is-light { color: var(--ink); }
  .chrome[data-tone="dark"].is-light::before { opacity: 0; }
  .chrome[data-tone="dark"].is-light .chrome-brand .brand-mark { background: var(--ink); }

  /* ── The bar's readable gold ────────────────────────────────────────────
     ONE PLACE DECIDES IT, and the condition is not the tone but the GROUND the bar is standing on
     at this scroll position — which is exactly the condition that already decides `color` above.
     Light tone unscrolled is paper text over a dark scrim on the hero photograph, dark tone solid
     is night glass: both are dark grounds and keep full candle. The two parchment states are the
     light bar once it goes solid and the dark bar over a `.tone-light` section, and those are the
     two rules below. Read them as "wherever this bar sets `color: var(--ink)`", because that is
     what they track; if a third parchment state is ever added, it belongs here in the same breath
     as its `color`, or the gold silently stays at 2.10 : 1 on it. */
  .chrome { --chrome-candle: var(--candle); }
  .chrome.is-solid:not([data-tone="dark"]),
  .chrome[data-tone="dark"].is-light { --chrome-candle: var(--candle-ink); }

  /* ── The tabula open: the BAR JOINS THE BAND ───────────────────────────────────────────────
     The band (styles/tabula.css) is an opaque sheet, and a glass bar sitting on top of an opaque
     sheet draws a seam straight across the middle of what is meant to read as ONE object deepening
     by a register. So while the index is out the bar takes the sheet's own ground, drops its
     backdrop blur (nothing shows through an opaque layer — the filter would only cost a raster)
     and hands its hairline down to the band's foot, so the pair closes with exactly one rule.

     These live HERE rather than in tabula.css because Astro appends `[data-astro-cid-…]` to every
     compound in a scoped block: the `.chrome.is-solid::after` rules above are emitted at (0,3,0)
     and a global two-class override could never win against them. Same trap the register audit
     exists to catch. They must also follow those rules in source order — equal specificity now,
     so order is what decides. */
     Each tone states the WHOLE set rather than inheriting part of it, because `[data-tone]` is a
     class-level selector: the dark rules above land at (0,4,0) and a shorthand override at (0,3,0)
     would silently keep their glass. Every rule here therefore carries at least as many compounds
     as the rule it has to beat. */
  .chrome.tabula-open::after {
    opacity: 1;
    background-color: var(--paper);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom-color: transparent;
  }
  .chrome[data-tone="dark"].tabula-open:not(.is-light)::after {
    opacity: 1;
    background-color: var(--night);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom-color: transparent;
  }
  .chrome[data-tone="dark"].tabula-open.is-light::after {
    opacity: 1;
    background-color: var(--paper);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom-color: transparent;
  }
  /* The bar's text follows its new ground, exactly as it does when it goes solid: a dark-tone
     page whose bar is still transparent over the hero has paper text, and the paper sheet under
     it would leave that unreadable for the length of the unroll. */
  .chrome.tabula-open:not([data-tone="dark"]) {
    color: var(--ink);
  }
  .chrome.tabula-open:not([data-tone="dark"]) .chrome-brand .brand-mark {
    background: var(--ink);
  }
  .chrome.tabula-open::before {
    opacity: 0;
  }

  /* ── "Antyfona" open: the persistent brand goes ink over the parchment card ────────────────
     LAST in this block on purpose — these tie with the tone/scroll mark rules above on
     specificity, and source order is what makes the open state win in every combination. */
  .chrome.menu-open .chrome-brand,
  .chrome.menu-closing .chrome-brand { color: var(--ink); }
  .chrome.menu-open .chrome-brand .brand-mark,
  .chrome.menu-closing .chrome-brand .brand-mark,
  .chrome[data-tone="dark"].menu-open .chrome-brand .brand-mark,
  .chrome[data-tone="dark"].menu-closing .chrome-brand .brand-mark { background: var(--ink); }
  /* A scrolled (is-solid) bar is tighter (16px top pad); while the card is open, return to the
     resting padding so the persistent brand sits exactly on the card's top row — the 6px glide
     rides the bar's existing padding transition. */
  .chrome.menu-open, .chrome.menu-closing { padding-top: calc(env(safe-area-inset-top, 0px) + 22px); }

</style>

<script>
  import { navigate } from "astro:transitions/client";

  import { horaForWarsaw } from "../islands/landing/lib/horaeCanonicae";
  import {
    dismissOverlayEntry,
    isOverlayEntry,
    navigateFromOverlay,
    pushOverlayEntry,
  } from "../lib/overlayHistory";

  // Document-delegated so it binds once and survives ClientRouter DOM swaps.
  if (!(window as unknown as { __voctChrome?: boolean }).__voctChrome) {
    (window as unknown as { __voctChrome?: boolean }).__voctChrome = true;

    const chrome = () => document.getElementById("chrome");
    const toggle = () => document.getElementById("navToggle");
    const nave = () => document.getElementById("navMenu");

    const syncSolid = () => {
      const c = chrome();
      if (c) c.classList.toggle("is-solid", window.scrollY > window.innerHeight * 0.5);
    };
    // The overlay fades shut over ~0.24s (nave-menu.css) — one quiet breath, no reverse wipe.
    // `menu-closing` keeps it painted through the fade; the timer then drops both classes → hidden.
    const WIPE_MS = 260;
    // How long a chosen silk is held before the page swap fires — one beat, so the gesture
    // reads before the crossfade (transitions.css) dissolves it. Shared by the desktop
    // registrum's bookmark pull AND the mobile Vitta's ribbon descent (nave-menu.css).
    const PULL_MS = 220;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    let closeTimer = 0;

    // The overlay is a modal surface: while it is open the page behind goes inert (focus,
    // assistive tech, clicks). The nave itself lives inside <header>, so it stays live.
    const setPageInert = (on: boolean) => {
      document.querySelectorAll("main, footer").forEach((el) => {
        if (on) el.setAttribute("inert", "");
        else el.removeAttribute("inert");
      });
    };

    const clearChosen = () => {
      const c = chrome();
      c?.querySelectorAll(".is-chosen").forEach((v) => v.classList.remove("is-chosen"));
      c?.querySelector(".nave-list.is-committing")?.classList.remove("is-committing");
    };
    const finalizeClose = () => {
      window.clearTimeout(closeTimer);
      const c = chrome();
      c?.classList.remove("menu-open", "menu-closing");
      clearChosen();
      toggle()?.setAttribute("aria-expanded", "false");
      document.body.classList.remove("nav-open");
      setPageInert(false);
    };
    const openMenu = () => {
      window.clearTimeout(closeTimer);
      const c = chrome();
      if (!c) return;
      // History integration: push a hash-marked entry (via ClientRouter's own navigate(), see
      // overlayHistory.ts) so the mobile back button / edge-swipe dismisses the "Antyfona" card
      // with NO document swap. No #menu element exists (nothing scrolls); the hash is transient.
      pushOverlayEntry("navOpen", "menu");
      c.classList.remove("menu-closing");
      // The card indexes the site and the tabula indexes the page; the card is the one that was
      // asked for out loud, so it takes the screen.
      closeTabula(true);
      c.classList.add("menu-open");
      toggle()?.setAttribute("aria-expanded", "true");
      document.body.classList.add("nav-open");
      setPageInert(true);
      // The antiphon names its hour: fill the page's opening line with the live canonical hour.
      const hora = horaForWarsaw(new Date());
      const name = document.getElementById("naveHoraName");
      const poem = document.getElementById("naveHoraPoem");
      if (name) name.textContent = hora.name;
      if (poem) poem.textContent = hora.poem;
      window.requestAnimationFrame(() => {
        document.getElementById("menuClose")?.focus({ preventScroll: true });
      });
    };
    // animated=true → play the quiet close fade (Zamknij / Escape). animated=false → snap shut
    // (navigation / reduced motion), where the page swap is the transition instead.
    const closeMenu = (animated = true) => {
      const c = chrome();
      if (!c || !c.classList.contains("menu-open")) return;
      // Hand focus back to the toggle if it currently sits inside the closing overlay.
      const n = nave();
      if (n && document.activeElement && n.contains(document.activeElement)) {
        toggle()?.focus({ preventScroll: true });
      }
      toggle()?.setAttribute("aria-expanded", "false");
      if (!animated || reduce.matches) {
        finalizeClose();
        return;
      }
      c.classList.add("menu-closing");
      window.clearTimeout(closeTimer);
      closeTimer = window.setTimeout(finalizeClose, WIPE_MS);
    };
    // Pure-dismiss closers (Zamknij, Escape) pop the entry pushed on open (→ popstate → animated
    // close) so no "swallowed" back press lingers; a genuine back press lands straight in the
    // popstate handler below. Navigation-adjacent closers (voices, the vault CTA) keep closeMenu.
    const dismissMenu = () => {
      const c = chrome();
      if (c?.classList.contains("menu-open")) dismissOverlayEntry("navOpen", () => closeMenu(true));
      else closeMenu(true);
    };

    // ── THE TABULA — the page's own index, summoned by turning BACK in the document ──────────
    // Composition, and why a gesture rather than a control, in styles/tabula.css.
    //
    // The gesture is measured as TRAVEL, not as the sign of one delta, and that is the whole
    // reason this reads as an intention rather than as a twitch: `travel` accumulates while the
    // reader keeps going one way and resets the moment they turn, so the index answers a run back
    // up the page and not a notch of the wheel. Px on both paths, so one pair of numbers governs
    // Lenis and native scroll alike.
    // Two numbers, because a gesture's INTENT is not its distance and the two input devices do not
    // convert alike: a wheel notch is ~100px and a reader turning back gives two or three of them,
    // while one lazy thumb flick carries most of a screen on momentum alone. One threshold would
    // either need three deliberate wheel runs or fire on a phone every time the reader nudged.
    const TABULA_UP = window.matchMedia("(pointer: coarse)").matches ? 340 : 180;
    const TABULA_DOWN = 90;
    // Anchor clicks travel far and fast; without a mute the jump's own upward distance would
    // re-summon the surface the click just dismissed.
    const TABULA_MUTE_MS = 900;
    let tabTravel = 0;
    let tabLastY = 0;
    let tabRaf = 0;
    let tabMuteUntil = 0;
    let tabIO: IntersectionObserver | undefined;
    // The gate: no current section, no tabula. In a page's head — where `/obrazy` prints this
    // very index — nothing holds the viewport, so the gesture summons nothing, which is right:
    // the surface exists to answer a question the head is already answering in place.
    let tabCurrent = "";

    interface LenisRead {
      readonly scroll: number;
      readonly direction: 1 | -1 | 0;
      scrollTo(target: number, opts?: { immediate?: boolean; force?: boolean }): void;
    }
    const lenisRead = (): LenisRead | undefined =>
      (window as unknown as { __lenis?: LenisRead }).__lenis;
    // Position is read from Lenis's own float when it drives the scroll: `window.scrollY` is
    // rounded, so on the tail of an ease it stalls and stutters between integers, which is
    // exactly where a naive direction test flips sign. Direction comes from Lenis for the same
    // reason. Both fall back to the document for touch and reduced motion, where Lenis is not
    // mounted at all (BaseLayout gates it on `pointer: fine` + motion).
    const tabY = (): number => lenisRead()?.scroll ?? window.scrollY;

    const openTabula = () => {
      const c = chrome();
      if (!c || !tabCurrent || c.classList.contains("menu-open")) return;
      c.classList.add("tabula-open");
    };
    // force=true for the cases that are not a change of mind — leaving the indexed body of the
    // document, a navigation, the card opening. Everything else defers to a pointer or a keyboard
    // that is currently using the surface: withdrawing under someone's hand is the one failure
    // this gesture can produce that a hover-summoned surface cannot.
    const closeTabula = (force = false) => {
      const c = chrome();
      if (!c || !c.classList.contains("tabula-open")) return;
      if (!force) {
        const tab = c.querySelector<HTMLElement>(".tabula");
        if (tab && (tab.matches(":hover") || tab.contains(document.activeElement))) return;
      }
      c.classList.remove("tabula-open");
    };

    const tabulaScroll = () => {
      if (tabRaf) return;
      tabRaf = window.requestAnimationFrame(() => {
        tabRaf = 0;
        if (!tabIO) return;
        const y = tabY();
        const dy = y - tabLastY;
        tabLastY = y;
        if (window.performance.now() < tabMuteUntil) {
          tabTravel = 0;
          return;
        }
        if (dy === 0) return;
        const lenis = lenisRead();
        const dir = lenis && lenis.direction !== 0 ? lenis.direction : dy > 0 ? 1 : -1;
        // Turning resets the run. The accumulator then grows on raw delta, so a stray frame of
        // the wrong sign inside a run costs a pixel or two rather than the whole gesture.
        if ((dir > 0 && tabTravel < 0) || (dir < 0 && tabTravel > 0)) tabTravel = 0;
        tabTravel += dy;
        if (tabTravel <= -TABULA_UP) openTabula();
        else if (tabTravel >= TABULA_DOWN) closeTabula();
      });
    };

    // Re-armed on every navigation: ClientRouter swaps the whole document, so the observer's
    // targets, the rows and the page's very possession of a tabula all change under us.
    const armTabula = () => {
      tabIO?.disconnect();
      tabIO = undefined;
      tabCurrent = "";
      tabTravel = 0;
      tabLastY = tabY();
      const c = chrome();
      c?.classList.remove("tabula-open");
      const rows = Array.from(c?.querySelectorAll<HTMLAnchorElement>(".tabula-entry") ?? []);
      const pairs = rows
        .map((a) => ({ a, el: document.getElementById(a.getAttribute("href")?.slice(1) ?? "") }))
        .filter((p): p is { a: HTMLAnchorElement; el: HTMLElement } => p.el !== null);
      if (!pairs.length) return; // this page passed no index — no listener work beyond the bail
      // A centre band, as the two rails use: one section holds it at a time, and the SET is what
      // makes leaving the body of the document legible — an entry that stops intersecting fires,
      // an empty set means the reader is in the head or the foot and there is no row to mark.
      const active = new Set<Element>();
      tabIO = new IntersectionObserver(
        (obs) => {
          for (const e of obs) {
            if (e.isIntersecting) active.add(e.target);
            else active.delete(e.target);
          }
          const hit = pairs.find((p) => active.has(p.el)) ?? null;
          tabCurrent = hit ? hit.el.id : "";
          for (const p of pairs) {
            if (hit && p.el === hit.el) p.a.setAttribute("aria-current", "location");
            else p.a.removeAttribute("aria-current");
          }
          if (!tabCurrent) closeTabula(true);
        },
        { rootMargin: "-45% 0px -45% 0px", threshold: 0 },
      );
      pairs.forEach((p) => tabIO!.observe(p.el));
    };

    window.addEventListener("scroll", syncSolid, { passive: true });
    window.addEventListener("scroll", tabulaScroll, { passive: true });
    // Re-evaluate tone after each navigation (new page starts scrolled to top).
    document.addEventListener("astro:page-load", syncSolid);
    document.addEventListener("astro:page-load", armTabula);
    armTabula();
    // A navigation swap tears down the open overlay; drop the scroll lock with it (no wipe here).
    // The tabula goes with it: its rows belong to the outgoing document, and the incoming one is
    // at the top of itself where nothing holds the viewport anyway.
    document.addEventListener("astro:before-swap", () => {
      closeMenu(false);
      closeTabula(true);
    });
    // Mobile back button / edge-swipe: the browser pops our pushed entry — fade the card shut.
    // closeMenu no-ops when the card isn't open, so ordinary page-to-page back is unaffected.
    // The isOverlayEntry gate skips the router's synthetic popstate right after the open-push
    // and a forward re-traversal onto a stranded entry — neither is a dismissal.
    window.addEventListener("popstate", () => {
      if (!isOverlayEntry("navOpen")) closeMenu(true);
    });

    // CAPTURE phase — load-bearing, not stylistic. ClientRouter's own click handler is a
    // BUBBLING document listener registered ahead of this one (its script is emitted into
    // <head>, this one into the body), so a bubbling listener here reaches the anchor SECOND:
    // the router has already preventDefaulted the click and started navigating, and the
    // preventDefault below lands on a consumed event. The pull beat then never reads, and the
    // navigate() at the end of the beat hits a navigation already in flight — the router aborts
    // it and skips its View Transition, then re-fetches and re-swaps the same page. Which of the
    // three failures the visitor sees (no transition at all / the new page jumping / a stall of
    // a beat plus a hero warm) only depends on which frame the second call lands in. Capturing
    // puts our preventDefault before the router ever sees the click; same contract as
    // scripts/vault-triggers.ts, and the branches that navigate honour defaultPrevented in turn
    // so a capturing listener registered before this one still wins its own clicks.
    // `chrome()` gates every branch: after a ClientRouter swap onto the landing this script is
    // still live, but the landing's React StickyHeader (no #chrome id) owns its own menu there —
    // React binds on the island root, below document, so it wins that race without capturing.
    document.addEventListener("click", (e) => {
      const t = e.target as Element | null;
      if (!t || !chrome()) return;
      if (t.closest("#navToggle")) {
        openMenu();
        return;
      }
      if (t.closest("#menuClose")) {
        dismissMenu();
        return;
      }
      // A tabula row carries no pull beat — that beat is a page SWAP reading before a crossfade,
      // and an in-document jump has no swap. What it does need is the scroll itself, because
      // this surface is the first on the site whose anchors are clicked MID-GESTURE by
      // construction: the reader has just run back up the page, so Lenis is still animating when
      // the row is hit. Lenis keeps a virtual position and reasserts it on the next frame, so the
      // jump the router performs is silently undone and the click reads as dead — measured, on
      // every one of these pages. §20 found the plain anchor sufficient for `/obrazy`'s PRINTED
      // index and that finding stands: those rows are only reachable from a page at rest.
      //
      // So where Lenis owns the scroll, drive it rather than race it, with `immediate` — the
      // printed index on the same page lands its five destinations as a cut, and two index
      // surfaces pointing at the same five sections must not travel differently. The offset is
      // read from the target's own `scroll-margin-top` rather than restated here: one number,
      // in the stylesheet, where the bar's height is already accounted for. Without Lenis (touch,
      // reduced motion) nothing is taken over — there is nothing to fight, and the router's own
      // handling is what every other anchor on the site uses.
      const tabRow = t.closest(".tabula-entry");
      if (tabRow) {
        tabMuteUntil = window.performance.now() + TABULA_MUTE_MS;
        tabTravel = 0;
        closeTabula(true);
        const id = tabRow.getAttribute("href")?.slice(1) ?? "";
        const target = id ? document.getElementById(id) : null;
        const lenis = lenisRead();
        if (!target || !lenis || e.defaultPrevented) return;
        if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        e.preventDefault();
        const margin = Number.parseFloat(getComputedStyle(target).scrollMarginTop) || 0;
        lenis.scrollTo(window.scrollY + target.getBoundingClientRect().top - margin, {
          immediate: true,
          force: true,
        });
        // The hash is what keeps the row a LINK: it survives a copy, and back returns the reader
        // where they were — the same entry the anchor would have pushed on its own.
        window.history.pushState(null, "", `#${id}`);
        return;
      }
      // Registrum ribbon: pull the chosen bookmark long, then let the page dissolve onto its
      // concert. Plain primary clicks only — modified / middle clicks navigate normally (new tab),
      // and the current concert's own row (aria-current) just navigates (you can't pull to where
      // you already are). Reduced motion skips straight to the swap.
      const ribbon = t.closest(".registrum .ribbon");
      if (ribbon && ribbon.getAttribute("aria-current") !== "page") {
        if (e.defaultPrevented) return;
        if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        const href = ribbon.getAttribute("href");
        if (!href || reduce.matches) return;
        e.preventDefault();
        const registrum = ribbon.closest(".registrum");
        ribbon.classList.add("is-chosen");
        // is-committing also starts easing the hush blur to 0 (registrum.css), timed to be spent
        // by this beat's end; is-leaving then swaps blur(0) for NONE in the navigate tick — an
        // invisible change, but required BEFORE the View Transition captures the outgoing page
        // (a live backdrop-filter seams the snapshot; the dim tint stays and dissolves with it).
        registrum?.classList.add("is-committing");
        window.setTimeout(() => {
          registrum?.classList.add("is-leaving");
          void navigate(href);
        }, PULL_MS);
        // Safety: a no-op navigate (same URL) leaves no swap to discard the classes — release the
        // committing state so the set can't stay stuck withdrawn. A successful swap replaces these
        // nodes first, making this a harmless no-op on detached elements.
        window.setTimeout(() => {
          ribbon.classList.remove("is-chosen");
          registrum?.classList.remove("is-committing", "is-leaving");
        }, PULL_MS + 900);
        return;
      }
      // A voice or a Via row — both are lines of the same page and commit identically; each
      // carries its own `--vb`/`--vr` (nave-menu.css GEOMETRY), so nothing here needs to know
      // which kind it caught.
      const voice = t.closest(".nave .voice, .nave .via-row");
      if (voice) {
        // Tapping the page you're already on is a dismissal, not a journey — so it must be
        // stopped here. Left to the router, a link to the current URL is still a navigation:
        // it re-fetches and re-swaps the whole document under the card, replaying every reveal
        // and dropping the reader back at the top of a page they were already reading. Routing
        // it through dismissMenu (rather than a bare closeMenu) also consumes the card's own
        // history entry, so the back press it pushed doesn't linger unanswered.
        if (voice.getAttribute("aria-current") === "page") {
          e.preventDefault();
          dismissMenu();
          return;
        }
        // Modified / middle clicks navigate normally (new tab) — no pull, no classes.
        if (e.defaultPrevented) return;
        if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        // A line is a page — choosing one RUNS THE RIBBON (nave-menu.css): copying the row's
        // `--vb`/`--vr` onto the vitta makes the ONE ribbon run through the slot to the chosen
        // line (one height transition — never two ribbons swapping), and the swap is held one
        // PULL_MS beat so the run reads. The card stays OPEN into the swap: the OUTGOING
        // snapshot captures it mid-run and the page transition dissolves it into the
        // destination as one motion (`before-swap` tears it down AFTER the snapshot). The
        // chosen rubric is instant (no transition) so an early snapshot can't catch it
        // mid-tween. Reduced motion skips the hold — the swap is the transition.
        const list = voice.closest(".nave-list");
        voice.classList.add("is-chosen");
        list?.classList.add("is-committing");
        const vitta = list?.querySelector<HTMLElement>(".vitta");
        const prev = {
          vb: vitta?.style.getPropertyValue("--vb") ?? "",
          vr: vitta?.style.getPropertyValue("--vr") ?? "",
          set: vitta?.classList.contains("is-set") ?? false,
        };
        const vb = voice instanceof HTMLElement ? voice.style.getPropertyValue("--vb").trim() : "";
        const vr = voice instanceof HTMLElement ? voice.style.getPropertyValue("--vr").trim() : "";
        if (vitta && vb) {
          vitta.classList.add("is-set");
          vitta.style.setProperty("--vb", vb);
          vitta.style.setProperty("--vr", vr || "0");
        }
        const href = voice.getAttribute("href");
        if (!href) return;
        e.preventDefault();
        // navigateFromOverlay, not navigate: the card pushed a history entry on open, and the
        // destination has to REPLACE it — pushed on top it becomes a shadow entry that eats the
        // first back press. Reduced motion takes the same path without the hold beat, so the
        // back button behaves identically however the visitor has their system set.
        const commit = (): void => void navigateFromOverlay("navOpen", href);
        if (reduce.matches) commit();
        else window.setTimeout(commit, PULL_MS);
        // Safety: a no-op navigate leaves no swap to discard the classes — release the
        // committing state (and re-park the ribbon) so the card can't stay stuck mid-choice
        // (harmless on detached nodes after a successful swap).
        window.setTimeout(() => {
          voice.classList.remove("is-chosen");
          list?.classList.remove("is-committing");
          if (vitta) {
            if (prev.vb) vitta.style.setProperty("--vb", prev.vb);
            else vitta.style.removeProperty("--vb");
            if (prev.vr) vitta.style.setProperty("--vr", prev.vr);
            else vitta.style.removeProperty("--vr");
            if (!prev.set) vitta.classList.remove("is-set");
          }
        }, PULL_MS + 900);
        return;
      }
      // The Wesprzyj CTA (→ vault) or any other card link closes immediately (no page swap).
      if (t.closest(".nave a")) closeMenu(false);
    }, true);
    document.addEventListener("keydown", (e) => {
      const c = chrome();
      if (!c) return;
      if (e.key === "Escape") {
        // Desktop registrum ribbons hold open via :focus-within — Escape blurs out of the
        // set so the CSS releases it (the pointer path needs no JS at all).
        const active = document.activeElement as HTMLElement | null;
        if (active?.closest(".registrum-drop")) {
          active.blur();
          return;
        }
        // The tabula is dismissible the way every summoned surface here is. Blur out of it
        // first, or the focus that is standing inside it refuses the close (see closeTabula)
        // and the key reads as dead. The two surfaces cannot both be out, so this never
        // shadows the card: closeTabula no-ops unless the index is actually open.
        if (c.classList.contains("tabula-open")) {
          if (active?.closest(".tabula")) active.blur();
          tabTravel = 0;
          closeTabula(true);
          return;
        }
        dismissMenu();
        return;
      }
      // Focus trap: while the overlay is open, Tab cycles inside it.
      if (e.key !== "Tab" || !c.classList.contains("menu-open") || c.classList.contains("menu-closing")) return;
      const n = nave();
      if (!n) return;
      const targets = Array.from(n.querySelectorAll<HTMLElement>("a[href], button:not([disabled])"));
      if (!targets.length) return;
      const first = targets[0];
      const last = targets[targets.length - 1];
      const active = document.activeElement as HTMLElement | null;
      if (e.shiftKey && (!active || !n.contains(active) || active === first)) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && (!active || !n.contains(active) || active === last)) {
        e.preventDefault();
        first.focus();
      }
    });
  }
</script>
