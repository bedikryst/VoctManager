# Copy desk — credentials for the three commands that talk to the panel
# (`copy:sync`, `copy:propose`, `copy:apply`). Copy this file to `web/.env`,
# which is gitignored, and fill in the password.
#
# There is no API key: the scripts sign in at POST /api/token/ exactly as a
# browser does, because Postgres publishes no host port and HTTP is the only
# door from a checkout to the desk's mirror. The account must be `is_staff`
# — accepting a proposal is the decision to commit it (copydesk/permissions.py).

COPYDESK_EMAIL=you@example.com
COPYDESK_PASSWORD=

# The panel this checkout talks to. Omit for the dev stack's default.
# COPYDESK_API=http://localhost:8000
