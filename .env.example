# ==========================================
# VoctManager Backend Environment Variables
# Author: Krystian Bugalski
# Instructions: Copy this file to '.env' and replace the dummy values.
# ==========================================

# --- Core Django Settings ---
# Cryptographic signing key. KEEP THIS SECRET IN PRODUCTION!
SECRET_KEY=your-super-secret-django-key-replace-me-in-production

# Set to 'False' in production to disable debug pages and enforce security
DEBUG=True

# Comma-separated list of allowed hostnames.
ALLOWED_HOSTS=localhost,127.0.0.1,web,voctensemble.com,www.voctensemble.com,voctensemble.pl,www.voctensemble.pl,voctfoundation.pl,www.voctfoundation.pl,voctfoundation.com,www.voctfoundation.com,voctfoundation.org,www.voctfoundation.org

# --- PostgreSQL Database ---
# Credentials matching your docker-compose.yml postgres service
DB_NAME=voct_db
DB_USER=voct_user
DB_PASSWORD=voct_password
DB_HOST=db
DB_PORT=5432

# --- Redis & Celery ---
# Connection strings for the asynchronous task queue
REDIS_PASSWORD=voct_super_secret_redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0


# --- Security & CORS ---
# Comma-separated list of allowed frontend origins (no trailing slashes).
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1:5173,https://voctensemble.com,https://www.voctensemble.com,https://voctensemble.pl,https://www.voctensemble.pl,https://voctfoundation.pl,https://www.voctfoundation.pl,https://voctfoundation.com,https://www.voctfoundation.com,https://voctfoundation.org,https://www.voctfoundation.org

# Leave empty. An empty value is normalised to None (settings.py), so Django omits
# the Domain attribute and the browser scopes the cookie to the exact host that set
# it. That is both the only value that works across the several domains this single
# deployment answers on, and the stricter one — a host-only cookie is not exposed to
# subdomains. Set a value ONLY if the panel and the API ever move to different
# subdomains of one domain; the JWT auth cookies are host-only for the same reason.
CSRF_COOKIE_DOMAIN=

# --- Business Logic ---
# Default password automatically assigned to newly created Artist profiles
DEFAULT_ARTIST_PASSWORD=Password123!

# --- Monitoring ---
# Sentry DSN (Leave empty in local dev, set actual URL in production).
# NOTE: enabling this adds a RODO sub-processor — update the panel privacy
# policy, docs/legal/rodo-ropa.md and podprocesorzy.md BEFORE setting a value.
SENTRY_DSN=

# healthchecks.io ping URL for the Celery beat heartbeat (https://hc-ping.com/<uuid>).
# Empty = no ping (dev default). Separate from the backup job's own check, which
# lives in infra/backup.env. See docs/monitoring.md.
BEAT_HEARTBEAT_URL=

# --- Email (Anymail) — addresses, whatever the provider ---
DEFAULT_FROM_EMAIL=VoctManager <voctmanager@notifications.voctensemble.com>

# Inbox receiving in-app feedback (the corner widget). Defaults to
# PATRON_NOTIFICATION_EMAIL when unset — set it explicitly if reports should
# reach a different address than patronage leads.
FEEDBACK_NOTIFICATION_EMAIL=

# Sender for mail to people OUTSIDE the ensemble (the concert notice list). Left
# empty it becomes DEFAULT_FROM_EMAIL's own address under the display name
# "VoctEnsemble" — the panel's name means nothing to a concert-goer. Only set a
# different ADDRESS here once its domain has SPF/DKIM, or the mail lands in spam.
PUBLIC_FROM_EMAIL=

# Where a REPLY to that mail goes. The sender above is a noreply address, while the
# mail's footer invites the reader to write about their consent — so this must be a
# mailbox a human reads. Empty = rodo@voctensemble.com, which is the address the
# footer and the privacy policy both print.
PUBLIC_REPLY_TO_EMAIL=

# --- ESP SELECTION ---
# Which provider actually sends: "emaillabs", "resend", or empty for the console
# backend in development. Named explicitly so a rollback is this one variable and a
# restart. Empty with RESEND_API_KEY set still means Resend, for older deployments.
EMAIL_PROVIDER=emaillabs

# --- RESEND (USA) — the retiring provider, kept only so a rollback is one variable ---
# The privacy policy no longer names it as a processor, so switching EMAIL_PROVIDER back
# here is a data-protection decision and not merely a technical one.
RESEND_API_KEY=

# --- EMAILLABS (Vercom S.A., PL) ---
# App key + secret from Konto → Ustawienia → API.
EMAILLABS_APP_KEY=
EMAILLABS_SECRET_KEY=
# The sending identity inside the account, e.g. 1.voctensemble.smtp — never seen by a
# reader, but it picks the IP pool, and EmailLabs types an account as transactional or
# marketing. Panel mail belongs on a transactional one.
EMAILLABS_SMTP_ACCOUNT=
# "user:password" — the SAME string configured in the panel under Webhooks →
# Authentication mode → Basic auth. Their reports carry no signature, so this is the
# only thing standing between the suppression ledger and anyone who finds the URL.
# Generate a long random password; it is never typed by a human.
EMAILLABS_WEBHOOK_SECRET=

# ==========================================
# GOOGLE CLOUD PLATFORM (Logistics & Maps)
# ==========================================
GOOGLE_MAPS_BACKEND_KEY=your-google-maps-backend-api-key-replace-me

# Web Push (VAPID). The only push transport there is: the panel is a PWA, so a
# subscription always belongs to a browser and the keypair below is what signs
# the delivery. Generate once; changing it invalidates every live subscription.
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_PUBLIC_KEY=your_vapid_public_key_here

# --- AXEPTA BNP PARIBAS ---

AXEPTA_MERCHANT_ID=
AXEPTA_MAC_KEY=
AXEPTA_SERVICE_ID=

AXEPTA_API_URL="https://api.sandbox.axepta.pl/v1"
AXEPTA_TOKEN=
AXEPTA_RETURN_URL="https://voctensemble.com/?donated=success"
AXEPTA_FAILURE_RETURN_URL="https://voctensemble.com/?donated=failure"
# Sends `customer.locale` (pl|en) with the payment-link request, which sets the
# language of the mail Axepta sends about a payment having started. It is
# documented on the API's `transaction` schema, not on `payment-link`. KEEP OFF:
# tried on production in 2026-09, the gateway took 'pl' and refused 'en', so
# every English and French donation died with a 502. The payment page's own
# language does not depend on this — it comes from the returned URL.
AXEPTA_SEND_CUSTOMER_LOCALE="False"

# --- SCORE PACKAGE COMPILER (AI PDF reading & generation) ---
# Claude (Anthropic) API key. Required for ingestion; leave blank to disable.
ANTHROPIC_API_KEY=
# SDK transient-retry budget (429/5xx/529-overloaded/connection). The Celery
# layer adds a far more patient tier on top, so this stays modest. (default: 4)
ANTHROPIC_MAX_RETRIES=4
# Per-request timeout, seconds. Generous (worker, not a web request); an explicit
# value also suppresses the SDK's large-max_tokens non-streaming guard. (default: 600)
ANTHROPIC_REQUEST_TIMEOUT_SECONDS=600

# Cost governance (USD cents). A native-PDF run is ~10-30¢.
#   per-run ceiling: refused once THIS run hits it; resets on every (re)ingest.
INGESTION_COST_CEILING_CENTS=100
#   lifetime ceiling per edition: never resets — stops a re-processed PDF draining the account.
INGESTION_LIFETIME_CEILING_CENTS=500
#   org-wide DAILY budget: circuit breaker summed across all editions today.
INGESTION_DAILY_BUDGET_CENTS=2000
ANTHROPIC_MAX_RETRIES=3


# Recording enrichment (optional — blank disables that source).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=
